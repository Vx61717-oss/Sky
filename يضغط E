--// Mobile + Draggable + Animated Border

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer

local Enabled = true
local CurrentPrompt = nil

--==================================================
-- GUI
--==================================================

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SKY_AutoE"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = game:GetService("CoreGui")

local Main = Instance.new("Frame")
Main.Name = "Main"
Main.Size = UDim2.new(0, 190, 0, 75)
Main.Position = UDim2.new(0.5, -95, 0.5, -37)
Main.BackgroundColor3 = Color3.fromRGB(8, 8, 12)
Main.BorderSizePixel = 0
Main.Active = true
Main.Parent = ScreenGui

local MainCorner = Instance.new("UICorner")
MainCorner.CornerRadius = UDim.new(0, 14)
MainCorner.Parent = Main

--==================================================
-- الحواف البنفسجية المتحركة
--==================================================

local Stroke = Instance.new("UIStroke")
Stroke.Thickness = 3
Stroke.Parent = Main

local Gradient = Instance.new("UIGradient")
Gradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
    ColorSequenceKeypoint.new(0.25, Color3.fromRGB(80, 0, 180)),
    ColorSequenceKeypoint.new(0.5, Color3.fromRGB(180, 0, 255)),
    ColorSequenceKeypoint.new(0.75, Color3.fromRGB(80, 0, 180)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
})
Gradient.Parent = Stroke

task.spawn(function()
    while Main.Parent do
        Gradient.Rotation = 0
        Gradient.Offset = Vector2.new(-1, 0)

        local Tween = TweenService:Create(
            Gradient,
            TweenInfo.new(2, Enum.EasingStyle.Linear),
            {
                Offset = Vector2.new(1, 0)
            }
        )

        Tween:Play()
        Tween.Completed:Wait()
    end
end)

