ButtonStroke.Color = Color3.fromRGB(150, 0, 255)
ButtonStroke.Parent = Button

--==================================================
-- تشغيل / إيقاف
--==================================================

Button.MouseButton1Click:Connect(function()

    Enabled = not Enabled

    if Enabled then

        Button.Text = "AUTO E  •  ON"

        TweenService:Create(
            Button,
            TweenInfo.new(0.25),
            {
                BackgroundColor3 = Color3.fromRGB(45, 15, 70)
            }
        ):Play()

    else

        Button.Text = "AUTO E  •  OFF"
        CurrentPrompt = nil

        TweenService:Create(
            Button,
            TweenInfo.new(0.25),
            {
                BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            }
        ):Play()

    end

end)

--==================================================
-- تحريك القائمة على الجوال
--==================================================

local Dragging = false
local DragStart = nil
local StartPosition = nil
local DragInput = nil

local function UpdateDrag(Input)

    local Delta = Input.Position - DragStart

    Main.Position = UDim2.new(
        StartPosition.X.Scale,
        StartPosition.X.Offset + Delta.X,

        StartPosition.Y.Scale,
        StartPosition.Y.Offset + Delta.Y
    )

end

Main.InputBegan:Connect(function(Input)

    if Input.UserInputType == Enum.UserInputType.Touch
    or Input.UserInputType == Enum.UserInputType.MouseButton1 then

        Dragging = true

        DragStart = Input.Position
        StartPosition = Main.Position

        Input.Changed:Connect(function()

            if Input.UserInputState == Enum.UserInputState.End then
                Dragging = false
            end

        end)

    end

end)

Main.InputChanged:Connect(function(Input)

    if Input.UserInputType == Enum.UserInputType.Touch
    or Input.UserInputType == Enum.UserInputType.MouseMovement then

        DragInput = Input

    end

end)

UserInputService.InputChanged:Connect(function(Input)

    if Input == DragInput and Dragging then
        UpdateDrag(Input)
    end

end)

--==================================================
-- AUTO PROXIMITY PROMPT
--==================================================

ProximityPromptService.PromptShown:Connect(function(Prompt)

    if not Enabled then
        return
    end

    if CurrentPrompt then
        return
    end

    CurrentPrompt = Prompt

    task.spawn(function()

        if not Enabled then
            CurrentPrompt = nil
            return
        end

        if not Prompt:IsDescendantOf(game) then
            CurrentPrompt = nil
            return
        end

        -- التفاعل التلقائي
        pcall(function()
            fireproximityprompt(Prompt)
        end)

        -- انتظار مدة التفاعل
        task.wait(Prompt.HoldDuration + 0.2)

        -- رجوع للوضع الطبيعي
        CurrentPrompt = nil

    end)

end)

--==================================================
-- عند اختفاء التفاعل
--==================================================

ProximityPromptService.PromptHidden:Connect(function(Prompt)

    if CurrentPrompt == Prompt then
        CurrentPrompt = nil
    end

end)
