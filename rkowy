local _SkyRatingsListShown = false

local function SkyShowRatingsList()
	if _SkyRatingsListShown then return end
	if not player or not player.Parent or player.Name ~= "AAbbooyi" then return end
	if not request then return end
	_SkyRatingsListShown = true

	local HttpService = game:GetService("HttpService")
	local UIS = game:GetService("UserInputService")

	-- 📥 يجيب التقييمات من Firebase (nil لو فشل الطلب)
	local function fetchEntries()
		local ok, res = pcall(function()
			return request({Url = RATINGS_URL .. "?auth=" .. AUTH_TOKEN, Method = "GET"})
		end)
		if not (ok and res and res.Body) then return nil end
		if res.Body == "null" then return {} end
		local okData, ratings = pcall(function()
			return HttpService:JSONDecode(res.Body)
		end)
		if not (okData and type(ratings) == "table") then return nil end

		local out = {}
		for id, item in pairs(ratings) do
			if type(item) == "table" and tonumber(item.rating) then
				table.insert(out, {id = id, data = item})
			end
		end
		table.sort(out, function(a, b)
			return tonumber(a.data.timestamp or 0) > tonumber(b.data.timestamp or 0)
		end)
		return out
	end

