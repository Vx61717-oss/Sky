        local function updateOwnMessageReadState(otherUserInChat)
            local latestOwnRow = nil
            local latestTimestamp = -math.huge

            -- نحدد آخر رسالة لي فقط حتى لا نكرر الحالة تحت كل الرسائل القديمة.
            for _, row in ipairs(chatLog:GetChildren()) do
                if row:IsA("Frame") and row.Name == "MsgRow" and row:GetAttribute("IsMine") then
                    local rowTimestamp = tonumber(row:GetAttribute("ChatTimestamp")) or 0
                    if rowTimestamp >= latestTimestamp then
                        latestTimestamp = rowTimestamp
                        latestOwnRow = row
                    end
                end
            end

            -- أي شخص داخل الدردشة الحين ينضاف لقايمة اللي شافوا آخر رسالة (ويبقى حتى لو طلع بعدين)
            if latestOwnRow then
                local key = _ReadRx.keyOf(latestOwnRow)
                local rd = _ReadRx.rows[key]
                if not rd then
                    rd = {list = {}, set = {}}
                    _ReadRx.rows[key] = rd
                end
                for _, name in ipairs(_ReadRx.present) do
                    if not rd.set[name] then
                        rd.set[name] = true
                        table.insert(rd.list, name)
                    end
                end
                if #rd.list > 0 then
                    latestOwnRow:SetAttribute("ReadState", "Read")
                end
            end

            for _, row in ipairs(chatLog:GetChildren()) do
                if row:IsA("Frame") and row.Name == "MsgRow" and row:GetAttribute("IsMine") then
                    _ReadRx.render(row, row == latestOwnRow)
                end
            end
        end

