        -- يحفظ الرسالة الخاصة (مرة وحدة لكل رسالة) ويرجع true إذا كانت جديدة
        _G.SkyPmStore = function(partnerId, m, key)
            if not partnerId or not key then return false end
            local h = pmHistoryFor(partnerId)
            if h.seen[key] then return false end
            h.seen[key] = true
            table.insert(h.list, m)
            if _G.SkyPmActiveUserId == partnerId then pmAppendBubble(m) end
            return true
        end

        -- يستقبل أي رسالة خاصة من السيرفر ويحدد الطرف الثاني فيها
        _G.SkyPmIncoming = function(m)
            local myId = game.Players.LocalPlayer.UserId
            local uid, tid = tonumber(m.userId), tonumber(m.targetUserId)
            if not uid or not tid or uid == tid then return end
            local partner
            if tid == myId then partner = uid
            elseif uid == myId then partner = tid
            else return end
            local key = tostring(m.clientId or m.id or (tostring(m.timestamp) .. ":" .. tostring(m.text)))
            local isNew = _G.SkyPmStore(partner, m, key)
            -- إشعار بس للرسايل الجديدة من الشخص الثاني (مو رسايلي، ومو من قبل تشغيل السكربت)
            if isNew and uid ~= myId and (tonumber(m.timestamp) or 0) >= CHAT_SESSION_STARTED_AT then
                pmOnNewIncoming(partner, m)
            end
        end

