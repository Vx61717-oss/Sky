            -- مثال: "sky لا هو كيذا"  ←  "@sky لا هو كيذا"
            _G.SkyAutoMention = function(text)
                if type(text) ~= "string" then return text end
                local first, rest = text:match("^%s*([%w_]+)(.*)$")
                if not first or #first < 3 then return text end
                for _, pl in ipairs(game.Players:GetPlayers()) do
                    if pl.Name:lower() == first:lower() then
                        return "@" .. pl.Name .. rest
                    end
                end
                return text
            end

