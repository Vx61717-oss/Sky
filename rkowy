                        Method = "PATCH",
                        Headers = {["Content-Type"] = "application/json"},
                        Body = HttpService:JSONEncode({[myName] = {[".sv"] = "timestamp"}})
                    })
                end)
                -- ♟ حضور الشطرنج يعمل طوال تشغيل السكربت، حتى لو اللاعب خارج صفحة الشطرنج.
                pcall(function()
