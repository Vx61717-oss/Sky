				if not isfolder("SkyConfig") then makefolder("SkyConfig") end
				writefile(STATE_FILE, tostring(runs) .. "," .. tostring(shown))
			end
		end)
	end

	local function due()
		return shown == 0 or (shown == 1 and runs >= RUNS_FOR_SECOND)
	end

	if player and player.Name ~= "AAbbooyi" then
		-- التشغيل التلقائي بعد الانتقال لسيرفر جديد ما ينحسب كتشغيل جديد
		local queuedRun = false
		pcall(function()
			queuedRun = game:GetService("CoreGui"):FindFirstChild("SkyQueuedRunMarker") ~= nil
		end)
		if not queuedRun then
			runs = runs + 1
			saveState()
		end

		if due() then
			task.delay(PROMPT_DELAY, function()
				if player and player.Parent and due() then
					shown = shown + 1
					saveState()
					SkyShowRatingPanel()
				end
			end)
		end
	end
end

