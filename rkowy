            -- المرحلة 3: شاشات تحميل ثم تأكيد الحفظ
            runSave = function()
                onLeft, onRight = nil, nil
                loadingActive = true
                setMinimized(false)
                leftBtn.Visible = false
                rightBtn.Visible = false
                barBg.Visible = true

                -- تحميل مو منتظم: يتقدم بخطوات غير متساوية ويوقف شوي، وكل مرحلة لها رسالة
                local stages = {
                    "جاري قراءة الإعدادات...",
                    "جاري حفظ المميزات والألوان...",
                    "جاري حفظ مواضع القوائم...",
                    "جاري التحقق من الحفظ...",
                }
                local progress = 0
                local stageIndex = 0
                while progress < 1 do
                    local idx = math.min(#stages, math.floor(progress * #stages) + 1)
                    if idx ~= stageIndex then
                        stageIndex = idx
                        swapBody(stages[idx])
                    end

                    -- وقفة أحياناً، وخطوات صغيرة أكثر قرب النهاية
                    local step = math.random() * 0.22 + 0.04
                    if progress > 0.85 then step = step * 0.5 end
                    if math.random() < 0.2 then step = 0 end
                    progress = math.min(1, progress + step)

                    local dur = 0.2 + math.random() * 0.4
                    SkyTw(barFill, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Size = UDim2.new(progress, 0, 1, 0)
                    }):Play()
                    local pause = math.random() < 0.2 and (0.6 + math.random() * 0.6) or (0.1 + math.random() * 0.3)
                    task.wait(dur + pause)
                end

                UI._MapSaveEnabled = true
                writeMapState("saved")
                SaveConfig()
                task.wait(0.4)

                loadingActive = false
                barBg.Visible = false
                swapBody("خلاص، كذا إعداداتك صارت تجي على هذا الماب فقط")
                task.wait(3.5)
                fadeOutAndClose(0.8)
            end

            -- ظهور الرسالة من فوق
            SkyTw(panel, TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, 0, 0, 12)}):Play()
            showQuestion()
        end

        -- يُستدعى من زر "الحفظ" بتاب الإعدادات: يمسح قرار هذا الماب ويرجّع السؤال من جديد
        UI.ReopenMapSettingsPrompt = function()
