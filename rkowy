        SkyTw(I, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0, 330, 0, 0)
        }):Play()

        task.delay(0.56, function()
            removeNotificationRecord(category, F)
            if F.Parent then F:Destroy() end
            if liveKey and _liveNotifFrames[liveKey] == F then
                _liveNotifFrames[liveKey] = nil
            end
        end)
    end)

    table.insert(_notificationQueues[category], F)
    trimNotificationQueue(category)
    updateNotificationPositions()

    -- 🔑 لو معه liveKey، نسجّله كإشعار حي؛ أي نداء Notify جاي بنفس المفتاح يحدّث هذا الفريم بدل ما يكدّس وحد جديد.
    if liveKey then
        F:SetAttribute("Gen", 0)
        _liveNotifFrames[liveKey] = F
    end

    task.spawn(function()
        pcall(function()
            -- دخول هادئ وبطيء من اليمين لليسار، مع ظهور تدريجي خفيف مثل شاشة التحميل.
            SkyTw(I, TweenInfo.new(0.58, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = UDim2.new(0, 0, 0, 0)
            }):Play()
            SkyTw(I, TweenInfo.new(0.68, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundTransparency = 0.08
            }):Play()
            SkyTw(TL, TweenInfo.new(0.68, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
            SkyTw(ML, TweenInfo.new(0.68, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
            if AvatarImg then
                SkyTw(AvatarImg, TweenInfo.new(0.68, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {ImageTransparency = 0}):Play()
            end

            if shake then
                -- 🚨 إنذار واضح للاعب المحدد عند خروجه: حوالي ثانية وباهتزاز أقوى.
                task.wait(0.12)
                if not F.Parent then return end
                local shakeOffsets = {10, -10, 9, -9, 8, -8, 7, -7, 6, -6, 5, -5, 4, -4, 3, -3, 0}
                for _, offset in ipairs(shakeOffsets) do
                    if not F.Parent then return end
                    local duration = (math.abs(offset) >= 8) and 0.055 or 0.045
                    local tween = SkyTw(I, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
                        Position = UDim2.new(0, offset, 0, 0)
                    })
                    tween:Play()
                    tween.Completed:Wait()
                end
                SkyTw(I, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Position = UDim2.new(0, 0, 0, 0)
                }):Play()
            end

            _dismissNotificationAfterDelay(F, I, Stroke, TL, ML, AvatarImg, category, liveKey and 0 or nil, liveKey)
        end)
    end)
end

