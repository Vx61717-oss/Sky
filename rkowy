        local function solveFrom(start, weight, cap, alive)
            local cols, n = COLS, N
            local function dist(v, i)
                return math.abs((v - 1) % cols - (i - 1) % cols)
                    + math.abs(math.floor((v - 1) / cols) - math.floor((i - 1) / cols))
            end
            local function keyOf(a) return table.concat(a, ",") end

            local heap, hn = {}, 0
            local function push(node)
