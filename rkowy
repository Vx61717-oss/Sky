                    end
                    local e = cur.e
                    local nbs = {}
                    if e > cols then table.insert(nbs, e - cols) end
                    if e <= n - cols then table.insert(nbs, e + cols) end
                    if (e - 1) % cols > 0 then table.insert(nbs, e - 1) end
                    if (e - 1) % cols < cols - 1 then table.insert(nbs, e + 1) end
                    for _, t in ipairs(nbs) do
                        local nb = copyBoard(cur.b)
                        local v = nb[t]
