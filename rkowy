        -- ------------------------------------------------------------------
        -- 3) 💣 قصف القنابل (سكربت ترتبتي: يقصف اللاعب المحدد في تاب 2)
        -- ------------------------------------------------------------------
        do
            local bombRunning = false
            local bombGen = 0

            local function GetRemotes()
                local mt = _RepStorage:FindFirstChild("MenuToys")
                local be = _RepStorage:FindFirstChild("BombEvents")
                local ge = _RepStorage:FindFirstChild("GrabEvents")
                local spawnRemote = mt and mt:FindFirstChild("SpawnToyRemoteFunction")
                local explodeRemote = be and be:FindFirstChild("BombExplode")
                local networkRemote = ge and ge:FindFirstChild("SetNetworkOwner")
                return spawnRemote, explodeRemote, networkRemote
            end

            local function executePerfectBomb(targetPlayer, spawnRemote, explodeRemote, networkRemote, gen)
                local function alive() return bombRunning and bombGen == gen end
                local myRoot = _me.Character and (_me.Character:FindFirstChild("HumanoidRootPart") or _me.Character:FindFirstChild("Torso"))
                if not myRoot or not targetPlayer or not targetPlayer.Character then return end
                local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart") or targetPlayer.Character:FindFirstChild("Torso")
                if not targetRoot then return end

                local folderName = _me.Name .. "SpawnedInToys"
                local toyFolder = workspace:FindFirstChild(folderName)
                if toyFolder then
                    for _, obj in pairs(toyFolder:GetChildren()) do
                        if obj.Name == "BombMissile" then obj:Destroy() end
                    end
                end

                local myHeadCF = myRoot.CFrame * CFrame.new(0, 12, 0)
                task.spawn(function()
                    spawnRemote:InvokeServer("BombMissile", myHeadCF, Vector3.new(0, 0, 0))
                end)

                local bombModel = nil
                local startTime = tick()
                while not bombModel and (tick() - startTime) < 2 do
                    toyFolder = workspace:FindFirstChild(folderName)
                    if toyFolder then bombModel = toyFolder:FindFirstChild("BombMissile") end
                    task.wait(0.02)
                end
                if not bombModel or not alive() then return end

                local buttonPart = bombModel:WaitForChild("Button", 1)
                local hitDetector = bombModel:WaitForChild("PartHitDetector", 1)
                local bodyPart = bombModel:WaitForChild("Body", 1)
                if not buttonPart or not hitDetector or not bodyPart then return end

                for _, part in pairs(bombModel:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                        part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    end
                end

                task.wait(0.5)
                if not alive() then return end

                networkRemote:FireServer(buttonPart, buttonPart.CFrame)
                local clickDetector = buttonPart:FindFirstChildWhichIsA("ClickDetector")
                if clickDetector and fireclickdetector then
                    fireclickdetector(clickDetector)
                end

                if not alive() or not targetRoot or not targetRoot.Parent then return end

                for _, part in pairs(bombModel:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = true end
                end

                local targetVelocity = targetRoot.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
                local predictedPosition = targetRoot.Position + (targetVelocity * 0.28) + Vector3.new(0, 1.5, 0)
                local targetCF = CFrame.new(predictedPosition)

                if bombModel:IsA("Model") then bombModel:PivotTo(targetCF) end
                for _, part in pairs(bombModel:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CFrame = targetCF
                        part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    end
                end

                explodeRemote:FireServer({
                    ["Radius"] = 50,
                    ["TimeLength"] = 0.2,
                    ["Hitbox"] = hitDetector,
                    ["ExplodesByFire"] = true,
                    ["MaxForcePerStudSquared"] = 1000,
                    ["DestroysModel"] = true,
                    ["Model"] = bombModel,
                    ["ExplodesByPointy"] = false,
                    ["ImpactSpeed"] = 35,
                    ["PositionPart"] = bodyPart,
                }, predictedPosition)
            end

            MakeFeature({
                tab6 = "قصف القنابل",
                item = "💣 قصف القنابل",
                order = 3,
                onMsg = "💣 قصف القنابل: تشغيل",
                offMsg = "💣 قصف القنابل: إيقاف",
                start = function(reject)
                    local target = State.selectedPlayer
                    if not target then
                        WARN("⚠️ اختر لاعب من القائمة أول!")
                        reject()
                        return
                    end
                    local spawnRemote, explodeRemote, networkRemote = GetRemotes()
                    if not spawnRemote or not explodeRemote or not networkRemote then
                        WARN("⚠️ ريموتات القنابل مو موجودة بهالماب")
                        reject()
                        return
                    end
                    bombGen = bombGen + 1
                    local gen = bombGen
                    bombRunning = true
                    task.spawn(function()
                        while bombRunning and bombGen == gen do
                            local t = State.selectedPlayer
                            if not t or not t.Parent then
                                -- الهدف راح أو انشال التحديد: نوقف
                                reject()
                                break
                            end
                            pcall(executePerfectBomb, t, spawnRemote, explodeRemote, networkRemote, gen)
                            task.wait(0.3)
                        end
                    end)
                end,
                stop = function()
                    bombRunning = false
                    bombGen = bombGen + 1
                end,
            })
        end

