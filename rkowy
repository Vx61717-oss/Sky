        local function newMathQuestion()
            locked = false
            local a, b = math.random(2, 12), math.random(2, 12)
            local op = math.random(1, 3)
            local symbol
            if op == 1 then symbol = "+"; answer = a + b
            elseif op == 2 then
                if a < b then a, b = b, a end
                symbol = "-"; answer = a - b
            else symbol = "×"; answer = a * b end
            questionLabel.Text = tostring(a) .. " " .. symbol .. " " .. tostring(b) .. " = ؟"
            feedback.Text = "اختر الناتج الصحيح"
            local values = {answer}
            while #values < 3 do
                local candidate = answer + math.random(-10, 10)
                if candidate ~= answer and candidate >= 0 then
                    local exists = false
                    for _, value in ipairs(values) do
                        if value == candidate then exists = true end
                    end
                    if not exists then table.insert(values, candidate) end
                end
            end
            for i = #values, 2, -1 do
                local j = math.random(i)
                values[i], values[j] = values[j], values[i]
            end
            for i, button in ipairs(choices) do button.Text = tostring(values[i]) end
        end

