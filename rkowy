                -- 🚗 السيارات
                local function newCar(kind, name, color, slot)
                    local c = {kind = kind, name = name, v = 0, lap = 0, idx = 1, steer = 0, slot = slot,
                        isMe = (kind == "me"),
                        -- البوتات أقوى من قبل، ولكل واحد مستوى قيادة مختلف
