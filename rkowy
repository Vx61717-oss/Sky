            if type(q) ~= "string" or q == "" then return false end
            if not SkyAI.lastScript or (os.clock() - (SkyAI.lastScriptAt or 0)) > 3600 then return false end
            local low = q:lower()
            -- يبي سكربت جديد صريح؟ فهذا مو تعديل
            if SkyAI._has(low, {"سكربت جديد", "سكريبت جديد", "سكربت ثاني", "سكريبت ثاني", "سكربت اخر", "سكربت آخر", "سكريبت اخر", "سكريبت آخر", "سكربت ثانية", "من الصفر", "new script", "another script"}) then return false end
            -- أفعال تعديل
            if SkyAI._has(low, {"عدل", "عدّل", "تعديل", "زيد", "زود", "أضف", "اضف", "ضيف", "أضيف", "صلح", "صحح", "بدل", "شيل", "احذف", "امسح", "غير", "غيّر", "حسن", "حسّن", "خله", "خلي", "خلّه", "قلل", "كبر", "صغر", "اجعل", "رتب", "لون", "edit", "fix", "modify", "update", "remove", "change", "add ", "make it"}) then
                return true
            end
            -- ملاحظات على السكربت (ما عجبني / ما يشتغل / فيه مشكلة...)
            if SkyAI._has(low, {"ما عجب", "ما اعجب", "ماعجب", "مااعجب", "مو حلو", "مب حلو", "مو عاجب", "ما اشتغل", "ما يشتغل", "ماشتغل", "مايشتغل", "ما ضبط", "ماضبط", "غلط", "خربان", "فيه مشكل", "فيها مشكل", "مشكلة", "ما يطلع", "ما تطلع", "ما ينفتح"}) then
                return true
            end
            return false
        end

        -- يفصل الكود عن الشرح من رد الذكاء الاصطناعي
        SkyAI.extractScript = function(body)
            local code = body:match("```[%w_]*[ \t]*\r?\n(.-)```") or body:match("```[%w_]*[ \t]*\r?\n(.*)$")
            if not code then return nil, body end
            local before = body:match("^(.-)```") or ""
            before = before:gsub("^%s+", ""):gsub("%s+$", "")
            code = code:gsub("^%s+", ""):gsub("%s+$", "")
            if code == "" then return nil, body end
            return code, before
        end

        -- 🧾 يطلع اسم الملف + الشرح (وش يسوي / وش أضفت) من كلام الذكاء الاصطناعي قبل الكود
        SkyAI.parseScriptInfo = function(before)
            local name
            local lines = {}
            for line in ((before or "") .. "\n"):gmatch("([^\r\n]*)\r?\n") do
                local l = line:gsub("^%s+", ""):gsub("%s+$", "")
                local fn = l:match("^[Ff][Ii][Ll][Ee]%s*[:：]%s*(.+)$")
                if fn then
                    fn = fn:gsub("[^%w_%-%.]", "")
                    if fn ~= "" then name = fn end
                elseif l ~= "" and #lines < 9 then
                    l = l:gsub("%*%*", ""):gsub("^#+%s*", ""):gsub("^[%-%*]%s+", "• ")
                    table.insert(lines, l)
                end
            end
            name = tostring(name or "sky_script"):gsub("%.[Ll][Uu][Aa]$", "")
            if name == "" then name = "sky_script" end
            name = name:sub(1, 24) .. ".lua"
            local details = table.concat(lines, "\n")
            if utf8.len(details) and utf8.len(details) > 520 then
                details = details:sub(1, (utf8.offset(details, 521) or (#details + 1)) - 1) .. "…"
            end
            return name, details
        end

