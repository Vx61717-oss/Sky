        if p ~= _lastP then
            _lastP, _isF = p, false
            if p then
                task.spawn(function()
                    local r = IsFriend(p)
                    if _lastP == p then _isF = r and true or false end
                end)
            end
        end

        local cam = workspace.CurrentCamera
        local root = p and p.Parent == Players and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if not (p and root and cam) then
            _arrow.Visible, _dist.Visible = false, false
            return
        end

        local pos = root.Position + Vector3.new(0, 3.5, 0)
        local W, H = _arrowGui.AbsoluteSize.X, _arrowGui.AbsoluteSize.Y
        local v = cam:WorldToViewportPoint(pos)
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local studs = myRoot and math.floor((myRoot.Position - root.Position).Magnitude) or 0

        -- كل ما بعد اللاعب يكبر السهم (من 56 لين 100)
        local sz = math.clamp(56 + studs * 0.12, 56, 100)
        _arrow.Size = UDim2.new(0, sz, 0, sz)
        _arrow.TextSize = math.floor(sz * 0.85)
        local m = sz * 0.75

        if v.Z > 0 and v.X > m and v.X < W - m and v.Y > m and v.Y < H - m then
            -- على الشاشة: سهم لتحت فوق راسه
            _arrow.Text = "▼"
            _arrow.Rotation = 0
            _arrow.Position = UDim2.new(0, v.X, 0, v.Y - sz * 0.6)
            _dist.Position = UDim2.new(0, v.X, 0, v.Y - sz * 1.1)
        else
            -- برا الشاشة: سهم على الحافة باتجاه اللاعب
            _arrow.Text = "▲"
            local rel = cam.CFrame:PointToObjectSpace(pos)
            local d = Vector2.new(rel.X, -rel.Y)
            if d.Magnitude < 1e-3 then d = Vector2.new(1, 0) end
            d = d.Unit
            local sx = math.abs(d.X) > 1e-3 and (W / 2 - m) / math.abs(d.X) or math.huge
            local sy = math.abs(d.Y) > 1e-3 and (H / 2 - m) / math.abs(d.Y) or math.huge
            local k = math.min(sx, sy)
            local px, py = W / 2 + d.X * k, H / 2 + d.Y * k
            _arrow.Rotation = math.deg(math.atan2(d.X, -d.Y))
            _arrow.Position = UDim2.new(0, px, 0, py)
            _dist.Position = UDim2.new(0, px, 0, py + sz * 0.7)
        end
        _dist.Text = studs .. " m"
        _arrow.Visible, _dist.Visible = true, true
    end)
end

