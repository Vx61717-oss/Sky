                            local nowClock = os.clock()
                            _Aux.seen = _Aux.seen or {}
                            for pname, pts in pairs(presenceData) do
                                if pname ~= myName and type(pts) == "number" then
                                    local entry = _Aux.seen[pname]
                                    if not entry then
                                        entry = {value = pts, t = nowClock, changed = false}
                                        _Aux.seen[pname] = entry
                                    elseif entry.value ~= pts then
                                        entry.value = pts
                                        entry.t = nowClock
                                        entry.changed = true
                                    end
                                    local clockFresh = math.abs(os.time() - pts) < 10
                                    local stillMoving = entry.changed and (nowClock - entry.t) < 15
                                    if clockFresh or stillMoving then
