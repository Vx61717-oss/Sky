        -- 📤 إرسال الملاحظة لفايربيس عشان المطوّرة تشوفها لاحقًا
        local function sendNote()
            local text = tostring(notesInputBox.Text or "")
            if text:gsub("%s+", "") == "" then return end
            notesInputBox.Text = ""

            local myName = game.Players.LocalPlayer.Name
            local myUserId = game.Players.LocalPlayer.UserId
            local payload = {
                ["sender"] = myName,
                ["userId"] = myUserId,
                ["text"] = text,
                ["ts"] = os.time(),
                ["placeId"] = tostring(game.PlaceId),
            }

            task.spawn(function()
                local ok = false
                local newId = nil
                if request then
                    local success, response = pcall(function()
                        return request({
                            Url = NOTES_URL .. "?auth=" .. AUTH_TOKEN,
                            Method = "POST",
                            Headers = {["Content-Type"] = "application/json"},
                            Body = game:GetService("HttpService"):JSONEncode(payload)
                        })
                    end)
                    ok = success and response and (not response.StatusCode or response.StatusCode == 200)
                    if ok and response.Body then
                        local okK, keyData = pcall(function()
                            return game:GetService("HttpService"):JSONDecode(response.Body)
                        end)
                        if okK and keyData and keyData.name then newId = keyData.name end
                    end
                end
                addNoteRow(text, ok, newId, myUserId)
                if ok then
                    Notify("📝 تم الإرسال", "وصلت ملاحظتك، شكرًا لك", UI.TabColors[8])
                else
                    Notify("❌ فشل الإرسال", "تأكد من الاتصال وحاول مرة ثانية", Color3.fromRGB(255, 60, 60))
                end
            end)
        end

        notesInputBox.FocusLost:Connect(function(enter)
            if enter then sendNote() end
        end)

        -- 📂 نجيب الملاحظات أول ما تفتح النافذة: عند AAbbooyi كل ملاحظات الكل، عند الباقين ملاحظاتهم هم بس
        task.spawn(function()
            if not request then return end
            local ok, res = pcall(function()
                return request({Url = NOTES_URL .. "?auth=" .. AUTH_TOKEN, Method = "GET"})
            end)
            if not (ok and res and res.Body and res.Body ~= "null") then return end
            local okD, allNotes = pcall(function()
                return game:GetService("HttpService"):JSONDecode(res.Body)
            end)
            if not (okD and type(allNotes) == "table") then return end

            local myUserId = game.Players.LocalPlayer.UserId
            local list = {}
            for k, v in pairs(allNotes) do
                if type(v) == "table" and (isNotesAdmin or v.userId == myUserId) then
                    v.__id = k
                    table.insert(list, v)
                end
            end
            table.sort(list, function(a, b) return (a.ts or 0) < (b.ts or 0) end)
            if not isNotesAdmin then
                while #list > 10 do table.remove(list, 1) end
            end
            if #list > 0 then NotesEmptyLbl.Visible = false end
            for _, v in ipairs(list) do
                addNoteRow(tostring(v.text or ""), true, v.__id, v.userId)
            end
        end)

