                        e.timer = e.timer - dt
                        if e.timer <= 0 then
                            e.hidden = not e.hidden
                            local tr = e.hidden and 1 or 0
                            e.a.Transparency, e.b.Transparency = tr, tr
                            e.timer = e.hidden and rnd(0.1, 0.25) or rnd(2, 6)
                        end
                    end

                    -- 👤 رسم الوحش (له نور فيه عشان يبان بالليل)
