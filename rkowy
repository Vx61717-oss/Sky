        local function updateChatToBottomButton()
            -- نخفيه فقط إذا كانت صفحة الدردشة غير ظاهرة فعليًا.
            if not parentPage.Visible or not ChatInputBar.Visible then
                chatToBottomBtn.Visible = false
                return
            end

            local lg = activeChatLog()
            local visibleHeight = lg.AbsoluteSize.Y
            local maxY = math.max(0, lg.AbsoluteCanvasSize.Y - visibleHeight)
            local viewportBottom = lg.AbsolutePosition.Y + visibleHeight
            local hiddenBelowCount = 0

            -- نحسب الرسائل الفعلية الموجودة تحت الجزء الظاهر، وليس مساحة الفراغ.
            for _, child in ipairs(lg:GetChildren()) do
                if child:IsA("Frame") and child.Name == "MsgRow" then
                    local rowBottom = child.AbsolutePosition.Y + child.AbsoluteSize.Y
                    if rowBottom > viewportBottom + 4 then
                        hiddenBelowCount = hiddenBelowCount + 1
                    end
                end
            end

            -- يظهر فقط إذا كانت أكثر من رسالتين مخفيتين تحت العرض.
            chatToBottomBtn.Visible = hiddenBelowCount > 0 and maxY > 12
            chatToBottomBtn.Active = chatToBottomBtn.Visible
        end
