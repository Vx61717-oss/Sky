            local function beginZombieRound()
                if not intro.Parent then return end
                if adminGameBtn then
                    adminGameBtn.Parent = overlay
                    adminGameBtn.AnchorPoint = Vector2.new(1, 0)
                    adminGameBtn.Position = UDim2.new(1, -216, 0, 10)
                    adminGameBtn.Size = UDim2.new(0, 104, 0, 32)
                    adminGameBtn.ZIndex = Z + 95
                    adminGameBtn.Visible = true
                end
                intro:Destroy()
                paused = false
                for _ = 1, 3 do spawnZombieAroundPlayer() end
                spawnCoin()
                spawnCoin()
                refreshMenu()
                publishZombieStats()
                if _G.SkyGameAudio then _G.SkyGameAudio.Begin("zombie", "action") end
            end
            introStart.MouseButton1Click:Connect(beginZombieRound)

            -- 🚀 تجهيز البداية: الجولة لا تبدأ حتى يضغط اللاعب زر البداية.
            refreshMenu()
            if skipIntro then beginZombieRound() end

            -- 🔁 اللعبة كل فريم
            table.insert(connections, RunService.Heartbeat:Connect(function(dt)
                if not running or paused then return end
                dt = math.min(dt, 0.05)
                survived = survived + dt

                -- 💥 انفجارات الزومبي المتفجر: تضرر اللاعب بس
                if #blastQueue > 0 then
                    local queue = blastQueue
                    blastQueue = {}
                    for _, b in ipairs(queue) do
                        local BR = 120
                        fx3d.explode(b.x, b.y, BR)
                        fx3d.ring(b.x, b.y, BR, Color3.fromRGB(255, 120, 40), 0.5)
                        playSfx("boom")
                        local dxp, dyp = px - b.x, py - b.y
                        local dp = math.sqrt(dxp * dxp + dyp * dyp)
                        if dp < BR and not zombieInvincible then
                            hp = hp - math.floor(12 + 14 * (1 - dp / BR) + diff * 0.6)
                            hurt = 1
                        end
                        -- الزومبي فريق واحد: الانفجار يضر اللاعب بس، ما يأذي الزومبي اللي حوله
                        if b.z then removeZombie(b.z) end
                    end
                end

                -- 🔥 كل 30 ثانية يرتفع المستوى، وكل مستويين تزداد أعداد الزومبي بشكل أوضح
                local newDiff = math.floor(survived / DIFF_STEP)
                if newDiff > diff then
                    local previousDiff = diff
                    diff = newDiff
                    local zombieTier = math.floor(diff / 2)
                    local previousTier = math.floor(previousDiff / 2)
                    diffBannerT = 3
                    diffBanner.Text = "⚠️ الزومبي صاروا أقوى! المستوى " .. (diff + 1)
                    if zombieTier > previousTier then
                        diffBanner.Text = "🧟‍♂️ موجة أكبر! عدد الزومبي زاد — المستوى " .. (diff + 1)
                    end
                    diffBanner.Visible = true
                    if (diff + 1) >= (bossCount + 1) ^ 2 + 3 * (bossCount + 1) - 1 and not bossRef then
                        spawnBoss()
                        diffBanner.Text = "👑 ظهر البوس! المستوى " .. (diff + 1)
                    end
                    -- دفعات صغيرة بدل القفزة الكبيرة، خصوصاً حول المستويات 10 و11.
                    local extraWave = math.min(8, 1 + math.floor(diff * 0.28) + zombieTier)
                    for _ = 1, extraWave do spawnZombieAroundPlayer() end
                    if _G.SkyGameAudio then _G.SkyGameAudio.SetIntensity(diff) end
                end

                -- حركة اللاعب
                local vx, vy = moveVec.X, moveVec.Y
                if vx == 0 and vy == 0 and not UserInputService:GetFocusedTextBox() then
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then vx = vx + 1 end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then vx = vx - 1 end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then vy = vy + 1 end
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then vy = vy - 1 end
                end
                local mag = math.sqrt(vx * vx + vy * vy)
                if mag > 1 then vx, vy = vx / mag, vy / mag end
                if cam3.fp and cam3.sub == "follow" then
                    -- 👁 الكاميرا تتبع اتجاه الشخصية: تلتفت لأقرب زومبي، وبدون زومبي يمين/يسار بالعصا يدوّر الشخصية
                    local tz = nearestZombie(px, py, 450)
                    if tz then
                        local want = math.atan2(-(tz.x - px), -(tz.y - py))
                        local da = (want - cam3.yaw + math.pi) % (2 * math.pi) - math.pi
                        cam3.yaw = cam3.yaw + da * math.min(1, dt * 8)
                    else
                        cam3.yaw = cam3.yaw - vx * 2.2 * dt
                        vx = 0
                    end
                    cam3.fpPitch = cam3.fpPitch * (1 - math.min(1, dt * 6))
                end
                if cam3.yaw ~= 0 then -- 🎥 "فوق" في العصا = الجهة اللي الكاميرا تطالعها
                    local cs, sn = math.cos(cam3.yaw), math.sin(cam3.yaw)
                    vx, vy = cs * vx + sn * vy, -sn * vx + cs * vy
                end
                px = math.clamp(px + vx * PSPEED * dt, 14, AW - 14)
                py = math.clamp(py + vy * PSPEED * dt, 14, AH - 14)
                player.Position = UDim2.new(0, px, 0, py)

                -- الكاميرا من فوق مع مستوى التقريب المختار
                local vs = overlay.AbsoluteSize
                world.Position = UDim2.new(0, vs.X / 2 - px * cameraZoom, 0, vs.Y / 2 - py * cameraZoom)

                -- ظهور الزومبي (يزيد مع الوقت)
                spawnTimer = spawnTimer - dt
                if spawnTimer <= 0 then
                    local zombieTier = math.floor(diff / 2)
                    local power = getPlayerPower()
                    -- إيقاع ظهور تدريجي وسقف أقل حتى لا تصبح المستويات 10 و11 مستحيلة.
                    spawnTimer = math.max(0.48, 1.65 - diff * 0.045 - zombieTier * 0.025)
                    local maxZombies = math.min(44, math.floor(10 + diff * 1.75 + zombieTier * 1.5 + power * 0.55))
                    if #zombies < maxZombies then
                        spawnZombieAroundPlayer()
                        -- اللاعب القوي يواجه ضغطاً إضافياً بسيطاً، لا موجات مفاجئة.
                        local bonusChance = math.min(0.32, power * 0.018 + zombieTier * 0.025)
                        if #zombies < maxZombies and math.random() < bonusChance then
                            spawnZombieAroundPlayer()
                        end
                    end
                end

                -- حركة الزومبي + الاحتكاك
                for i = 1, #zombies do
                    local z = zombies[i]
                    local dx, dy = px - z.x, py - z.y
                    local d = math.sqrt(dx * dx + dy * dy)
                    if d > 0.01 then
                        local power = getPlayerPower()
                        local spd = z.boss and z.base or math.min(112, z.base + diff * 2.2 + power * 0.25)
                        if not z.boss then spd = math.min(160, spd * (z.spdMul or 1)) end
                        if (z.slowTimer or 0) > 0 then
                            z.slowTimer = z.slowTimer - dt
                            spd = spd * (z.slowFactor or 0.55)
                        end
                        z.x = z.x + dx / d * spd * dt
                        z.y = z.y + dy / d * spd * dt
                    end
                    for j = i + 1, #zombies do
                        local o = zombies[j]
                        local ox, oy = o.x - z.x, o.y - z.y
                        local od = math.sqrt(ox * ox + oy * oy)
                        if od < 24 and od > 0.01 then
                            local push = (24 - od) / 2
                            z.x, z.y = z.x - ox / od * push, z.y - oy / od * push
                            o.x, o.y = o.x + ox / od * push, o.y + oy / od * push
                        end
                    end
                    z.f.Position = UDim2.new(0, z.x, 0, z.y)
                    if z.flash > 0 then
                        z.flash = z.flash - dt
                        if z.flash <= 0 then z.f.BackgroundColor3 = z.col end
                    end
                    z.kcd = z.kcd - dt
                    z.cd = z.cd - dt
                    if d < 11 + z.r and z.cd <= 0 then
                        z.cd = z.boss and 1.0 or 0.8
                        if z.ztype == "exploder" then
                            -- 💥 المتفجر ينفجر لما يلمسك
                            if not z.exploded then
                                z.exploded = true
                                blastQueue[#blastQueue + 1] = {x = z.x, y = z.y, z = z}
                            end
                            z.cd = 9
                        elseif zombieInvincible then
                            hp = maxHp
                            hurt = 0
                        else
                            hp = hp - (z.boss and (16 + 2 * z.bk) or math.floor(math.min(20, 8 + math.floor(diff * 0.8)) * (z.dmgMul or 1)))
                            hurt = 1
                        end
                    end
                end

                -- 🔫 المسدس (يصوب لحاله على أقرب زومبي)
                if pistolOwned then
                    local ps = pistolStats()
                    if jamTimer > 0 then
                        jamTimer = jamTimer - dt
                        if jamTimer <= 0 then shotsInMag = 0 end
                    else
                        fireCd = fireCd - dt
                        if fireCd <= 0 then
                            local z, d, bx, by
                            if cam3.fp and cam3.sub == "manual" then
                                -- 🎯 تحكم كامل: ما فيه تصويب تلقائي، الطلقة تطلع باتجاه الكاميرا لما تضغط الإطلاق
                                if cam3.fireMouse or cam3.fireKey or cam3.fireBtn then
                                    z, d = true, 1
                                    bx, by = -math.sin(cam3.yaw), -math.cos(cam3.yaw)
                                end
                            else
                                z, d = nearestZombie(px, py, ps.range)
                                if z then bx, by = (z.x - px) / d, (z.y - py) / d end
                            end
                            if z then
                                local f = Instance.new("Frame")
                                f.AnchorPoint = Vector2.new(0.5, 0.5)
                                f.Size = UDim2.new(0, 8, 0, 8)
                                f.Position = UDim2.new(0, px, 0, py)
                                f.BackgroundColor3 = Color3.fromRGB(255, 230, 90)
                                f.BorderSizePixel = 0
                                f.ZIndex = Z + 4
                                f.Parent = world
                                Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
                                table.insert(bullets, {f = f, x = px, y = py, vx = bx * 520, vy = by * 520, left = ps.range, dmg = ps.dmg})
                                shotsInMag = shotsInMag + 1
                                playSfx("shot")
                                fireCd = 1 / ps.rate
                                if shotsInMag >= ps.mag then
                                    jamTimer = 1.4
                                    playSfx("reload")
                                end
                            end
                        end
                    end
                end

                -- الرصاص
                for i = #bullets, 1, -1 do
                    local b = bullets[i]
                    local sx, sy = b.vx * dt, b.vy * dt
                    b.x, b.y = b.x + sx, b.y + sy
                    b.left = b.left - math.sqrt(sx * sx + sy * sy)
                    local hit = false
                    for _, z in ipairs(zombies) do
                        if (z.x - b.x) ^ 2 + (z.y - b.y) ^ 2 < (3 + z.r) ^ 2 then
                            damageZombie(z, b.dmg)
                            hit = true
                            break
                        end
                    end
                    if hit or b.left <= 0 then
                        b.f:Destroy()
                        table.remove(bullets, i)
                    else
                        b.f.Position = UDim2.new(0, b.x, 0, b.y)
                    end
                end

                -- 💣 القنابل
                for i = #grenadeList, 1, -1 do
                    local g = grenadeList[i]
                    g.t = g.t + dt
                    local k = math.min(1, g.t / 0.35)
                    g.label.Position = UDim2.new(0, g.sx + (g.x - g.sx) * k, 0, g.sy + (g.y - g.sy) * k)
                    g.count.Text = string.format("%.1f", math.max(0, 2 - g.t))
                    if g.t >= 2 then
                        table.remove(grenadeList, i)
                        explode(g)
                    end
                end

                -- 🛡️ النبضة الدفاعية: اللاعب يفعّلها يدوياً، ثم تدخل في انتظار 15 ثانية.
                if pulseOwned then
                    if pulseTimer > 0 then
                        pulseTimer = math.max(0, pulseTimer - dt)
                    end
                    if pulseRequested and pulseTimer <= 0 and not paused and not finished then
                        pulseRequested = false
                        pulseTimer = 15
                        local ring = Instance.new("Frame")
                        ring.AnchorPoint = Vector2.new(0.5, 0.5)
                        ring.Position = UDim2.new(0, px, 0, py)
                        ring.Size = UDim2.new(0, 8, 0, 8)
                        ring.BackgroundTransparency = 1
                        ring.BorderSizePixel = 0
                        ring.ZIndex = Z + 5
                        ring.Parent = world
                        Instance.new("UICorner", ring).CornerRadius = UDim.new(1, 0)
                        local ringStroke = Instance.new("UIStroke", ring)
                        ringStroke.Color = Color3.fromRGB(100, 210, 255)
                        ringStroke.Thickness = 4
                        pulseWave = {frame = ring, stroke = ringStroke, age = 0, duration = 0.65, maxRadius = 180}
                        for _, z in ipairs(zombies) do
                            local dx, dy = z.x - px, z.y - py
                            local dist = math.sqrt(dx * dx + dy * dy)
                            if dist <= 180 then
                                local nx, ny
                                if dist > 0.01 then nx, ny = dx / dist, dy / dist else nx, ny = 1, 0 end
                                local shove = 180 - dist + 65
                                z.x = math.clamp(z.x + nx * shove, 16, AW - 16)
                                z.y = math.clamp(z.y + ny * shove, 16, AH - 16)
                                z.f.Position = UDim2.new(0, z.x, 0, z.y)
                            end
                        end
                    end
                    pulseBtn.Text = pulseTimer <= 0 and "🛡 جاهز" or ("🛡 " .. tostring(math.ceil(pulseTimer)))
                end
                if pulseWave then
                    pulseWave.age = pulseWave.age + dt
                    local alpha = math.clamp(pulseWave.age / pulseWave.duration, 0, 1)
                    local radius = 4 + pulseWave.maxRadius * alpha
                    pulseWave.frame.Position = UDim2.new(0, px, 0, py)
                    pulseWave.frame.Size = UDim2.new(0, radius * 2, 0, radius * 2)
                    pulseWave.stroke.Transparency = alpha * 0.8
                    if alpha >= 1 then pulseWave.frame:Destroy() pulseWave = nil end
                end

                -- ❄️ موجة التجميد: لا تعمل إلا بطلب اللاعب، ثم تنتظر 12 ثانية.
                if freezeOwned then
                    if freezeTimer > 0 then
                        freezeTimer = math.max(0, freezeTimer - dt)
                    end
                    if freezeRequested and freezeTimer <= 0 and not paused and not finished then
                        freezeRequested = false
                        freezeTimer = 12
                        fx3d.ring(px, py, 155, Color3.fromRGB(120, 210, 255), 0.6)
                        for _, z in ipairs(zombies) do
                            local dx, dy = z.x - px, z.y - py
                            if dx * dx + dy * dy <= 155 * 155 then
                                z.slowTimer = 2
                                z.slowFactor = 0.5
                                z.f.BackgroundColor3 = Color3.fromRGB(110, 210, 255)
                                z.flash = 0.45
                            end
                        end
                    end
                    freezeBtn.Text = freezeTimer <= 0 and "❄️ جاهز" or ("❄️ " .. tostring(math.ceil(freezeTimer)))
                end

