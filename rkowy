        local function raycastLocation(screenPosition)
            local camera = workspace.CurrentCamera
            if not camera then return nil end
            local result, ray
            pcall(function()
                ray = camera:ScreenPointToRay(screenPosition.X, screenPosition.Y)
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = {LocalPlayer.Character}
                result = workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
            end)
            -- إذا كان الضغط على السماء، نضع النقطة أمام الكاميرا بدل تجاهل الضغطة.
            return result and result.Position or (ray and ray.Origin + ray.Direction * 500 or nil)
        end

