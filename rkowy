            if not State.locationMarkerActive or not position or not camera then
                hideLocationMarker()
                return
            end

            local width, height = markerGui.AbsoluteSize.X, markerGui.AbsoluteSize.Y
            local point, onScreen = camera:WorldToViewportPoint(position)
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local distance = myRoot and math.floor((myRoot.Position - position).Magnitude) or 0
            markerDistance.Text = distance .. " m"

            local size = 64
            local margin = size * 0.75
            if onScreen and point.Z > 0 and point.X > margin and point.X < width - margin
                and point.Y > margin and point.Y < height - margin then
                marker.Text = "▼"
                marker.Rotation = 0
                marker.Position = UDim2.new(0, point.X, 0, point.Y - size * 0.55)
                markerDistance.Position = UDim2.new(0, point.X, 0, point.Y - size * 1.05)
            else
                marker.Text = "▲"
                local relative = camera.CFrame:PointToObjectSpace(position)
                local direction = Vector2.new(relative.X, -relative.Y)
                if direction.Magnitude < 1e-3 then direction = Vector2.new(1, 0) end
                direction = direction.Unit
                local sx = math.abs(direction.X) > 1e-3 and (width / 2 - margin) / math.abs(direction.X) or math.huge
                local sy = math.abs(direction.Y) > 1e-3 and (height / 2 - margin) / math.abs(direction.Y) or math.huge
                local edge = math.min(sx, sy)
                local x, y = width / 2 + direction.X * edge, height / 2 + direction.Y * edge
                marker.Rotation = math.deg(math.atan2(direction.X, -direction.Y))
                marker.Position = UDim2.new(0, x, 0, y)
                markerDistance.Position = UDim2.new(0, x, 0, y + size * 0.7)
            end
            marker.Visible = true
            markerDistance.Visible = true
        end)

