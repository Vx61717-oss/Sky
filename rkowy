    displayDuration = tonumber(displayDuration) or 4
    msg = _TranslateText(msg)
    _infoTipSound:Stop()
    _infoTipSound.TimePosition = 0
    _infoTipSound:Play()
    local frame = Instance.new("Frame")
    frame.Size = showDismissBtn and UDim2.new(0, 370, 0, 55) or UDim2.new(0, 300, 0, 55)
