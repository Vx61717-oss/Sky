                        elseif kind == 2 then   -- يطيح على وجهه
                            dirV, spd = rotY(d, rf(-0.4, 0.4)), rf(10, 35)
                        elseif kind == 3 then   -- يميل على جنبه
                            dirV = rotY(away, (RN() < 0.5 and -1 or 1) * rf(1.2, 1.8))
                            spd = rf(15, 40)
                        elseif kind == 4 then   -- تنهار ركبه وينزل
                            dirV, spd = rotY(away, rf(-3.1, 3.1)), rf(0, 10)
                        else                    -- يتمايل وهو يطيح
                            dirV, spd = rotY(away, rf(-0.8, 0.8)), rf(15, 35)
                        end
                        if boss then spd = spd * 0.5 end
                        local perp = Vector3.new(-dirV.Z, 0, dirV.X)
                        local twist = (kind == 5) and (RN() < 0.5 and -1 or 1) * rf(15, 35) or 0
                        local Q = {}
                        for i = 1, NP do
                            local v = Vector3.new(0, 0, 0)
                            if i == 1 or i == 2 or i == 4 or i == 5 then      -- الجزء العلوي يميل أول = ينقلب طبيعي
                                v = dirV * spd * rf(0.8, 1.4)
                            elseif i == 3 or i == 6 or i == 7 then
                                v = dirV * spd * 0.2
                            end
                            if twist ~= 0 then
                                if i == 4 then v = v + perp * twist elseif i == 5 then v = v - perp * twist end
                            end
                            v = v + Vector3.new(rf(-3, 3), 0, rf(-3, 3))
                            Q[i] = P[i] - v * STEP
                        end

                        for _, e in ipairs({rig.eyeL, rig.eyeR}) do
                            e.Color = Color3.fromRGB(25, 25, 25)
                            e.Material = Enum.Material.SmoothPlastic
                        end
                        rig.P, rig.Q, rig.R, rig.W, rig.C = P, Q, Rd, W, C
                        rig.t, rig.acc, rig.slowT, rig.settled, rig.boss = 0, 0, 0, false, boss
                        if boss then puff(rig.lx, rig.ly, true) end
                        dying[#dying + 1] = rig
                        if #dying > MAX_CORPSES then destroyRig(table.remove(dying, 1)) end
                    end

                    -- خطوة فيزياء واحدة (Verlet)
                    local function stepRagdoll(rig)
                        local P, Q, Rd, W, C = rig.P, rig.Q, rig.R, rig.W, rig.C
                        local gdt = Vector3.new(0, GRAV * STEP * STEP, 0)
                        for i = 1, NP do
                            local p, q = P[i], Q[i]
                            local np = p + (p - q) * 0.996 + gdt
                            local nx = math.clamp(np.X, 5, AW - 5)
                            local nz = math.clamp(np.Z, 5, AH - 5)
                            local qx, qz = p.X, p.Z
                            if nx ~= np.X then qx = nx end
                            if nz ~= np.Z then qz = nz end
                            local qy = p.Y
                            local ny = np.Y
                            if ny < Rd[i] then -- ارتطام بالأرض مع ارتداد
                                local vy = ny - p.Y
                                qy = Rd[i] + vy * REST
                                ny = Rd[i]
                            end
                            P[i] = Vector3.new(nx, ny, nz)
                            Q[i] = Vector3.new(qx, qy, qz)
                        end
                        for _ = 1, 4 do
                            for ci = 1, #C do
                                local c = C[ci]
                                local a, b = c[1], c[2]
                                local pa, pb = P[a], P[b]
                                local dv = pb - pa
                                local m = dv.Magnitude
                                if m > 1e-4 and (not c[5] or m < c[3]) then
                                    local diff = (m - c[3]) / m * c[4]
                                    local wa, wb = W[a], W[b]
                                    local sw = wa + wb
                                    P[a] = pa + dv * (diff * wa / sw)
                                    P[b] = pb - dv * (diff * wb / sw)
                                end
                            end
                            for i = 1, NP do
                                local p = P[i]
                                if p.Y < Rd[i] then P[i] = Vector3.new(p.X, Rd[i], p.Z) end
                            end
                        end
                        -- احتكاك الأرض
                        for i = 1, NP do
                            local p = P[i]
                            if p.Y <= Rd[i] + 0.05 then
                                local q = Q[i]
                                Q[i] = Vector3.new(q.X + (p.X - q.X) * FRIC, q.Y, q.Z + (p.Z - q.Z) * FRIC)
                            end
                        end
                    end

                    local function renderRagdoll(rig)
                        local P, u = rig.P, rig.u
                        local hint = (P[5] - P[4]) + (P[7] - P[6])
                        local tv = P[2] - P[3]
                        if tv.Magnitude < 1e-3 then return end
                        local tUp = tv.Unit
                        rig.torso.CFrame = orient((P[2] + P[3]) / 2, tUp, hint)
                        local hv = (P[1] - P[2])
                        local hUp = (hv.Magnitude > 1e-3) and hv.Unit:Lerp(tUp, 0.6) or tUp
                        if hUp.Magnitude < 1e-3 then hUp = tUp end
                        local headCF = orient(P[1], hUp.Unit, hint)
                        rig.head.CFrame = headCF
                        rig.eyeL.CFrame = headCF * CFrame.new(-0.3 * u, 0.1 * u, -0.64 * u)
                        rig.eyeR.CFrame = headCF * CFrame.new(0.3 * u, 0.1 * u, -0.64 * u)
                        if rig.crown then rig.crown.CFrame = headCF * CFrame.new(0, 0.95 * u, 0) end
                        local function limb(part, top, bot)
                            local v = P[top] - P[bot]
                            if v.Magnitude < 1e-3 then return end
                            part.CFrame = orient((P[top] + P[bot]) / 2, v.Unit, hint)
                        end
                        limb(rig.armL, 4, 8)
                        limb(rig.armR, 5, 9)
                        limb(rig.legL, 6, 10)
                        limb(rig.legR, 7, 11)
                        rig.shadow.CFrame = CFrame.new(P[3].X, 0.35, P[3].Z) * FLAT
                    end

                    -- يرجّع true لما تخلص الجثة وتنحذف
                    local function poseDead(rig, dt)
                        if not rig.settled then
                            rig.acc = rig.acc + dt
                            local n = 0
                            while rig.acc >= STEP and n < 4 do
                                stepRagdoll(rig)
                                rig.acc = rig.acc - STEP
                                n = n + 1
                            end
                            if n >= 4 then rig.acc = 0 end
                            -- لما يهدا الجسم نوقف الحساب
                            if rig.t > 0.6 then
                                local sum = 0
                                for i = 1, NP do sum = sum + (rig.P[i] - rig.Q[i]).Magnitude end
                                if sum < 0.06 then rig.slowT = rig.slowT + dt else rig.slowT = 0 end
                                if rig.slowT > 0.4 then rig.settled = true end
                            end
                            renderRagdoll(rig)
                        end
                        local life = rig.boss and 5.5 or 4.0
                        if rig.t > life then
                            local a = math.clamp((rig.t - life) / 1.0, 0, 1)
                            for _, part in ipairs(rig.model:GetChildren()) do
                                if part:IsA("BasePart") then part.Transparency = a end
                            end
                            rig.shadow.Transparency = 0.55 + 0.45 * a
                            if a >= 1 then return true end
                        end
                        return false
                    end

                    local function updateDying(dt)
                        for i = #dying, 1, -1 do
                            local rig = dying[i]
                            rig.t = rig.t + dt
                            if poseDead(rig, dt) then
                                destroyRig(rig)
                                table.remove(dying, i)
                            end
                        end
                    end

                    local function sync3D(dt)
                        gameT = gameT + dt
                        coinSpin = coinSpin + dt * 3

                        -- كاميرا خلف اللاعب ومن فوق (الاتجاه ثابت، فأزرار الحركة تبقى نفسها)
                        local zoom = math.clamp(cameraZoom, 0.45, 2.2)
                        if not UserInputService:GetFocusedTextBox() and not (cam3.fp and cam3.sub == "follow") then
                            if UserInputService:IsKeyDown(Enum.KeyCode.Q) then cam3.yaw = cam3.yaw + dt * 2 end
                            if UserInputService:IsKeyDown(Enum.KeyCode.E) then cam3.yaw = cam3.yaw - dt * 2 end
                        end
                        local cy, cp = cam3.yaw, cam3.pitch
                        if cam3.fp then
                            -- 👁 منظور أول: الكاميرا من عيون الشخصية وتدور بحرية (اللمس / السحب / Q و E)
                            local fy = cam3.fpPitch
                            local walkAmp = math.clamp(playerRig.spd / 55, 0, 1)
                            local eye = Vector3.new(px, 25.85 + math.sin(gameT * 9) * 0.6 * walkAmp, py)
                            local look = Vector3.new(-math.sin(cy) * math.cos(fy), math.sin(fy), -math.cos(cy) * math.cos(fy))
                            cam3d.FieldOfView = 80
                            cam3d.CFrame = CFrame.lookAt(eye, eye + look)
                        else
                            local camDist = 389 / zoom
                            local offset = Vector3.new(math.sin(cy) * math.cos(cp), math.sin(cp), math.cos(cy) * math.cos(cp)) * camDist
                            local focus = Vector3.new(px - math.sin(cy) * 25, 0, py - math.cos(cy) * 25)
                            cam3d.FieldOfView = 62
                            cam3d.CFrame = CFrame.lookAt(focus + offset, focus)
                        end

                        -- 🧍 اللاعب
                        local pspeed = math.sqrt((px - plx) ^ 2 + (py - ply) ^ 2) / math.max(dt, 1e-3)
                        playerRig.spd = playerRig.spd + (pspeed - playerRig.spd) * math.min(1, dt * 10)
                        local target = flatDir(px - plx, py - ply)
                        local aiming = false
                        if pistolOwned then
                            local bz, bd
                            for _, z in ipairs(zombies) do
                                local d = math.sqrt((z.x - px) ^ 2 + (z.y - py) ^ 2)
                                if d < 300 and (not bd or d < bd) then bz, bd = z, d end
                            end
                            if bz then target = flatDir(bz.x - px, bz.y - py) or target; aiming = true end
                        end
                        if target then
                            local nd = pdir:Lerp(target, math.min(1, dt * 12))
                            if nd.Magnitude > 0.01 then pdir = nd.Unit end
                        end
                        plx, ply = px, py
                        local pbase = poseRig(playerRig, px, py, pdir, dt, pistolOwned)
                        playerRig.torso.Color = Color3.fromRGB(90, 255, 170):Lerp(Color3.fromRGB(255, 60, 60), math.clamp(hurt, 0, 1))
                        -- 👁 في المنظور الأول نخفي مجسّم اللاعب (والمسدس) عشان ما يسد الشاشة
                        if (cam3.hidden or false) ~= cam3.fp then
                            cam3.hidden = cam3.fp
                            local tr = cam3.fp and 1 or 0
                            for _, part in ipairs(playerRig.model:GetChildren()) do
                                if part:IsA("BasePart") and part ~= gun then part.Transparency = tr end
                            end
                            cam3.shadowT = cam3.shadowT or playerRig.shadow.Transparency
                            playerRig.shadow.Transparency = cam3.fp and 1 or cam3.shadowT
                        end
                        gun.Transparency = (pistolOwned and not cam3.fp) and 0 or 1
                        gun.CFrame = pbase * CFrame.new(1.4 * 5.5, 3.6 * 5.5, -2.7 * 5.5)

                        -- 🧟 الزومبي
                        local seen = {}
                        for _, z in ipairs(zombies) do
                            seen[z] = true
                            local rig = zr[z]
                            if not rig then
                                local u = z.boss and 15 or 7.5 * (z.sz or 1)
                                local skin = z.col
                                local pants = z.boss and Color3.fromRGB(50, 25, 65) or Color3.fromRGB(45, 55, 85)
                                rig = newRig(u, skin, skin:Lerp(Color3.new(0, 0, 0), 0.35), pants, Color3.fromRGB(255, 60, 40), true)
                                rig.lx, rig.ly = z.x, z.y
                                rig.bar = z.hpFill and z.hpFill.Parent
                                if rig.bar then
                                    rig.bar.AnchorPoint = Vector2.new(0.5, 1)
                                    rig.bar.Parent = barLayer
                                end
                                rig.barW = z.boss and 90 or 30 * (z.sz or 1)
                                rig.barH = z.boss and 9 or 5
                                rig.dir = Vector3.new(0, 0, 1)
                                if z.boss then
                                    local crown = mkPart(rig.model, Vector3.new(1.4 * u, 0.5 * u, 1.4 * u), Color3.fromRGB(255, 205, 50), nil, nil, Enum.Material.Neon)
                                    rig.crown = crown
                                elseif z.ztype == "armored" then
                                    rig.crown = mkPart(rig.model, Vector3.new(1.45 * u, 0.55 * u, 1.45 * u), Color3.fromRGB(150, 160, 175), nil, nil, Enum.Material.Metal)
                                    rig.torso.Material = Enum.Material.Metal
                                elseif z.ztype == "exploder" then
                                    rig.crown = mkPart(rig.model, Vector3.new(1.1 * u, 1.1 * u, 1.1 * u), Color3.fromRGB(255, 110, 30), nil, Enum.PartType.Ball, Enum.Material.Neon)
                                end
                                zr[z] = rig
                            end
                            local spd = math.sqrt((z.x - rig.lx) ^ 2 + (z.y - rig.ly) ^ 2) / math.max(dt, 1e-3)
                            rig.spd = rig.spd + (math.min(spd, 140) - rig.spd) * math.min(1, dt * 8)
                            rig.lx, rig.ly = z.x, z.y
                            local want = flatDir(px - z.x, py - z.y)
                            if want then
                                local nd = rig.dir:Lerp(want, math.min(1, dt * 10))
                                if nd.Magnitude > 0.01 then rig.dir = nd.Unit end
                            end
                            local dist = math.sqrt((px - z.x) ^ 2 + (py - z.y) ^ 2)
                            local visible = dist < 760
                            if rig.vis ~= visible then
                                rig.vis = visible
                                rig.model.Parent = visible and scene or nil
                                rig.shadow.Parent = visible and scene or nil
                            end
                            if visible then
                                local col = z.f.BackgroundColor3
                                setRigColor(rig, col)
                                local base = poseRig(rig, z.x, z.y, rig.dir, dt, false)
                                if rig.crown then
                                    rig.crown.CFrame = base * CFrame.new(0, 5.55 * rig.u, 0)
                                    if z.ztype == "exploder" then -- القنبلة تنبض
                                        local pulse = (math.sin(gameT * 9 + rig.phase) + 1) / 2
                                        rig.crown.Color = Color3.fromRGB(255, 70, 20):Lerp(Color3.fromRGB(255, 220, 90), pulse)
                                    end
                                end
                                -- شريط الدم فوق الرأس
                                if rig.bar then
                                    local top = Vector3.new(z.x, (z.boss and 6.2 or 5.7) * rig.u + 5, z.y)
                                    local sp, pps = project(top)
                                    if sp then
                                        rig.bar.Visible = true
                                        rig.bar.Size = UDim2.new(0, math.max(14, rig.barW * pps * 0.9), 0, rig.barH)
                                        rig.bar.Position = UDim2.new(0, sp.X, 0, sp.Y)
                                    else
                                        rig.bar.Visible = false
                                    end
                                end
                            elseif rig.bar then
                                rig.bar.Visible = false
                            end
                        end
                        for z, rig in pairs(zr) do
                            if not seen[z] then
                                startDeath(z, rig)
                                zr[z] = nil
                            end
                        end
                        updateDying(dt)
                        updateBlood(dt)

                        -- 🔫 الرصاص
                        local bseen = {}
                        for _, b in ipairs(bullets) do
                            bseen[b] = true
                            local p = br[b]
                            if not p then
                                p = mkPart(scene, Vector3.new(2.4, 2.4, 16), Color3.fromRGB(255, 230, 90), CFrame.new(), nil, Enum.Material.Neon)
                                br[b] = p
                            end
                            local pos = Vector3.new(b.x, 17, b.y)
                            local v = Vector3.new(b.vx, 0, b.vy)
                            p.CFrame = v.Magnitude > 0 and CFrame.lookAt(pos, pos + v) or CFrame.new(pos)
                        end
                        for b, p in pairs(br) do
                            if not bseen[b] then p:Destroy() br[b] = nil end
                        end

                        -- 🪙 العملات: قرص يدور + عمود ضوء يبيّنها من بعيد
                        local cseen = {}
                        for _, c in ipairs(coins) do
                            cseen[c] = true
                            local o = cr[c]
                            if not o then
                                o = {
                                    disc = mkPart(scene, Vector3.new(3, 22, 22), Color3.fromRGB(255, 205, 50), CFrame.new(), Enum.PartType.Cylinder, Enum.Material.Neon),
                                    glow = mkPart(scene, Vector3.new(0.5, 46, 46), Color3.fromRGB(255, 225, 90), CFrame.new(), Enum.PartType.Cylinder, Enum.Material.Neon),
                                    beam = mkPart(scene, Vector3.new(4, 150, 4), Color3.fromRGB(255, 220, 80), CFrame.new(), nil, Enum.Material.Neon),
                                }
                                o.glow.Transparency = 0.7
                                o.beam.Transparency = 0.72
                                cr[c] = o
                            end
                            local bobY = 17 + math.sin(gameT * 3 + c.x) * 3
                            o.disc.CFrame = CFrame.new(c.x, bobY, c.y) * CFrame.Angles(0, coinSpin + c.x, 0)
                            o.glow.CFrame = CFrame.new(c.x, 0.6, c.y) * FLAT
                            o.glow.Size = Vector3.new(0.5, 46 + math.sin(gameT * 5) * 8, 46 + math.sin(gameT * 5) * 8)
                            o.beam.CFrame = CFrame.new(c.x, 75, c.y)
                        end
                        for c, o in pairs(cr) do
                            if not cseen[c] then o.disc:Destroy() o.glow:Destroy() o.beam:Destroy() cr[c] = nil end
                        end

                        -- 💣 القنابل (قوس + دائرة تبيّن منطقة الانفجار)
                        local gseen = {}
                        for _, g in ipairs(grenadeList) do
                            gseen[g] = true
                            local o = gr[g]
                            if not o then
                                o = {
                                    ball = mkPart(scene, Vector3.new(10, 10, 10), Color3.fromRGB(40, 40, 44), CFrame.new(), Enum.PartType.Ball),
                                    zone = mkPart(scene, Vector3.new(0.4, g.stats.radius * 2, g.stats.radius * 2), Color3.fromRGB(255, 80, 50), CFrame.new(g.x, 0.7, g.y) * FLAT, Enum.PartType.Cylinder, Enum.Material.Neon),
                                }
                                o.zone.Transparency = 0.82
                                gr[g] = o
                            end
                            local k = math.min(1, g.t / 0.35)
                            local gx = g.sx + (g.x - g.sx) * k
                            local gz = g.sy + (g.y - g.sy) * k
                            o.ball.CFrame = CFrame.new(gx, 6 + math.sin(math.pi * k) * 60, gz)
                            local blink = (math.floor(g.t * 6) % 2 == 0)
                            o.ball.Color = blink and Color3.fromRGB(255, 60, 40) or Color3.fromRGB(40, 40, 44)
                            o.zone.Transparency = 0.82 - 0.25 * math.clamp(g.t / 2, 0, 1)
                        end
                        for g, o in pairs(gr) do
                            if not gseen[g] then o.ball:Destroy() o.zone:Destroy() gr[g] = nil end
                        end

                        -- 🔪 السكاكين
                        if knifeOwned then
                            local ks = knifeStats()
                            local n = #knives
                            for i = 1, n do
                                local o = kr[i]
                                if not o then
                                    o = {
                                        blade = mkPart(scene, Vector3.new(2.2, 3, 18), Color3.fromRGB(225, 232, 240), CFrame.new(), nil, Enum.Material.Metal),
                                        handle = mkPart(scene, Vector3.new(2.6, 3.4, 8), Color3.fromRGB(140, 85, 45)),
                                    }
                                    kr[i] = o
                                end
                                local a = knifeAngle + (i - 1) * (math.pi * 2 / n)
                                local kp = Vector3.new(px + math.cos(a) * ks.radius, 16, py + math.sin(a) * ks.radius)
                                local tang = Vector3.new(-math.sin(a), 0, math.cos(a))
                                local kb = CFrame.lookAt(kp, kp + tang)
                                o.blade.CFrame = kb * CFrame.new(0, 0, -9)
                                o.handle.CFrame = kb * CFrame.new(0, 0, 4)
                            end
                            for i = n + 1, #kr do
                                local o = kr[i]
                                if o then o.blade:Destroy() o.handle:Destroy() kr[i] = nil end
                            end
                        end

                        -- 🛡 موجة النبضة الدفاعية
                        if pulseWave then
                            if not pulseRing3d then
                                pulseRing3d = mkPart(scene, Vector3.new(1.5, 10, 10), Color3.fromRGB(100, 210, 255), CFrame.new(), Enum.PartType.Cylinder, Enum.Material.Neon)
                            end
                            local alpha = math.clamp(pulseWave.age / pulseWave.duration, 0, 1)
                            local r = 4 + pulseWave.maxRadius * alpha
                            pulseRing3d.Size = Vector3.new(1.5, r * 2, r * 2)
                            pulseRing3d.CFrame = CFrame.new(px, 2, py) * FLAT
                            pulseRing3d.Transparency = 0.2 + alpha * 0.8
                        elseif pulseRing3d then
                            pulseRing3d:Destroy()
                            pulseRing3d = nil
                        end
                    end

                    -- 🎥 تدوير الكاميرا بالسحب على أي مكان فاضي بالشاشة (أو Q/E بالكيبورد)
                    local catcher = Instance.new("Frame")
                    catcher.BackgroundTransparency = 1
                    catcher.BorderSizePixel = 0
                    catcher.Size = UDim2.new(1, 0, 1, 0)
                    catcher.Active = true
                    catcher.ZIndex = Z + 2
                    catcher.Parent = overlay
                    -- ✌️ إصبع واحد = تدوير، إصبعين (قرص) = تقريب/إبعاد، وعجلة الماوس للزوم
                    local tlist, tpos = {}, {}
                    local mouseDrag = false
                    local ZMIN, ZMAX = 0.45, 2.2
                    local function dropTouch(input)
                        tpos[input] = nil
                        for k = #tlist, 1, -1 do
                            if tlist[k] == input then table.remove(tlist, k) end
                        end
                    end
                    local function purgeGestures()
                        -- ينظّف أي لمسة عالقة (هذا اللي كان يخلي الكاميرا تتحرك لحالها)
                        if paused then
                            tlist, tpos, mouseDrag = {}, {}, false
                            return
                        end
                        for k = #tlist, 1, -1 do
                            local inp = tlist[k]
                            local st = inp.UserInputState
                            if st == Enum.UserInputState.End or st == Enum.UserInputState.Cancel then
                                dropTouch(inp)
                            end
                        end
                        if cam3.fireMouse and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                            cam3.fireMouse = false
                        end
                        if mouseDrag and not (UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
                            or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)) then
                            mouseDrag = false
                        end
                    end
                    table.insert(connections, catcher.InputBegan:Connect(function(input)
                        local t = input.UserInputType
                        if t == Enum.UserInputType.Touch then
                            if #tlist < 2 then
                                table.insert(tlist, input)
                                tpos[input] = Vector2.new(input.Position.X, input.Position.Y)
                            end
                        elseif t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 then
                            if t == Enum.UserInputType.MouseButton1 and cam3.fp and cam3.sub == "manual" then
                                cam3.fireMouse = true -- 🔫 كليك يسار = إطلاق (اللف بالكليك اليمين)
                            else
                                mouseDrag = true
                            end
                        end
                    end))
                    table.insert(connections, UserInputService.InputChanged:Connect(function(input)
                        local t = input.UserInputType
                        if t == Enum.UserInputType.Touch then
                            local old = tpos[input]
                            if not old then return end
                            local newPos = Vector2.new(input.Position.X, input.Position.Y)
                            if #tlist == 1 then
