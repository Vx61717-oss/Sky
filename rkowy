                    if started or finished then return end
                    if #defenders == 0 then
                        showMsg("ضع كائن واحد على الأقل قبل لا تبدأ", Color3.fromRGB(255, 220, 120))
                        return
                    end
                    started = true
                    goBtn.Visible = false
                    breakTimer = 3
                    refreshTray()
                    saveRun()
                end)

