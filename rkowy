            label.TextColor3 = Color3.new(1, 1, 1)
            label.Font = Enum.Font.Arcade
            label.TextSize = 14
            label.Parent = panel
            table.insert(bodyItems, label)
            task.delay(0.05, function()
                if label and label.Parent then
                    SkyTw(label, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
