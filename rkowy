local function IsToggleStatusNotice(title, message)
    local value = tostring(title or "") .. " " .. tostring(message or "")
    local statusPhrases = {
        "تم تشغيل", "تم إيقاف", "تم تفعيل", "تم تعطيل",
        "مفعل", "معطل", "مفعّل", "معطّل",
        "التشغيل", "الإيقاف", "تفعيل", "تعطيل",
        "إضاءة عادية", "توقف الجلوس",
        "تشغيل:", "إيقاف:",
    }
    for _, phrase in ipairs(statusPhrases) do
        if string.find(value, phrase, 1, true) then
            return true
        end
    end
    return false
end

