        -- 💾 السكربتات المحفوظة: تنحفظ بمجلد SkyAI_Saved بمجلد المنفّذ (لو يدعم)، وبالذاكرة كاحتياط
        SkyAI.SAVE_DIR = "SkyAI_Saved"
        SkyAI.savedMem = SkyAI.savedMem or {}

        SkyAI.listSaved = function()
            local map, out = {}, {}
            pcall(function()
                if type(listfiles) ~= "function" or type(readfile) ~= "function" then return end
                if type(isfolder) == "function" and not isfolder(SkyAI.SAVE_DIR) then return end
                local okL, res = pcall(listfiles, SkyAI.SAVE_DIR)
                if not okL or type(res) ~= "table" then return end
                for _, f in ipairs(res) do
                    local base = tostring(f):gsub("^.*[/\\]", "")
                    local ext = base:lower():match("%.(%w+)$")
                    if ext == "lua" or ext == "txt" then
                        local okR, code = pcall(readfile, tostring(f))
                        if okR and type(code) == "string" and code:gsub("%s+", "") ~= "" then
                            map[base] = true
                            table.insert(out, {name = base, code = code, path = tostring(f)})
                        end
                    end
                end
            end)
            for _, m in ipairs(SkyAI.savedMem) do
                if not map[m.name] then table.insert(out, {name = m.name, code = m.code}) end
            end
            table.sort(out, function(a, b) return a.name:lower() < b.name:lower() end)
            return out
        end

        SkyAI.saveScript = function(code)
            code = tostring(code or "")
            if code:gsub("%s+", "") == "" then
                pcall(Notify, "💾 حفظ", "الصق السكربت بخانة الكتابة أول، وبعدين اضغط حفظ", Color3.fromRGB(255, 170, 70), true)
                return false
            end
            if #code > 9000 then
                pcall(Notify, "💾 حفظ", "السكربت كبير (" .. #code .. " حرف)، الحد حوالي 9000", Color3.fromRGB(255, 170, 70), true)
                return false
            end
            -- الاسم: من أول تعليق بالسكربت لو موجود، وإلا script_رقم
            local used = {}
            for _, s in ipairs(SkyAI.listSaved()) do used[s.name] = true end
            local base = (code:match("^%s*%-%-+%s*%[*=*%[*%s*([^\r\n]+)") or ""):gsub("[^%w_%-]", "_"):gsub("_+", "_"):gsub("^_+", ""):gsub("_+$", "")
            base = base:sub(1, 20)
            if base == "" then base = "script" end
            local name, n = base .. ".lua", 1
            while used[name] do
                n = n + 1
                name = base .. "_" .. n .. ".lua"
            end
            local path
            pcall(function()
                if type(writefile) ~= "function" then return end
                if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder(SkyAI.SAVE_DIR) then
                    makefolder(SkyAI.SAVE_DIR)
                end
                path = SkyAI.SAVE_DIR .. "/" .. name
                writefile(path, code)
            end)
            if not path then table.insert(SkyAI.savedMem, {name = name, code = code}) end
            pcall(Notify, "💾 حفظ", "انحفظ بالقائمة: " .. name .. (path and "" or " (مؤقت، المنفّذ ما يدعم الحفظ بملفات)"), Color3.fromRGB(120, 255, 190), true)
            return true, name
        end

        SkyAI.deleteSaved = function(item)
            pcall(function()
                if item.path and type(delfile) == "function" then delfile(item.path) end
            end)
            for i = #SkyAI.savedMem, 1, -1 do
                if SkyAI.savedMem[i].name == item.name then table.remove(SkyAI.savedMem, i) end
            end
        end

        -- ✏️ تغيير اسم سكربت محفوظ. يرجع: true, الاسم_الجديد  أو  false, سبب
        SkyAI.renameSaved = function(item, newName)
            newName = tostring(newName or "")
            newName = newName:gsub("[\\/:%*%?\"<>|%c]", ""):gsub("^%s+", ""):gsub("%s+$", "")
            newName = newName:gsub("%.[lL][uU][aA]$", ""):gsub("%.[tT][xX][tT]$", "")
            if newName == "" then return false, "الاسم فاضي" end
            if #newName > 40 then newName = newName:sub(1, 40) end
            local ext = (tostring(item.name):lower():match("%.(%w+)$") == "txt") and "txt" or "lua"
            local full = newName .. "." .. ext
            if full == item.name then return true, full end
            for _, s in ipairs(SkyAI.listSaved()) do
                if s.name ~= item.name and s.name:lower() == full:lower() then
                    return false, "فيه سكربت بنفس الاسم"
                end
            end
            if item.path then
                if type(writefile) ~= "function" or type(delfile) ~= "function" then
                    return false, "المنفّذ ما يدعم تغيير أسماء الملفات"
                end
                local newPath = SkyAI.SAVE_DIR .. "/" .. full
                local sameLower = (full:lower() == tostring(item.name):lower())
                local okW = pcall(function()
                    if sameLower then
                        -- نفس الاسم مع اختلاف بحالة الأحرف: نمر بملف مؤقت عشان ما ينحذف الأصل
                        local tmp = SkyAI.SAVE_DIR .. "/__rename_tmp.txt"
                        writefile(tmp, item.code)
