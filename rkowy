        l.Text = txt .. ": " .. startVal
        l.ZIndex = 7

        local area = Instance.new("Frame", f)
        area.Size = UDim2.new(1, -20, 0, 84)
        area.Position = UDim2.new(0, 10, 0, 40)
        area.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        area.BorderSizePixel = 0
        area.Active = true
        area.ClipsDescendants = true
        area.ZIndex = 7
        Instance.new("UICorner", area).CornerRadius = UDim.new(0, 6)

        local bars = {}
        for i = 1, EQ_COUNT do
            local b = Instance.new("Frame", area)
            b.AnchorPoint = Vector2.new(0, 1)
            b.Position = UDim2.new((i - 1) / EQ_COUNT + 0.1 / EQ_COUNT, 0, 1, -4)
            b.Size = UDim2.new(0.8 / EQ_COUNT, 0, heights[i] * 0.9, 0)
            b.BorderSizePixel = 0
            b.BackgroundColor3 = EQ_OFF
            b.ZIndex = 8
            bars[i] = b
        end

        local currentVal = startVal

        local function render(val)
            local p = (val - min) / (max - min)
            for i, b in ipairs(bars) do
                local lit = (i / EQ_COUNT) <= p + 0.001
                if lit then
                    b.BackgroundColor3 = heights[i] > 0.7 and EQ_PEAK or EQ_LIT
                else
                    b.BackgroundColor3 = EQ_OFF
                end
            end
        end

        local function applySlider(val)
            val = math.clamp(math.floor(val), min, max)
            currentVal = val
            l.Text = txt .. ": " .. val
            render(val)
            call(val)
        end

        render(startVal)

        -- 🎵 تحريك الأعمدة مع الأغنية الشغالة (حسب قوة الصوت PlaybackLoudness)
        -- LOUD_REF: كلما قل الرقم صار التحرك أقوى
        local LOUD_REF = 300
        local levels = {}
        for i = 1, EQ_COUNT do levels[i] = 0.1 end

        local function currentLoudness()
            for _, s in ipairs(MusicTracks) do
                if s.IsPlaying then
                    return s.PlaybackLoudness
                end
            end
            return 0
        end

        game:GetService("RunService").Heartbeat:Connect(function(dt)
            local energy = math.clamp(currentLoudness() / LOUD_REF, 0, 1)
            local t = os.clock()
            local k = 1 - math.exp(-12 * math.max(dt, 0))
            for i = 1, EQ_COUNT do
                local wobble = 0.5 + 0.5 * math.sin(t * (3 + i * 0.37) + i)
                local target = 0.1 + energy * heights[i] * (0.4 + 0.6 * wobble)
                target = math.clamp(target, 0.08, 0.95)
                levels[i] = levels[i] + (target - levels[i]) * k
                bars[i].Size = UDim2.new(0.8 / EQ_COUNT, 0, levels[i], 0)
            end
        end)

        -- سحب بالماوس أو باللمس على الأعمدة
        local dragging = false
        local function setFromX(x)
            local p = math.clamp((x - area.AbsolutePosition.X) / area.AbsoluteSize.X, 0, 1)
            applySlider(min + p * (max - min))
            SaveConfig()
        end

        area.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                setFromX(i.Position.X)
            end
        end)

        UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        UIS.InputChanged:Connect(function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                setFromX(i.Position.X)
            end
        end)

        -- 💾 تسجيل السلايدر في نظام حفظ الإعدادات
        UI.ConfigRegistry[txt] = {
            get = function() return currentVal end,
            default = startVal,
            apply = function(value) applySlider(tonumber(value) or startVal) end
        }
        return f
    end

    -- 🎵 صوت الموسيقى: يضبط كل أغاني الموسيقى (MusicTracks) مع الحفاظ على مستواها الأصلي
    local musicVolume = 1
    local _musicBaseVolume = {}
    local function SetMusicVolume(v)
        musicVolume = math.clamp(v, 0, 1)
        for _, s in ipairs(MusicTracks) do
            if _musicBaseVolume[s] == nil then
                _musicBaseVolume[s] = s.Volume
            end
            s.Volume = _musicBaseVolume[s] * musicVolume
        end
    end

    -- السلايدر الأول: صوت اللعبة
    NewSlider(_TranslateText("صوت اللعبة"), 0, 100, function(v) SetGameVolume(v / 100) end, UI.Page4, 100)
    -- 🎵 سلايدر صوت الموسيقى: ما يطلع في تاب الموسيقى، بس تقدر تحطه في أي قائمة ثانية (مثل القائمة البنفسجية)
    -- الاستخدام من أي سكربت/قائمة ثانية:  _G.SkyMusicVolumeSlider(parentFrame)
    _G.SkyMusicVolumeSlider = function(parent)
        return NewEqSlider(_TranslateText("صوت الموسيقى"), 0, 100, function(v) SetMusicVolume(v / 100) end, parent, 100)
    end
end

