                                    end
                                end
                                table.sort(list, function(a, b) return a.d < b.d end)
                                for i = 1, math.min(#list, 10) do
                                    local z, dist = list[i].z, list[i].d
                                    local rel = cf:PointToObjectSpace(Vector3.new(z.x, 14, z.y))
                                    local dir, nearPos
                                    local sz = math.clamp(46 - dist / 28, 28, 46)
                                    if rel.Z < -1 then
                                        local nx = rel.X / (-rel.Z * th * aspect)
                                        local ny = rel.Y / (-rel.Z * th)
                                        if math.abs(nx) > 0.95 or math.abs(ny) > 0.95 then
                                            dir = Vector2.new(nx, -ny) -- قدّامك بس برا الشاشة
                                        elseif dist <= 230 then
                                            -- 🧟 زومبي قريب وظاهر قدّامك: العلامة فوق راسه
                                            local hrel = cf:PointToObjectSpace(Vector3.new(z.x, 36, z.y))
                                            if hrel.Z < -1 then
                                                local hx = hrel.X / (-hrel.Z * th * aspect)
                                                local hy = hrel.Y / (-hrel.Z * th)
                                                nearPos = Vector2.new((hx * 0.5 + 0.5) * W, (0.5 - hy * 0.5) * H - sz * 0.9 - 14)
                                            end
                                        end
                                    else
                                        local ang = math.atan2(rel.X, -rel.Z) -- وراك أو بجنبك: نحدد الجهة بالزاوية
                                        dir = Vector2.new(math.sin(ang), -math.cos(ang))
                                    end
                                    if nearPos then
