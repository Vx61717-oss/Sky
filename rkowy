                local i = hn
                heap[i] = node
                while i > 1 do
                    local p = math.floor(i / 2)
                    if heap[p].f > heap[i].f then
                        heap[p], heap[i] = heap[i], heap[p]
                        i = p
                    else
                        break
                    end
                end
            end
            local function pop()
                local top = heap[1]
                heap[1] = heap[hn]
                heap[hn] = nil
                hn = hn - 1
                local i = 1
                while true do
