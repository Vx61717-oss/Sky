        local PET_MAX_LV = 6
        local function petUpgradeCost(t, lv) return math.floor(CREATURES[t].price * 0.4 * lv + 0.5) end
        local function petStats(t, lv)
            lv = math.clamp(math.floor(tonumber(lv) or 1), 1, PET_MAX_LV)
            local base = CREATURES[t]
            local s2 = {}
            for k, v in pairs(base) do s2[k] = v end
            s2.dmg = base.dmg * (1 + 0.06 * (lv - 1))
            s2.rate = base.rate * (1 + 0.02 * (lv - 1))
            s2.range = base.range * (1 + 0.05 * (lv - 1))
            if base.splash then s2.splash = base.splash * (1 + 0.05 * (lv - 1)) end
            s2.lv = lv
            return s2
        end
        local function fmtStat(n) if n < 10 then return string.format("%.1f", n) end return fmt(n) end

