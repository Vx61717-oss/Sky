        if #popupTracks == 0 then return end
        current = ((index - 1) % #popupTracks) + 1
        local selected = popupTracks[current]
        for _, track in ipairs(MusicTracks) do
            if track ~= selected then track:Stop() end
        end
        songName.Text = "الأغنية " .. tostring(current)
        if playNow then selected:Play() end
        playPause.Text = selected.IsPlaying and "⏸" or "▶"
    end
