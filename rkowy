local _selectedDeathCharacterConn
local _selectedDeathHumanoidConn

local function _disconnectSelectedDeathHooks()
    if _selectedDeathCharacterConn then
        _selectedDeathCharacterConn:Disconnect()
        _selectedDeathCharacterConn = nil
    end
    if _selectedDeathHumanoidConn then
        _selectedDeathHumanoidConn:Disconnect()
        _selectedDeathHumanoidConn = nil
    end
end

local function _hookSelectedPlayerDeath(player)
    _disconnectSelectedDeathHooks()
    if not player then return end

    local function hookCharacter(character)
        if _selectedDeathHumanoidConn then
            _selectedDeathHumanoidConn:Disconnect()
            _selectedDeathHumanoidConn = nil
        end

        if State.selectedPlayer ~= player then return end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
            or character:WaitForChild("Humanoid", 5)

        if humanoid and State.selectedPlayer == player then
            local playedThisDeath = false

            _selectedDeathHumanoidConn = humanoid.Died:Connect(function()
                if playedThisDeath or State.selectedPlayer ~= player then
                    return
                end

                playedThisDeath = true
                _selectedDeathSound:Stop()
                _selectedDeathSound.TimePosition = 0
                _selectedDeathSound:Play()
            end)
        end
    end

    if player.Character then
        hookCharacter(player.Character)
    end

    _selectedDeathCharacterConn = player.CharacterAdded:Connect(function(character)
        if State.selectedPlayer == player then
            hookCharacter(character)
        end
    end)
end

-- إعادة ربط ميزات تاب 2 فور تغيير اللاعب المحدد، بدون إطفاء الأزرار وتشغيلها من جديد.
local function _syncSelectedPlayerFeatures(player)
    if not player then return end

    State._hmmPhase = 0
    State._headBangPhase = 0
    State._hmmTargetPlayer = player
    State._hmmLastTargetPosition = nil
    State._hmmVelocity = nil

    if State.watchingActive then
        task.spawn(function()
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                or (character and character:WaitForChild("Humanoid", 5))
            if humanoid and State.selectedPlayer == player and State.watchingActive then
                Camera.CameraSubject = humanoid
            end
        end)
    end

    -- زر التطيير الخارجي هو المفتاح الرئيسي؛ أعد تهيئة هدفه الجديد داخليًا.
    if State._flingMasterEnabled then
        saveMyPos()
        State._flingStartCFrame = State.lastLocation
        State._flingTargetCharacter = player.Character
        State._flingTooFar = false
        State._flingReturned = false
        State._flingAutoPaused = player.Character == nil
        State.flingEnabled = player.Character ~= nil
    end
end

