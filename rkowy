            if state ~= nil then return end -- "declined": ما نسأل مرة ثانية

            -- أول مرة: ننتظر المعلومتين تخلصون قبل ما تجي الرسالة
            local waited = 0
            while not _G.SkyInfoTipsDone and waited < 15 do
                task.wait(0.2)
                waited = waited + 0.2
            end
            showMapPrompt()
        end
    end

