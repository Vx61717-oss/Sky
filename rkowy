	local function timeAgo(ts)
		ts = tonumber(ts)
		if not ts then return "" end
		local d = math.max(0, os.time() - ts)
		if d < 60 then return "الحين" end
		if d < 3600 then
			local n = math.floor(d / 60)
			return n == 1 and "قبل دقيقة" or ("قبل " .. n .. " دقايق")
		end
		if d < 86400 then
			local n = math.floor(d / 3600)
			return n == 1 and "قبل ساعة" or ("قبل " .. n .. " ساعات")
		end
		local n = math.floor(d / 86400)
		return n == 1 and "قبل يوم" or ("قبل " .. n .. " ايام")
	end

