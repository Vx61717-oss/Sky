-- 🌐 تحميل السيرفرات العامة بالخلفية من بداية تشغيل Sk، قبل فتح القائمة.
local SkyServerPreload = {
    data = {},
    done = false,
    running = false,
    started = false,
    fetchedPages = 0,
    error = nil
}

local function SkyStartServerPreload(forceRefresh)
    if SkyServerPreload.running then return end
    if SkyServerPreload.started and not forceRefresh then return end

    SkyServerPreload.data = {}
    SkyServerPreload.done = false
    SkyServerPreload.running = true
    SkyServerPreload.started = true
    SkyServerPreload.fetchedPages = 0
    SkyServerPreload.error = nil

    task.spawn(function()
        local httpService = game:GetService("HttpService")
        local placeId = tostring(game.PlaceId)

        local function fetchPage(sortOrder, cursor)
            local url = "https://games.roblox.com/v1/games/" .. placeId
                .. "/servers/Public?sortOrder=" .. sortOrder .. "&limit=100"
            if cursor and cursor ~= "" then
                url = url .. "&cursor=" .. httpService:UrlEncode(cursor)
            end

            local body
            if type(request) == "function" then
                local requestOK, response = pcall(function()
                    return request({Url = url, Method = "GET"})
                end)
                if requestOK and type(response) == "table" then
                    body = response.Body or response.body
                end
            end
            if type(body) ~= "string" or body == "" then
                local httpOK, httpBody = pcall(function()
                    return game:HttpGet(url)
                end)
                if httpOK and type(httpBody) == "string" then
                    body = httpBody
                end
            end
            if type(body) ~= "string" or body == "" then
                error("تعذر قراءة صفحة السيرفرات")
            end
            return httpService:JSONDecode(body)
        end

        -- نطلب ترتيب Asc ونجمع كل السيرفرات التي فيها 3 لاعبين أو أقل.
        -- نتابع الصفحات ما دام ترتيب Roblox يعرض السيرفرات الأقل أولاً.
        local pageOK, pageError = pcall(function()
            local cursor = ""
            local seenCursors = {}
            local keepSearching = true

            while keepSearching and SkyServerPreload.fetchedPages < 100 do
                local page = fetchPage("Asc", cursor)
                if type(page) ~= "table" or type(page.data) ~= "table" then
                    error("بيانات السيرفرات غير مكتملة")
                end

                SkyServerPreload.fetchedPages = SkyServerPreload.fetchedPages + 1
                for _, server in ipairs(page.data) do
                    local playing = tonumber(server.playing)
                    local maxPlayers = tonumber(server.maxPlayers)
                    if server.id and playing and maxPlayers then
                        if playing <= 3 then
                            SkyServerPreload.data[server.id] = {
                                id = server.id,
                                playing = playing,
                                maxPlayers = maxPlayers
                            }
                        else
                            -- وصلنا لما فوق 3 لاعبين؛ ما نحتاج صفحات أكثر.
                            keepSearching = false
                            break
                        end
                    end
                end

                local nextCursor = page.nextPageCursor
                if not keepSearching or type(nextCursor) ~= "string" or nextCursor == "" then
                    break
                end
                if seenCursors[nextCursor] then
                    break
                end
                seenCursors[nextCursor] = true
                cursor = nextCursor
                task.wait(0.15)
            end
        end)
        if not pageOK then
            SkyServerPreload.error = tostring(pageError)
        end

        SkyServerPreload.running = false
        SkyServerPreload.done = true
    end)
end

