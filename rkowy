                -- 🎲 تأخير النزول: مرات يطلعون ورا بعض على الخط (قطار 2-4 لاصقين)، ومرات بينهم مسافة تقدر تذبحهم فيها
                local function nextSpawnDelay()
                    local spd = 15 * (1 + wave * 0.07) * st.spdMul
                    local tight = 30 / spd -- الوقت اللي يتحرك فيه العدو 30 بكسل (يعني لاصق بالي قدامه)
                    if burstLeft > 0 then
                        burstLeft = burstLeft - 1
                        return tight
                    end
                    if spawnLeft >= 1 and math.random() < 0.6 then
                        burstLeft = math.min(math.random(1, 3), spawnLeft) - 1
                        return tight
                    end
                    return tight * (3 + math.random() * 3) -- مسافة فاضية بين المجموعات
