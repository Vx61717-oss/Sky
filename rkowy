            local function resetSpeed()
                currentSpeed = defaultSpeed
                if camLabel then camLabel.Text = "السرعة: " .. math.floor(defaultSpeed) end
                OK("↩ تم إرجاع سرعة المناظرة الطبيعية", "freecamspeed")
            end

            -- ➖ / ➕ — نفس زري + و- بقائمة الجاذبية بالضبط (نفس الحجم والموضع والأنيميشن)
            local function makeStepButton(text, xScale, delta)
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(0.38, 0, 0, 30)
                btn.Position = UDim2.new(xScale, 0, 0, 72)
                btn.BackgroundColor3 = Color3.fromRGB(0, 90, 140)
                btn.BackgroundTransparency = 1
                btn.TextTransparency = 1
                btn.Text = text
                btn.TextColor3 = Color3.new(1, 1, 1)
                btn.TextScaled = true
                btn.Font = Enum.Font.Arcade
                btn.TextSize = 16
                Instance.new("UICorner", btn)
                btn.Parent = panel
                table.insert(bodyItems, btn)
                local btnGlow = Instance.new("UIStroke", btn)
                btnGlow.Thickness = 1.5
                btnGlow.Transparency = 1
                AddMovingBorderGlow(btnGlow, 1.5, ASSIST_BLUE)
                task.delay(0.05, function()
                    if btn and btn.Parent then
                        SkyTw(btn, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0, TextTransparency = 0}):Play()
                        SkyTw(btnGlow, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 0.3}):Play()
                    end
                end)

                -- ضغطة وحدة = خطوة، ضغطة مطوّلة = تكرار تلقائي (مثل الجاذبية)
                local holding = false
                local longPress = false
                btn.InputBegan:Connect(function(input)
                    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
                    holding = true
                    longPress = false
                    task.delay(0.45, function()
                        if not holding or not btn.Parent then return end
                        longPress = true
                        local ticks = 0
                        while holding and btn.Parent do
                            -- ⏩ كل ما طوّلت الضغط تتسارع الخطوة عشان توصل للأرقام الكبيرة بسرعة
                            local mult = ticks < 10 and 1 or (ticks < 25 and 5 or (ticks < 50 and 20 or 50))
                            applySpeed(currentSpeed + delta * mult)
                            ticks = ticks + 1
                            task.wait(0.08)
                        end
                    end)
                end)
                btn.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        holding = false
                    end
                end)
                btn.MouseButton1Click:Connect(function()
                    playClick()
                    if not longPress then
                        applySpeed(currentSpeed + delta)
                    end
                    longPress = false
                end)
            end
            makeStepButton("-", 0.06, -SPEED_STEP)
            makeStepButton("+", 0.56, SPEED_STEP)

            -- 🔄 زر Reset لإرجاع السرعة للقيمة الافتراضية
            local resetBtn = Instance.new("TextButton")
            resetBtn.Name = "ResetFreeCamSpeed"
