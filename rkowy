                    if vis ~= mShown then
                        mShown = vis
                        mModel.Parent = vis and scene or nil
                    end
                    if vis then
                        local mspd = math.sqrt((mx - lastMx) ^ 2 + (my - lastMy) ^ 2) / math.max(dt, 1e-3)
                        mWalk = mWalk + (math.min(1, mspd / (PSPEED * 0.6)) - mWalk) * math.min(1, dt * 6)
                        local raging = state == "play" and (FL.rage or 0) > 0
                        if state == "play" then
                            if raging then
                                mRaise = mRaise + (1 - mRaise) * math.min(1, dt * 10)
                            else
                                local rt = (mState == "chase" and md < 6) and 1 or 0
                                mRaise = mRaise + (rt * 0.25 - mRaise) * math.min(1, dt * 3)
                            end
                        end
                        lightTall(brightAt(mx, my, mf, lamps))
                        -- 🏃 يركض (أنيميشن مخيف) لما يلاحقك بالصعب
                        local runT = (SP.hard and state == "play" and mState == "chase" and not raging and mspd > PSPEED * 0.25) and 1 or 0
                        MonStep.run = MonStep.run + (runT - MonStep.run) * math.min(1, dt * 7)
                        if raging then
                            poseTall(mx + rnd(-1, 1) * 0.3, my + rnd(-1, 1) * 0.3, mFace, dt, t, 0, mRaise, close, mElev)
                        else
                            poseTall(mx, my, mFace, dt, t, mWalk, mRaise, close, mElev, MonStep.run)
                        end
                    end
                    lastMx, lastMy = mx, my

                    updateEye(dt)

                    -- 🎥 الكاميرا (منظور أول شخص)
                    camKick = math.max(0, camKick - dt * 2.8)
                    camKickRoll = math.max(0, camKickRoll - dt * 0.22)
                    -- 🎥 حركة مشي ناعمة: تزيد تدريجيًا مع السرعة وتختفي تدريجيًا عند الوقوف.
                    local walkBlend = math.clamp(walkAmt, 0, 1)
                    -- حركة واضحة لكن ناعمة: صعود/نزول + تمايل جانبي + ميلان ودوران خفيف.
                    local bob = math.sin(walkPhase) * 0.105 * walkBlend
                    local sideSway = math.cos(walkPhase * 0.5) * 0.045 * walkBlend
                    local stepBob = math.sin(walkPhase * 0.5) * 0.022 * walkBlend
                    local walkPitch = math.sin(walkPhase) * 0.026 * walkBlend
                    local walkYaw = math.cos(walkPhase * 0.5) * 0.018 * walkBlend
                    local sx, sy, sz = sideSway, 0, 0
                    local totalShake = shake + camKick * 0.22
                    if totalShake > 0.001 then
                        sx = sx + rnd(-1, 1) * totalShake
                        sy = sy + rnd(-1, 1) * totalShake
                        sz = sz + rnd(-1, 1) * totalShake
                    end
                    sy = sy + stepBob
                    local smoothRoll = math.sin(walkPhase * 0.5) * 0.012 * walkBlend
                    local roll = smoothRoll + ((totalShake > 0.001) and rnd(-1, 1) * (totalShake * 0.025 + camKickRoll * 0.22) or 0)
                    cam3d.CFrame = CFrame.new(px + sx, viewElev + EYE + bob + sy, py + sz)
                        * CFrame.Angles(0, yaw + walkYaw, 0)
                        * CFrame.Angles(pitch + walkPitch, 0, 0)
                        * CFrame.Angles(0, 0, roll)
                    SP.fov = SP.fov + ((SP.on and 7 or 0) - SP.fov) * math.min(1, dt * 6) -- 🏃 الركض يوسّع الرؤية شوي
                    cam3d.FieldOfView = 78 + SP.fov + H.hs.halu * 5 * math.sin(os.clock() * 2.3) - close * 7 + close * 2 * math.sin(os.clock() * 9)

