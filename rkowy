            local function applySpeed(newVal)
                newVal = math.clamp(math.floor(newVal), MIN_SPEED, MAX_SPEED)
                currentSpeed = newVal
                if camLabel then camLabel.Text = "السرعة: " .. newVal end
                OK("🚁 سرعة المناظرة: " .. newVal, "freecamspeed")
