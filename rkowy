            _G.SkyMentionSeen = _G.SkyMentionSeen or {}

            function C.isMentioned(text, myName)
                if type(text) ~= "string" or type(myName) ~= "string" or myName == "" then return false end
                local escaped = myName:lower():gsub("%W", "%%%0")
                return text:lower():find("@%s*" .. escaped .. "%f[^%w_]") ~= nil
