                end

                local elapsed = os.clock() - startedAt
                local waitBeforeFade = math.max(0, soundLength - elapsed - fadeDuration)
                task.wait(waitBeforeFade)

                if not mathErrorImage.Parent then return end

                local fadeImage = TweenService:Create(
                    mathErrorImage,
                    TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
                    {ImageTransparency = 1, Size = UDim2.new(0, 228, 0, 228)}
