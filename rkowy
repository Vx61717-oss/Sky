                    if l <= hn and heap[l].f < heap[s].f then s = l end
                    if r <= hn and heap[r].f < heap[s].f then s = r end
                    if s == i then break end
                    heap[s], heap[i] = heap[i], heap[s]
                    i = s
                end
                return top
            end

            local h0, e0 = 0, 0
            for i = 1, n do
                local v = start[i]
                if v == 0 then e0 = i else h0 = h0 + dist(v, i) end
            end
            local k0 = keyOf(start)
            local best = {[k0] = 0}
            push({b = copyBoard(start), g = 0, h = h0, f = weight * h0, e = e0, k = k0})

            local expanded = 0
            while hn > 0 do
