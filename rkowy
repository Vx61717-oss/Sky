                end
            end)

            task.spawn(function()
                local answer, failInfo, scriptCode, scriptName
                pcall(function()
                    local HS = game:GetService("HttpService")
                    -- 👤 معلومات المستخدم الحالي (عشان يقدر يجاوب لو سألته عن نفسك)
                    local lp = game.Players.LocalPlayer
                    if not SkyAI.gameName then
                        local okG, infoG = pcall(function()
                            return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
                        end)
                        SkyAI.gameName = (okG and type(infoG) == "table" and infoG.Name) or "غير معروف"
                    end
                    local userInfo = "\n\nمعلومات المستخدم الحالي:\n- اسم الحساب: " .. tostring(lp.Name)
                        .. "\n- الاسم الظاهر: " .. tostring(lp.DisplayName)
