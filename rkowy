                        for attempt = 1, 3 do
                            if SkyAI.token ~= myToken then return nil end
                            local b, st = tryPost(models[((attempt - 1) % #models) + 1])
                            if b then return b end
                            failInfo = tostring(st)
                            if st == 401 or st == 402 or st == 403 then break end
                            if attempt < 3 then task.wait(waits[attempt] or 8) end
                        end
                        return nil
                    end
                    body = fetchBody()
                    if SkyAI.token ~= myToken then return end

                    -- احتياط أخير: GET بالسؤال فقط
                    if not body and not isScript and SkyAI.token == myToken and SkyAI.API_KEY ~= "" then
                        local url = "https://gen.pollinations.ai/text/" .. HS:UrlEncode(question) .. "?key=" .. SkyAI.API_KEY
                            .. "&system=" .. HS:UrlEncode(SkyAI.SHORT_SYS .. (limited and SkyAI.LIMIT_NOTE or ""))
                        local ok, res = pcall(request, {Url = url, Method = "GET"})
                        if ok and type(res) == "table" and (res.StatusCode == nil or res.StatusCode == 200) then
                            body = res.Body or res.body
                        elseif ok and type(res) == "table" then
                            failInfo = tostring(res.StatusCode)
                        end
                        if type(body) ~= "string" or body == "" then
                            local ok2, b = pcall(function() return game:HttpGet(url) end)
                            if ok2 then body = b end
                        end
                    end

                    -- 📝 رد سكربت: نفصل الكود عن الشرح بدون ما نقص الكود أو ننظفه
                    if isScript and type(body) == "string" and body:gsub("%s+", "") ~= "" then
                        body = body:gsub("^%s+", ""):gsub("%s+$", "")
                        local code, before = SkyAI.extractScript(body)
                        -- ✏️ وضع التعديل: لو رد بدون كود (مثلاً سأل سؤال) نعيد الطلب مرة وحدة ونجبره يكتب السكربت
                        if not code and isEdit then
                            table.insert(msgs, {role = "assistant", content = body})
                            table.insert(msgs, {role = "user", content = "لا تسأل أسئلة. اكتب الحين النسخة الكاملة المعدلة من السكربت داخل كتلة ```lua``` بنفس الشكل (FILE ثم وش يسوي ثم وش أضفت ثم الكود)، وفسّر طلبي بأقرب شي منطقي."})
                            local body3 = fetchBody()
                            if SkyAI.token ~= myToken then return end
                            if type(body3) == "string" and body3:gsub("%s+", "") ~= "" then
                                body3 = body3:gsub("^%s+", ""):gsub("%s+$", "")
                                local code3, before3 = SkyAI.extractScript(body3)
                                if code3 then body, code, before = body3, code3, before3 end
                            end
                        end
                        -- ✅ نفحص السكربت (تحليل فقط، ما ينشغّل). لو فيه خطأ سينتاكس نطلب من الذكاء الاصطناعي يصلحه مرة وحدة
                        if code and type(loadstring) == "function" then
                            local fnOk, fnErr = loadstring(code)
                            if not fnOk then
                                pcall(warn, "[SkyAI] خطأ سينتاكس بالسكربت، نعيد التصحيح: " .. tostring(fnErr))
                                table.insert(msgs, {role = "assistant", content = body})
                                table.insert(msgs, {role = "user", content = "السكربت فيه خطأ سينتاكس يمنع تشغيله: " .. tostring(fnErr) .. "\nصلّحه واكتب النسخة الكاملة المصححة بنفس الشكل (FILE ثم وش يسوي ثم وش أضفت ثم الكود)."})
                                local body2 = fetchBody()
                                if SkyAI.token ~= myToken then return end
                                if type(body2) == "string" and body2:gsub("%s+", "") ~= "" then
                                    body2 = body2:gsub("^%s+", ""):gsub("%s+$", "")
                                    local code2, before2 = SkyAI.extractScript(body2)
                                    if code2 then body, code, before = body2, code2, before2 end
                                end
                            end
                        end
                        if code then
                            scriptCode = code
                            local details
                            scriptName, details = SkyAI.parseScriptInfo(before)
                            if details == "" then details = "هذا السكربت اللي طلبته، اضغط على الملف وانسخه" end
                            answer = details
                        else
                            if utf8.len(body) and utf8.len(body) > SkyAI.MAX_A then
                                body = body:sub(1, (utf8.offset(body, SkyAI.MAX_A + 1) or (#body + 1)) - 1) .. "…"
                            end
                            answer = body
                        end
                    elseif type(body) == "string" and body:gsub("%s+", "") ~= "" then
                        body = body:gsub("^%s+", ""):gsub("%s+$", "")
                        if utf8.len(body) and utf8.len(body) > SkyAI.MAX_A then
                            body = body:sub(1, (utf8.offset(body, SkyAI.MAX_A + 1) or (#body + 1)) - 1) .. "…"
                        end
                        -- 🧹 ننظف الرد: بدون تنسيق، بدون نقاط بنهاية الجمل، وأقصى 4 أسطر
                        body = body:gsub("%*%*", ""):gsub("`", ""):gsub("^#+%s*", "")
                        body = body:gsub("%.(%s)", "%1"):gsub("%.$", ""):gsub("。", "")
                        local lines, n = {}, 0
                        for line in body:gmatch("[^\r\n]+") do
                            line = line:gsub("^%s+", ""):gsub("%s+$", "")
                            if line ~= "" then
                                n = n + 1
                                if n > 4 then break end
                                table.insert(lines, line)
                            end
                        end
                        body = table.concat(lines, "\n")
                        -- ملاحظة: ما نفلتر الرد بقائمة الكلمات الممنوعة لأن المطابقة الجزئية تعطي أخطاء كاذبة
                        answer = body
                    end
                end)
                if SkyAI.token ~= myToken then return end -- انتهى الانتظار قبل وصول الرد
                SkyAI.token = myToken + 1
                SkyAI.busy = false
                SkyAI.setTyping(false)
                if answer then
                    table.insert(SkyAI.history, {role = "user", content = question})
                    table.insert(SkyAI.history, {role = "assistant", content = scriptCode and ("```lua\n" .. scriptCode .. "\n```") or answer})
                    while #SkyAI.history > 6 do table.remove(SkyAI.history, 1) end
                end
                if not answer then pcall(warn, "[SkyAI] فشل الطلب: " .. tostring(failInfo)) end
                if scriptCode and SkyAI.sourceFile and type(writefile) == "function" then
                    -- 💾 نسخة المعدّل تنحفظ بمجلد المنفّذ بدون ما نغيّر ملفك الأصلي
                    local outName = "SkyAI_Edited_" .. (tostring(SkyAI.sourceFile):gsub("^.*[/\\]", ""))
                    if pcall(writefile, outName, scriptCode) then
                        answer = tostring(answer or "") .. "\n💾 انحفظت النسخة المعدّلة بمجلد المنفّذ باسم " .. outName
                    end
                end
                if scriptCode then
                    SkyAI.lastScript = scriptCode
                    SkyAI.lastScriptAt = os.clock()
                    SkyAI.lastScriptName = scriptName or "sky_script.lua"
                    SkyAI.showScriptCard(scriptName or "sky_script.lua", scriptCode) -- 📄 الملف الوهمي أول
                end
                SkyAI.show(answer or SkyAI.FAILED) -- وتحته الشرح
            end)
        end

