            -- ---------- الرسم والحالة ----------
            local INIT = {P = 8, N = 2, B = 2, R = 2, Q = 1}
            local ORDER = {"Q", "R", "B", "N", "P"}
            local PV = {P = 1, N = 3, B = 3, R = 5, Q = 9}

            local function refreshInfo()
                local cnt = {w = {}, b = {}}
                local mat = {w = 0, b = 0}
                for r = 1, 8 do
                    for c = 1, 8 do
                        local p = state.board[r][c]
                        if p then
                            local col, t = p:sub(1, 1), p:sub(2, 2)
                            cnt[col][t] = (cnt[col][t] or 0) + 1
                            if PV[t] then mat[col] = mat[col] + PV[t] end
                        end
                    end
                end
                local function fillCaptured(holder, col, adv)
                    local parts, key = {}, tostring(adv)
                    for _, t in ipairs(ORDER) do
                        local miss = math.max(0, INIT[t] - (cnt[col][t] or 0))
                        if miss > 0 then
                            parts[#parts + 1] = {t, miss}
                            key = key .. t .. tostring(miss)
                        end
                    end
                    if holder:GetAttribute("key") == key then return end
                    holder:SetAttribute("key", key)
                    for _, ch in ipairs(holder:GetChildren()) do
                        if ch:IsA("GuiObject") then ch:Destroy() end
                    end
                    for i, pr in ipairs(parts) do
                        local icon = Instance.new("Frame")
                        icon.LayoutOrder = i * 2
                        icon.Size = UDim2.new(0, 24, 0, 24)
                        icon.BackgroundTransparency = 1
                        icon.ZIndex = Z + 3
                        icon.Parent = holder
                        drawPiece(icon, pr[1], col, Z + 4, 1, true)
                        if pr[2] > 1 then
                            local n = Instance.new("TextLabel")
                            n.LayoutOrder = i * 2 + 1
                            n.Size = UDim2.new(0, 16, 0, 24)
                            n.BackgroundTransparency = 1
                            n.Font = Enum.Font.GothamBold
                            n.TextSize = 12
                            n.TextColor3 = Color3.fromRGB(215, 225, 240)
                            n.Text = "x" .. tostring(pr[2])
                            n.ZIndex = Z + 3
                            n.Parent = holder
                        end
                    end
                    if adv > 0 then
                        local a2 = Instance.new("TextLabel")
                        a2.LayoutOrder = 100
                        a2.Size = UDim2.new(0, 34, 0, 24)
                        a2.BackgroundTransparency = 1
                        a2.Font = Enum.Font.GothamBold
                        a2.TextSize = 14
                        a2.TextColor3 = GREEN
                        a2.Text = "+" .. tostring(adv)
                        a2.ZIndex = Z + 3
                        a2.Parent = holder
                    end
                end
                local diff = mat.w - mat.b
                fillCaptured(oppCap, "w", (diff < 0) and (-diff) or 0)
                fillCaptured(plrCap, "b", (diff > 0) and diff or 0)
                local whiteTurn = state.turn == "w" and not gameOver
                local blackTurn = state.turn == "b" and not gameOver
                plrStroke.Color = whiteTurn and THEME or Color3.fromRGB(60, 72, 88)
                oppStroke.Color = blackTurn and THEME or Color3.fromRGB(60, 72, 88)
            end

            local CHECK_C = Color3.fromRGB(235, 70, 70)
            local LAST_C = Color3.fromRGB(255, 235, 90)

            local function render()
                local kr, kc
                if Engine.inCheck(state) then kr, kc = Engine.findKing(state.board, state.turn) end
                for r = 1, 8 do
                    for c = 1, 8 do
                        local sq = squares[r][c]
                        local hlColor, hlTrans = LAST_C, 1
                        if lastMove and ((lastMove.fr == r and lastMove.fc == c) or (lastMove.tr == r and lastMove.tc == c)) then
                            hlTrans = 0.55
                        end
                        if selected and selected[1] == r and selected[2] == c then
                            hlTrans = 0.25
                        end
                        if kr == r and kc == c then
                            hlColor = CHECK_C
                            hlTrans = 0.2
                        end
                        sq.hl.BackgroundColor3 = hlColor
                        sq.hl.BackgroundTransparency = hlTrans
                        sq.dot.Visible = false
                        sq.ring.Visible = false
                        setPiece(sq, state.board[r][c] or false)
                    end
                end
                for _, m in ipairs(selMoves) do
                    local sq = squares[m.tr][m.tc]
                    if state.board[m.tr][m.tc] or m.ep then
                        sq.ring.Visible = true
                    else
                        sq.dot.Visible = true
                    end
