        SkyAI.ask = function(question)
            if SkyAI.busy then
                Notify("🤖 Sky AI", "انتظر الرد السابق", Color3.fromRGB(255, 170, 70), true)
                return
            end
            local left = SkyAI.COOLDOWN - (os.clock() - SkyAI.last)
            if left > 0 then
                Notify("🤖 Sky AI", "انتظر " .. math.ceil(left) .. " ثواني", Color3.fromRGB(255, 170, 70), true)
                return
            end
            SkyAI.curInTab = SkyAI.tabActive and true or false
            local fileCode

            local isEdit = (fileCode ~= nil) or SkyAI.isEditRequest(question)
            if not isEdit and SkyAI.pendingEdit and (os.clock() - SkyAI.pendingEdit) < 900 then isEdit = true end
            SkyAI.pendingEdit = nil
            local isScript = isEdit or SkyAI.isScriptRequest(question)
            if isScript and not isEdit then SkyAI.sourceFile = nil end
            if not isScript and SkyAI.lastScript and (question:find("افتح السكربت", 1, true) or question:find("افتح الكود", 1, true)) then
                SkyAI.last = os.clock()
                SkyAI.openScriptViewer(SkyAI.lastScript)
                return
            end
            -- ⚡ جواب جاهز محلي: فوري، بدون إنترنت، وما يحسب من حد السوالف
            local localAns = (not isScript) and SkyAI.localAnswer(question) or nil
            if localAns then
                SkyAI.last = os.clock() - SkyAI.COOLDOWN + 1
                SkyAI.setTyping(true)
                task.delay(0.5, function()
                    SkyAI.setTyping(false)
                    SkyAI.show(localAns)
                end)
                table.insert(SkyAI.history, {role = "user", content = question})
                table.insert(SkyAI.history, {role = "assistant", content = localAns})
                while #SkyAI.history > 6 do table.remove(SkyAI.history, 1) end
                return
            end
            SkyAI.busy = true
            SkyAI.last = os.clock()
            -- 🔢 عدّاد السوالف: بعد 10 رسايل يعتذر دقيقة (أسئلة السكربت تبقى مجابة)
            local nowT = os.time()
            if SkyAI.limitUntil and nowT >= SkyAI.limitUntil then
                SkyAI.limitUntil = nil
                SkyAI.count = 0
            end
            if not isScript then
                SkyAI.count = (SkyAI.count or 0) + 1
                if SkyAI.count > SkyAI.CHAT_LIMIT and not SkyAI.limitUntil then
                    SkyAI.limitUntil = nowT + SkyAI.LIMIT_SECONDS
                end
            end
            local limited = (not isScript) and (SkyAI.limitUntil ~= nil) or false
            SkyAI.token = (SkyAI.token or 0) + 1
            local myToken = SkyAI.token
            SkyAI.setTyping(true)

            -- ⏱️ لو تأخر الرد أكثر من 45 ثانية نوقف الانتظار
