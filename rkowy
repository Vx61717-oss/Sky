        -- 🤝 قايمة الأصدقاء: روبلوكس يخزّن نتيجة IsFriendsWith، فالصديق الجديد (اللي انضاف وأنت داخل اللعبة)
        -- ممكن ما يبان صديق لين تعيد الدخول. عشان كذا نجيب القايمة الحديثة من موقع روبلوكس كل فترة
        -- ونجمعها مع IsFriendsWith.
        local _ChatFriends = {set = {}, last = 0, busy = false}

        local function isChatFriend(userId)
            userId = tonumber(userId)
            if not userId then return false end
            if userId == game.Players.LocalPlayer.UserId then return true end
            if _ChatFriends.set[userId] then return true end
            local ok, result = pcall(function()
                return game.Players.LocalPlayer:IsFriendsWith(userId)
            end)
            if ok and result == true then return true end
            -- ما طلع صديق: يمكن صديق جديد، نحدّث القايمة (بحد أدنى 20 ثانية بين كل تحديث)
            if _ChatFriends.refresh then _ChatFriends.refresh(false) end
            return false
        end

        local function isChatMessageVisible(m)
            if not m then return false end
            local mode = tostring(m.chatType or "general")
            if mode == "private" then return false end -- 🔒 التنبيه الخاص ما يبان بالدردشة
            -- 📍 الرسالة تبان في التاب اللي انكتبت فيه فقط (حتى لو الكاتب خويي):
            --   • كتبها بالعام  → تبان بتاب العام بس.
            --   • كتبها بأخوياك → تبان بتاب أخوياك بس، ولأصدقاء الكاتب بس (خصوصية).
            if currentChatMode == "friends" then
                return mode == "friends" and isChatFriend(m.userId)
            end
            if mode == "friends" then return false end
            return true
        end

        local function clearChatRows()
            for _, child in ipairs(chatLog and chatLog:GetChildren() or {}) do
                if child:IsA("Frame") and child.Name == "MsgRow" then child:Destroy() end
            end
        end

        local function rebuildChatForMode()
            clearChatRows()
            local items = {}
            local seen = {}
            for _, m in pairs(chatMessageCache) do
                if isChatMessageVisible(m) then
                    -- 🔒 منع أي نسخة مكررة من نفس الرسالة داخل الكاش عند تبديل عام/أخوياك.
                    local fingerprint = tostring(m.clientId or "")
                    if fingerprint == "" then
                        fingerprint = tostring(m.id or "")
                    end
                    if fingerprint == "" then
                        fingerprint = table.concat({
                            tostring(m.timestamp or ""),
                            tostring(m.sender or ""),
                            tostring(m.text or ""),
                            tostring(m.chatType or "general"),
                            tostring(m.jobId or "")
                        }, "\31")
                    end
                    if not seen[fingerprint] then
                        seen[fingerprint] = true
                        table.insert(items, m)
                    end
                end
            end
            table.sort(items, function(a,b) return (tonumber(a.timestamp) or 0) < (tonumber(b.timestamp) or 0) end)
            for _, m in ipairs(items) do
                addChatMsg(m.sender, m.text, m.id, m.userId, m.timestamp, m.chatType, m.jobId, m.placeId, m.clientId, m.replyTo)
            end
            SkyAI.scrollToLast(chatLog, chatList)
        end

        -- 🔄 تحديث قايمة الأصدقاء من موقع روبلوكس. إذا تغيرت نعيد بناء الرسائل عشان تظهر اللي كانت مخفية.
        function _ChatFriends.refresh(force)
            if _ChatFriends.busy then return end
            if not force and os.clock() - _ChatFriends.last < 20 then return end
            _ChatFriends.busy = true
            _ChatFriends.last = os.clock()
            task.spawn(function()
                local url = "https://friends.roblox.com/v1/users/" .. tostring(game.Players.LocalPlayer.UserId) .. "/friends"
                local body
                pcall(function() body = game:HttpGet(url) end)
                if not body and request then
                    pcall(function()
                        local res = request({Url = url, Method = "GET"})
                        if res and res.StatusCode == 200 then body = res.Body end
                    end)
                end
                _ChatFriends.busy = false
                if not body then return end
                local okD, data = pcall(function() return game:GetService("HttpService"):JSONDecode(body) end)
                if not okD or type(data) ~= "table" or type(data.data) ~= "table" then return end
                local newSet, changed = {}, false
                for _, f in ipairs(data.data) do
                    local id = tonumber(f.id)
                    if id then
                        newSet[id] = true
                        if not _ChatFriends.set[id] then changed = true end
                    end
                end
                for id in pairs(_ChatFriends.set) do
                    if not newSet[id] then changed = true end
                end
                _ChatFriends.set = newSet
                if changed then pcall(rebuildChatForMode) end
            end)
        end
        task.spawn(function()
            while true do
                _ChatFriends.refresh(true)
                task.wait(45)
            end
        end)

        local function switchChatMode(mode)
            mode = mode == "friends" and "friends" or "general"
