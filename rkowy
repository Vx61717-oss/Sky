    -- ====================== AimBot Loop ======================
    -- توجيه الكاميرا للهدف بشكل ناعم بدل الانتقال الفوري.
    local aimSmoothSpeed = 12

    -- 🎯 قائمة الأهداف تتجدد بالخلفية كل 0.25 ثانية (الفحص الثقيل ما ينعمل داخل RenderStepped)
    -- كل هدف: {char = Model, player = Player أو nil للبوتات, category = "Friend" / "Enemy" / "Bot"}
    State.AimCandidates = {}

    -- 💀 كشف الموت بدون الاعتماد على الدم (Health) بس، لأن بعض المابات تخلي الشخصية "ميتة" شكلاً والدم باقي.
    -- فحص سريع (كل فريم): دم صفر / حالة Dead أو Ragdoll / الشخصية راقدة على الأرض.
    State.AimQuickDead = function(char, hum)
        if hum.Health <= 0 then return true end
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.Dead or st == Enum.HumanoidStateType.Ragdoll then return true end
        -- راقد: الجذع مايل أكثر من ~65 درجة (نستثني السباحة والجلوس)
        if st ~= Enum.HumanoidStateType.Swimming and not hum.Sit then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root and root.CFrame.UpVector.Y < 0.4 then return true end
        end
        return false
    end

    -- فحص أعمق (بالخلفية كل 0.25 ثانية): مفصل الرقبة انقطع/انعطل، أو علامات Dead/Ragdoll من سكربت الماب.
    State.AimDeadFlags = {"Dead", "IsDead", "Died", "Ragdoll", "Ragdolled", "Downed", "Knocked", "KnockedOut"}
    State.AimHadNeck = setmetatable({}, {__mode = "k"})
    State.AimDeepDead = function(char)
        local hum = char:FindFirstChildOfClass("Humanoid")
        for _, name in ipairs(State.AimDeadFlags) do
            if char:GetAttribute(name) == true or (hum and hum:GetAttribute(name) == true) then return true end
            local v = char:FindFirstChild(name)
            if v and v:IsA("BoolValue") and v.Value then return true end
        end
        local neck = char:FindFirstChild("Neck", true)
        if neck then
            State.AimHadNeck[char] = true
            if neck:IsA("Motor6D") and (not neck.Enabled or not neck.Part0 or not neck.Part1) then return true end
        elseif State.AimHadNeck[char] then
            return true -- كان عنده رقبة وانحذفت = انفكت المفاصل
        end
        return false
    end

    task.spawn(function()
        -- يرجع true إذا الموديل هذا (أو أحد آبائه) شخصية لاعب حقيقي
        local function belongsToPlayer(model)
            local m = model
            while m and m ~= Workspace do
                if Players:GetPlayerFromCharacter(m) then return true end
                m = m.Parent
            end
            return false
        end

        while true do
            task.wait(0.25)

            if not State.AimBotActive then
                if #State.AimCandidates > 0 then State.AimCandidates = {} end
                State.AimLock = nil
                continue
            end

            local list = {}

            -- اللاعبون: أصدقاء / لاعبين
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local isFriend = false
                    pcall(function() isFriend = LocalPlayer:IsFriendsWith(p.UserId) end)
                    local category = isFriend and "Friend" or "Enemy"
                    if State.AimFilters[category] then
                        table.insert(list, {char = p.Character, player = p, category = category, dead = State.AimDeepDead(p.Character)})
                    end
                end
            end

            -- البوتات: أي موديل فيه Humanoid وما هو شخصية لاعب
            if State.AimFilters.Bot then
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("Humanoid") then
                        local model = obj.Parent
                        if model and model:IsA("Model")
                            and model:FindFirstChild("HumanoidRootPart")
                            and model:FindFirstChild("Head")
                            and not belongsToPlayer(model) then
                            table.insert(list, {char = model, player = nil, category = "Bot", dead = State.AimDeepDead(model)})
                        end
                    end
                end
            end

            State.AimCandidates = list
        end
    end)

    RunService:BindToRenderStep("SkyAimBotMain", Enum.RenderPriority.Camera.Value + 1, function(dt)
        local activeCamera = Workspace.CurrentCamera or Camera
        if State.AimBotActive and not State.AimSelectedActive and activeCamera and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local closestHead = nil
            local shortestDistance = math.huge
            local myRoot = LocalPlayer.Character.HumanoidRootPart

            -- 💀 المرحلة 1: نفرز الأحياء من الأموات كل فريم، فلو مات الهدف ينتقل فوراً للي بعده.
            -- جثث الأموات نضيفها لفلتر الـ Raycast عشان ما تسد الطريق على الأهداف الحيّة.
            local alive = {}
            local filter = {LocalPlayer.Character}
            for _, cand in ipairs(State.AimCandidates) do
                local char = cand.char
                local hum = char and char.Parent and char:FindFirstChildOfClass("Humanoid")
                if hum and not cand.dead and not State.AimQuickDead(char, hum) then
                    table.insert(alive, cand)
                elseif char then
                    table.insert(filter, char)
                end
            end

            local rayParams = RaycastParams.new()
            rayParams.FilterDescendantsInstances = filter
            rayParams.FilterType = Enum.RaycastFilterType.Blacklist
            rayParams.IgnoreWater = true

            -- 🔒 تثبيت الهدف: بدل ما يغيّر الهدف كل فريم لما اثنين قريبين من بعض أو الرؤية تقطع وترجع،
            -- نمسك هدف واحد ونبدّل فقط إذا مات/ابتعد/انحجب فترة، أو ظهر هدف أقرب بوضوح بعد مدة تثبيت.
            local LOCK_HOLD = 0.6        -- أقل مدة نبقى على الهدف قبل ما نفكر نبدّل لأقرب منه
            local LOCK_LOSE_SIGHT = 0.5  -- كم ثانية نصبر لو انحجب الهدف قبل ما نتركه
            local SWITCH_RATIO = 0.7     -- الهدف الجديد لازم يكون أقرب بـ 30% على الأقل عشان نبدّل
            local now = os.clock()

            local valid = {}
            for _, cand in ipairs(alive) do
                local char = cand.char
                local player = cand.player
                local targetRoot = char:FindFirstChild("HumanoidRootPart")
                local targetHead = char:FindFirstChild("Head")
                if State.AimFilters[cand.category]
                    and targetRoot and targetHead
                    -- تجاهل أعضاء فريقك إذا كنت داخل فريق (للاعبين فقط)
                    and (player == nil or LocalPlayer.Team == nil or player.Team ~= LocalPlayer.Team) then
                    local distance = (myRoot.Position - targetRoot.Position).Magnitude
                    if distance < 300 then
                        table.insert(valid, {char = char, head = targetHead, dist = distance})
                    end
                end
            end
            table.sort(valid, function(a, b) return a.dist < b.dist end)

            local visCache = {}
            local function isVisible(t)
                local v = visCache[t]
                if v == nil then
                    local dir = t.head.Position - myRoot.Position
                    local rayResult = Workspace:Raycast(myRoot.Position, dir.Unit * (dir.Magnitude + 1), rayParams)
                    v = (rayResult and rayResult.Instance and rayResult.Instance:IsDescendantOf(t.char)) and true or false
                    visCache[t] = v
                end
                return v
            end

            -- أقرب هدف ظاهر
            local best = nil
            for _, t in ipairs(valid) do
                if isVisible(t) then best = t break end
            end

            -- الهدف المثبّت حالياً (لو لسا صالح)
            local lock = State.AimLock
            local curT = nil
            if lock then
                for _, t in ipairs(valid) do
                    if t.char == lock.char then curT = t break end
                end
                if not curT then lock = nil; State.AimLock = nil end -- مات / ابتعد / انطفى فلترة
            end

            local target = nil
            if curT then
                if isVisible(curT) then lock.seen = now end
                local lostLong = (now - lock.seen) > LOCK_LOSE_SIGHT
                local holdDone = (now - lock.since) > LOCK_HOLD
                if best and best ~= curT and (lostLong or (holdDone and best.dist < curT.dist * SWITCH_RATIO)) then
                    State.AimLock = {char = best.char, since = now, seen = now}
                    target = best
                elseif lostLong and not best then
                    State.AimLock = nil
                else
                    target = curT
                end
            elseif best then
                State.AimLock = {char = best.char, since = now, seen = now}
                target = best
            end

            if target then
                local targetCFrame = CFrame.new(activeCamera.CFrame.Position, target.head.Position)

                -- كلما زادت aimSmoothSpeed صار الانتقال أسرع، بدون "قفزة" مباشرة.
                local alpha = 1 - math.exp(-aimSmoothSpeed * math.max(dt, 0))
                if State.AimMode == "Instant" then alpha = 1 end -- مفاجئ: ينقفل على الراس فوراً بدون تدرج
                activeCamera.CFrame = activeCamera.CFrame:Lerp(targetCFrame, math.clamp(alpha, 0, 1))
            end
        end
    end)

    -- ====================== 🎯 ايم بوت على اللاعب المحدد (زر تاب 2) ======================
    -- يتبع اللاعب اللي محدده بقائمة تاب 2 بس (بدون فحص فريق أو مسافة). لو مات يوقف ويكمل لما يرجع.
    -- نمط التصويب (سلس / مفاجئ) نفس نمط الايم بوت العادي.
    RunService:BindToRenderStep("SkyAimBotSelected", Enum.RenderPriority.Camera.Value + 2, function(dt)
        if not State.AimSelectedActive then return end

        -- استخدم الكاميرا الحالية كل فريم؛ بعض المابات تستبدل CurrentCamera بعد الموت أو إعادة الظهور.
        local activeCamera = Workspace.CurrentCamera or Camera
        if not activeCamera then return end

        local sp = State.selectedPlayer
        if not sp or sp.Parent ~= Players then return end

        -- أعد قراءة الشخصية وأجزائها باستمرار حتى يرجع التتبع تلقائياً بعد Respawn.
        local char = sp.Character
        if not char or not char:IsDescendantOf(Workspace) then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local head = char:FindFirstChild("Head")
        if not (hum and head and hum.Health > 0) then return end
        if State.AimQuickDead(char, hum) or State.AimDeepDead(char) then return end

        local targetCFrame = CFrame.new(activeCamera.CFrame.Position, head.Position)
        local alpha = 1 - math.exp(-aimSmoothSpeed * math.max(dt, 0))
        if State.AimMode == "Instant" then alpha = 1 end
        activeCamera.CFrame = activeCamera.CFrame:Lerp(targetCFrame, math.clamp(alpha, 0, 1))
    end)

    -- ====================== 👁️ نظام الـ ESP للأصدقاء والأعداء ======================
-- نسخة محسنة للأداء:
-- 1) لا نستخدم Workspace:GetDescendants() كل فريم.
-- 2) تحديث ESP يكون كل 0.20 ثانية بدل RenderStepped.
-- 3) خط الـESP نفسه يتبع الكاميرا تلقائيًا، لذلك لا يحتاج تحديثًا كل فريم.
-- 4) يتم تنظيف العناصر القديمة فقط عند الحاجة.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local ESP = {}

local COLORS = {
    Enemy = Color3.fromRGB(255, 0, 0),
    Friend = Color3.fromRGB(0, 120, 255),
    Bot = Color3.fromRGB(0, 255, 0)
}

local function IsFriend(player)
    if not player or player == LocalPlayer then
        return false
    end

    local ok, result = pcall(function()
        return LocalPlayer:IsFriendsWith(player.UserId)
    end)

    return ok and result
end

local function GetRoot(character)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function GetPlayerESPColor(player)
    if player and player ~= LocalPlayer then
        return IsFriend(player) and COLORS.Friend or COLORS.Enemy
    end
    return COLORS.Enemy
end

-- ✨ ظهور واختفاء ناعم للـ ESP بدل الظهور/الاختفاء المفاجئ
-- (نخزن الدوال داخل State بدل local عشان ما نتعدى حد المتغيرات المحلية في Lua)
State.ESPFadeTime = 0.35

State.SetESPAlpha = function(data, alpha) -- 1 = ظاهر كامل، 0 = مخفي
    if data.Highlight then data.Highlight.OutlineTransparency = 1 - alpha end
    if data.Beam then data.Beam.Transparency = NumberSequence.new(1 - alpha) end
end

State.FadeESP = function(data, target, duration, onDone)
    data.FadeId = (data.FadeId or 0) + 1
    local id = data.FadeId
    local startAlpha = data.Alpha or 0
    task.spawn(function()
        local t0 = os.clock()
        while true do
            if data.FadeId ~= id then return end -- تم إلغاء هذا الأنميشن بأنميشن أحدث
            local k = math.clamp((os.clock() - t0) / duration, 0, 1)
            local eased = k * k * (3 - 2 * k)
            data.Alpha = startAlpha + (target - startAlpha) * eased
            State.SetESPAlpha(data, data.Alpha)
            if k >= 1 then break end
            RunService.Heartbeat:Wait()
        end
        if onDone then onDone() end
    end)
end

State.DestroyESPData = function(character, data)
    if data.Highlight then data.Highlight:Destroy() end
    if data.Attachment then data.Attachment:Destroy() end
    if data.Beam then data.Beam:Destroy() end
    if ESP[character] == data then ESP[character] = nil end
end

-- instant = true عند اختفاء الشخصية فعليًا (ما فيه شي نسوي له أنميشن)
local function RemoveESP(character, instant)
    local data = ESP[character]
    if not data then return end

    if instant then
        data.FadeId = (data.FadeId or 0) + 1
        State.DestroyESPData(character, data)
        return
    end

    if data.Removing then return end
    data.Removing = true
    State.FadeESP(data, 0, State.ESPFadeTime, function()
        if data.Removing then
            State.DestroyESPData(character, data)
        end
    end)
end

local function HideAllESP()
    for character in pairs(ESP) do
        RemoveESP(character)
    end
end

local function CreateESP(character, color)
    if ESP[character] then return end

    local root = GetRoot(character)
    if not root then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "SkyESP"
    highlight.Adornee = character
    highlight.FillTransparency = 1
    highlight.OutlineTransparency = 1
    highlight.OutlineColor = color
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character

    local attachment = Instance.new("Attachment")
    attachment.Name = "SkyESP_Tracer"
    attachment.Parent = root

    local beam = Instance.new("Beam")
    beam.Name = "SkyESP_Line"
    beam.Attachment0 = attachment
    beam.FaceCamera = true
    beam.Width0 = 0.04
    beam.Width1 = 0.04
    beam.Transparency = NumberSequence.new(1)
    beam.Color = ColorSequence.new(color)
    beam.LightEmission = 1
    beam.Segments = 1
    beam.Parent = root

    local data = {
        Root = root,
        Highlight = highlight,
        Attachment = attachment,
        Beam = beam,
        Color = color,
        Alpha = 0
    }
    ESP[character] = data
    State.FadeESP(data, 1, State.ESPFadeTime)
end

local function UpdateESP(character, color)
    local root = GetRoot(character)

    if not root then
        RemoveESP(character, true)
        return
    end

    if not ESP[character] then
        CreateESP(character, color)
    end

    local data = ESP[character]
    if not data then return end

    -- لو كان قاعد يختفي ورجع هدف صالح، نرجعه يظهر بنعومة.
    if data.Removing then
        data.Removing = false
        State.FadeESP(data, 1, State.ESPFadeTime)
    end

    -- لا نعيد إنشاء ColorSequence كل فريم.
    if data.Color ~= color then
        data.Color = color

        if data.Highlight then
            data.Highlight.OutlineColor = color
        end

        if data.Beam then
            data.Beam.Color = ColorSequence.new(color)
        end
    end

    if data.Highlight then
        data.Highlight.Adornee = character
        data.Highlight.Enabled = true
    end

    if data.Beam then
        data.Beam.Enabled = true
    end
end

