            local function pickMove(s, level)
                local moves = legalMoves(s)
                if #moves == 0 then return nil end
                local noise = ({140, 30, 4})[level] or 30
                local bestScore, bestMove = -math.huge, moves[1]
                nodes = 0
                for _, m in ipairs(moves) do
                    local score = -search(applyMove(s, m), level - 1, -math.huge, math.huge)
                    score = score + math.random() * noise
                    if score > bestScore then bestScore = score; bestMove = m end
                end
                return bestMove
            end

            return {
