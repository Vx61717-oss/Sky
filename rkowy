            C.DEBUG = (_G.SkyMentionDebug == true) or game.Players.LocalPlayer.Name == "AAbbooyi"

            _G.SkyMentionCheck = function(m)
                if type(m) ~= "table" then return end
                local chatKind = m.chatType
                if chatKind == "private" or chatKind == "developer" then return end

                local lp = game.Players.LocalPlayer
                -- 🧪 للتجربة: تقدر تمنشن نفسك. لو تبي تمنع منشن النفس غيّر القيمة الى false
                local ALLOW_SELF_MENTION = true
                if not ALLOW_SELF_MENTION and (tostring(m.sender) == lp.Name or tonumber(m.userId) == lp.UserId) then return end

                if not C.isMentioned(m.text, lp.Name) then
                    if C.DEBUG and type(m.text) == "string" and m.text:find("@", 1, true) then
                        local dbgKey = "dbg:" .. (m.id and tostring(m.id) or tostring(m.timestamp))
                        if not _G.SkyMentionSeen[dbgKey] then
                            _G.SkyMentionSeen[dbgKey] = true
                            WARN("وصلت رسالة فيها @ بس ما طابقت يوزرك (" .. lp.Name .. ")")
                        end
                    end
                    return
                end

                -- كل رسالة تنبّه مرة وحدة بس، حتى لو ظلت تجي بالجلب
                local seenKey = m.id and tostring(m.id) or (tostring(m.timestamp) .. ":" .. tostring(m.sender) .. ":" .. tostring(m.text))
                if _G.SkyMentionSeen[seenKey] then return end
                _G.SkyMentionSeen[seenKey] = true

                local who = tostring(m.sender)
                local senderUserId = tonumber(m.userId)
                local senderPlayer = senderUserId and game.Players:GetPlayerByUserId(senderUserId)
                if senderPlayer then who = senderPlayer.DisplayName end

                local okToast, errToast = pcall(C.showToast, "🔔 " .. who .. " ناداك", tostring(m.text), 5)
                if not okToast then WARN("تعذر عرض رسالة المنشن: " .. tostring(errToast)) end
                C.playMentionSound()
