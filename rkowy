    local heights = {}
    for i = 1, EQ_COUNT do
        local x = (i - 0.5) / EQ_COUNT
        local h = 0.38
            + 0.28 * math.exp(-((x - 0.17) / 0.08) ^ 2)
            + 0.30 * math.exp(-((x - 0.80) / 0.08) ^ 2)
            + 0.05 * math.sin(i * 1.7)
        heights[i] = math.clamp(h, 0.2, 1)
    end

    local function NewEqSlider(txt, min, max, call, parent, startVal)
        startVal = startVal or min

        local f = Instance.new("Frame", parent)
        f.Size = UDim2.new(1, -10, 0, 130)
