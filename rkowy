                                end
                            end
                        end
                    end
                    -- البلوكات المجاورة (عند الأطراف)
                    for i = ci - 1, ci + 1 do
                        local row = blocks[i]
                        if row then
                            for j = cj - 1, cj + 1 do
                                local lst = row[j]
                                if lst and (i ~= ci or j ~= cj) then
                                    for _, b in ipairs(lst) do
