                local function startWave()
                    wave = wave + 1
                    bossIdx = nil
                    for k, bw in ipairs(BOSS_WAVES) do
                        if bw == wave then bossIdx = k end
                    end
                    local base = math.floor((2 + wave) * st.cntMul + 0.5)
                    if bossIdx then base = math.max(2, math.floor(base * 0.5)) end
                    spawnLeft = base + (bossIdx and 1 or 0)
                    bossPending = bossIdx ~= nil
                    spawnTimer, burstLeft, breakTimer = 0, 0, 5
                    if bossIdx then
                        showMsg("👑 موجة البوس " .. bossIdx .. "/" .. #BOSS_WAVES .. " !", Color3.fromRGB(255, 215, 80))
                    else
                        showMsg("الموجة " .. wave .. " 🔥")
                    end
                    saveRun()
                end

