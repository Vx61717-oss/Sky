        -- 🛡️ منع الزحلقة: يثبّت الفيزياء ويوقف الانزلاق
        local slipConn
        local function restorePhysics()
            local ch = LocalPlayer.Character
            if ch then
                for _, part in ipairs(ch:GetChildren()) do
                    if part:IsA("BasePart") then
                        pcall(function() part.CustomPhysicalProperties = nil end)
                    end
                end
            end
        end
        local function stopSlip()
            if slipConn then slipConn:Disconnect() slipConn = nil end
            restorePhysics()
        end
        local function startSlip()
            stopSlip()
            slipConn = RunService.RenderStepped:Connect(function()
                local ch = LocalPlayer.Character
                local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                local root = ch and ch:FindFirstChild("HumanoidRootPart")
                if not hum or not root or hum.Health <= 0 then return end
                for _, part in ipairs(ch:GetChildren()) do
                    if part:IsA("BasePart") then
                        pcall(function()
                            part.CustomPhysicalProperties = PhysicalProperties.new(100, 10, 1, 0, 0)
                        end)
                    end
                end
                local vy = root.AssemblyLinearVelocity.Y
                if hum.MoveDirection.Magnitude == 0 then
                    root.AssemblyLinearVelocity = Vector3.new(0, vy, 0)
                else
                    local v = hum.MoveDirection * hum.WalkSpeed
                    root.AssemblyLinearVelocity = Vector3.new(v.X, vy, v.Z)
                end
            end)
        end

        -- ⏱️ تخطي المؤقتات: يصفّر مدة الضغط المطوّل (ProximityPrompt) وقيم الكولداون/التايمر
        local bypassGen = 0
        local bypassOrig = setmetatable({}, {__mode = "k"})
        local function stopBypass()
            bypassGen = bypassGen + 1
            for obj, old in pairs(bypassOrig) do
                pcall(function()
                    if obj.Parent then
                        if obj:IsA("ProximityPrompt") then obj.HoldDuration = old else obj.Value = old end
                    end
                end)
            end
            table.clear(bypassOrig)
        end
        local function startBypass()
            stopBypass()
            local gen = bypassGen
            task.spawn(function()
                while bypassGen == gen do
                    pcall(function()
                        for _, obj in ipairs(workspace:GetDescendants()) do
                            if obj:IsA("ProximityPrompt") then
                                if obj.HoldDuration ~= 0 then
                                    if bypassOrig[obj] == nil then bypassOrig[obj] = obj.HoldDuration end
                                    obj.HoldDuration = 0
                                end
                            elseif obj:IsA("NumberValue") or obj:IsA("IntValue") then
                                local n = obj.Name:lower()
                                if (n:find("cooldown") or n:find("timer") or n:find("time")) and obj.Value ~= 0 then
                                    if bypassOrig[obj] == nil then bypassOrig[obj] = obj.Value end
                                    obj.Value = 0
                                end
                            end
                        end
                    end)
                    task.wait(0.5)
                end
            end)
        end

