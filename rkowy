                    request({Url = "https://skyv-1ce1a-default-rtdb.firebaseio.com/chess/online/" .. tostring(lp.UserId) .. ".json?auth=" .. AUTH_TOKEN,
                        Method = "PUT", Headers = {["Content-Type"] = "application/json"},
                        Body = HttpService:JSONEncode({userId=tostring(lp.UserId), name=lp.Name,
                            displayName=lp.DisplayName or lp.Name, updatedAt=os.time()})})
                end)

                -- 🔢 نحسب المتصلين
                local ok, res = pcall(function()
                    return request({Url = ONLINE_URL .. "?auth=" .. AUTH_TOKEN, Method = "GET"})
                end)
                if ok and res and res.Body and res.Body ~= "null" then
                    local okD, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
                    if okD and type(data) == "table" then
                        local newest = 0
                        for _, ts in pairs(data) do
                            if type(ts) == "number" and ts > newest then newest = ts end
                        end
                        local count, stale = 0, {}
                        for name, ts in pairs(data) do
                            if type(ts) == "number" then
                                if newest - ts <= ALIVE_MS then
                                    count = count + 1
                                elseif newest - ts > PRUNE_MS then
                                    table.insert(stale, HttpService:JSONEncode(name) .. ":null")
                                end
                            end
                        end
                        if UI.OnlineLabel and UI.OnlineLabel.Parent then
                            UI.OnlineLabel.Text = "👥 " .. tostring(count)
                        end
                        -- 🧹 تنظيف الأسماء القديمة بطلب واحد
                        if #stale > 0 then
                            pcall(function()
                                request({
                                    Url = ONLINE_URL .. "?auth=" .. AUTH_TOKEN,
                                    Method = "PATCH",
                                    Headers = {["Content-Type"] = "application/json"},
                                    Body = "{" .. table.concat(stale, ",") .. "}"
                                })
