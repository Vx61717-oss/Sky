        ui.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                local delta = input.Position - dragStart
                local wanted = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )

                -- احسب حدود النافذة من حجم الحاوية، حتى لا تخرج عن الشاشة.
                local parent = ui.Parent
                local camera = workspace.CurrentCamera
                local parentSize
                if parent and parent:IsA("GuiObject") then
                    parentSize = parent.AbsoluteSize
                else
                    parentSize = camera and camera.ViewportSize or ScreenGui.AbsoluteSize
                end

                local size = ui.AbsoluteSize
                local anchor = ui.AnchorPoint
                local anchorX = parentSize.X * wanted.X.Scale + wanted.X.Offset
                local anchorY = parentSize.Y * wanted.Y.Scale + wanted.Y.Offset
                local left = anchorX - size.X * anchor.X
                local top = anchorY - size.Y * anchor.Y
                left = math.clamp(left, 0, math.max(0, parentSize.X - size.X))
                top = math.clamp(top, 0, math.max(0, parentSize.Y - size.Y))

                local boundedAnchorX = left + size.X * anchor.X
                local boundedAnchorY = top + size.Y * anchor.Y
                ui.Position = UDim2.new(
                    wanted.X.Scale, boundedAnchorX - parentSize.X * wanted.X.Scale,
                    wanted.Y.Scale, boundedAnchorY - parentSize.Y * wanted.Y.Scale
                )
            end
        end)
    end

