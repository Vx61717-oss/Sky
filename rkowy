local SkyPerformanceMode = false
local SkySavedGradients = {}
local SkySavedEffects = {}
local function SkyEnablePerformanceMode()
    if SkyPerformanceMode then return end
    SkyPerformanceMode = true
    -- حفظ مؤثرات الـGlow ثم فصلها مؤقتًا حتى يمكن إعادتها لاحقًا.
    for _, item in ipairs(game.CoreGui:GetDescendants()) do
        if item:IsA("UIGradient") then
            table.insert(SkySavedGradients, {item = item, parent = item.Parent})
            item.Parent = nil
        end
    end
    -- إيقاف المؤثرات البصرية الثقيلة الموجودة في واجهات السكربت فقط.
    for _, item in ipairs(game.CoreGui:GetDescendants()) do
        if item:IsA("ParticleEmitter") or item:IsA("Trail") or item:IsA("Beam") then
            table.insert(SkySavedEffects, {item = item, enabled = item.Enabled})
            item.Enabled = false
        end
    end
end

local function SkyRestorePerformanceMode()
    if not SkyPerformanceMode then return end
    for _, data in ipairs(SkySavedGradients) do
        if data.item and data.parent and data.parent.Parent then
            data.item.Parent = data.parent
        end
    end
    for _, data in ipairs(SkySavedEffects) do
        if data.item and data.item.Parent then
            data.item.Enabled = data.enabled
        end
    end
    SkySavedGradients = {}
    SkySavedEffects = {}
    SkyPerformanceMode = false
end

_G.SkyEnablePerformanceMode = SkyEnablePerformanceMode
_G.SkyRestorePerformanceMode = SkyRestorePerformanceMode

