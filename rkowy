    -- 🌫️ تلاشي تدريجي للقائمة (دوال مخزّنة داخل State عشان ما نزيد متغيرات محلية)
    State._FadeSaved = setmetatable({}, {__mode = "k"})
    State._FadeProps = function(obj)
        if obj:IsA("TextButton") or obj:IsA("TextLabel") or obj:IsA("TextBox") then
            return {"BackgroundTransparency", "TextTransparency"}
        elseif obj:IsA("ScrollingFrame") then
            return {"BackgroundTransparency", "ScrollBarImageTransparency"}
        elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            return {"BackgroundTransparency", "ImageTransparency"}
        elseif obj:IsA("Frame") then
            return {"BackgroundTransparency"}
        elseif obj:IsA("UIStroke") then
            return {"Transparency"}
        end
        return nil
    end
    -- هل العنصر ظاهر فعلاً داخل القائمة (هو وكل آبائه)
    State._FadeShown = function(obj)
        local cur = obj
        while cur and cur ~= UI.MainFrame do
            if cur:IsA("GuiObject") and not cur.Visible then return false end
            cur = cur.Parent
        end
        return cur == UI.MainFrame
    end
    State._FadeList = function()
        local list = {}
        local function add(obj)
            if State._FadeProps(obj) and State._FadeShown(obj) then
                table.insert(list, obj)
            end
        end
        add(UI.MainFrame)
        for _, d in ipairs(UI.MainFrame:GetDescendants()) do add(d) end
        return list
    end
    -- يخفي العناصر الظاهرة شوي شوي (ويحفظ قيمها الأصلية)
    State._FadeOut = function(duration)
        local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        for _, obj in ipairs(State._FadeList()) do
            local saved, goal = {}, {}
            for _, p in ipairs(State._FadeProps(obj)) do
                saved[p] = obj[p]
                goal[p] = 1
            end
            State._FadeSaved[obj] = saved
            SkyTw(obj, info, goal):Play()
        end
    end
    -- يظهر العناصر الظاهرة شوي شوي (بعد ما تنضبط Visible)
    State._FadeIn = function(duration)
        local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        for _, obj in ipairs(State._FadeList()) do
            local props = State._FadeProps(obj)
            local saved = State._FadeSaved[obj]
            if not saved then
                saved = {}
                for _, p in ipairs(props) do saved[p] = obj[p] end
                State._FadeSaved[obj] = saved
            end
            local goal = {}
            for _, p in ipairs(props) do
                goal[p] = saved[p]
                obj[p] = 1
            end
            SkyTw(obj, info, goal):Play()
        end
    end

