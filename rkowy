        SkyAI.attachFile = function(path)
            local content
            pcall(function()
                if type(readfile) ~= "function" then return end
                if type(isfile) == "function" and not isfile(path) then return end
                content = readfile(path)
            end)
            local base = tostring(path):gsub("^.*[/\\]", "")
            if type(content) ~= "string" or content:gsub("%s+", "") == "" then
                pcall(Notify, "📂 الملفات", "ما قدرت أقرأ الملف " .. base, Color3.fromRGB(255, 170, 70), true)
                return false
            end
            if #content > 9000 then
                pcall(Notify, "📂 الملفات", base .. " كبير (" .. #content .. " حرف)، الحد حوالي 9000", Color3.fromRGB(255, 170, 70), true)
                return false
            end
            return SkyAI.attachCode(base, content, path)
        end

