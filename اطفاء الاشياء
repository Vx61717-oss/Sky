    local function triggerStruggle()
        local currentTime = tick()
        if currentTime - lastTriggerTick >= cooldown then
            lastTriggerTick = currentTime
            pcall(function()
                local events = game:GetService("ReplicatedStorage"):FindFirstChild("CharacterEvents")
                local struggle = events and events:FindFirstChild("Struggle")
                if struggle then struggle:FireServer() end
            end)
        end
