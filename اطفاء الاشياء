    local function executePerfectBomb(targetPlayer)
        local spawnRemote = game:GetService("ReplicatedStorage"):WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
        local explodeRemote = game:GetService("ReplicatedStorage"):WaitForChild("BombEvents"):WaitForChild("BombExplode")
