    local Corner = Instance.new("UICorner", I)
    Corner.CornerRadius = UDim.new(0, 12)
    
    local Stroke = Instance.new("UIStroke", I)
    Stroke.Color = C
    Stroke.Thickness = 2
    Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    -- شريط لون رفيع على الجنب يميز نوع الإشعار
