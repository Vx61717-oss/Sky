            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            
            if humanoid and rootPart then
                -- Anti-Fling Logic
                if State.AntiFlingActive then
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character then
                            for _, part in pairs(p.Character:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    part.CanCollide = false
                                    part.Velocity = Vector3.new(0, 0, 0)
                                    part.RotVelocity = Vector3.new(0, 0, 0)
                                end
                            end
                        end
                    end
                end

                if State.speedActive then
                    humanoid.WalkSpeed = State.targetSpeed
                    if humanoid.MoveDirection.Magnitude > 0 then
                        rootPart.CFrame = rootPart.CFrame + (humanoid.MoveDirection * (State.targetSpeed * 0.168))
                    end
                end

                -- ما نلمس النط إطلاقاً إلا لو غيّرته بنفسك، عشان يبقى نط الماب طبيعي دايم
                if State.jumpActive then
                    if not humanoid.UseJumpPower then
                        humanoid.UseJumpPower = true -- 🔥 بدونها R6 يتجاهل JumpPower ويستخدم JumpHeight
                    end

                    if humanoid.JumpPower ~= State.desiredJumpPower then
                        humanoid.JumpPower = State.desiredJumpPower
                    end
                end
            end
        end
    end)

    -- ====================== Delta Fly System ======================
    local function ToggleFly()
        State.flying = not State.flying
        local character = LocalPlayer.Character
        if not character then return end
        local root = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid then return end

        if State.flying then
            humanoid.PlatformStand = true
            State.bv = Instance.new("BodyVelocity")
            State.bg = Instance.new("BodyGyro")
            State.bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            State.bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
            State.bv.Parent = root
            State.bg.Parent = root

            local PlayerScripts = LocalPlayer:WaitForChild("PlayerScripts")
            local ControlModule = require(PlayerScripts:WaitForChild("PlayerModule")):GetControls()

            RunService.RenderStepped:Connect(function()
                if not State.flying then return end
                State.bg.CFrame = Camera.CFrame
                local moveVector = ControlModule:GetMoveVector()
                local camCF = Camera.CFrame
                local direction = (camCF.LookVector * -moveVector.Z) + (camCF.RightVector * moveVector.X)
                State.bv.Velocity = moveVector.Magnitude > 0 and direction * State.flySpeed or Vector3.new(0, 0, 0)
            end)
        else
            humanoid.PlatformStand = false
            if State.bv then State.bv:Destroy() State.bv = nil end
            if State.bg then State.bg:Destroy() State.bg = nil end
        end
    end

