-- 🔊 نظام صوت اللعبة (منفصل تماماً عن موسيقى القائمة)
-- ═══════════════════════════════════════════════════════════════════
local gameVolume = 1

local _ownSounds = {
    [clickSound] = true,
    [okSound] = true,
    [warnSound] = true,

    [Music] = true,
    [Music2] = true,
    [Music3] = true,
    [Music4] = true,
    [Music5] = true,
    [Music6] = true,
    [Music7] = true,
    [Music8] = true
}

local _trackedVolumes = {}

local function _isOwnSound(snd)
    return snd and _ownSounds[snd] == true
end

local function _registerGameSound(snd)
    if not snd or not snd:IsA("Sound") then return end
    if _isOwnSound(snd) then return end

    if _trackedVolumes[snd] == nil then
        _trackedVolumes[snd] = snd.Volume
    end

    snd.Volume = _trackedVolumes[snd] * gameVolume
end

local function _applyGameVolume()
    for snd, originalVolume in pairs(_trackedVolumes) do
        if snd and snd.Parent then
            if not _isOwnSound(snd) then
                snd.Volume = originalVolume * gameVolume
            end
        else
            _trackedVolumes[snd] = nil
        end
    end
end

function SetGameVolume(v)
    gameVolume = math.clamp(v, 0, 1)
    _applyGameVolume()
end

-- تسجيل أصوات اللعبة الموجودة حاليًا
for _, d in ipairs(game:GetDescendants()) do
    if d:IsA("Sound") then
        _registerGameSound(d)
    end
end

-- تسجيل أي صوت جديد يدخل اللعبة
game.DescendantAdded:Connect(function(d)
    if d:IsA("Sound") then
        task.defer(function()
            _registerGameSound(d)
        end)
    end
end)

