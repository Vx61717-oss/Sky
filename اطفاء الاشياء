        F:TweenSize(UDim2.new(1, 0, 0, 0), "In", "Quad", 0.15, true)
        task.wait(0.2)
        if _currentNotification == F then _currentNotification = nil end
        if F.Parent then F:Destroy() end
        end)
    end)
end

