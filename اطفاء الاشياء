-- 🎯 منطقة التدوير + الـ FOV + التعرف على الضغطات (يمين الشاشة)
local lookZone = Instance.new("Frame", gui)
lookZone.Size = UDim2.new(0.5, 0, 1, 0)
lookZone.Position = UDim2.new(0.5, 0, 0, 0)
lookZone.BackgroundTransparency = 1

lookZone.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch and freeCamActive then
        table.insert(activeTouches, input)
        
        if #activeTouches == 1 then
            lookTouch = input
            lastLookPos = input.Position
            
            local currentTime = os.clock()
            if currentTime - lastTapTime < tapTimeout then
                tapCount = tapCount + 1
            else
                tapCount = 1
            end
            lastTapTime = currentTime
            
            task.delay(tapTimeout, function()
                if os.clock() - lastTapTime >= tapTimeout then
                    if tapCount == 2 then
                        currentSpeed = currentSpeed + 20
                        showSpeedAnimation(currentSpeed) 
                    elseif tapCount == 3 then
                        currentSpeed = defaultSpeed
                        showSpeedAnimation(currentSpeed) 
                    end
                    tapCount = 0 
                end
            end)
            
        elseif #activeTouches == 2 then
            lookTouch = nil
            startPinchDistance = getDistanceBetweenTouches()
            startFOV = currentTargetFOV
        end
    end
end)

lookZone.InputChanged:Connect(function(input)
    if not freeCamActive then return end
    
    if #activeTouches == 2 and startPinchDistance and startFOV then
        local currentDistance = getDistanceBetweenTouches()
        if currentDistance then
            local ratio = startPinchDistance / currentDistance
            currentTargetFOV = math.clamp(startFOV * ratio, minFOV, maxFOV)
        end
    elseif input == lookTouch and lastLookPos then
        local currentPos = input.Position
        local deltaX = currentPos.X - lastLookPos.X
        local deltaY = currentPos.Y - lastLookPos.Y
        
        local sensitivity = 0.25 
        
        targetYaw = targetYaw - (deltaX * sensitivity)
        targetPitch = targetPitch - (deltaY * sensitivity)
        targetPitch = math.clamp(targetPitch, -85, 85)
        
        lastLookPos = currentPos
    end
end)

lookZone.InputEnded:Connect(function(input)
    for i, touch in ipairs(activeTouches) do
        if touch == input then
            table.remove(activeTouches, i)
            break
        end
    end
    
    if #activeTouches < 2 then
        startPinchDistance = nil
        startFOV = nil
    end
    
    if input == lookTouch then
        lookTouch = nil
        lastLookPos = nil
    end
    
    if #activeTouches == 1 then
        lookTouch = activeTouches[1]
        lastLookPos = lookTouch.Position
    end
end)
    

