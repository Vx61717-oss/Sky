-- 🛡️ ميزة جلب الجميع (Mass Bring) - نسخة آمنة ضد الباند
local function ToggleBringAll(state)
    State.BringAllRunning = state
    if state then
        task.spawn(function()
            while State.BringAllRunning do
                local Character = LocalPlayer.Character
                local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
                if RootPart then
                    local originalCFrame = RootPart.CFrame
                    local players = Players:GetPlayers()
                    
                    for i, player in ipairs(players) do
                        if not State.BringAllRunning then break end
                        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                            local targetRoot = player.Character.HumanoidRootPart
                            
                            -- 1. الانتقال فوق اللاعب (بمسافة آمنة قليلاً)
                            RootPart.CFrame = targetRoot.CFrame + Vector3.new(0, 5, 0)
                            task.wait(0.2) -- انتظار أطول لتجنب كشف الانتقال
                            
                            -- 2. تفعيل المسك (مع pcall للحماية)
                            pcall(function()
                                ReplicatedStorage.GrabEvents.SetNetworkOwner:FireServer(targetRoot, targetRoot.CFrame)
                                task.wait(0.05)
                                ReplicatedStorage.GrabEvents.ExtendGrabLine:FireServer(9.394556045532227)
                            end)
                            
                            task.wait(0.2) -- انتظار قبل العودة

                            -- 3. الرجوع للمكان الأصلي
                            RootPart.CFrame = originalCFrame
                            if targetRoot then
                                targetRoot.CFrame = originalCFrame + Vector3.new(0, 3, 0)
                            end
                            
                            -- 4. فاصل زمني بين كل لاعب وآخر (مهم جداً ضد الباند)
                            task.wait(0.8) 
                        end
                    end
                end
                -- فاصل زمني كبير بعد الانتهاء من جميع اللاعبين قبل البدء مرة أخرى
                task.wait(3) 
            end
        end)
        OK("🛡️ تم تفعيل جلب الجميع (الوضع الآمن)")
    else
        OK("⏸️ تم إيقاف جلب الجميع")
    end
end


