        local myRoot = LocalPlayer.Character and (LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character:FindFirstChild("Torso"))
        if not myRoot or not targetPlayer or not targetPlayer.Character then return end
        local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart") or targetPlayer.Character:FindFirstChild("Torso")
        if not targetRoot then return end

        local folderName = LocalPlayer.Name .. "SpawnedInToys"
        local toyFolder = workspace:FindFirstChild(folderName)
        if toyFolder then
            for _, obj in pairs(toyFolder:GetChildren()) do
                if obj.Name == "BombMissile" then obj:Destroy() end
            end
        end

        local myHeadCF = myRoot.CFrame * CFrame.new(0, 7.5, 0)
        spawnRemote:InvokeServer("BombMissile", myHeadCF, Vector3.new(0, 0, 0))
        toyFolder = workspace:WaitForChild(folderName, 2)
        if not toyFolder then return end
        local bombModel = toyFolder:WaitForChild("BombMissile", 2)
        if not bombModel then return end

        local buttonPart = bombModel:WaitForChild("Button", 2)
        local hitDetector = bombModel:WaitForChild("PartHitDetector", 2)
        local bodyPart = bombModel:WaitForChild("Body", 2)

        for _, part in pairs(bombModel:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
                part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
        end

        for i = 1, 6 do
            if not State.BombRunning or not myRoot or not myRoot.Parent then return end
            local stickCF = myRoot.CFrame * CFrame.new(0, 7.5, 0)
            if bombModel:IsA("Model") then bombModel:PivotTo(stickCF) end
            for _, part in pairs(bombModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CFrame = stickCF
                    part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end
            end
            task.wait(0.1)
        end

        if not State.BombRunning then return end
        if buttonPart then
            networkRemote:FireServer(buttonPart, buttonPart.CFrame)
            task.wait(0.05)
            local clickDetector = buttonPart:FindFirstChildWhichIsA("ClickDetector")
            if clickDetector and fireclickdetector then fireclickdetector(clickDetector) end
        end
        task.wait(0.15)
        for _, part in pairs(bombModel:GetDescendants()) do
            if part:IsA("BasePart") then part.CustomPhysicalProperties = nil end
        end
        for i = 1, 3 do
            if not State.BombRunning or not targetRoot or not targetRoot.Parent then return end
            local trackingCF = CFrame.new(targetRoot.Position + Vector3.new(0, 3, 0))
            if bombModel:IsA("Model") then bombModel:PivotTo(trackingCF) end
            for _, part in pairs(bombModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CFrame = trackingCF
                    part.AssemblyLinearVelocity = Vector3.new(0, -10, 0)
                    part.AssemblyAngularVelocity = Vector3.new(5, 5, 5)
                end
            end
            task.wait(0.1)
        end
        if not State.BombRunning or not targetRoot or not targetRoot.Parent then return end
        local finalPosition = targetRoot.Position
        if hitDetector and bodyPart then
            local explodeArgs = {
                [1] = {
                    ["Radius"] = 35, ["TimeLength"] = 0.5, ["Hitbox"] = hitDetector, ["ExplodesByFire"] = true,
                    ["MaxForcePerStudSquared"] = 500, ["DestroysModel"] = true, ["Model"] = bombModel,
                    ["ExplodesByPointy"] = false, ["ImpactSpeed"] = 20, ["PositionPart"] = bodyPart
                },
                [2] = finalPosition
            }
            explodeRemote:FireServer(unpack(explodeArgs))
        end
    end


local LocalPlayer = Players.LocalPlayer
local ESP = {}

local COLORS = {
    Enemy = Color3.fromRGB(255, 0, 0),
    Friend = Color3.fromRGB(0, 120, 255),
    Bot = Color3.fromRGB(0, 255, 0)
}

local function IsFriend(player)
    if not player or player == LocalPlayer then
        return false
    end

    local ok, result = pcall(function()
        return LocalPlayer:IsFriendsWith(player.UserId)
    end)

    return ok and result
end

local function GetRoot(character)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function GetPlayerESPColor(player)
    if player and player ~= LocalPlayer then
        return IsFriend(player) and COLORS.Friend or COLORS.Enemy
    end
    return COLORS.Enemy
end

local function RemoveESP(character)
    local data = ESP[character]
    if not data then return end

    if data.Highlight then data.Highlight:Destroy() end
    if data.Attachment then data.Attachment:Destroy() end
    if data.Beam then data.Beam:Destroy() end

    ESP[character] = nil
end

local function HideAllESP()
    for character in pairs(ESP) do
        RemoveESP(character)
    end
end

local function CreateESP(character, color)
    if ESP[character] then return end

    local root = GetRoot(character)
    if not root then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "SkyESP"
    highlight.Adornee = character
    highlight.FillTransparency = 1
    highlight.OutlineTransparency = 0
    highlight.OutlineColor = color
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character

    local attachment = Instance.new("Attachment")
    attachment.Name = "SkyESP_Tracer"
    attachment.Parent = root

    local beam = Instance.new("Beam")
    beam.Name = "SkyESP_Line"
    beam.Attachment0 = attachment
    beam.FaceCamera = true
    beam.Width0 = 0.04
    beam.Width1 = 0.04
    beam.Transparency = NumberSequence.new(0)
    beam.Color = ColorSequence.new(color)
    beam.LightEmission = 1
    beam.Segments = 1
    beam.Parent = root

    ESP[character] = {
        Root = root,
        Highlight = highlight,
        Attachment = attachment,
        Beam = beam,
        Color = color
    }
end

local function UpdateESP(character, color)
    local root = GetRoot(character)

    if not root then
        RemoveESP(character)
        return
    end

    if not ESP[character] then
        CreateESP(character, color)
    end

    local data = ESP[character]
    if not data then return end

    -- لا نعيد إنشاء ColorSequence كل فريم.
    if data.Color ~= color then
        data.Color = color

        if data.Highlight then
            data.Highlight.OutlineColor = color
        end

        if data.Beam then
            data.Beam.Color = ColorSequence.new(color)
        end
    end

    if data.Highlight then
        data.Highlight.Adornee = character
        data.Highlight.Enabled = true
    end

    if data.Beam then
        data.Beam.Enabled = true
    end
end

