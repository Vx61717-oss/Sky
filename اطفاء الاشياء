    RunService.RenderStepped:Connect(function()
        if not State.AntiGrabActive then 
            locked = false
            lockedCFrame = nil
            return 
        end
        local character = LocalPlayer.Character
        if not character then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not rootPart then return end
        local velocity = rootPart.AssemblyLinearVelocity
        local verticalVelocity = velocity.Y
        local isRestrained = humanoid.PlatformStand or humanoid.Sit
        local isFlyingUp = verticalVelocity > 75
        local isStopped = velocity.Magnitude < 1 and humanoid.MoveDirection.Magnitude <= 0
        local isGrabbed = isStopped and (isRestrained or rootPart.Anchored)
        local shouldLock = isRestrained or isFlyingUp or isGrabbed
        if shouldLock then
            if not locked then
                locked = true
                lockedCFrame = rootPart.CFrame
                rootPart.AssemblyLinearVelocity = Vector3.zero
                rootPart.AssemblyAngularVelocity = Vector3.zero
            end
            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            if lockedCFrame then rootPart.CFrame = lockedCFrame end
            triggerStruggle()
        else
            if locked then
                locked = false
                lockedCFrame = nil
            end
        end
    end)

