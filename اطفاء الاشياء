    F.Size = UDim2.new(1, 0, 0, 0)
    F.BackgroundTransparency = 1
    
    local I = Instance.new("Frame", F)
    I.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    I.BorderSizePixel = 0
    I.Size = UDim2.new(1, 0, 0, 0)
