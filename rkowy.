        local track = popupTracks[current]
        if not track then return end
        if track.IsPlaying then track:Pause() else track:Play() end
        playPause.Text = track.IsPlaying and "⏸" or "▶"
    end)
    local barUIS = game:GetService("UserInputService")
    local barDragging = false
    local function seekFromX(x)
        local track = popupTracks[current]
        if not track or not track.IsLoaded or track.TimeLength <= 0 then return end
        local ratio = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        track.TimePosition = ratio * track.TimeLength
        fill.Size = UDim2.new(ratio, 0, 1, 0)
    end
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            barDragging = true
            seekFromX(input.Position.X)
        end
    end)
    barUIS.InputChanged:Connect(function(input)
        if barDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            seekFromX(input.Position.X)
        end
    end)
    barUIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            barDragging = false
        end
    end)
    task.spawn(function()
        while panel.Parent do
            task.wait(0.2)
            local track = popupTracks[current]
            if track then
                local length = track.TimeLength or 0
                local pos = track.TimePosition or 0
                if not barDragging then
                    fill.Size = UDim2.new(length > 0 and math.clamp(pos / length, 0, 1) or 0, 0, 1, 0)
                end
                local function fmt(n) n = math.floor(n); return string.format("%02d:%02d", math.floor(n/60), n%60) end
                timeText.Text = fmt(pos) .. "  /  " .. fmt(length)
                playPause.Text = track.IsPlaying and "⏸" or "▶"
            end
        end
    end)
