        -- أقرب اصطدام للضارب بمسار مستقيم
        local function rayCast(sx, sy, dx, dy)
            local best, hit = 1400, nil
            for _, p in ipairs(pieces) do
                if p.alive then
                    local fx, fy = p.x - sx, p.y - sy
                    local proj = fx * dx + fy * dy
                    if proj > 0 then
                        local perp2 = fx * fx + fy * fy - proj * proj
                        local rr = SR + p.r
                        if perp2 < rr * rr then
                            local t = proj - math.sqrt(rr * rr - perp2)
                            if t >= 0 and t < best then best, hit = t, p end
                        end
                    end
                end
            end
            local tw = best
            if dx > 0.0001 then tw = math.min(tw, (B - SR - sx) / dx) elseif dx < -0.0001 then tw = math.min(tw, (SR - sx) / dx) end
            if dy > 0.0001 then tw = math.min(tw, (B - SR - sy) / dy) elseif dy < -0.0001 then tw = math.min(tw, (SR - sy) / dy) end
            if tw < best then best, hit = tw, nil end
            return math.max(best, 0), hit
        end

