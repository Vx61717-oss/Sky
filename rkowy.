                    ghostStroke.Color = col
                    ghostLabel.Text = c.name
                    ghostRange.Position = UDim2.new(0, x, 0, y)
                    ghostRange.Size = UDim2.new(0, c.range * sc * 2, 0, c.range * sc * 2)
                    ghostRange.BackgroundColor3 = col
                    ghostRangeStroke.Color = col
                    ghost.Visible, ghostRange.Visible = true, true
                    return ok, fx, fy
                end

