        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local studs = myRoot and math.floor((myRoot.Position - root.Position).Magnitude) or 0

        -- كل ما بعد اللاعب يكبر السهم (من 56 لين 100)
        local sz = math.clamp(56 + studs * 0.12, 56, 100)
