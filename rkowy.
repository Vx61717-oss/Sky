            end

            function C.copyValue(value)
                if not value or value == "" then return end
                if setClipboardText then
                    pcall(function() setClipboardText(value) end)
                    C.showToast()
                else
                    WARN("⚠️ برنامج الإكسبلويت حقك ما يدعم setclipboard")
                end
            end

            -- 🔔 منشن: إذا أحد كتب @ ويوزري بالدردشة (عام/أخوياك) تطلع لي رسالة من فوق فيها اسمه ونص رسالته.
            -- يقبل "@sky" و "@ sky"، وما يلتقط "@skyhigh" لأنه يوزر ثاني.
            _G.SkyMentionSeen = _G.SkyMentionSeen or {}

            function C.isMentioned(text, myName)
                if type(text) ~= "string" or type(myName) ~= "string" or myName == "" then return false end
                local escaped = myName:lower():gsub("%W", "%%%0")
                return text:lower():find("@%s*" .. escaped .. "%f[^%w_]") ~= nil
            end

            -- 🔊 صوت المنشن
            function C.playMentionSound()
                pcall(function()
                    local snd = Instance.new("Sound")
                    snd.Name = "SkyMentionSound"
                    snd.SoundId = "rbxassetid://3173566193"
                    snd.Volume = 1
                    snd.Parent = game:GetService("SoundService")
                    snd.Ended:Connect(function() snd:Destroy() end)
                    task.delay(20, function() if snd.Parent then snd:Destroy() end end)
                    snd:Play()
                end)
            end

            -- 🐞 تشخيص: يطلع تنبيه برتقالي لو وصلت رسالة فيها @ ولا طابقت يوزرك (يشتغل للمطور، أو لو حطيت _G.SkyMentionDebug = true)
            C.DEBUG = (_G.SkyMentionDebug == true) or game.Players.LocalPlayer.Name == "AAbbooyi"

            _G.SkyMentionCheck = function(m)
                if type(m) ~= "table" then return end
                local chatKind = m.chatType
                if chatKind == "private" or chatKind == "developer" then return end

                local lp = game.Players.LocalPlayer
                -- 🧪 للتجربة: تقدر تمنشن نفسك. لو تبي تمنع منشن النفس غيّر القيمة الى false
                local ALLOW_SELF_MENTION = true
                if not ALLOW_SELF_MENTION and (tostring(m.sender) == lp.Name or tonumber(m.userId) == lp.UserId) then return end

                if not C.isMentioned(m.text, lp.Name) then
                    if C.DEBUG and type(m.text) == "string" and m.text:find("@", 1, true) then
                        local dbgKey = "dbg:" .. (m.id and tostring(m.id) or tostring(m.timestamp))
                        if not _G.SkyMentionSeen[dbgKey] then
                            _G.SkyMentionSeen[dbgKey] = true
                            WARN("وصلت رسالة فيها @ بس ما طابقت يوزرك (" .. lp.Name .. ")")
                        end
                    end
                    return
                end

                -- كل رسالة تنبّه مرة وحدة بس، حتى لو ظلت تجي بالجلب
                local seenKey = m.id and tostring(m.id) or (tostring(m.timestamp) .. ":" .. tostring(m.sender) .. ":" .. tostring(m.text))
                if _G.SkyMentionSeen[seenKey] then return end
                _G.SkyMentionSeen[seenKey] = true

                local who = tostring(m.sender)
                local senderUserId = tonumber(m.userId)
                local senderPlayer = senderUserId and game.Players:GetPlayerByUserId(senderUserId)
                if senderPlayer then who = senderPlayer.DisplayName end

                local okToast, errToast = pcall(C.showToast, "🔔 " .. who .. " ناداك", tostring(m.text), 5)
                if not okToast then WARN("تعذر عرض رسالة المنشن: " .. tostring(errToast)) end
                C.playMentionSound()
            end

            -- ✍️ إضافة @ تلقائياً عند الإرسال: إذا أول كلمة بالرسالة = يوزر لاعب بالسيرفر، نكتب @ قبله بدالك
            -- مثال: "sky لا هو كيذا"  ←  "@sky لا هو كيذا"
            _G.SkyAutoMention = function(text)
                if type(text) ~= "string" then return text end
                local first, rest = text:match("^%s*([%w_]+)(.*)$")
                if not first or #first < 3 then return text end
                for _, pl in ipairs(game.Players:GetPlayers()) do
                    if pl.Name:lower() == first:lower() then
                        return "@" .. pl.Name .. rest
                    end
                end
                return text
            end

            -- منطقة ضغط شفافة فوق النص (ما تغيّر شكل النافذة)
