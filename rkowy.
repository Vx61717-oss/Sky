                local function drawSnake(positions, n, fwdVec, t, flashRed)
                    local sk = curSkin
                    local hp = positions[1] + Vector3.new(0, 1.5, 0)
                    local fwd = fwdVec.Unit
                    local right = Vector3.new(-fwd.Z, 0, fwd.X)
                    local RED = Color3.fromRGB(255, 70, 70)
                    local yawHead = math.atan2(-fwd.X, -fwd.Z)
                    local hs = (sk.shape == "ball") and 3 or 2.9
                    head.Size = Vector3.new(hs, hs, hs)
                    head.Color = flashRed and RED or skinColor(sk, 1, n, t)
                    if sk.shape == "diamond" then
                        head.CFrame = CFrame.new(hp) * CFrame.Angles(t * 2, yawHead, 0.615)
                    else
                        head.CFrame = CFrame.new(hp) * CFrame.Angles(0, yawHead, 0)
                    end
                    local ey = hp + Vector3.new(0, 0.7, 0) + fwd * 0.8
                    eyeL.CFrame = CFrame.new(ey - right * 0.85)
                    eyeR.CFrame = CFrame.new(ey + right * 0.85)
                    pupL.CFrame = CFrame.new(ey - right * 0.85 + fwd * 0.32 + Vector3.new(0, 0.05, 0))
                    pupR.CFrame = CFrame.new(ey + right * 0.85 + fwd * 0.32 + Vector3.new(0, 0.05, 0))
                    local tongueOn = (math.floor(t * 3) % 2 == 0)
                    tongue.Transparency = tongueOn and 0 or 1
                    tongue.CFrame = CFrame.lookAt(hp + fwd * 2.1 - Vector3.new(0, 0.3, 0), hp + fwd * 3.4 - Vector3.new(0, 0.3, 0))
                    -- إكسسوارات الرأس
                    for _, a in ipairs(accParts) do
                        local sp = a.spec
                        local o = hp + right * sp.off[1] + Vector3.new(0, sp.off[2], 0) + fwd * sp.off[3]
                        if sp.bob then o = o + Vector3.new(0, math.sin(t * 6 + sp.off[1]) * 0.15, 0) end
                        a.part.CFrame = CFrame.new(o)
                    end
                    -- الجسم والمفاصل
                    local isBall = (sk.shape == "ball")
                    for i = 2, n do
                        local seg = bodyBalls[i]
                        if seg then
                            local d = 2.5 - (i - 2) / math.max(1, n - 2) * 0.9
                            if not isBall then d = 2.8 - (i - 2) / math.max(1, n - 2) * 0.7 end
                            seg.Size = Vector3.new(d, d, d)
                            local prev = positions[i - 1]
                            local dv = prev - positions[i]
                            local yaw = (dv.Magnitude > 0.01) and math.atan2(-dv.X, -dv.Z) or 0
                            local base = CFrame.new(positions[i] + Vector3.new(0, d / 2 + 0.1, 0))
                            if sk.shape == "diamond" then
                                seg.CFrame = base * CFrame.Angles(t * 2 + i * 0.3, yaw, 0.615)
                            elseif sk.shape == "block" then
                                seg.CFrame = base * CFrame.Angles(0, yaw, 0)
                            else
                                seg.CFrame = base
                            end
                            seg.Color = flashRed and RED or skinColor(sk, i, n, t)
                        end
                    end
                    if isBall then
                        for i = 1, n - 1 do
                            local j = joints[i]
                            if j then
                                local d = 2.3 - (i - 1) / math.max(1, n - 2) * 0.9
                                local mid = (positions[i] + positions[i + 1]) / 2
                                j.Size = Vector3.new(d, d, d)
                                j.CFrame = CFrame.new(mid + Vector3.new(0, (i == 1 and 1.5 or d / 2 + 0.1), 0))
                                j.Color = flashRed and RED or skinColor(sk, i + 0.5, n, t)
                            end
                        end
                    end
                end

