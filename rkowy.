            -- 🎨 ألوان الدردشة:
            -- أنا = بنفسجي، صديقي = أزرق، الشخص الذي ليس مضافًا عندي = رصاصي.
            local isSenderFriend = (not isMine) and isChatFriend(userId)
            local CHAT_OTHER_GRAY = Color3.fromRGB(145, 145, 155)
            local senderChatColor = isMine and COLOR_MINE or (isSenderFriend and Color3.fromRGB(0, 140, 255) or CHAT_OTHER_GRAY)
            local edgeColor = (isPrivate and not _G.SkyPmRendering) and Color3.fromRGB(255, 50, 55) or senderChatColor
            local AVATAR_SIZE = 28
            local AVATAR_GAP = 6
            local QUOTE_H, QUOTE_GAP = 32, 4
            local QUOTE_OFFSET = (type(replyTo) == "table" and replyTo.text ~= nil and State._Reply) and (QUOTE_H + QUOTE_GAP) or 0
            -- إزاحة رسائلي قليلًا إلى اليسار حتى لا تدخل في الخط أو حافة القائمة.
            local MY_MESSAGE_LEFT_SHIFT = 12
            local FRIEND_MESSAGE_RIGHT_SHIFT = 12

            -- 📦 الصف اللي يحتوي الفقاعة (يمين لكلامي / يسار لكلام خويي)
            local row = Instance.new("Frame")
            row.Name = "MsgRow"
            row.Size = UDim2.new(1, 0, 0, 0)
            row.AutomaticSize = Enum.AutomaticSize.Y
            row.BackgroundTransparency = 1
            row.ZIndex = 8
            row.Parent = chatLog
            row:SetAttribute("IsMine", isMine)
            row:SetAttribute("ChatId", id or "")
            row:SetAttribute("ChatClientId", tostring(clientId or ""))
            row:SetAttribute("ChatTimestamp", tonumber(timestamp) or 0)
            row:SetAttribute("ChatSender", tostring(sender))
            row:SetAttribute("ChatText", tostring(text))
            row:SetAttribute("ChatJobId", tostring(jobId or ""))
            row:SetAttribute("ChatPlaceId", tostring(placeId or game.PlaceId))
            if isMine then
                row:SetAttribute("ReadState", "Unread")
            end

            -- 🖼️ صورة المرسل (تظهر يسار الفقاعة لكلام الغير، ويمينها لكلامك انت)
            local avatarImg
            if userId then
                avatarImg = Instance.new("ImageLabel")
                avatarImg.Name = "SenderAvatar"
                avatarImg.Size = UDim2.new(0, AVATAR_SIZE, 0, AVATAR_SIZE)
                avatarImg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
                avatarImg.BackgroundTransparency = 0
                avatarImg.ImageTransparency = 1 -- يبدأ شفاف عشان الانميشن
                avatarImg.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(userId) .. "&w=150&h=150"
                avatarImg.ZIndex = 9
                avatarImg.Parent = row
                if isMine then
                    avatarImg.AnchorPoint = Vector2.new(1, 0)
                    avatarImg.Position = UDim2.new(1, -(5 + MY_MESSAGE_LEFT_SHIFT), 0, 2 + QUOTE_OFFSET)
                else
                    avatarImg.AnchorPoint = Vector2.new(0, 0)
                    avatarImg.Position = UDim2.new(0, 5 + FRIEND_MESSAGE_RIGHT_SHIFT, 0, 2 + QUOTE_OFFSET)
                end
                Instance.new("UICorner", avatarImg).CornerRadius = UDim.new(1, 0)
                local avStroke = Instance.new("UIStroke", avatarImg)
                avStroke.Thickness = 1.5
                local avatarGlowColor = isMine and COLOR_MINE or (isSenderFriend and Color3.fromRGB(0, 140, 255) or CHAT_OTHER_GRAY)
                avStroke.Color = avatarGlowColor
                avStroke.Transparency = 1
                -- نفس الـGlow: بنفسجي لي وأزرق لخويي
                AddMovingBorderGlow(avStroke, 1.5, avatarGlowColor)
                avatarImg.Active = true
                avatarImg.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        openPlayerInfo(sender, userId, row:GetAttribute("ChatJobId"), row:GetAttribute("ChatPlaceId"))
                    end
                end)
            end

            -- 💬 الفقاعة نفسها: مربعة بحواف دايريه
            local bubble = Instance.new("Frame")
            bubble.Name = "Bubble"
            bubble.BackgroundColor3 = Color3.fromRGB(24, 22, 30)
            bubble.BackgroundTransparency = 1 -- يبدأ شفاف عشان الانميشن
            bubble.BorderSizePixel = 0
            bubble.AutomaticSize = Enum.AutomaticSize.Y
            bubble.Size = UDim2.new(0, math.max(calcBubbleWidth(text), (type(replyTo) == "table") and 150 or 0), 0, 0) -- رسائلي: عرض أدنى يكفي 3 صور + «المزيد»
            bubble.ZIndex = 9
            if sender == "Sky AI" then
                -- فقاعة أعرض شوي لرد الذكاء الاصطناعي عشان الخط العادي ما يتقطع كثير
                bubble.Size = UDim2.new(0, 240, 0, 0)
            end
            bubble.Parent = row

            local corner = Instance.new("UICorner", bubble)
            corner.CornerRadius = UDim.new(0, 14)

            local stroke = Instance.new("UIStroke", bubble)
            stroke.Thickness = 1.5
            local bubbleGlowColor
            if _copyModeActive then
                bubbleGlowColor = Color3.fromRGB(0, 140, 255)
            elseif isPrivate and not _G.SkyPmRendering then
                bubbleGlowColor = Color3.fromRGB(255, 45, 50)
            elseif isMine and _deleteModeActive then
                bubbleGlowColor = Color3.fromRGB(255, 50, 50)
            else
                bubbleGlowColor = isMine and COLOR_MINE or (isSenderFriend and Color3.fromRGB(0, 140, 255) or CHAT_OTHER_GRAY)
            end
            stroke.Color = bubbleGlowColor
            stroke.Transparency = 1 -- يبدأ شفاف عشان الانميشن
            -- نفس Glow المتحرك المستخدم في أزرار السكربت
            AddMovingBorderGlow(stroke, 1.5, bubbleGlowColor)

            local pad = Instance.new("UIPadding", bubble)
            pad.PaddingTop = UDim.new(0, 8)
            pad.PaddingBottom = UDim.new(0, 8)
            pad.PaddingLeft = UDim.new(0, 12)
            pad.PaddingRight = UDim.new(0, 12)

            local bubbleLayout = Instance.new("UIListLayout", bubble)
            bubbleLayout.FillDirection = Enum.FillDirection.Vertical
            bubbleLayout.SortOrder = Enum.SortOrder.LayoutOrder
            bubbleLayout.Padding = UDim.new(0, 2)

            -- 👤 اسم المرسل: لون هادئ حتى ما يخرب شكل الـGlow
            local nameLabel = Instance.new("TextLabel", bubble)
            nameLabel.Name = "SenderName"
            nameLabel.LayoutOrder = 1
            nameLabel.BackgroundTransparency = 1
            nameLabel.Size = UDim2.new(1, 0, 0, 12)
            nameLabel.Text = sender
            nameLabel.TextColor3 = Color3.fromRGB(205, 205, 210)
            nameLabel.TextTransparency = 1 -- يبدأ شفاف عشان الانميشن مثل الباقي
            nameLabel.Font = Enum.Font.Arcade
            nameLabel.TextSize = 9
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            nameLabel.TextStrokeTransparency = 0.65
            nameLabel.ZIndex = 10

            local label = Instance.new("TextLabel", bubble)
            label.Name = "MsgText"
            label.LayoutOrder = 3
            label.BackgroundTransparency = 1
            label.Size = UDim2.new(1, 0, 0, 0)
            label.AutomaticSize = Enum.AutomaticSize.Y
            label.Text = _TranslateText(text)
            label.TextWrapped = true
            label.TextColor3 = Color3.new(1, 1, 1)
            label.TextTransparency = 1 -- يبدأ شفاف عشان الانميشن
            label.Font = Enum.Font.Arcade
            label.TextSize = 14
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.ZIndex = 10
            if sender == "Sky AI" then
                -- خط عادي وواضح لرد الذكاء الاصطناعي (مو بكسلات)
                label.Font = Enum.Font.GothamMedium
                label.TextSize = 15
                nameLabel.Font = Enum.Font.GothamBold
                nameLabel.TextSize = 10
            end


            -- ↩️ اقتباس الرسالة اللي انرد عليها: صورة صاحبها + كلامه فوق نص رسالتي (يبان للكل)
            local replyQuote
            if type(replyTo) == "table" and replyTo.text ~= nil and State._Reply then
                -- 🎨 اللون حسب الشخص المقتبس من وجهة نظر اللي يشوف: أنا = بنفسجي، خويي = أزرق، غيره = رصاصي
                local qUserId = tonumber(replyTo.userId)
                local qBlue = Color3.fromRGB(0, 140, 255)
                local qGray = Color3.fromRGB(145, 145, 155)
                local qColor
                local qIsPurple = false
                if qUserId and qUserId == game.Players.LocalPlayer.UserId then
                    -- المقتبس هو أنا: عندي بنفسجي (وعند غيري يحسبونه حسب صداقتهم معي: أزرق/رصاصي)
                    qColor = Color3.fromRGB(170, 0, 255)
                    qIsPurple = true
                else
                    qColor = (qUserId and isChatFriend(qUserId)) and qBlue or qGray
                end

                replyQuote = {}
                local q = Instance.new("Frame", row)
                q.Name = "ReplyQuote"
                q.Size = UDim2.new(0, bubble.Size.X.Offset, 0, QUOTE_H)
                q.BackgroundColor3 = Color3.fromRGB(24, 22, 30)
                q.BackgroundTransparency = 1
                q.BorderSizePixel = 0
                q.ZIndex = 9
                Instance.new("UICorner", q).CornerRadius = UDim.new(0, 10)
                local qStroke = Instance.new("UIStroke", q)
                qStroke.Thickness = 1.5
                qStroke.Color = qIsPurple and qColor or Color3.new(1, 1, 1) -- أبيض عشان اللون الظاهر = لون التوهج بالضبط
                qStroke.Transparency = 1
                AddMovingBorderGlow(qStroke, 1.5, qColor)
                replyQuote.frame = q
                replyQuote.stroke = qStroke

                local accent = Instance.new("Frame", q)
                accent.Size = UDim2.new(0, 3, 1, -8)
                accent.Position = UDim2.new(0, 4, 0, 4)
                accent.BackgroundColor3 = qIsPurple and Color3.fromRGB(113, 0, 255) or qColor
                accent.BackgroundTransparency = 1
                accent.BorderSizePixel = 0
                accent.ZIndex = 11
                Instance.new("UICorner", accent).CornerRadius = UDim.new(1, 0)
                replyQuote.accent = accent

                local qAvatar = Instance.new("ImageLabel", q)
                qAvatar.Size = UDim2.new(0, 20, 0, 20)
                qAvatar.Position = UDim2.new(0, 11, 0.5, -10)
                qAvatar.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
                qAvatar.ImageTransparency = 1
                qAvatar.BackgroundTransparency = 1
                qAvatar.Image = qUserId and ("rbxthumb://type=AvatarHeadShot&id=" .. tostring(qUserId) .. "&w=150&h=150") or ""
                qAvatar.ZIndex = 11
                Instance.new("UICorner", qAvatar).CornerRadius = UDim.new(1, 0)
                replyQuote.avatar = qAvatar

                local qName = Instance.new("TextLabel", q)
                qName.BackgroundTransparency = 1
                qName.Position = UDim2.new(0, 37, 0, 3)
                qName.Size = UDim2.new(1, -42, 0, 11)
                qName.Font = Enum.Font.Arcade
                qName.TextSize = 10
                qName.TextColor3 = qIsPurple and Color3.fromRGB(113, 0, 255) or qColor
                qName.TextTransparency = 1
                qName.TextXAlignment = Enum.TextXAlignment.Left
                qName.TextTruncate = Enum.TextTruncate.AtEnd
                qName.Text = "↩ " .. tostring(replyTo.sender or "")
                qName.ZIndex = 11
                replyQuote.name = qName

                local qText = Instance.new("TextLabel", q)
                qText.BackgroundTransparency = 1
                qText.Position = UDim2.new(0, 37, 0, 16)
                qText.Size = UDim2.new(1, -42, 0, 13)
                qText.Font = Enum.Font.Arcade
                qText.TextSize = 12
                qText.TextColor3 = Color3.fromRGB(235, 235, 240)
                qText.TextTransparency = 1
                qText.TextXAlignment = Enum.TextXAlignment.Left
                qText.TextTruncate = Enum.TextTruncate.AtEnd
                qText.TextWrapped = false
                qText.Text = State._Reply.clip(replyTo.text, 50)
                qText.ZIndex = 11
                replyQuote.text = qText
            end

            -- (تم حذف نظام «غير مقروء» وصور المشاهدين)

            -- 📍 محاذاة: كلامي يمين، كلام خويي يسار (نفس الشي عند الطرفين لأنه مبني على isMine)
            local targetPos
            if isMine then
                bubble.AnchorPoint = Vector2.new(1, 0)
                local rightOffset = avatarImg and (5 + AVATAR_SIZE + AVATAR_GAP + MY_MESSAGE_LEFT_SHIFT) or (5 + MY_MESSAGE_LEFT_SHIFT)
                targetPos = UDim2.new(1, -rightOffset, 0, QUOTE_OFFSET)
                bubble.Position = UDim2.new(1, 25, 0, QUOTE_OFFSET) -- يبدأ خارج الحافة عشان الانميشن
                if replyQuote then
                    replyQuote.frame.AnchorPoint = Vector2.new(1, 0)
                    replyQuote.frame.Position = UDim2.new(1, -rightOffset, 0, 0)
                end
            else
                bubble.AnchorPoint = Vector2.new(0, 0)
                local leftOffset = avatarImg and (5 + AVATAR_SIZE + AVATAR_GAP + FRIEND_MESSAGE_RIGHT_SHIFT) or (5 + FRIEND_MESSAGE_RIGHT_SHIFT)
                targetPos = UDim2.new(0, leftOffset, 0, QUOTE_OFFSET)
                bubble.Position = UDim2.new(0, leftOffset - 30, 0, QUOTE_OFFSET)
                if replyQuote then
                    replyQuote.frame.AnchorPoint = Vector2.new(0, 0)
                    replyQuote.frame.Position = UDim2.new(0, leftOffset, 0, 0)
                end
            end

            -- نخلي السحاب فيه مساحة إضافية 500 بكسل، لكن ما نغيّر مكان المستخدم
            -- عند وصول/تحميل الرسائل. التحريك لآخر رسالة يصير فقط عند إرسال رسالة من المستخدم.
            chatLog.CanvasSize = UDim2.new(0, 0, 0, chatList.AbsoluteContentSize.Y + 500)

            -- 👆 كل الرسايل قابلة للضغط: الحذف بس لرسايلي، النسخ لأي رسالة
            -- (نخلي الفقاعة نفسها قابلة للنقر بدل ما نضيف عنصر جواها، عشان ما يصير تضارب بحساب الطول التلقائي)
            bubble.Active = true
            bubble.InputBegan:Connect(function(input)
                if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
                if _deleteModeActive and isMine then
                    local liveId = row:GetAttribute("ChatId")
                    if not liveId or liveId == "" then liveId = nil end
                    openSelectMenu(bubble, stroke, label, row, liveId)
                elseif _copyModeActive then
                    openCopyMenu(label)
                elseif (not isMine) and (not isPrivate) and State._Reply then
                    -- ↩️ ضغطة خفيفة (مو سحب للتمرير) على رسالة شخص ثاني = رد عليه
                    local startPos = input.Position
                    local conn
                    conn = input.Changed:Connect(function()
                        if input.UserInputState == Enum.UserInputState.End then
                            conn:Disconnect()
                            if (input.Position - startPos).Magnitude < 12 then
                                State._Reply.set(sender, text, userId)
                            end
                        end
                    end)
                end
            end)

            -- ✨ انميشن الدخول: ما تجي فجأة، تدخل بحركة ناعمة (Back easing)
            task.defer(function()
                local slideInfo = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                local fadeInfo = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                SkyTw(bubble, slideInfo, {Position = targetPos}):Play()
                SkyTw(bubble, fadeInfo, {BackgroundTransparency = 0.25}):Play()
                SkyTw(stroke, fadeInfo, {Transparency = 0}):Play()
                SkyTw(nameLabel, fadeInfo, {TextTransparency = 0.35}):Play()
                SkyTw(label, fadeInfo, {TextTransparency = 0}):Play()
                if replyQuote then
                    SkyTw(replyQuote.frame, fadeInfo, {BackgroundTransparency = 0.25}):Play()
                    SkyTw(replyQuote.stroke, fadeInfo, {Transparency = 0}):Play()
                    SkyTw(replyQuote.accent, fadeInfo, {BackgroundTransparency = 0}):Play()
                    SkyTw(replyQuote.avatar, fadeInfo, {ImageTransparency = 0, BackgroundTransparency = 0}):Play()
                    SkyTw(replyQuote.name, fadeInfo, {TextTransparency = 0.1}):Play()
                    SkyTw(replyQuote.text, fadeInfo, {TextTransparency = 0.05}):Play()
                end
                local readStatus = bubble:FindFirstChild("ReadStatus")
                if readStatus then
                    SkyTw(readStatus, fadeInfo, {TextTransparency = 0}):Play()
                end
                if avatarImg then
                    local avStroke = avatarImg:FindFirstChildOfClass("UIStroke")
                    SkyTw(avatarImg, fadeInfo, {ImageTransparency = 0}):Play()
                    if avStroke then SkyTw(avStroke, fadeInfo, {Transparency = 0}):Play() end
                end
            end)

            task.defer(function()
                updateOwnMessageReadState(_otherUserInChat)
            end)
        end
        
        -- 💬 فقاعة ثابتة فوق الرأس بحجم شاشة واحد.
        -- الفقاعة الأصلية في Roblox تكبر وتصغر مع بُعد الكاميرا، لذلك نستخدم
        -- ScreenGui ونحوّل مكان الرأس إلى إحداثيات الشاشة في كل إطار.
        -- 💬 فقاعات فوق الرأس مثل روبلوكس:
        -- نسمح بحد أقصى 3 رسايل لنفس الشخص في نفس الوقت.
        -- الجديدة تكون تحت، والأقدم تطلع فوق. إذا وصلت رسالة رابعة نحذف الأقدم.
        local _headBubbleStacks = {}
        local HEAD_BUBBLE_MAX = 3
        local HEAD_BUBBLE_GAP = 5
        local HEAD_BUBBLE_BASE_OFFSET = 8
        local HEAD_BUBBLE_MAX_HEIGHT = 120

        local function showMessageAboveHead(text, targetPlayer, isMine)
            local player = targetPlayer or game.Players.LocalPlayer
            local character = player and player.Character
            local head = character and character:FindFirstChild("Head")
            if not head then return end

            text = tostring(text or "")
            if text == "" then return end
            if isMine == nil then isMine = true end

            local userKey = tostring(player.UserId)
            local stack = _headBubbleStacks[userKey]
            if not stack then
                stack = {}
                _headBubbleStacks[userKey] = stack
            end

            -- 🧹 إذا عندنا 3 بالفعل، نحذف أقدم فقاعة قبل إضافة الجديدة.
            while #stack >= HEAD_BUBBLE_MAX do
                -- الرابعة لا تدخل أصلًا: نحذف أقدم فقاعة فقط ونبقي آخر 3.
                local oldest = table.remove(stack, 1)
                if oldest then
                    oldest.alive = false
                    if oldest.followConnection then
                        oldest.followConnection:Disconnect()
                        oldest.followConnection = nil
                    end
                    if oldest.bubble and oldest.bubble.Parent then
                        oldest.bubble:Destroy()
                    end
                end
            end

            local Camera = workspace.CurrentCamera
            if not Camera then return end

            -- حجم متناسب مع الكلام، مع حد أدنى حتى لا تصغر الرسائل القصيرة جدًا.
            local TextService = game:GetService("TextService")
            local textFont = Enum.Font.Arcade
            local textSize = 18
            local measured = TextService:GetTextSize(text, textSize, textFont, Vector2.new(300, 1000))
            local bubbleWidth = math.clamp(measured.X + 34, 155, 310)
            local bubbleHeight = math.clamp(measured.Y + 22, 58, 110)

            -- 🎨 لون التوهج: أنا بنفسجي، خويي أزرق، وغير المضاف رصاصي.
            local headIsFriend = false
            if not isMine and player then
                pcall(function()
                    headIsFriend = game.Players.LocalPlayer:IsFriendsWith(player.UserId)
                end)
            end
            local glowColor = isMine and Color3.fromRGB(170, 0, 255)
                or (headIsFriend and Color3.fromRGB(0, 140, 255) or Color3.fromRGB(145, 145, 155))

            local bubble = Instance.new("Frame")
            bubble.Name = "SkyFixedChatBubble_" .. userKey .. "_" .. tostring(math.floor(os.clock() * 1000000))
            bubble.Parent = NG
            bubble.AnchorPoint = Vector2.new(0.5, 1)
            local bubbleFullSize = UDim2.new(0, bubbleWidth, 0, bubbleHeight)
            bubble.Size = UDim2.new(0, 0, 0, 0)
            bubble.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
            bubble.BackgroundTransparency = 1
            bubble.BorderSizePixel = 0
            bubble.ZIndex = 100
            Instance.new("UICorner", bubble).CornerRadius = UDim.new(0, 14)

            local bubbleStroke = Instance.new("UIStroke", bubble)
            bubbleStroke.Color = glowColor
            bubbleStroke.Thickness = 1.6
            bubbleStroke.Transparency = 1

            local bubbleGradient = Instance.new("UIGradient", bubbleStroke)
            bubbleGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, glowColor),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(8, 8, 10)),
                ColorSequenceKeypoint.new(1, glowColor),
            })
            task.spawn(function()
                while bubbleGradient and bubbleGradient.Parent do
                    if not _G.SkyGlowOff then bubbleGradient.Rotation = (bubbleGradient.Rotation + 1.5) % 360 end
                    task.wait(0.03)
                end
            end)

            local label = Instance.new("TextLabel", bubble)
            label.Size = UDim2.new(1, -24, 1, -14)
            label.Position = UDim2.new(0, 12, 0, 7)
            label.BackgroundTransparency = 1
            label.Text = text
            label.TextColor3 = Color3.fromRGB(255, 255, 255)
            label.TextTransparency = 1
            label.Font = Enum.Font.Arcade
            label.TextSize = 18
            label.TextWrapped = true
            label.TextTruncate = Enum.TextTruncate.None
            label.TextXAlignment = Enum.TextXAlignment.Center
            label.TextYAlignment = Enum.TextYAlignment.Center
            label.ZIndex = 101

            -- ذيل صغير يربط الفقاعة بالرأس.
            local tail = Instance.new("Frame", bubble)
            tail.Size = UDim2.new(0, 12, 0, 12)
            tail.AnchorPoint = Vector2.new(0.5, 0)
            tail.Position = UDim2.new(0.5, 0, 1, -4)
            tail.Rotation = 45
            tail.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
            tail.BackgroundTransparency = 1
            tail.BorderSizePixel = 0
            tail.ZIndex = 99

            local record = {
                bubble = bubble,
                bubbleStroke = bubbleStroke,
                label = label,
                tail = tail,
                height = bubbleHeight,
                alive = true,
                followConnection = nil,
            }
            table.insert(stack, record)

            -- نعيد ترتيب الفقاعات: الأحدث تحت، والأقدم فوقها.
            local function repositionStack()
                for index, item in ipairs(stack) do
                    if item and item.bubble and item.bubble.Parent then
                        local newerCount = #stack - index
                        item.stackOffset = newerCount
                    end
                end
            end
            repositionStack()

            -- ⏱️ كل فقاعة لها مدة مستقلة، لكن وجود أكثر من 3 لا يحدث أبدًا.
            local baseSeconds = 6
            local extraSeconds = 0
            if #text > 15 then
                extraSeconds = math.clamp((#text - 15) * 0.09, 0, 12)
            end
            local visibleUntil = os.clock() + baseSeconds + extraSeconds
            local isClosing = false

            local function removeRecord()
                if not record.alive then return end
                record.alive = false
                if record.followConnection then
                    record.followConnection:Disconnect()
                    record.followConnection = nil
                end

                for i, item in ipairs(stack) do
                    if item == record then
                        table.remove(stack, i)
                        break
                    end
                end
                if #stack == 0 then
                    _headBubbleStacks[userKey] = nil
                end
                repositionStack()
                if bubble.Parent then bubble:Destroy() end
            end

            record.followConnection = RunService.RenderStepped:Connect(function()
                if not record.alive or not bubble.Parent or not head.Parent then
                    removeRecord()
                    return
                end

                Camera = workspace.CurrentCamera or Camera
                if not Camera then return end

                -- 📌 ترتيب Roblox: آخر رسالة تكون تحت، والرسائل الأقدم تصعد فوقها.
                -- لكل لاعب Stack مستقل، لذلك رسائل اللاعبين الآخرين لا تتداخل مع بعض.
                local stackIndex = table.find(stack, record) or #stack
                local pixelOffset = HEAD_BUBBLE_BASE_OFFSET + 30

                -- نجمع ارتفاع الفقاعات الأحدث فقط؛ بهذا تكون الجديدة دائمًا أقرب للرأس.
                for i = #stack, stackIndex + 1, -1 do
                    local newer = stack[i]
                    if newer and newer.alive and newer.bubble and newer.bubble.Parent then
                        pixelOffset = pixelOffset + math.min(newer.height or 58, HEAD_BUBBLE_MAX_HEIGHT) + HEAD_BUBBLE_GAP
                    end
                end

                local screenPoint, onScreen = Camera:WorldToViewportPoint(head.Position)
                bubble.Position = UDim2.fromOffset(screenPoint.X, screenPoint.Y - pixelOffset)
                bubble.Visible = (onScreen and screenPoint.Z > 0) or isClosing

