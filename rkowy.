        UserInputService.InputBegan:Connect(function(input, processed)
            if processed or not State.locationMarkerActive or not State.locationMarkerArmed then return end
            if input.UserInputType ~= Enum.UserInputType.Touch
                and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            placing = true
            placeStart = input.Position
            local connection
            connection = input.Changed:Connect(function()
                if input.UserInputState ~= Enum.UserInputState.End then return end
                connection:Disconnect()
                if not placing then return end
                placing = false
                if not placeStart or (input.Position - placeStart).Magnitude > 12 then return end
                local position = raycastLocation(Vector2.new(input.Position.X, input.Position.Y))
                if position then
                    State.locationMarkerPosition = position
                    State.locationMarkerArmed = false
                    marker.Visible = true
                    markerDistance.Visible = true
                    if State.locationPanel then
