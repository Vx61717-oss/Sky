        privateAlertText.BackgroundTransparency = 1
        privateAlertText.TextColor3 = Color3.fromRGB(255, 255, 255)
        privateAlertText.Font = Enum.Font.Arcade
        privateAlertText.TextSize = 17
        privateAlertText.TextWrapped = true
        privateAlertText.TextXAlignment = Enum.TextXAlignment.Center
        privateAlertText.TextYAlignment = Enum.TextYAlignment.Center
        privateAlertText.ZIndex = 141
        local privateAlertTextBasePosition = privateAlertText.Position
        local privateAlertFrameBasePosition = privateAlertFrame.Position

        local privateAlertSerial = 0
        showPrivateAlert = function(text)
            privateAlertSerial = privateAlertSerial + 1
            local serial = privateAlertSerial
            text = tostring(text or "")
            privateAlertText.Text = text

            -- قياس النص: الرسالة القصيرة تعطي نافذة قصيرة، والطويلة تتمدد مع الالتفاف.
            local textService = game:GetService("TextService")
            local measured = textService:GetTextSize(text, 17, Enum.Font.Arcade, Vector2.new(620, 220))
            local alertWidth = math.clamp(measured.X + 56, 260, 700)
            local alertHeight = math.clamp(measured.Y + 78, 105, 260)
            privateAlertFrame.Size = UDim2.new(0, alertWidth, 0, alertHeight)
            privateAlertText.Size = UDim2.new(1, -24, 1, -44)
            privateAlertFrame.Position = UDim2.new(0.5, 0, 0.42, 18)
            privateAlertText.Position = privateAlertTextBasePosition
            privateAlertFrame.BackgroundTransparency = 1
            privateAlertFrame.Visible = true

            -- دخول بانميشن ناعم من الأسفل مع تكبير تدريجي.
            SkyTw(privateAlertFrame, TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Position = privateAlertFrameBasePosition,
                BackgroundTransparency = 0.03
            }):Play()

            -- اهتزاز الرسالة عدة مرات حتى تكون لافتة وواضحة.
            task.spawn(function()
                local shakeOffsets = {-7, 7, -5, 5, -3, 3, 0}
                for _, offset in ipairs(shakeOffsets) do
                    if serial ~= privateAlertSerial then return end
                    local shake = SkyTw(privateAlertText, TweenInfo.new(0.055, Enum.EasingStyle.Linear), {
                        Position = UDim2.new(privateAlertTextBasePosition.X.Scale, privateAlertTextBasePosition.X.Offset + offset, privateAlertTextBasePosition.Y.Scale, privateAlertTextBasePosition.Y.Offset)
                    })
                    shake:Play()
                    shake.Completed:Wait()
                end
            end)

            task.delay(6, function()
                if serial == privateAlertSerial and privateAlertFrame then
                    local out = SkyTw(privateAlertFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                        Position = UDim2.new(0.5, 0, 0.42, 18),
                        BackgroundTransparency = 1
                    })
                    out:Play()
                    out.Completed:Connect(function()
                        if serial == privateAlertSerial then
                            privateAlertFrame.Visible = false
                            privateAlertFrame.Position = privateAlertFrameBasePosition
                            privateAlertText.Position = privateAlertTextBasePosition
                        end
                    end)
                end
            end)
        end

