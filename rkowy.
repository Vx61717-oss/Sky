                sliderInput = nil
            end
            if aimInput and (input == aimInput or (aimInput.UserInputType == Enum.UserInputType.MouseButton1 and ut == Enum.UserInputType.MouseButton1)) then
                local pw = aimPower
                aimInput = nil
                aimPower = 0
                if humanTurn() and pw >= 0.07 then
                    if blocked then
                        hideAim()
                        statusLabel.Text = "⚠️ الضارب فوق قطعة! حرّكه لمكان فاضي"
                    else
                        shoot(aimDX, aimDY, pw)
                    end
                else
                    hideAim()
                end
            end
        end))

        add(RunService.Heartbeat:Connect(function(dt)
            if not S_.alive or phase ~= "moving" then return end
            dt = math.min(dt, 1 / 30)
            local ok = pcall(function()
                local maxsp = 0
                for _, b in ipairs(bodies) do
                    if b.alive then
                        local sp = math.sqrt(b.vx * b.vx + b.vy * b.vy)
                        if sp > maxsp then maxsp = sp end
                    end
