        local function drawAim(dx, dy, power)
            local sx, sy = striker.x, striker.y
            local col = Color3.fromHSV(0.33 * (1 - power), 0.85, 1)
            local len = power * 170
            pullLine.Visible = power > 0.02
            pullLine.Position = UDim2.fromScale((sx - dx * len / 2) / B, (sy - dy * len / 2) / B)
            pullLine.Size = UDim2.fromScale(math.max(len, 1) / B, 0.012)
            pullLine.Rotation = math.deg(math.atan2(dy, dx))
            pullLine.BackgroundColor3 = col
            powerFill.Size = UDim2.fromScale(power, 1)
            powerFill.BackgroundColor3 = col

            local t, hit = rayCast(sx, sy, dx, dy)
            local start = SR + 12
            local n = math.clamp(math.floor((t - start) / 34) + 1, 0, #dots)
            for i = 1, #dots do
                local d = dots[i]
                if i <= n then
                    local dist = start + (i - 1) * 34
                    d.Position = UDim2.fromScale((sx + dx * dist) / B, (sy + dy * dist) / B)
                    d.Visible = true
                else
                    d.Visible = false
                end
            end
            local gx, gy = sx + dx * t, sy + dy * t
            ghost.Position = UDim2.fromScale(gx / B, gy / B)
            ghost.Visible = true
            if hit then
                local tx, ty = hit.x - gx, hit.y - gy
                local tl = math.sqrt(tx * tx + ty * ty)
                if tl > 0.001 then
                    tx, ty = tx / tl, ty / tl
                    for i = 1, #tdots do
                        local dist = hit.r + 16 + (i - 1) * 30
                        local px, py = hit.x + tx * dist, hit.y + ty * dist
                        if px > 40 and px < B - 40 and py > 40 and py < B - 40 then
                            tdots[i].Position = UDim2.fromScale(px / B, py / B)
                            tdots[i].Visible = true
                        else
                            tdots[i].Visible = false
                        end
                    end
                end
            else
                for _, d in ipairs(tdots) do d.Visible = false end
            end
        end

