            C.zone(UDim2.new(0, 100, 0, 60), UDim2.new(1, -112, 0, C.lineH + 2), "SkyName")                          -- السطر الأول: الاسم
            C.zone(UDim2.new(0, 100, 0, 60 + C.lineH + 1), UDim2.new(1, -112, 0, C.lineH + 2), "SkyUser")             -- السطر الثاني: اليوزر

