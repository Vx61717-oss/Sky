-- ⭐ طلب التقييم للمستخدم: يطلع بعد 30 ثانية، ومرتين بس:
-- المرة الأولى بأول تشغيل، والمرة الثانية لما يصير شغّل السكربت 8 مرات (بعد 30 ثانية)، وبعدها ما يطلع أبد.
do
	local STATE_FILE = "SkyConfig/RatingPrompt.txt" -- "عدد التشغيلات,عدد مرات الظهور"
	local RUNS_FOR_SECOND = 8
	local PROMPT_DELAY = 30

	local runs, shown = 0, 0
	pcall(function()
		if readfile and isfile and isfile(STATE_FILE) then
			local a, b = tostring(readfile(STATE_FILE)):match("^(%d+),(%d+)")
			runs = tonumber(a) or 0
			shown = tonumber(b) or 0
		end
	end)

	local function saveState()
		pcall(function()
			if writefile and makefolder and isfolder then
				if not isfolder("SkyConfig") then makefolder("SkyConfig") end
				writefile(STATE_FILE, tostring(runs) .. "," .. tostring(shown))
			end
		end)
	end

	local function due()
		return shown == 0 or (shown == 1 and runs >= RUNS_FOR_SECOND)
	end

	if player and player.Name ~= "AAbbooyi" then
		-- التشغيل التلقائي بعد الانتقال لسيرفر جديد ما ينحسب كتشغيل جديد
		local queuedRun = false
		pcall(function()
			queuedRun = game:GetService("CoreGui"):FindFirstChild("SkyQueuedRunMarker") ~= nil
		end)
		if not queuedRun then
			runs = runs + 1
			saveState()
		end

		if due() then
			task.delay(PROMPT_DELAY, function()
				if player and player.Parent and due() then
					shown = shown + 1
					saveState()
					SkyShowRatingPanel()
				end
			end)
		end
	end
end

