            for i = 1, #CREATURES do d.owned[i] = 0 d.petLv[i] = 1 end
            local ok, raw = pcall(function()
                if readfile and isfile and isfile(activeSaveFile) then return HttpService:JSONDecode(readfile(activeSaveFile)) end
            end)
            if ok and type(raw) == "table" then
                d.wallet = math.max(0, tonumber(raw.wallet) or d.wallet)
                if type(raw.owned) == "table" then
                    for i = 1, #CREATURES do d.owned[i] = math.max(0, math.floor(tonumber(raw.owned[i]) or 0)) end
                end
                if type(raw.petLv) == "table" then
                    for i = 1, #CREATURES do d.petLv[i] = math.clamp(math.floor(tonumber(raw.petLv[i]) or 1), 1, PET_MAX_LV) end
                end
                d.unlocked = math.clamp(math.floor(tonumber(raw.unlocked) or 1), 1, #STAGES)
                d.finished = raw.finished == true
                d.money2x = raw.money2x == true
                d.totalKills = math.max(0, math.floor(tonumber(raw.totalKills) or 0))
                d.totalWins = math.max(0, math.floor(tonumber(raw.totalWins) or 0))
                d.stagesWon = type(raw.stagesWon) == "table" and raw.stagesWon or {}
                if type(raw.run) == "table" and STAGES[tonumber(raw.run.stage) or 0] then
                    d.run = raw.run
                    d.run.stage = math.floor(tonumber(d.run.stage))
                    d.run.wave = math.clamp(math.floor(tonumber(d.run.wave) or 0), 0, WAVES_PER_STAGE - 1)
