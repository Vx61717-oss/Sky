        SkyAI.ask = function(question)
            if SkyAI.busy then
                Notify("🤖 Sky AI", "انتظر الرد السابق", Color3.fromRGB(255, 170, 70), true)
                return
            end
            local left = SkyAI.COOLDOWN - (os.clock() - SkyAI.last)
            if left > 0 then
                Notify("🤖 Sky AI", "انتظر " .. math.ceil(left) .. " ثواني", Color3.fromRGB(255, 170, 70), true)
                return
            end
            SkyAI.curInTab = SkyAI.tabActive and true or false
            local fileCode

            local isEdit = (fileCode ~= nil) or SkyAI.isEditRequest(question)
            if not isEdit and SkyAI.pendingEdit and (os.clock() - SkyAI.pendingEdit) < 900 then isEdit = true end
            SkyAI.pendingEdit = nil
            local isScript = isEdit or SkyAI.isScriptRequest(question)
            if isScript and not isEdit then SkyAI.sourceFile = nil end
            if not isScript and SkyAI.lastScript and (question:find("افتح السكربت", 1, true) or question:find("افتح الكود", 1, true)) then
                SkyAI.last = os.clock()
                SkyAI.openScriptViewer(SkyAI.lastScript)
                return
            end
            -- ⚡ جواب جاهز محلي: فوري، بدون إنترنت، وما يحسب من حد السوالف
            local localAns = (not isScript) and SkyAI.localAnswer(question) or nil
            if localAns then
                SkyAI.last = os.clock() - SkyAI.COOLDOWN + 1
                SkyAI.setTyping(true)
                task.delay(0.5, function()
                    SkyAI.setTyping(false)
                    SkyAI.show(localAns)
                end)
                table.insert(SkyAI.history, {role = "user", content = question})
                table.insert(SkyAI.history, {role = "assistant", content = localAns})
                while #SkyAI.history > 6 do table.remove(SkyAI.history, 1) end
                return
            end
            SkyAI.busy = true
            SkyAI.last = os.clock()
            -- 🔢 عدّاد السوالف: بعد 10 رسايل يعتذر دقيقة (أسئلة السكربت تبقى مجابة)
            local nowT = os.time()
            if SkyAI.limitUntil and nowT >= SkyAI.limitUntil then
                SkyAI.limitUntil = nil
                SkyAI.count = 0
            end
            if not isScript then
                SkyAI.count = (SkyAI.count or 0) + 1
                if SkyAI.count > SkyAI.CHAT_LIMIT and not SkyAI.limitUntil then
                    SkyAI.limitUntil = nowT + SkyAI.LIMIT_SECONDS
                end
            end
            local limited = (not isScript) and (SkyAI.limitUntil ~= nil) or false
            SkyAI.token = (SkyAI.token or 0) + 1
            local myToken = SkyAI.token
            SkyAI.setTyping(true)

            -- ⏱️ لو تأخر الرد أكثر من 45 ثانية نوقف الانتظار
            task.delay(isScript and SkyAI.SCRIPT_TIMEOUT or 30, function()
                if SkyAI.token == myToken and SkyAI.busy then
                    SkyAI.token = myToken + 1
                    SkyAI.busy = false
                    SkyAI.setTyping(false)
                    SkyAI.show("الرد تأخر كثير، جرّب تسألني مرة ثانية 🙏")
                end
            end)

            task.spawn(function()
                local answer, failInfo, scriptCode, scriptName
                pcall(function()
                    local HS = game:GetService("HttpService")
                    -- 👤 معلومات المستخدم الحالي (عشان يقدر يجاوب لو سألته عن نفسك)
                    local lp = game.Players.LocalPlayer
                    if not SkyAI.gameName then
                        local okG, infoG = pcall(function()
                            return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
                        end)
                        SkyAI.gameName = (okG and type(infoG) == "table" and infoG.Name) or "غير معروف"
                    end
                    local userInfo = "\n\nمعلومات المستخدم الحالي:\n- اسم الحساب: " .. tostring(lp.Name)
                        .. "\n- الاسم الظاهر: " .. tostring(lp.DisplayName)
                        .. "\n- عمر الحساب بالأيام: " .. tostring(lp.AccountAge)
                        .. "\n- اسم الماب: " .. tostring(SkyAI.gameName)
                        .. "\n- عدد اللاعبين في السيرفر: " .. tostring(#game.Players:GetPlayers())
                    local msgs = {{role = "system", content = isScript and SkyAI.SCRIPT_SYS or (SkyAI.KB .. userInfo .. (limited and SkyAI.LIMIT_NOTE or ""))}}
                    if isEdit and SkyAI.lastScript then
                        -- ✏️ تعديل: نرسل آخر سكربت كامل مع التعديل المطلوب (بدون سوالف قديمة)
                        table.insert(msgs, {role = "user", content = "السكربت الحالي:\n```lua\n" .. SkyAI.lastScript .. "\n```\n\nالتعديل المطلوب: " .. question
                            .. "\n\nطبّق التعديل على السكربت الحالي بالضبط واكتب النسخة الكاملة الجديدة بنفس الشكل، واحتفظ بنفس اسم الملف (FILE: " .. tostring(SkyAI.lastScriptName or "sky_script.lua") .. ") ولا تغيّر شي ما طلبته. مهم: لا تسأل المستخدم أي سؤال ولا تطلب توضيح؛ لو كلامه غامض (مثل: عدل هذا الشي، أو ما عجبني شي بالقائمة) فسّره بأقرب تحسين منطقي (غالبًا الواجهة أو الجزء اللي يقصده) ونفّذه، وإذا كان يشتكي من مشكلة أو إن السكربت ما يشتغل فأصلحها. لازم ترجع السكربت كامل داخل كتلة ```lua```. في «وش أضفت» اذكر التعديلات اللي سويتها بس."})
                    else
                        for _, m in ipairs(SkyAI.history) do table.insert(msgs, m) end
                        table.insert(msgs, {role = "user", content = question})
                    end
                    local models = isScript and {"openai", "openai-fast", "mistral"} or {"openai-fast", "openai", "mistral"}
                    local function bodyFor(model)
                        return HS:JSONEncode({model = model, messages = msgs, temperature = isScript and 0.2 or 0.55, max_tokens = isScript and SkyAI.SCRIPT_MAX_TOKENS or 300})
                    end

                    -- يرجع: النص، رمز الحالة
                    local function tryPost(model)
                        if type(request) ~= "function" then return nil, "no-request" end
                        local ok, res = pcall(request, {
                            Url = "https://gen.pollinations.ai/v1/chat/completions",
                            Method = "POST",
                            Headers = (SkyAI.API_KEY ~= "") and {["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. SkyAI.API_KEY} or {["Content-Type"] = "application/json"},
                            Body = bodyFor(model)
                        })
                        if not ok or type(res) ~= "table" then return nil, "err" end
                        local code = res.StatusCode or res.statusCode
                        local raw = res.Body or res.body
                        if code and code ~= 200 then return nil, code end
                        if type(raw) ~= "string" or raw == "" then return nil, "empty" end
                        local okJ, j = pcall(function() return HS:JSONDecode(raw) end)
                        if okJ and type(j) == "table" then
                            local c = j.choices and j.choices[1] and j.choices[1].message and j.choices[1].message.content
                            if type(c) == "string" and c ~= "" then return c, 200 end
                            return nil, "bad-json"
                        end
                        return raw, 200
                    end

                    local body
                    -- 🔁 نعيد المحاولة لو الخدمة مشغولة أو حدّت الطلبات (429 وغيرها)
                    local waits = {1.5, 3, 5}
                    local function fetchBody()
                        for attempt = 1, 3 do
                            if SkyAI.token ~= myToken then return nil end
                            local b, st = tryPost(models[((attempt - 1) % #models) + 1])
                            if b then return b end
                            failInfo = tostring(st)
                            if st == 401 or st == 402 or st == 403 then break end
                            if attempt < 3 then task.wait(waits[attempt] or 8) end
                        end
                        return nil
                    end
                    body = fetchBody()
                    if SkyAI.token ~= myToken then return end

                    -- احتياط أخير: GET بالسؤال فقط
                    if not body and not isScript and SkyAI.token == myToken and SkyAI.API_KEY ~= "" then
                        local url = "https://gen.pollinations.ai/text/" .. HS:UrlEncode(question) .. "?key=" .. SkyAI.API_KEY
                            .. "&system=" .. HS:UrlEncode(SkyAI.SHORT_SYS .. (limited and SkyAI.LIMIT_NOTE or ""))
                        local ok, res = pcall(request, {Url = url, Method = "GET"})
                        if ok and type(res) == "table" and (res.StatusCode == nil or res.StatusCode == 200) then
                            body = res.Body or res.body
                        elseif ok and type(res) == "table" then
                            failInfo = tostring(res.StatusCode)
                        end
                        if type(body) ~= "string" or body == "" then
                            local ok2, b = pcall(function() return game:HttpGet(url) end)
                            if ok2 then body = b end
                        end
                    end

                    -- 📝 رد سكربت: نفصل الكود عن الشرح بدون ما نقص الكود أو ننظفه
                    if isScript and type(body) == "string" and body:gsub("%s+", "") ~= "" then
                        body = body:gsub("^%s+", ""):gsub("%s+$", "")
                        local code, before = SkyAI.extractScript(body)
                        -- ✏️ وضع التعديل: لو رد بدون كود (مثلاً سأل سؤال) نعيد الطلب مرة وحدة ونجبره يكتب السكربت
                        if not code and isEdit then
                            table.insert(msgs, {role = "assistant", content = body})
                            table.insert(msgs, {role = "user", content = "لا تسأل أسئلة. اكتب الحين النسخة الكاملة المعدلة من السكربت داخل كتلة ```lua``` بنفس الشكل (FILE ثم وش يسوي ثم وش أضفت ثم الكود)، وفسّر طلبي بأقرب شي منطقي."})
                            local body3 = fetchBody()
                            if SkyAI.token ~= myToken then return end
                            if type(body3) == "string" and body3:gsub("%s+", "") ~= "" then
                                body3 = body3:gsub("^%s+", ""):gsub("%s+$", "")
                                local code3, before3 = SkyAI.extractScript(body3)
                                if code3 then body, code, before = body3, code3, before3 end
                            end
                        end
                        -- ✅ نفحص السكربت (تحليل فقط، ما ينشغّل). لو فيه خطأ سينتاكس نطلب من الذكاء الاصطناعي يصلحه مرة وحدة
                        if code and type(loadstring) == "function" then
                            local fnOk, fnErr = loadstring(code)
                            if not fnOk then
                                pcall(warn, "[SkyAI] خطأ سينتاكس بالسكربت، نعيد التصحيح: " .. tostring(fnErr))
                                table.insert(msgs, {role = "assistant", content = body})
                                table.insert(msgs, {role = "user", content = "السكربت فيه خطأ سينتاكس يمنع تشغيله: " .. tostring(fnErr) .. "\nصلّحه واكتب النسخة الكاملة المصححة بنفس الشكل (FILE ثم وش يسوي ثم وش أضفت ثم الكود)."})
                                local body2 = fetchBody()
                                if SkyAI.token ~= myToken then return end
                                if type(body2) == "string" and body2:gsub("%s+", "") ~= "" then
                                    body2 = body2:gsub("^%s+", ""):gsub("%s+$", "")
                                    local code2, before2 = SkyAI.extractScript(body2)
                                    if code2 then body, code, before = body2, code2, before2 end
                                end
                            end
                        end
                        if code then
                            scriptCode = code
                            local details
                            scriptName, details = SkyAI.parseScriptInfo(before)
                            if details == "" then details = "هذا السكربت اللي طلبته، اضغط على الملف وانسخه" end
                            answer = details
                        else
                            if utf8.len(body) and utf8.len(body) > SkyAI.MAX_A then
                                body = body:sub(1, (utf8.offset(body, SkyAI.MAX_A + 1) or (#body + 1)) - 1) .. "…"
                            end
                            answer = body
                        end
                    elseif type(body) == "string" and body:gsub("%s+", "") ~= "" then
                        body = body:gsub("^%s+", ""):gsub("%s+$", "")
                        if utf8.len(body) and utf8.len(body) > SkyAI.MAX_A then
                            body = body:sub(1, (utf8.offset(body, SkyAI.MAX_A + 1) or (#body + 1)) - 1) .. "…"
                        end
                        -- 🧹 ننظف الرد: بدون تنسيق، بدون نقاط بنهاية الجمل، وأقصى 4 أسطر
                        body = body:gsub("%*%*", ""):gsub("`", ""):gsub("^#+%s*", "")
                        body = body:gsub("%.(%s)", "%1"):gsub("%.$", ""):gsub("。", "")
                        local lines, n = {}, 0
                        for line in body:gmatch("[^\r\n]+") do
                            line = line:gsub("^%s+", ""):gsub("%s+$", "")
                            if line ~= "" then
                                n = n + 1
                                if n > 4 then break end
                                table.insert(lines, line)
                            end
                        end
                        body = table.concat(lines, "\n")
                        -- ملاحظة: ما نفلتر الرد بقائمة الكلمات الممنوعة لأن المطابقة الجزئية تعطي أخطاء كاذبة
                        answer = body
                    end
                end)
                if SkyAI.token ~= myToken then return end -- انتهى الانتظار قبل وصول الرد
                SkyAI.token = myToken + 1
                SkyAI.busy = false
                SkyAI.setTyping(false)
                if answer then
                    table.insert(SkyAI.history, {role = "user", content = question})
                    table.insert(SkyAI.history, {role = "assistant", content = scriptCode and ("```lua\n" .. scriptCode .. "\n```") or answer})
                    while #SkyAI.history > 6 do table.remove(SkyAI.history, 1) end
                end
                if not answer then pcall(warn, "[SkyAI] فشل الطلب: " .. tostring(failInfo)) end
                if scriptCode and SkyAI.sourceFile and type(writefile) == "function" then
                    -- 💾 نسخة المعدّل تنحفظ بمجلد المنفّذ بدون ما نغيّر ملفك الأصلي
                    local outName = "SkyAI_Edited_" .. (tostring(SkyAI.sourceFile):gsub("^.*[/\\]", ""))
                    if pcall(writefile, outName, scriptCode) then
                        answer = tostring(answer or "") .. "\n💾 انحفظت النسخة المعدّلة بمجلد المنفّذ باسم " .. outName
                    end
                end
                if scriptCode then
                    SkyAI.lastScript = scriptCode
                    SkyAI.lastScriptAt = os.clock()
                    SkyAI.lastScriptName = scriptName or "sky_script.lua"
                    SkyAI.showScriptCard(scriptName or "sky_script.lua", scriptCode) -- 📄 الملف الوهمي أول
                end
                SkyAI.show(answer or SkyAI.FAILED) -- وتحته الشرح
            end)
        end

        -- 📩 رسالة الدردشة العادية: تظهر داخل قائمة الدردشة فقط.
        local function sendMsg(box)
            box = box or inputBox
            local text = tostring(box.Text or "")
            if text:gsub("%s+", "") == "" then return end
            local badWord = findBadChatWord(text)
            if badWord ~= nil then
                setChatMute(game.Players.LocalPlayer.UserId, badWord)
                box.Text = ""
                box:ReleaseFocus()
                Notify("🚫 الدردشة", "تم كتمك لمدة دقيقة بسبب ألفاظ غير لائقة", Color3.fromRGB(255, 70, 70), true)
                return
            end
            if chatMuteRemaining(game.Players.LocalPlayer.UserId) > 0 then
                if updateChatMuteDisplay then
                    updateChatMuteDisplay(localChatMutes[game.Players.LocalPlayer.UserId])
                end
                box.Text = ""
                box:ReleaseFocus()
                Notify("⏳ الدردشة", "أنت مكتوم مؤقتًا، حاول بعد دقيقة", Color3.fromRGB(255, 170, 70), true)
                return
            end
            if hideDeveloperAnnouncement then hideDeveloperAnnouncement() end

            -- 🤖 أوامر الذكاء الاصطناعي (محلية فقط، ما تنرسل للشات العام)
            do
                local q = SkyAI.mode and text or SkyAI.parse(text)
                if q ~= nil then
                    q = q:gsub("^%s+", ""):gsub("%s+$", "")
                    box.Text = ""
                    box:ReleaseFocus()
                    if q == "" then
                        Notify("🤖 Sky AI", "اكتب سؤالك بعد /ai", Color3.fromRGB(255, 170, 70), true)
                        return
                    end
                    local maxQ = (SkyAI.isScriptRequest(q) or q:lower():find("%.lua", 1, false) or q:lower():find("%.txt", 1, false)) and SkyAI.SCRIPT_MAX_Q or SkyAI.MAX_Q
                    if #q > maxQ then q = q:sub(1, maxQ) end
                    local me = game.Players.LocalPlayer
                    local ts = os.time()
                    local cid = "aiq:" .. tostring(os.clock())
                    local d = {sender = me.Name, text = q, timestamp = ts, chatType = currentChatMode,
                        jobId = game.JobId, placeId = game.PlaceId, clientId = cid}
                    if SkyAI.tabActive and SkyAI.render then
                        SkyAI.render(me.Name, q, me.UserId, ts, cid)
                    elseif isChatMessageVisible(d) then
                        addChatMsg(me.Name, q, nil, me.UserId, ts, d.chatType, d.jobId, d.placeId, cid, nil)
                    end
                    SkyAI.ask(q)
                    return
                end
            end

            -- ✍️ لو أول كلمة يوزر لاعب، نضيف @ تلقائياً
            text = _G.SkyAutoMention and _G.SkyAutoMention(text) or text

            local myName = game.Players.LocalPlayer.Name
            local myUserId = game.Players.LocalPlayer.UserId
            local clientId = tostring(game.Players.LocalPlayer.UserId) .. ":" .. tostring(os.clock()) .. ":" .. tostring(math.random(1, 1000000000))
            local data = {
                ["sender"] = myName,
                ["text"] = text,
                ["timestamp"] = os.time(),
                ["userId"] = myUserId,
                ["jobId"] = game.JobId,
                ["placeId"] = game.PlaceId,
                ["chatType"] = currentChatMode,
                ["clientId"] = clientId,
                ["replyTo"] = State._Reply and State._Reply.target or nil
            }

            box.Text = ""
            box:ReleaseFocus()

            if State._Reply then State._Reply.clear() end -- الرد انحفظ داخل data، نفرّغ الشريط

            chatMessageCache["local:" .. clientId] = data
            -- رسالة محلية فورية داخل قائمة الدردشة، بدون فقاعة فوق الرأس.
            if isChatMessageVisible(data) then
                addChatMsg(myName, text, nil, myUserId, data.timestamp, data.chatType, data.jobId, data.placeId, clientId, data.replyTo)
            end

            -- ⛔ ما ننزل السحاب تلقائياً عند الإرسال (السهم تحت يوديك لآخر رسالة)

            task.spawn(function()
                local ok, res = pcall(function()
                    return request({
                        Url = FIREBASE_URL .. "?auth=" .. AUTH_TOKEN,
                        Method = "POST",
                        Headers = {["Content-Type"] = "application/json"},
                        Body = game:GetService("HttpService"):JSONEncode(data)
                    })
                end)
                if not ok then
                    WARN("فشل إرسال الرسالة: " .. tostring(res))
                elseif res and res.StatusCode and res.StatusCode ~= 200 then
                    WARN("فايربيس رفض الإرسال (" .. tostring(res.StatusCode) .. "): " .. tostring(res.Body))
                end
            end)
        end



        -- 💬 فقاعة الرأس: تظهر فوق الشخصية فقط ولا تدخل قائمة الدردشة.
        local function sendBubbleMsg(box)
