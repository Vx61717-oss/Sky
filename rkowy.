        local lastData = ""
        -- ⏱️ ما نبدأ بـ nil (يبلع أول رسالة تجي كـ"بيانات قديمة" ولا يبلّغ عنها).
        -- بما إن السكربت أصلاً يمسح كل تاريخ الدردشة عند كل تشغيل (فوق)، فما فيه رسائل قديمة أصلاً؛
        -- فنبدأ من وقت التشغيل الحالي، عشان أول رسالة/فقاعة توصل فعليًا تظهر من أول مرة.
        local _lastSeenTimestamp = os.time()
        local _shownPrivateAlertIds = {} -- 🔔 كل تنبيه خاص يظهر مرة وحدة بس (بمعرفه)، حتى لو ظل موجود بالجلب لين يوصل تنبيه جديد
        local _handledBadWordMsgIds = {} -- 🧹 كل رسالة مسيئة نعالجها مرة وحدة بس، حتى لو تكررت بنفس الجلب قبل ما ينفذ حذفها من السيرفر
        local _debugChat = true -- 🐞 خله true لين نتأكد إن كل شي يشتغل تمام، بعدها تقدر تخليه false
        -- 🔄 الحضور/الكتابة ينجلبون كل 3 ثواني دائماً، حتى لو الرسائل ما تغيرت.
        -- (قبل: كان «continue» يتخطاهم إذا ما جت رسالة جديدة، فدخول شخص للدردشة ما ينكشف إلا مع رسالة)
        local _Aux = {last = 0}
        function _Aux.safe()
            local okAux, errAux = pcall(_Aux.run)
            if not okAux and not _Aux.warned then
                _Aux.warned = true
                WARN("خطأ في نظام الحضور: " .. tostring(errAux))
            end
        end
        function _Aux.run()
            _Aux.last = os.clock()
            if currentChatMode == "friends" and State._chatPageOpen and _FriendsBadge.count > 0 then
                _FriendsBadge.set(0)
            end
                -- 🟢 نبعت "أنا موجود بالدردشة" بس وتاب الدردشة يكون مفتوح عندي فعلاً
                do -- 🟢 نعلن حضوري دايماً (حتى لو أنت برا الدردشة أو تلعب) عشان تبان للناس بقائمة الخاص
                    task.spawn(function()
                        pcall(function()
                            request({
                                Url = PRESENCE_URL .. "?auth=" .. AUTH_TOKEN,
                                Method = "PATCH",
                                Headers = {["Content-Type"] = "application/json"},
                                Body = game:GetService("HttpService"):JSONEncode({
                                    [game.Players.LocalPlayer.Name] = os.time()
                                })
                            })
                        end)
                    end)
                end

                -- ✍️ نجيب هل في حد يكتب الحين (غير نفسي)
                do
                    local okT, resT = pcall(function()
                        return request({Url = TYPING_URL .. "?auth=" .. AUTH_TOKEN, Method = "GET"})
                    end)
                    if okT and resT and resT.Body then
                        local okD, typingData = pcall(function()
                            return game:GetService("HttpService"):JSONDecode(resT.Body)
                        end)
                        local myName = game.Players.LocalPlayer.Name
                        if okD and typingData and typingData.name and typingData.name ~= myName
                            and typingData.ts and (os.time() - typingData.ts) < 6 then
                            typingLabel.Text = typingData.name .. " : يكتب..."
                        else
                            typingLabel.Text = ""
                        end
                    end
                end

                -- 🟢 نجيب هل خويي متصل (فاتح تاب الدردشة عنده هو الحين)
                do
                    local okP, resP = pcall(function()
                        return request({Url = PRESENCE_URL .. "?auth=" .. AUTH_TOKEN, Method = "GET"})
                    end)
                    if okP and resP and resP.Body then
                        local okD, presenceData = pcall(function()
                            return game:GetService("HttpService"):JSONDecode(resP.Body)
                        end)
                        local myName = game.Players.LocalPlayer.Name
                        local friendOnline = false
                        local presentNow = {}
                        if okD and type(presenceData) == "table" then
                            -- ⏱️ ساعة جهازي وساعة جهاز الثاني ممكن تختلف (ثواني أو دقايق)، فمقارنة os.time() لحالها
                            -- تخلي الشخص «مو موجود» غلط. لذلك نعتبره موجود إذا: وقته قريب من وقتي،
                            -- أو إذا قيمته كانت تتغير باستمرار عندي (يعني يرسل حضور الحين) حتى لو ساعته مختلفة.
                            local nowClock = os.clock()
                            _Aux.seen = _Aux.seen or {}
                            for pname, pts in pairs(presenceData) do
                                if pname ~= myName and type(pts) == "number" then
                                    local entry = _Aux.seen[pname]
                                    if not entry then
                                        entry = {value = pts, t = nowClock, changed = false}
                                        _Aux.seen[pname] = entry
                                    elseif entry.value ~= pts then
                                        entry.value = pts
                                        entry.t = nowClock
                                        entry.changed = true
                                    end
                                    local clockFresh = math.abs(os.time() - pts) < 10
                                    local stillMoving = entry.changed and (nowClock - entry.t) < 15
                                    if clockFresh or stillMoving then
                                        friendOnline = true
                                        table.insert(presentNow, pname)
                                    end
                                end
                            end
                        end
                        table.sort(presentNow)
                        _ReadRx.present = presentNow
                        _G.SkyPresentNames = presentNow
                        onlineLabel.Text = friendOnline and "🟢 متصل" or ""
                        _otherUserInChat = friendOnline
                        -- إذا لم يوجد أحد آخر داخل قائمة الدردشة تبقى رسائلي «غير مقروءة».
                        -- عند ظهور صديق/مستخدم آخر في الحضور تتحول إلى «مقروء».
                        updateOwnMessageReadState(friendOnline)
                    end
                end

        end
        -- ⬇️ تمرير سجل الدردشة إلى أحدث رسالة بعد أن يكتمل تحديث تخطيط الصفوف.
        local function scrollChatToLatestMessage()
            task.defer(function()
                task.wait()
                task.wait()
                if not chatLog or not chatLog.Parent then return end
                local contentHeight = chatList.AbsoluteContentSize.Y
                local visibleHeight = chatLog.AbsoluteSize.Y
                local targetY = math.max(0, contentHeight - visibleHeight + 70)
                local maxY = math.max(0, chatLog.AbsoluteCanvasSize.Y - visibleHeight)
                chatLog.CanvasPosition = Vector2.new(0, math.min(targetY, maxY))
            end)
        end

        task.spawn(function()
            while true do
                local success, response = pcall(function()
                    return request({Url = FIREBASE_URL .. "?auth=" .. AUTH_TOKEN, Method = "GET"})
                end)

                if not success then
                    -- ❌ فشل الطلب نفسه (مشكلة شبكة/إكسبلويت ما يدعم request)
                    if _debugChat then WARN("فشل جلب الدردشة: " .. tostring(response)) end
                elseif not response then
                    if _debugChat then WARN("جلب الدردشة رجع بدون رد (response = nil)") end
                elseif response.StatusCode and response.StatusCode ~= 200 then
                    -- ❌ السيرفر رد لكن برمز خطأ (مثلاً 400 = رابط غلط، 401/403 = صلاحيات)
                    if _debugChat then WARN("فايربيس رد بخطأ " .. tostring(response.StatusCode) .. ": " .. tostring(response.Body)) end
                elseif response.Body then
                    -- نحدّث الكتم في كل دورة، وليس فقط عند وصول رسالة جديدة.
                    refreshChatMutes()
                    if response.Body == lastData then
                        if os.clock() - _Aux.last >= 3 then _Aux.safe() end
                        task.wait(1)
                        continue
                    end
                    lastData = response.Body
                    local data = game:GetService("HttpService"):JSONDecode(response.Body)
                    if data then
                        if _G.SkyPmIncoming then
                            for k, pm in pairs(data) do
                                if type(pm) == "table" and pm.chatType == "private" then
                                    pm.id = pm.id or k
                                    pcall(_G.SkyPmIncoming, pm)
                                end
                            end
                        end
                        local msgs = {}
                        for k, v in pairs(data) do
                            v.id = k -- 🔑 مفتاح فايربيس الفريد
                            table.insert(msgs, v)
                        end
                        table.sort(msgs, function(a, b) return a.timestamp < b.timestamp end)
                        -- 🔢 نحتفظ بآخر 15 رسالة
                        while #msgs > 15 do table.remove(msgs, 1) end

                        -- 🚫 لا نمسح ونعيد إنشاء الرسائل عند كل تحديث.
                        -- نضيف فقط الرسائل الجديدة، حتى لا يحصل رعشة/إعادة ظهور للرسائل.
                        local existing = {}
                        for _, child in ipairs(chatLog:GetChildren()) do
                            if child:IsA("Frame") and child.Name == "MsgRow" then
                                local cid = child:GetAttribute("ChatId")
                                local cts = child:GetAttribute("ChatTimestamp")
                                local cs = child:GetAttribute("ChatSender")
                                local ct = child:GetAttribute("ChatText")
                                if cid and cid ~= "" then
                                    existing["id:" .. cid] = true
                                end
                                if cts and cts ~= 0 then
                                    existing["msg:" .. tostring(cts) .. ":" .. tostring(cs) .. ":" .. tostring(ct)] = true
                                end
                            end
                        end

                        for _, m in ipairs(msgs) do
                            -- 🧹 لا نعرض رسائل من جلسة/تشغيل قديم.
                            -- هذا يمنع رجوع رسائل الماب السابقة بعد الخروج والدخول وتشغيل السكربت من جديد.
                            local messageTimestamp = tonumber(m.timestamp) or 0
                            if messageTimestamp < CHAT_SESSION_STARTED_AT then
                                continue
                            end

                            -- إذا وصلت رسالة مسيئة من نسخة قديمة، اكتم صاحبها واحذفها محليًا ومن المصدر.
                            -- 🧹 مرة وحدة بس لكل رسالة (بمعرفها)، حتى لو ظلت تظهر بالجلب لين يكتمل حذفها من السيرفر.
                            local incomingBadWord = findBadChatWord(m.text)
                            local badWordMsgKey = m.id and tostring(m.id) or nil
                            if incomingBadWord ~= nil and m.userId and (not badWordMsgKey or not _handledBadWordMsgIds[badWordMsgKey]) then
                                if badWordMsgKey then _handledBadWordMsgIds[badWordMsgKey] = true end
                                setChatMute(m.userId, incomingBadWord)
                                if m.id then
                                    task.spawn(function()
                                        pcall(function()
                                            deleteMsgFromServer(m.id)
                                        end)
                                    end)
                                end
                            end
                            local senderMuted = m.userId and chatMuteRemaining(m.userId) > 0
                            -- 🔔 منشن: إذا أحد ناداني بـ @ يوزري (بدون المكتومين ولا الكلمات المسيئة، وأخوياك لأصدقاء الكاتب فقط)
                            if _G.SkyMentionCheck and not senderMuted and incomingBadWord == nil then
                                local mentionAllowed = true
                                if m.chatType == "friends" or (m.chatType == "bubble" and m.mode == "friends") then
                                    mentionAllowed = isChatFriend(m.userId)
                                end
                                if mentionAllowed then pcall(_G.SkyMentionCheck, m) end
                            end
                            local key = "id:" .. tostring(m.id)
                            local fallback = "msg:" .. tostring(m.timestamp) .. ":" .. tostring(m.sender) .. ":" .. tostring(m.text)
                            if not existing[key] and not existing[fallback] then
                                if m.chatType == "private" and tonumber(m.targetUserId) == game.Players.LocalPlayer.UserId then
                                    -- 🔒 التنبيه الخاص ما ينرسم بالدردشة، فما يدخل في existing؛ لذلك نسجله هنا بمعرفه
                                    -- عشان أي رسالة عامة/أخوياك/فقاعة جديدة ما ترجّعه مرة ثانية.
                                    local privateAlertKey = m.id and tostring(m.id) or fallback
                                    if not _shownPrivateAlertIds[privateAlertKey] then
                                        _shownPrivateAlertIds[privateAlertKey] = true
                                        if m.developerMessage == true and m.sender ~= game.Players.LocalPlayer.Name and showPrivateAlert then
                                            showPrivateAlert(m.text)
                                        end
                                    end
                                elseif not senderMuted and not incomingBadWord
                                    and m.chatType ~= "bubble"
                                    and m.chatType ~= "private" -- 🔒 التنبيهات الخاصة ما تنرسم بالدردشة أبداً (لا عندي ولا عند غيري)
                                    and not (m.chatType == "developer" and m.developerMessage == true) then
                                    chatMessageCache["id:" .. tostring(m.id)] = m
                                    -- 🔢 رسالة من خويي بدردشة أخوياك: نزيد الرقم إذا ما أنا فاتح تاب أخوياك (مرة وحدة لكل رسالة)
                                    if m.chatType == "friends" and m.sender ~= game.Players.LocalPlayer.Name and m.id
                                        and not _FriendsBadge.seen[m.id] and isChatFriend(m.userId) then
                                        _FriendsBadge.seen[m.id] = true
                                        if not (currentChatMode == "friends" and State._chatPageOpen) then
                                            _FriendsBadge.set(_FriendsBadge.count + 1)
                                        end
                                    end
                                    if isChatMessageVisible(m) then
                                        addChatMsg(m.sender, m.text, m.id, m.userId, m.timestamp, m.chatType, m.jobId, m.placeId, m.clientId, m.replyTo)
                                        -- ⛔ ما ننزل السحاب تلقائياً عند وصول رسالة (السهم تحت يوديك لآخر رسالة)
                                    end
                                end
                                existing[key] = true
                                existing[fallback] = true
                            else
                                -- 🔒 توحيد الرسالة: نسخة Firebase تحل محل أي نسخة محلية/قديمة مطابقة.
                                local matchedLocalKey = nil
                                for cacheKey, cachedMsg in pairs(chatMessageCache) do
                                    if type(cachedMsg) == "table" then
                                        local sameClient = m.clientId and cachedMsg.clientId and tostring(m.clientId) == tostring(cachedMsg.clientId)
                                        local sameLegacy = tostring(cachedMsg.timestamp) == tostring(m.timestamp)
                                            and tostring(cachedMsg.sender) == tostring(m.sender)
                                            and tostring(cachedMsg.text) == tostring(m.text)
                                            and tostring(cachedMsg.chatType or "general") == tostring(m.chatType or "general")
                                            and tostring(cachedMsg.jobId or "") == tostring(m.jobId or "")
                                        if sameClient or sameLegacy then
                                            matchedLocalKey = cacheKey
                                            break
                                        end
                                    end
                                end
                                if matchedLocalKey then chatMessageCache[matchedLocalKey] = nil end
                                -- احذف أي نسخة قديمة لنفس id ثم خزّن نسخة Firebase الوحيدة.
                                for cacheKey, cachedMsg in pairs(chatMessageCache) do
                                    if cacheKey ~= key and type(cachedMsg) == "table" and m.id
                                        and tostring(cachedMsg.id or "") == tostring(m.id) then
                                        chatMessageCache[cacheKey] = nil
                                    end
                                end
                                chatMessageCache[key] = m
                                -- لو الصف الحالي هو النسخة المحلية، حوّله للـid الحقيقي بدل إنشاء صف جديد.
                                for _, child in ipairs(chatLog:GetChildren()) do
                                    if child:IsA("Frame") and child.Name == "MsgRow" then
                                        local cid = child:GetAttribute("ChatId")
                                        local cclient = child:GetAttribute("ChatClientId")
                                        local cts = child:GetAttribute("ChatTimestamp")
                                        local cs = child:GetAttribute("ChatSender")
                                        local ct = child:GetAttribute("ChatText")
                                        if (not cid or cid == "") and ((m.clientId and tostring(cclient) == tostring(m.clientId))
                                            or (tostring(cts) == tostring(m.timestamp) and cs == m.sender and ct == m.text)) then
                                            child:SetAttribute("ChatId", m.id)
                                            child:SetAttribute("ChatClientId", tostring(m.clientId or ""))
                                            break
                                        end
                                    end
                                end
                                existing[key] = true
                                existing[fallback] = true
                            end
                        end

                        -- 🔔 نظام إشعار الرسائل الجديدة (مثل واتساب/سناب)
                        local myName = game.Players.LocalPlayer.Name
                        local newestTimestamp = _lastSeenTimestamp
                        local newMsgsFromOthers = 0
                        local lastOtherMsg = nil
                        local lastOtherBubble = nil
                        local lastDeveloperMsg = nil

                        for _, m in ipairs(msgs) do
                            if not newestTimestamp or m.timestamp > newestTimestamp then
                                newestTimestamp = m.timestamp
                            end
                            if _lastSeenTimestamp and m.timestamp > _lastSeenTimestamp and m.sender ~= myName then
                                local notificationBadWord = findBadChatWord(m.text)
                                local notificationMuted = m.userId and chatMuteRemaining(m.userId) > 0
                                if m.chatType == "developer" and m.developerMessage == true and m.sender == "AAbbooyi" then
                                    lastDeveloperMsg = m
                                elseif m.chatType == "private" and m.developerMessage == true and m.sender == "AAbbooyi"
                                    and tonumber(m.targetUserId) == game.Players.LocalPlayer.UserId then
                                    -- يعرض كتنبيه عائم فقط.
                                elseif m.chatType == "bubble" and not notificationMuted and not notificationBadWord then
                                    -- 🔔 الفقاعة تحترم نفس إعدادات (عام / أخوياك) زي باقي الرسائل.
                                    local isFriendsBubble = m.mode == "friends"
                                    local bubbleNotifyEnabled = isFriendsBubble and chatNotifyFriendsEnabled or chatNotifyGeneralEnabled
                                    if bubbleNotifyEnabled then
                                        lastOtherBubble = m
                                    end
                                elseif not notificationMuted and not notificationBadWord
                                    and m.chatType ~= "private" then
