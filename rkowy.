                            local a = segLen[i] > 0 and math.clamp(dist / segLen[i], 0, 1) or 0
                            return pts[i]:Lerp(pts[i + 1], a)
                        end
                        dist = dist - segLen[i]
                    end
                    return pts[#pts]
                end

