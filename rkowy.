                }, stage)
                local pts, segLen, total = {}, {}, 1
                local function buildGeometry()
                    local vs = overlay.AbsoluteSize
                    if vs.X >= 10 and vs.Y >= 10 then W, H = vs.X, vs.Y end
                    pts, segLen, total = {}, {}, 0
                    for i, p in ipairs(st.path) do pts[i] = Vector2.new(p[1] * W, p[2] * H) end
                    for i = 1, #pts - 1 do
                        segLen[i] = (pts[i + 1] - pts[i]).Magnitude
                        total = total + segLen[i]
                    end
                    if total < 1 then total = 1 end
                    roadLayer:ClearAllChildren()
                    for i = 1, #pts - 1 do
                        local a, b = pts[i], pts[i + 1]
                        local mid = (a + b) / 2
                        local d = b - a
                        local seg = mk("Frame", {
                            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, mid.X, 0, mid.Y),
                            Size = UDim2.new(0, segLen[i] + ROAD_W, 0, ROAD_W), Rotation = math.deg(math.atan2(d.Y, d.X)),
                            BackgroundColor3 = Color3.fromRGB(70, 70, 76), BorderSizePixel = 0, ZIndex = Z + 2,
                        }, roadLayer)
                        mk("Frame", {
                            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(1, -ROAD_W, 0, 2),
