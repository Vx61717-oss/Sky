                local function step()
                    if #dirQ > 0 then dir = table.remove(dirQ, 1) end

                    -- 🧲 جذب التفاحة القريبة خطوة بخطوة نحو رأس الدودة
                    local magnetNow = os.clock()
                    if magnetEnabled and food then
                        if magnetActiveUntil <= 0 and magnetReadyAt <= magnetNow then
                            magnetActiveUntil = magnetNow + 5
                            magnetReadyAt = magnetNow + 30 -- 5 ثواني تشغيل + 25 ثانية انتظار
                        end
                        if magnetActiveUntil > magnetNow then
                            local hx, hz = cells[1][1], cells[1][2]
                            local dx, dz = hx - food[1], hz - food[2]
                            local dist = math.abs(dx) + math.abs(dz)
                            if dist > 0 and dist <= 4 then
                                local tx, tz = food[1], food[2]
                                if math.abs(dx) >= math.abs(dz) and dx ~= 0 then
                                    tx = tx + (dx > 0 and 1 or -1)
                                elseif dz ~= 0 then
                                    tz = tz + (dz > 0 and 1 or -1)
                                end
                                if not rockSet[key(tx, tz)] then
                                    local occupiedByBody = false
                                    for _, part in ipairs(cells) do
                                        if part[1] == tx and part[2] == tz then occupiedByBody = true break end
                                    end
                                    if not occupiedByBody then food = {tx, tz} end
                                end
                            end
                        end
                    end

                    local nx, nz = cells[1][1] + dir[1], cells[1][2] + dir[2]
                    local mapNow = os.clock()
                    local outsideMap = nx < 0 or nx >= N or nz < 0 or nz >= N
                    local phasing = emptyMapEnabled and emptyMapActiveUntil > mapNow
                    if wrapMode then
                        nx, nz = nx % N, nz % N
                    elseif outsideMap then
                        die("wall")
                        return
                    end
                    if rockSet[key(nx, nz)] and not phasing then
                        phasing = markEmptyMapRescue(mapNow)
                        if not phasing then
                            die("rock")
                            return
                        end
                    end
                    local ateFood = food and food[1] == nx and food[2] == nz
                    local ateGold = golden and golden[1] == nx and golden[2] == nz
                    local willPending = pending + ((ateFood and 1) or 0) + ((ateGold and 3) or 0)
                    local removeTail = (willPending == 0)
                    local limit = #cells - (removeTail and 1 or 0)
                    local hitsSelf = false
                    for i = 1, limit do
                        if cells[i][1] == nx and cells[i][2] == nz then
                            hitsSelf = true
                            break
                        end
                    end
                    if hitsSelf and not phasing then
                        phasing = markEmptyMapRescue(mapNow)
                        if not phasing then
                            die("self")
                            return
                        end
                    end
                    old = {}
                    for i, c in ipairs(cells) do old[i] = {c[1], c[2]} end
                    table.insert(cells, 1, {nx, nz})
                    if ateFood then
                        eat(false, nx, nz)
                        food = nil
                        -- تفاحة ذهبية كل 6 تفاحات
                        if not golden and foods > 0 and foods % 6 == 0 then
                            local gx, gz = freeCell(3)
                            if gx then golden, goldenT = {gx, gz}, 8 end
                        end
                    elseif ateGold then
                        eat(true, nx, nz)
                    end
                    if pending > 0 then
                        pending = pending - 1
                    else
                        table.remove(cells)
                    end
                    if not food then spawnFood() end
                    ensureParts(#cells)
                end

