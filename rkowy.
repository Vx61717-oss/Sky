                return n .. " " .. many
            end
            if d < 7 then return pick(d, "يوم", "يومين", "أيام") end
            if d < 30 then return pick(math.floor(d / 7), "أسبوع", "أسبوعين", "أسابيع") end
            if d < 365 then return pick(math.floor(d / 30.44), "شهر", "شهرين", "أشهر") end
