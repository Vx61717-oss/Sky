                -- 👹 الأعداء
                ------------------------------------------------------------
                local function removeEnemy(e)
                    for i = #enemies, 1, -1 do
                        if enemies[i] == e then
                            e.f:Destroy()
                            table.remove(enemies, i)
                            return true
                        end
                    end
                    return false
                end
                local function damageEnemy(e, amount)
                    e.hp = e.hp - amount
                    e.fill.Size = UDim2.new(math.clamp(e.hp / e.maxhp, 0, 1), 0, 1, 0)
                    if e.hp <= 0 and removeEnemy(e) then
                        kills = kills + 1
                        if e.boss then
                            bossKills = bossKills + 1
                            local r = bossReward(si, e.k)
                            pot = pot + r
                            showMsg("👑 ذبحت البوس! +" .. fmt(r) .. " ريال (تنستلم لما تفوز أو تخسر)", Color3.fromRGB(255, 215, 80))
                        end
                    end
                end
                local function spawnEnemy(isBoss)
                    local size = isBoss and 44 or 24
                    local spdBase = 15 * (1 + wave * 0.07) * st.spdMul
                    local hpv, dmg, spd
                    if isBoss then
                        hpv, dmg, spd = st.bossHp[bossIdx], st.bossDmg, spdBase * 0.7
                    else
                        hpv = math.max(1, math.floor((1 + wave * 0.5) * st.hpMul))
                        dmg = 1 + math.floor(wave / 4) + st.dmgAdd
                        spd = spdBase
                    end
                    local p0 = pathPos(0)
                    local f = mk("Frame", {
                        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, p0.X, 0, p0.Y), Size = UDim2.new(0, size, 0, size),
                        BackgroundColor3 = isBoss and Color3.fromRGB(150, 40, 200)
                            or Color3.fromRGB(200, 70, 70):Lerp(Color3.fromRGB(120, 20, 60), math.min(1, wave / 15)),
                        BorderSizePixel = 0, ZIndex = isBoss and Z + 6 or Z + 5,
                    }, stage)
                    round(f)
                    mk("UIStroke", {Color = isBoss and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(40, 0, 0), Thickness = isBoss and 3 or 2}, f)
                    if isBoss then
                        mk("TextLabel", {
                            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Font = Enum.Font.Arcade, TextSize = 22,
                            TextColor3 = Color3.new(1, 1, 1), Text = "👑", ZIndex = Z + 7,
                        }, f)
                    end
                    local back = mk("Frame", {
                        Size = UDim2.new(1, 8, 0, 5), Position = UDim2.new(0, -4, 0, -9), BackgroundColor3 = Color3.fromRGB(15, 15, 15),
                        BorderSizePixel = 0, ZIndex = Z + 7,
                    }, f)
                    local fill = mk("Frame", {
                        Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = isBoss and Color3.fromRGB(255, 190, 60) or Color3.fromRGB(230, 70, 70),
                        BorderSizePixel = 0, ZIndex = Z + 8,
                    }, back)
                    table.insert(enemies, {
                        f = f, fill = fill, t = 0, hp = hpv, maxhp = hpv, spd = spd, dmg = dmg,
                        boss = isBoss, k = isBoss and bossIdx or nil, pos = p0,
                    })
                end

                -- 🎲 تأخير النزول: مرات يطلعون ورا بعض على الخط (قطار 2-4 لاصقين)، ومرات بينهم مسافة تقدر تذبحهم فيها
                local function nextSpawnDelay()
                    local spd = 15 * (1 + wave * 0.07) * st.spdMul
                    local tight = 30 / spd -- الوقت اللي يتحرك فيه العدو 30 بكسل (يعني لاصق بالي قدامه)
                    if burstLeft > 0 then
                        burstLeft = burstLeft - 1
                        return tight
                    end
                    if spawnLeft >= 1 and math.random() < 0.6 then
                        burstLeft = math.min(math.random(1, 3), spawnLeft) - 1
                        return tight
                    end
                    return tight * (3 + math.random() * 3) -- مسافة فاضية بين المجموعات
                end

                local function beam(x1, y1, x2, y2, color)
                    local dx, dy = x2 - x1, y2 - y1
                    local b = mk("Frame", {
                        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, x1, 0, y1),
                        Size = UDim2.new(0, math.sqrt(dx * dx + dy * dy), 0, 3), Rotation = math.deg(math.atan2(dy, dx)),
                        BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = Z + 6,
                    }, stage)
                    task.delay(0.1, function() b:Destroy() end)
                end

                ------------------------------------------------------------
                -- 🏁 نهاية المرحلة
                ------------------------------------------------------------
                local function endStage(won)
                    if finished then return end
                    finished = true
                    if G then G.finished = true end
                    hideGhost()
                    if _G.SkyGameAudio then _G.SkyGameAudio.End("lane") end
                    local paid = pot
                    local eventBonusApplied = isMoney2xActive()
                    if eventBonusApplied then paid = paid * 2 end
                    data.wallet = data.wallet + paid
                    local gift = 0
                    if PITY_GIFT and paid == 0 and data.wallet < BOX_COST then
                        gift = BOX_COST - data.wallet
                        data.wallet = BOX_COST
                    end
                    data.run = nil
                    data.totalKills = math.max(0, tonumber(data.totalKills) or 0) + math.max(0, tonumber(kills) or 0)
                    local allDone = false
                    if won then
                        data.totalWins = math.max(0, tonumber(data.totalWins) or 0) + 1
                        data.stagesWon = type(data.stagesWon) == "table" and data.stagesWon or {}
                        data.stagesWon[tostring(si)] = true
                        if si >= #STAGES then
                            data.finished = true
                            allDone = true
                        else
                            data.unlocked = math.max(data.unlocked, si + 1)
                        end
                    end
                    saveData(data)
                    task.spawn(function() publishDefenseStats(data) end)
                    if not won and UI.ShowMathWrongImage then pcall(UI.ShowMathWrongImage) end

                    local title
                    if won then
                        title = allDone and "🏆 خلصت العوالم الثلاثة وكل المراحل! أسطورة" or ("🎉 فزت بالمرحلة " .. si)
                    else
                        title = "💀 وصل العدو إلى البيت! خسرت الجولة"
                    end
                    local text = title .. "\nالموجة " .. wave .. "/" .. WAVES_PER_STAGE .. "  |  قتلت " .. kills
                        .. "\n🏦 استلمت: " .. fmt(paid) .. " ريال"
                    if gift > 0 then text = text .. "\n💝 هدية تعويض: " .. gift .. " ريال" end
                    if eventBonusApplied then
                        text = text .. "\n💰 فعالية ×2 كانت مفعّلة عند استلام المكافأة!"
                    end
                    text = text .. "\n💰 محفظتك: " .. fmt(data.wallet) .. " ريال"
                    if won and not allDone then text = text .. "\n🔓 انفتحت المرحلة " .. (si + 1) end

                    local panel = mk("Frame", {
                        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, 310, 0, 210),
                        BackgroundColor3 = Color3.fromRGB(20, 18, 26), BorderSizePixel = 0, Active = true, ZIndex = Z + 40,
                    }, stage)
                    round(panel, UDim.new(0, 12))
                    mk("UIStroke", {Color = won and Color3.fromRGB(80, 230, 130) or Color3.fromRGB(230, 70, 70), Thickness = 2}, panel)
                    mk("TextLabel", {
                        BackgroundTransparency = 1, Size = UDim2.new(1, -20, 0, 140), Position = UDim2.new(0, 10, 0, 10),
                        Font = Enum.Font.Arcade, TextSize = 15, TextWrapped = true, TextColor3 = Color3.new(1, 1, 1),
                        Text = text, ZIndex = Z + 41,
                    }, panel)
                    local function panelBtn(label, xScale, callback)
                        local b = mk("TextButton", {
                            Size = UDim2.new(0.42, 0, 0, 36), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(xScale, 0, 1, -14),
                            BackgroundColor3 = BASE, BorderSizePixel = 0, AutoButtonColor = false, Font = Enum.Font.Arcade,
                            TextSize = 15, TextColor3 = Color3.new(1, 1, 1), Text = label, ZIndex = Z + 41,
                        }, panel)
                        round(b, UDim.new(0, 8))
                        mk("UIStroke", {Color = THEME, Thickness = 1.3}, b)
                        b.MouseButton1Click:Connect(callback)
                    end
                    panelBtn("🛒 المتجر", 0.06, function() showHub() end)
                    panelBtn("✖ خروج", 0.52, cleanup)
                end

                ------------------------------------------------------------
                -- 🌊 الموجات
                ------------------------------------------------------------
                local function startWave()
                    wave = wave + 1
                    bossIdx = nil
                    for k, bw in ipairs(BOSS_WAVES) do
                        if bw == wave then bossIdx = k end
                    end
                    local base = math.floor((2 + wave) * st.cntMul + 0.5)
                    if bossIdx then base = math.max(2, math.floor(base * 0.5)) end
                    spawnLeft = base + (bossIdx and 1 or 0)
                    bossPending = bossIdx ~= nil
                    spawnTimer, burstLeft, breakTimer = 0, 0, 5
                    if bossIdx then
                        showMsg("👑 موجة البوس " .. bossIdx .. "/" .. #BOSS_WAVES .. " !", Color3.fromRGB(255, 215, 80))
                    else
                        showMsg("الموجة " .. wave .. " 🔥")
                    end
                    saveRun()
                end

                goBtn.MouseButton1Click:Connect(function()
                    if started or finished then return end
                    if #defenders == 0 then
                        showMsg("ضع كائن واحد على الأقل قبل لا تبدأ", Color3.fromRGB(255, 220, 120))
                        return
                    end
                    started = true
                    goBtn.Visible = false
                    breakTimer = 3
                    refreshTray()
                    saveRun()
                end)

                -- ♻️ لو كمّلت من حفظ: نرجّع الموجة والكائنات
                if resume and data.run and data.run.stage == si then
                    wave = data.run.wave
                    houseHp = math.clamp(tonumber(data.run.houseHp) or houseMax, 1, houseMax)
                    pot = potForCleared(si, wave)
                    for _, bw in ipairs(BOSS_WAVES) do
                        if bw <= wave then bossKills = bossKills + 1 end
                    end
                    if type(data.run.placed) == "table" then
                        for _, p in ipairs(data.run.placed) do
                            local t = tonumber(p.t)
                            if t and CREATURES[t] and tonumber(p.x) and tonumber(p.y) and #defenders < MAX_DEF and unplaced(t) > 0 then
                                table.insert(defenders, buildDefender(t, tonumber(p.x), tonumber(p.y)))
                            end
                        end
                    end
                    goBtn.Text = "▶ كمّل الموجات"
                end
                refreshTray()
                if #defenders == 0 then
                    showMsg("ضع كائناتك من الأسفل ثم اضغط ابدأ", Color3.fromRGB(255, 220, 120))
                end

                -- 🔁 اللعبة كل فريم
                table.insert(stageConns, RunService.Heartbeat:Connect(function(dt)
                    if not running or finished then return end
                    dt = math.min(dt, 0.05) * gameSpeed
                    saveTimer = saveTimer + dt
                    if saveTimer >= 3 then
                        saveTimer = 0
                        saveRun()
                    end
                    local sc = math.clamp(H / 500, 0.7, 1.6)

                    if started then
                        -- 🌊 نزول الأعداء
                        if spawnLeft > 0 then
                            spawnTimer = spawnTimer - dt
                            if spawnTimer <= 0 then
                                if bossPending and spawnLeft == 1 then
                                    bossPending = false
                                    spawnEnemy(true)
                                else
                                    spawnEnemy(false)
                                end
                                spawnLeft = spawnLeft - 1
                                spawnTimer = nextSpawnDelay()
                            end
                        elseif #enemies == 0 then
                            if wave >= WAVES_PER_STAGE then
                                endStage(true)
                                return
                            end
                            breakTimer = breakTimer - dt
                            if breakTimer <= 0 then startWave() end
                        end

                        -- 👹 حركة الأعداء على الطريق
                        for i = #enemies, 1, -1 do
                            local e = enemies[i]
                            e.t = e.t + e.spd * dt / total
                            if e.t >= 1 then
                                if e.boss then
                                    -- 👑 إذا وصل البوس إلى حيوانك/نهاية الطريق تخسر فوراً؛ لا ينتقص دم البيت تدريجياً.
                                    endStage(false)
                                    return
                                end
                                houseHp = houseHp - e.dmg
                                flashT = 0.2
                                e.f:Destroy()
                                table.remove(enemies, i)
                            else
                                local p = pathPos(e.t)
                                e.pos = p
                                e.f.Position = UDim2.new(0, p.X, 0, p.Y)
                            end
                        end

                        -- 🐾 هجوم الكائنات (يضرب أقرب عدو لبيتك ضمن المدى)
                        for _, d in ipairs(defenders) do
                            d.cd = d.cd - dt
                            if d.cd <= 0 and #enemies > 0 then
                                local dx0, dy0 = d.px * W, d.py * H
                                local best
                                for _, e in ipairs(enemies) do
                                    local dist = math.sqrt((e.pos.X - dx0) ^ 2 + (e.pos.Y - dy0) ^ 2)
                                    if dist <= d.c.range * sc and (not best or e.t > best.t) then best = e end
                                end
                                if best then
                                    d.cd = 1 / d.c.rate
                                    local bx, by = best.pos.X, best.pos.Y
                                    beam(dx0, dy0, bx, by, d.c.color)
                                    if d.c.splash then
                                        for _, o in ipairs(table.clone(enemies)) do
                                            if o ~= best then
                                                local dd = math.sqrt((o.pos.X - bx) ^ 2 + (o.pos.Y - by) ^ 2)
                                                if dd <= d.c.splash * sc then damageEnemy(o, d.c.dmg * 0.5) end
                                            end
                                        end
                                    end
                                    damageEnemy(best, d.c.dmg)
                                end
                            end
                        end
                    end

                    -- الواجهة
                    waveHud.Text = "الموجة " .. wave .. "/" .. WAVES_PER_STAGE
                    local nb
                    for _, bw in ipairs(BOSS_WAVES) do
                        if bw >= math.max(wave, 1) then nb = bw break end
                    end
                    bossHud.Text = "👑 البوسات " .. bossKills .. "/" .. #BOSS_WAVES .. (nb and ("  (الجاي: الموجة " .. nb .. ")") or "")
                    potHud.Text = "🏦 مكافآت البوسات: " .. fmt(pot) .. " ريال"
                    hbFill.Size = UDim2.new(math.clamp(houseHp / houseMax, 0, 1), 0, 1, 0)
                    hbText.Text = math.max(0, houseHp) .. "/" .. houseMax
                    if flashT > 0 then
                        flashT = flashT - dt
                        topHouse.BackgroundColor3 = Color3.fromRGB(230, 70, 70)
                    else
                        topHouse.BackgroundColor3 = HOUSE_COLOR
                    end
                    if msgTimer > 0 then
                        msgTimer = msgTimer - dt
                        if msgTimer <= 0 then msg.Visible = false end
                    end

                    if houseHp <= 0 then endStage(false) end
                end))
            end

            showHub()
        end

