                    if not badge then
                        badge = pmMakeBadge(data.frame, UDim2.new(0, 12, 0.5, -22), Vector2.new(0.5, 0.5), UDim2.new(0, 20, 0, 16))
                    end
                    badge.Text = tostring(n)
                    badge.Visible = true
                elseif badge then
                    badge.Visible = false
                end
            end
