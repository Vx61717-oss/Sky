        -- ----- الإدخال -----
        local function pointerPx(input)
            local inset = ScreenGui.IgnoreGuiInset and Vector2.new(0, 0) or GuiService:GetGuiInset()
            return Vector2.new(input.Position.X, input.Position.Y) - inset
        end
        local function toBoard(p)
            local ap, as = surface.AbsolutePosition, surface.AbsoluteSize
            return (p.X - ap.X) / math.max(1, as.X) * B, (p.Y - ap.Y) / math.max(1, as.Y) * B
        end
        local function sameDrag(tracked, input)
            if tracked.UserInputType == Enum.UserInputType.Touch then return input == tracked end
            return input.UserInputType == Enum.UserInputType.MouseMovement
        end

        add(UserInputService.InputBegan:Connect(function(input)
