                    ttl.TextColor3 = Color3.fromRGB(120, 190, 255)
                    ttl.Font = Enum.Font.GothamBold
                    ttl.TextSize = 14
                    ttl.TextTruncate = Enum.TextTruncate.AtEnd
                    ttl.TextXAlignment = Enum.TextXAlignment.Center
                    ttl.ZIndex = 4
                    ttl.Parent = box

                    -- السطر الثاني: نص رسالته (يقص بنقاط لو طويل)
                    local bd = Instance.new("TextLabel")
                    bd.BackgroundTransparency = 1
                    bd.Position = UDim2.new(0, 10, 0, 26)
                    bd.Size = UDim2.new(1, -20, 0, 33)
                    bd.Text = body
                    bd.TextColor3 = Color3.fromRGB(255, 255, 255)
                    bd.Font = Enum.Font.Gotham
                    bd.TextSize = 13
                    bd.TextWrapped = true
                    bd.TextTruncate = Enum.TextTruncate.AtEnd
                    bd.TextXAlignment = Enum.TextXAlignment.Center
                    bd.TextYAlignment = Enum.TextYAlignment.Top
                    bd.ZIndex = 4
                    bd.Parent = box
                else
                    local txt = Instance.new("TextLabel")
                    txt.BackgroundTransparency = 1
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.Text = body
                    txt.TextColor3 = Color3.fromRGB(255, 255, 255)
                    txt.Font = Enum.Font.GothamBold
                    txt.TextSize = 17
                    txt.ZIndex = 4
                    txt.Parent = box
                end

                -- المنشن ينزل ببطء وبنعومة (من غير ارتداد)، و"تم النسخ" تبقى سريعة
                local inInfo = twoLine
                    and TweenInfo.new(1.1, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
                    or TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                SkyTw(holder, inInfo, {Position = shownPos}):Play()

                task.delay(duration or 1.5, function()
                    if serial ~= C.toastSerial or not gui.Parent then return end
                    local outInfo = twoLine
                        and TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
                        or TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                    local out = SkyTw(holder, outInfo, {Position = hiddenPos})
                    out:Play()
                    out.Completed:Wait()
                    if serial == C.toastSerial then
                        C.toastGui = nil
                    end
                    gui:Destroy()
