                    if finished or not selectedTier or not isPressType(input) then return end
                    dragging, dragInput = true, input
                    dragIsTouch = input.UserInputType == Enum.UserInputType.Touch
                    updateGhost(input.Position)
                end))
                table.insert(stageConns, UserInputService.InputChanged:Connect(function(input)
                    if not dragging then return end
                    if dragIsTouch then
                        if input ~= dragInput then return end
                    elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
                        return
                    end
                    updateGhost(input.Position)
                end))
