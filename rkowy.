        nameLbl.ZIndex = 61
        local nsc = Instance.new("UITextSizeConstraint", nameLbl)
        nsc.MaxTextSize = 12
        nsc.MinTextSize = 7

        local btn = Instance.new("TextButton", holder)
        btn.Size = UDim2.new(1, 0, 1, 0)
        btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        btn.AutoButtonColor = false
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.TextSize = 16
        btn.Font = Enum.Font.Arcade
        btn.ZIndex = 60
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
        local stroke = Instance.new("UIStroke", btn)
        stroke.Thickness = 2
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        local grad = AddMovingBorderGlow(stroke, 1.5, TOGGLE_OFF_COLOR)

        -- زر × صغير لإزالة الزر العائم
        local x = Instance.new("TextButton", holder)
        x.Size = UDim2.new(0, 18, 0, 18)
        x.AnchorPoint = Vector2.new(1, 0)
        x.Position = UDim2.new(1, 6, 0, -6)
        x.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
        x.Text = "×"
        x.TextColor3 = Color3.new(1, 1, 1)
        x.Font = Enum.Font.Arcade
        x.TextSize = 14
        x.ZIndex = 62
        Instance.new("UICorner", x).CornerRadius = UDim.new(1, 0)
        x.MouseButton1Click:Connect(function() holder:Destroy() end)

        -- يطابق الزر الأصلي: نفس النص (تشغيل/إيقاف) ونفس لون الحافة
        local function refresh()
            local on = false
            pcall(function() on = getter() == true end)
            local c = on and GetTabColorForInstance(pageForColor) or TOGGLE_OFF_COLOR
            btn.Text = _TranslateText(on and "إيقاف" or "تشغيل")
            stroke.Color = c
            stroke.Transparency = on and 0 or 0.7
            SetGlowColor(grad, c)
        end
        refresh()
        UI.ToggleListeners[txt] = UI.ToggleListeners[txt] or {}
        UI.ToggleListeners[txt][holder] = refresh
        holder.Destroying:Connect(function()
            if UI.ToggleListeners[txt] then UI.ToggleListeners[txt][holder] = nil end
            if UI.FloatingToggles[txt] == holder then UI.FloatingToggles[txt] = nil end
        end)

        -- السحب والضغط على الحاوية كلها (الزر + الاسم)، و × له ضغطته الخاصة
        local begin = UI.MakeDraggableTap(holder, function()
            playClick()
            local sset = UI.ToggleSetters[txt]
            if not sset then holder:Destroy() return end -- الميزة انشالت من القائمة
            sset(not getter(), true)
        end)
        -- الـ InputBegan حق الحاوية ما يوصله لمس الزر (لأنه Active)، فنربط الزر نفسه كمان
        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                begin(input, false)
            end
        end)
        return begin, holder
    end

    -- يربط المسكة الطويلة بصف الميزة كامل، مع مراقبة اللمس: أي حركة بسيطة أو تمرير للقائمة = إلغاء
    function UI.AttachFloatDrag(row, txt, pageForColor)
        local UIS = game:GetService("UserInputService")
        local MOVE_CANCEL = 4 -- بكسل: لو الإصبع تحرك أكثر من كذا قبل ما تكتمل المسكة نلغي
        local HOLD_TIME = 0.5

        -- 🟦 المنطقة تغطي الصف كامل (يمين ويسار)، لكنها تحت الاسم وزر التشغيل (ZIndex أقل)
        local zone = Instance.new("Frame", row)
        zone.Name = "FloatZone"
        zone.BackgroundTransparency = 1
        zone.BorderSizePixel = 0
        zone.Active = false
        zone.Size = UDim2.new(1, 0, 1, 0)
        zone.Position = UDim2.new(0, 0, 0, 0)
        zone.ZIndex = 6

        -- أقرب ScrollingFrame فوق الصف، عشان نعرف لو القائمة انسحبت وإحنا ماسكين
        local scroller = row.Parent
        while scroller and not scroller:IsA("ScrollingFrame") do scroller = scroller.Parent end

        local holding, token, startPos, startInput, startCanvas = false, 0, nil, nil, nil
        local function cancel() holding = false end

        zone.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
            holding = true
            token = token + 1
            startPos = input.Position
            startInput = input
            startCanvas = scroller and scroller.CanvasPosition or nil
            local my = token
            task.spawn(function()
                local t0 = os.clock()
                while holding and my == token and os.clock() - t0 < HOLD_TIME do
                    -- القائمة تحركت (تمرير) = ما نبي الزر العائم
                    if scroller and startCanvas and (scroller.CanvasPosition - startCanvas).Magnitude > 0.5 then
                        holding = false
                        break
                    end
                    task.wait(0.02)
                end
                if not holding or my ~= token then return end
                holding = false
                local ap = zone.AbsolutePosition - ScreenGui.AbsolutePosition
                local begin = UI.SpawnFloatToggle(txt, pageForColor, ap.X + 20, ap.Y + 10)
                if begin then begin(input, true) end
            end)
        end)

        -- مراقبة اللمس على مستوى الشاشة كلها (مو بس فوق المنطقة): أي حركة بسيطة تلغي
        local moveConn = UIS.InputChanged:Connect(function(input)
            if not holding or not startPos then return end
            local isMove = input.UserInputType == Enum.UserInputType.MouseMovement
                or (input.UserInputType == Enum.UserInputType.Touch and input == startInput)
            if isMove and (input.Position - startPos).Magnitude > MOVE_CANCEL then
                cancel()
            end
        end)
        local endConn = UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                cancel()
            end
        end)
        zone.Destroying:Connect(function()
            pcall(function() moveConn:Disconnect() end)
            pcall(function() endConn:Disconnect() end)
        end)
    end

