                    if not dragging then return end
                    if dragIsTouch then
                        if input ~= dragInput then return end
                    elseif input.UserInputType ~= Enum.UserInputType.MouseButton1 then
                        return
                    end
                    dragging = false
                    local ok, fx, fy = updateGhost(input.Position)
                    hideGhost()
                    if ok and selectedTier and unplaced(selectedTier) > 0 then
                        table.insert(defenders, buildDefender(selectedTier, fx, fy))
                        refreshTray()
                        saveRun()
                    end
                end))

