        local function physics(h)
            local n = #bodies
            for i = 1, n do
                local b = bodies[i]
                if b.alive then
                    b.x = b.x + b.vx * h
                    b.y = b.y + b.vy * h
                    local r = b.r
                    if b.x < r then
                        b.x = r
                        if -b.vx > 450 then impactFx(b.x, b.y) end
                        b.vx = -b.vx * E_WALL
                    elseif b.x > B - r then
                        b.x = B - r
                        if b.vx > 450 then impactFx(b.x, b.y) end
                        b.vx = -b.vx * E_WALL
                    end
                    if b.y < r then
                        b.y = r
                        if -b.vy > 450 then impactFx(b.x, b.y) end
                        b.vy = -b.vy * E_WALL
                    elseif b.y > B - r then
                        b.y = B - r
                        if b.vy > 450 then impactFx(b.x, b.y) end
                        b.vy = -b.vy * E_WALL
                    end
                    for k = 1, 4 do
                        local pk = POCKETS[k]
                        local dx, dy = b.x - pk.x, b.y - pk.y
                        local lim = POCKET_R * 0.84
                        if dx * dx + dy * dy < lim * lim then pocketBody(b, pk) break end
                    end
                    if b.alive then
                        local sp = math.sqrt(b.vx * b.vx + b.vy * b.vy)
                        if sp > 0 then
                            local k = FRIC + (sp < 300 and 2.4 or 0)
                            local f = math.exp(-k * h)
                            b.vx, b.vy = b.vx * f, b.vy * f
                            if sp * f < 14 then b.vx, b.vy = 0, 0 end
                        end
                    end
                end
            end
            for i = 1, n - 1 do
                local a = bodies[i]
                if a.alive then
                    for j = i + 1, n do
                        local b = bodies[j]
                        if b.alive then
                            local dx, dy = b.x - a.x, b.y - a.y
                            local rr = a.r + b.r
                            local d2 = dx * dx + dy * dy
                            if d2 < rr * rr and d2 > 1e-6 then
                                local d = math.sqrt(d2)
                                local nx, ny = dx / d, dy / d
                                local overlap = rr - d
                                local tm = a.m + b.m
                                a.x = a.x - nx * overlap * b.m / tm
                                a.y = a.y - ny * overlap * b.m / tm
                                b.x = b.x + nx * overlap * a.m / tm
                                b.y = b.y + ny * overlap * a.m / tm
                                local vn = (b.vx - a.vx) * nx + (b.vy - a.vy) * ny
                                if vn < 0 then
                                    local imp = -(1 + E_PIECE) * vn / (1 / a.m + 1 / b.m)
                                    a.vx = a.vx - imp * nx / a.m
                                    a.vy = a.vy - imp * ny / a.m
                                    b.vx = b.vx + imp * nx / b.m
                                    b.vy = b.vy + imp * ny / b.m
                                    if -vn > 350 then impactFx(a.x + nx * a.r, a.y + ny * a.r) end
                                end
                            end
                        end
                    end
                end
            end
        end

