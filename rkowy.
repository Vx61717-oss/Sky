        do -- 📋 نسخ الاسم/اليوزر بالضغط + تلميح وخط توصيل (متغير local واحد فقط لتفادي حد 200 متغير)
            local C = {}
            C.toastGui = nil
            C.toastSerial = 0

            -- 🔵 رسالة علوية: تنزل من فوق لمكان قريب من الأعلى، خلفية سوداء وحواف زرقاء بتوهج.
            -- بدون عنوان = "تم النسخ" (سطر واحد)، ومع عنوان = اسم + نص (للمنشن).
            function C.showToast(title, body, duration)
                body = body or "تم النسخ"
                local twoLine = title ~= nil
                C.toastSerial = C.toastSerial + 1
                local serial = C.toastSerial
                if C.toastGui then pcall(function() C.toastGui:Destroy() end) end

                local blue = Color3.fromRGB(0, 140, 255)
                local gui = Instance.new("ScreenGui")
                gui.Name = "SkyCopyToast"
                gui.ResetOnSpawn = false
                gui.IgnoreGuiInset = true
                gui.DisplayOrder = 1500
                gui.Parent = game.CoreGui
                C.toastGui = gui

                local shownPos = UDim2.new(0.5, 0, 0, 26)
                local hiddenPos = UDim2.new(0.5, 0, 0, twoLine and -100 or -70)

                local holder = Instance.new("Frame")
                holder.AnchorPoint = Vector2.new(0.5, 0)
                holder.Size = twoLine and UDim2.new(0, 290, 0, 66) or UDim2.new(0, 150, 0, 40)
                holder.Position = hiddenPos
                holder.BackgroundTransparency = 1
                holder.BorderSizePixel = 0
                holder.Parent = gui

                local function makeGlow(grow, transparency, z)
                    local g = Instance.new("ImageLabel")
                    g.BackgroundTransparency = 1
                    g.Position = UDim2.new(0, -grow, 0, -grow)
                    g.Size = UDim2.new(1, grow * 2, 1, grow * 2)
                    g.Image = "rbxassetid://6014264795"
                    g.ImageColor3 = blue
                    g.ImageTransparency = transparency
                    g.ZIndex = z
                    g.Parent = holder
                end
                makeGlow(30, 0.55, 1)
                makeGlow(14, 0.3, 2)

                local box = Instance.new("Frame")
                box.Size = UDim2.new(1, 0, 1, 0)
                box.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                box.BorderSizePixel = 0
                box.ZIndex = 3
                box.Parent = holder
                Instance.new("UICorner", box).CornerRadius = UDim.new(0, 12)

                local boxStroke = Instance.new("UIStroke", box)
                boxStroke.Color = blue
                boxStroke.Thickness = 2.2
