            -- إضافة تأثيرات hover على الزر
            btn.MouseEnter:Connect(function()
                SkyTw(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    BackgroundColor3 = Color3.fromRGB(35, 35, 35) -- لون أغمق قليلاً عند المرور فوقه
                }):Play()
                if not act then -- فقط إذا لم يكن الزر نشطًا بالفعل
                    SkyTw(stroke, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Transparency = 0, -- يصبح أوضح
                        Thickness = 3 -- يصبح أسمك قليلاً
                    }):Play()
                end
            end)
            btn.MouseLeave:Connect(function()
                SkyTw(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    BackgroundColor3 = Color3.fromRGB(25, 25, 25) -- يعود للونه الأصلي
                }):Play()
                if not act then -- فقط إذا لم يكن الزر نشطًا بالفعل
                    SkyTw(stroke, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Transparency = 0.7, -- يعود لشفافيته الأصلية
                        Thickness = 2 -- يعود لسمكه الأصلي
                    }):Play()
                end
            end)

            local act = false
            local function applyToggle(newAct)
                local wasAct = act
                act = newAct
                local _onColor = GetTabColorForInstance(parent) -- 🎨 نجيب اللون الحالي وقت الضغط (مو محفوظ من قبل) عشان يطابق أي تغيير سويته من تاب الإعدادات
                btn.Text = _TranslateText(act and "إيقاف" or "تشغيل")
                stroke.Color = act and _onColor or TOGGLE_OFF_COLOR
                stroke.Transparency = 0
                SetGlowColor(_btnGlowGrad, act and _onColor or TOGGLE_OFF_COLOR) -- 🎨 نحدّث لون الحافة المتحركة نفسها
                _activeGlow(stroke, act, _onColor)
                -- 🔢 نعدّل العداد فقط لو الحالة تغيّرت فعلاً (يمنع النقص/الزيادة الخاطئة)
                -- ونحسبه على صفحة التاب الأصلية حتى لو الزر داخل حاوية فرعية
                local badgePage = UI.ResolveBadgePage(parent)
                if badgePage and act ~= wasAct then
                    UI.activeCounts[badgePage] = (UI.activeCounts[badgePage] or 0) + (act and 1 or -1)
                    if UI.activeCounts[badgePage] < 0 then UI.activeCounts[badgePage] = 0 end
                end
                UpdateBadge(parent)
                local _L = UI.ToggleListeners[txt]
                if _L then for _, _fn in pairs(_L) do pcall(_fn) end end -- يحدّث لون الأزرار العائمة
                call(act)
            end
            btn.MouseButton1Click:Connect(function() 
                playClick()
                applyToggle(not act)
                -- زر السيرفر أمر لحظي، ولا يتم حفظ حالته أبداً.
                if txt ~= "سيرفر" then
                    SaveConfig()
                end
            end)
            -- 💾 تسجيل الأزرار في نظام الحفظ، باستثناء زر السيرفر (أمر لحظي) وأزرار تاب السكربت (ما تنحفظ).
            if txt ~= "سيرفر" and parent ~= UI.Page6 then
                UI.ConfigRegistry[txt] = {
                    get = function() return act end,
                    default = false,
                    apply = function(value) applyToggle(value == true) end
                }
            end
            -- 🎨 نسجّل هذا الزر عشان لو غيّرنا لون التاب من تاب الإعدادات وهو مفعّل حاليًا، يتحدث لونه فورًا بدون ما نحتاج نضغط عليه
            do
                local idxForWatch = GetTabIndexForInstance(parent)
                UI.ActiveToggleWatchers[idxForWatch] = UI.ActiveToggleWatchers[idxForWatch] or {}
                table.insert(UI.ActiveToggleWatchers[idxForWatch], {
                    stroke = stroke,
                    glow = _btnGlowGrad,
                    isActive = function() return act end
                })
            end

            -- 🔧 مفتاح داخلي: أي قائمة فرعية تقدر الآن ترجع زرها الرئيسي
            -- لحالة "تشغيل" بدون ترك الحالة البصرية عالقة على "إيقاف".
            UI.ToggleButtons = UI.ToggleButtons or {}
            UI.ToggleButtons[txt] = {btn = btn, stroke = stroke}
            UI.ToggleGetters[txt] = function() return act end
            UI.AttachFloatDrag(f, txt, parent)
            UI.ToggleSetters[txt] = function(value, save)
                applyToggle(value == true)
                if save and txt ~= "سيرفر" then
                    SaveConfig()
                end
            end

            return btn, stroke, _btnGlowGrad
        end
    end

