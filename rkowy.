                local function checkSpot(x, y, sz)
                    local fx, fy = x / sz.X, y / sz.Y
                    local maxY = math.min(0.82, 1 - 96 / sz.Y)
                    if #defenders >= MAX_DEF then return false, fx, fy end
                    if fx < 0.04 or fx > 0.96 or fy < 0.12 or fy > maxY then return false, fx, fy end
                    for _, hp in ipairs({st.path[1], st.path[#st.path]}) do
                        if math.abs(hp[1] * sz.X - x) < 76 and math.abs(hp[2] * sz.Y - y) < 46 then return false, fx, fy end
                    end
                    for _, d in ipairs(defenders) do
                        local ddx, ddy = d.px * sz.X - x, d.py * sz.Y - y
                        if math.sqrt(ddx * ddx + ddy * ddy) < PLACE_MIN_GAP then return false, fx, fy end
                    end
                    return true, fx, fy
                end

                local dragging, dragInput, dragIsTouch = false, nil, false
                local function updateGhost(pos)
                    if not selectedTier then hideGhost() return false end
                    local c = petStats(selectedTier, data.petLv and data.petLv[selectedTier] or 1)
                    local abs, sz = overlay.AbsolutePosition, overlay.AbsoluteSize
                    local x = pos.X - abs.X
                    local y = pos.Y - abs.Y - (dragIsTouch and TOUCH_OFFSET or 0)
                    local ok, fx, fy = checkSpot(x, y, sz)
                    local sc = math.clamp(sz.Y / 500, 0.7, 1.6)
                    local col = ok and Color3.fromRGB(120, 255, 150) or Color3.fromRGB(255, 90, 90)
                    ghost.Position = UDim2.new(0, x, 0, y)
