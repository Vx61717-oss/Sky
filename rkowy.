    -- مسكة طويلة على المنطقة اللي بين الاسم والزر → يطلع زر عائم تسحبه وين تبي وتضغطه بدون ما تفتح القائمة.
    UI.ToggleGetters = UI.ToggleGetters or {}
    UI.ToggleListeners = UI.ToggleListeners or {}
    UI.FloatingToggles = UI.FloatingToggles or {}

    -- يخلّي أي زر قابل للسحب + ضغطة عادية (tap). يرجّع دالة تبدأ السحب فوراً (تستخدمها المسكة الطويلة)
    function UI.MakeDraggableTap(btn, onTap)
        local UIS = game:GetService("UserInputService")
        local active, moved, last, startInput = false, 0, nil, nil
        local conns = {}
        local function begin(input, noTap)
            active = true
            moved = noTap and 999 or 0
            last = input.Position
            startInput = input
        end
        table.insert(conns, btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                begin(input, false)
            end
        end))
        table.insert(conns, UIS.InputChanged:Connect(function(input)
            if not active then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or (input.UserInputType == Enum.UserInputType.Touch and input == startInput) then
                local d = input.Position - last
                last = input.Position
                moved = moved + d.Magnitude
                if moved > 8 then
                    local screen = ScreenGui.AbsoluteSize
                    local x = math.clamp(btn.Position.X.Offset + d.X, 0, math.max(0, screen.X - btn.AbsoluteSize.X))
                    local y = math.clamp(btn.Position.Y.Offset + d.Y, 0, math.max(0, screen.Y - btn.AbsoluteSize.Y))
                    btn.Position = UDim2.new(0, x, 0, y)
                end
            end
        end))
        table.insert(conns, UIS.InputEnded:Connect(function(input)
            if not active then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or (input.UserInputType == Enum.UserInputType.Touch and input == startInput) then
                active = false
                if moved <= 8 and onTap then onTap() end
            end
        end))
        btn.Destroying:Connect(function()
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        end)
        return begin
    end

    -- ينشئ الزر العائم للميزة: نفس شكل زر التشغيل/الإيقاف حقها بالضبط (نفس النص واللون والحافة المتحركة)
