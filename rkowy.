        pmRefreshBadges = function()
            -- العدد الكلي فوق زر "💬 خاص" (يختفي بعد ما تفتح القائمة)
            local dmBtn = ChatInputBar:FindFirstChild("DmOpenBtn")
            if dmBtn and not pmTotalBadge then
                pmTotalBadge = pmMakeBadge(dmBtn, UDim2.new(1, 2, 0, -2), Vector2.new(0.5, 0.5), UDim2.new(0, 20, 0, 16))
            end
            if pmTotalBadge then
                local t = pmTotalCount()
                pmTotalBadge.Text = tostring(t)
                pmTotalBadge.Visible = pmTotalShown and t > 0
            end
            -- عدد كل شخص فوق رأسه بالقائمة (يبان بعد ما تفتح القائمة)
            for name, data in pairs(dmListRows) do
                local uid = dmResolveUserId(name)
                local n = uid and (pmUnread[uid] or 0) or 0
                local badge = data.frame:FindFirstChild("PmBadge")
