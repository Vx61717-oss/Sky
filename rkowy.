                    local x, y = 500 + math.cos(a) * rad, 500 + math.sin(a) * rad
                    local ok = true
                    for _, p in ipairs(pieces) do
                        if p.alive and p ~= me then
                            local dx, dy = p.x - x, p.y - y
                            local rr = p.r + r + 3
                            if dx * dx + dy * dy < rr * rr then ok = false break end
                        end
                    end
                    if ok then return x, y end
                end
            end
            return 500, 500
        end
