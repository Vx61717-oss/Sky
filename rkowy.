        SkyAI.norm = function(s)
            local ok, res = pcall(function()
                local map = {["أ"] = "ا", ["إ"] = "ا", ["آ"] = "ا", ["ة"] = "ه", ["ى"] = "ي", ["ؤ"] = "و", ["ئ"] = "ي", ["ـ"] = "", ["؟"] = " ", ["،"] = " ", ["؛"] = " "}
                local out = {}
                for ch in tostring(s):lower():gmatch(utf8.charpattern) do
                    local cp = utf8.codepoint(ch)
                    if not (cp >= 0x64B and cp <= 0x652) then -- نشيل التشكيل
                        local m = map[ch]
                        if m == nil then out[#out + 1] = ch elseif m ~= "" then out[#out + 1] = m end
                    end
                end
                local r = table.concat(out):gsub("%p", " "):gsub("%s+", " ")
                return r
            end)
            if ok and type(res) == "string" then return res end
            return ""
        end

        SkyAI.localAnswer = function(question)
            local q = " " .. SkyAI.norm(question) .. " "
            local qLen = utf8.len(question) or #question
            for _, e in ipairs(SkyAI.FAQ) do
                if not e.max or qLen <= e.max then
                    local allOk = true
                    for _, group in ipairs(e.g) do
                        local hit = false
                        for _, kw in ipairs(group) do
                            local nk = SkyAI.norm(kw)
                            if nk ~= "" and q:find(nk, 1, true) then hit = true; break end
                        end
                        if not hit then allOk = false; break end
                    end
                    if allOk then return e.a end
                end
            end
            return nil
        end

        SkyAI.parse = function(text)
            local t = text:gsub("^%s+", "")
            local low = t:lower()
            for _, p in ipairs({"/ai ", "@sky ", "@ai "}) do
                if low:sub(1, #p) == p then return t:sub(#p + 1) end
            end
            if t:sub(1, #"سكاي ") == "سكاي " then return t:sub(#"سكاي " + 1) end
            return nil
        end

