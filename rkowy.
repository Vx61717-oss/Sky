    -- ====================== 🧩 أزرار تاب 2 اللي تطلع من تاب السكربت (محد يقدر يمسك / طيّر الماسك / قصف القنابل) ======================
    do
        local _RS = game:GetService("RunService")
        local _RepStorage = game:GetService("ReplicatedStorage")
        local _Plrs = game:GetService("Players")
        local _me = _Plrs.LocalPlayer

        -- الأزرار تنزل بعد أول كم زر في قائمة التخريب (غيّر الرقم لو تبيها أعلى/أنزل، 0 = أول القائمة)
        local INSERT_AFTER = 2

        local function triggerStruggleFactory()
            local lastTick, cooldown = 0, 0.05
            return function()
                local t = tick()
                if t - lastTick >= cooldown then
                    lastTick = t
                    pcall(function()
                        local events = _RepStorage:FindFirstChild("CharacterEvents")
                        local struggle = events and events:FindFirstChild("Struggle")
                        if struggle then struggle:FireServer() end
                    end)
                end
            end
        end

        -- يرتّب أزرار تاب 2 الإضافية بعد أول INSERT_AFTER أزرار
        local function ReorderTab2()
            local holder = UI.TrollControls
            if not holder then return end
            local idx, extras = 0, {}
            for _, c in ipairs(holder:GetChildren()) do
                if c:IsA("Frame") then
                    if c:GetAttribute("SkyTab2Extra") then
                        table.insert(extras, c)
                    else
                        idx = idx + 1
                        c.LayoutOrder = idx * 10
                    end
                end
            end
            table.sort(extras, function(a, b) return a:GetAttribute("SkyTab2Extra") < b:GetAttribute("SkyTab2Extra") end)
            for j, c in ipairs(extras) do
                c.LayoutOrder = INSERT_AFTER * 10 + j
            end
        end

        local Features = {} -- كل ميزة تسجّل نفسها هنا، وزر واحد في تاب السكربت يطلّعها/يشيلها كلها

        -- يسجّل ميزة: زر مقابل في تاب 2 (يطلع ويختفي مع زر تاب السكربت الواحد)
        -- cfg: tab6 (اسم زر تاب السكربت) | item (اسم زر تاب 2) | order | start(reject) | stop() | onMsg | offMsg
        local function MakeFeature(cfg)
            local frame = nil

            local function AddTab2Item()
                if frame and frame.Parent then return end
                local holder = UI.TrollControls
                if not holder then return end
                local btn = NewItem(cfg.item, "Button", function(v)
                    if v then
                        cfg.start(function()
                            -- رفض التشغيل: نرجّع الزر لإيقاف
                            task.defer(function()
                                local s = UI.ToggleSetters[cfg.item]
                                if s then s(false) end
                            end)
                        end)
                        OK(cfg.onMsg)
                    else
                        cfg.stop()
                        OK(cfg.offMsg)
                    end
                end, holder)
                frame = btn and btn.Parent
                if frame then
                    frame:SetAttribute("SkyTab2Extra", cfg.order)
                    ReorderTab2()
                end
            end

            local function RemoveTab2Item()
                -- نطفي الميزة أول (يحدّث العدّاد والشارة) وبعدها نحذف الزر
                local setter = UI.ToggleSetters[cfg.item]
                if setter then pcall(setter, false) end
                cfg.stop()
                UI.ToggleSetters[cfg.item] = nil
                UI.ConfigRegistry[cfg.item] = nil
                if frame then pcall(function() frame:Destroy() end) end
                frame = nil
            end

            table.insert(Features, {add = AddTab2Item, remove = RemoveTab2Item})
        end

        -- ------------------------------------------------------------------
        -- 1) 🛡️ محد يقدر يمسك
        -- ------------------------------------------------------------------
        do
            local conn = nil
            local locked, lockedCFrame = false, nil
            local triggerStruggle = triggerStruggleFactory()

            MakeFeature({
                tab6 = "محد يقدر يمسك",
                item = "🛡️ محد يقدر يمسك",
                order = 1,
                onMsg = "🛡️ محد يقدر يمسك: تشغيل",
                offMsg = "🛡️ محد يقدر يمسك: إيقاف",
                start = function()
                    if conn then return end
                    locked, lockedCFrame = false, nil
                    conn = _RS.RenderStepped:Connect(function()
                        local character = _me.Character
                        if not character then return end
                        local humanoid = character:FindFirstChildOfClass("Humanoid")
                        local rootPart = character:FindFirstChild("HumanoidRootPart")
                        if not humanoid or not rootPart then return end

                        local velocity = rootPart.AssemblyLinearVelocity
                        local isRestrained = humanoid.PlatformStand or humanoid.Sit
                        local isFlyingUp = velocity.Y > 75
                        local isStopped = velocity.Magnitude < 1 and humanoid.MoveDirection.Magnitude <= 0
                        local isGrabbed = isStopped and (isRestrained or rootPart.Anchored)
                        local shouldLock = isRestrained or isFlyingUp or isGrabbed

                        if shouldLock then
                            if not locked then
                                locked = true
                                lockedCFrame = rootPart.CFrame -- نحفظ مكانك لحظة اكتشاف المسك
                            end
                            rootPart.AssemblyLinearVelocity = Vector3.zero
                            rootPart.AssemblyAngularVelocity = Vector3.zero
                            if lockedCFrame then rootPart.CFrame = lockedCFrame end
                            triggerStruggle()
                        else
                            if locked then locked, lockedCFrame = false, nil end
                        end
                    end)
                end,
                stop = function()
                    if conn then conn:Disconnect() conn = nil end
                    locked, lockedCFrame = false, nil
                end,
            })
        end

        -- ------------------------------------------------------------------
        -- 2) 🌀 طيّر الماسك (سكربت تد_تد: أي لاعب يلصق فيك أو يمسكك يتطيّر)
        -- ------------------------------------------------------------------
        do
            local hb = nil
            local evConns = {}
            local grabbedActive = false
            local triggerStruggle = triggerStruggleFactory()

            MakeFeature({
                tab6 = "طيّر الماسك",
                item = "🌀 طيّر الماسك",
                order = 2,
                onMsg = "🌀 طيّر الماسك: تشغيل",
                offMsg = "🌀 طيّر الماسك: إيقاف",
                start = function()
                    if hb then return end
                    grabbedActive = false
                    -- مراقبة أحداث الـ Grab
                    pcall(function()
                        local grabEvents = _RepStorage:FindFirstChild("GrabEvents")
                        if grabEvents then
                            for _, event in ipairs(grabEvents:GetChildren()) do
                                if event:IsA("RemoteEvent") then
                                    table.insert(evConns, event.OnClientEvent:Connect(function()
                                        grabbedActive = true
                                        task.delay(1, function() grabbedActive = false end)
                                    end))
                                end
                            end
                        end
                    end)
                    hb = _RS.Heartbeat:Connect(function()
                        local character = _me.Character
                        if not character then return end
                        local rootPart = character:FindFirstChild("HumanoidRootPart")
                        if not rootPart then return end
                        pcall(function()
                            for _, otherPlayer in ipairs(_Plrs:GetPlayers()) do
                                if otherPlayer ~= _me and otherPlayer.Character then
                                    local otherRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
                                    if otherRoot then
                                        local distance = (rootPart.Position - otherRoot.Position).Magnitude
                                        -- إذا لصق فيك أو تفعّل الـ Grab
                                        if distance < 4 or grabbedActive then
                                            otherRoot.AssemblyLinearVelocity = Vector3.new(math.random(-5000, 5000), 7000, math.random(-5000, 5000))
                                            otherRoot.AssemblyAngularVelocity = Vector3.new(math.random(-4000, 4000), 4000, math.random(-4000, 4000))
                                            triggerStruggle()
                                        end
                                    end
                                end
                            end
                        end)
                    end)
                end,
                stop = function()
                    if hb then hb:Disconnect() hb = nil end
                    for _, c in ipairs(evConns) do pcall(function() c:Disconnect() end) end
                    evConns = {}
                    grabbedActive = false
                end,
            })
        end

        -- ------------------------------------------------------------------
        -- 3) 💣 قصف القنابل (سكربت ترتبتي: يقصف اللاعب المحدد في تاب 2)
        -- ------------------------------------------------------------------
        do
            local bombRunning = false
            local bombGen = 0

            local function GetRemotes()
                local mt = _RepStorage:FindFirstChild("MenuToys")
                local be = _RepStorage:FindFirstChild("BombEvents")
                local ge = _RepStorage:FindFirstChild("GrabEvents")
                local spawnRemote = mt and mt:FindFirstChild("SpawnToyRemoteFunction")
                local explodeRemote = be and be:FindFirstChild("BombExplode")
                local networkRemote = ge and ge:FindFirstChild("SetNetworkOwner")
                return spawnRemote, explodeRemote, networkRemote
            end

            local function executePerfectBomb(targetPlayer, spawnRemote, explodeRemote, networkRemote, gen)
                local function alive() return bombRunning and bombGen == gen end
                local myRoot = _me.Character and (_me.Character:FindFirstChild("HumanoidRootPart") or _me.Character:FindFirstChild("Torso"))
                if not myRoot or not targetPlayer or not targetPlayer.Character then return end
                local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart") or targetPlayer.Character:FindFirstChild("Torso")
                if not targetRoot then return end

                local folderName = _me.Name .. "SpawnedInToys"
                local toyFolder = workspace:FindFirstChild(folderName)
                if toyFolder then
                    for _, obj in pairs(toyFolder:GetChildren()) do
                        if obj.Name == "BombMissile" then obj:Destroy() end
                    end
                end

                local myHeadCF = myRoot.CFrame * CFrame.new(0, 12, 0)
                task.spawn(function()
                    spawnRemote:InvokeServer("BombMissile", myHeadCF, Vector3.new(0, 0, 0))
                end)

                local bombModel = nil
                local startTime = tick()
                while not bombModel and (tick() - startTime) < 2 do
                    toyFolder = workspace:FindFirstChild(folderName)
                    if toyFolder then bombModel = toyFolder:FindFirstChild("BombMissile") end
                    task.wait(0.02)
                end
                if not bombModel or not alive() then return end

                local buttonPart = bombModel:WaitForChild("Button", 1)
                local hitDetector = bombModel:WaitForChild("PartHitDetector", 1)
                local bodyPart = bombModel:WaitForChild("Body", 1)
                if not buttonPart or not hitDetector or not bodyPart then return end

                for _, part in pairs(bombModel:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                        part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    end
                end

                task.wait(0.5)
                if not alive() then return end

                networkRemote:FireServer(buttonPart, buttonPart.CFrame)
                local clickDetector = buttonPart:FindFirstChildWhichIsA("ClickDetector")
                if clickDetector and fireclickdetector then
                    fireclickdetector(clickDetector)
                end

                if not alive() or not targetRoot or not targetRoot.Parent then return end

                for _, part in pairs(bombModel:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = true end
                end

                local targetVelocity = targetRoot.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
                local predictedPosition = targetRoot.Position + (targetVelocity * 0.28) + Vector3.new(0, 1.5, 0)
                local targetCF = CFrame.new(predictedPosition)

                if bombModel:IsA("Model") then bombModel:PivotTo(targetCF) end
                for _, part in pairs(bombModel:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CFrame = targetCF
                        part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    end
                end

                explodeRemote:FireServer({
                    ["Radius"] = 50,
                    ["TimeLength"] = 0.2,
                    ["Hitbox"] = hitDetector,
                    ["ExplodesByFire"] = true,
                    ["MaxForcePerStudSquared"] = 1000,
                    ["DestroysModel"] = true,
                    ["Model"] = bombModel,
                    ["ExplodesByPointy"] = false,
                    ["ImpactSpeed"] = 35,
                    ["PositionPart"] = bodyPart,
                }, predictedPosition)
            end

            MakeFeature({
                tab6 = "قصف القنابل",
                item = "💣 قصف القنابل",
                order = 3,
                onMsg = "💣 قصف القنابل: تشغيل",
                offMsg = "💣 قصف القنابل: إيقاف",
                start = function(reject)
                    local target = State.selectedPlayer
                    if not target then
                        WARN("⚠️ اختر لاعب من القائمة أول!")
                        reject()
                        return
                    end
                    local spawnRemote, explodeRemote, networkRemote = GetRemotes()
                    if not spawnRemote or not explodeRemote or not networkRemote then
                        WARN("⚠️ ريموتات القنابل مو موجودة بهالماب")
                        reject()
                        return
                    end
                    bombGen = bombGen + 1
                    local gen = bombGen
                    bombRunning = true
                    task.spawn(function()
                        while bombRunning and bombGen == gen do
                            local t = State.selectedPlayer
                            if not t or not t.Parent then
                                -- الهدف راح أو انشال التحديد: نوقف
                                reject()
                                break
                            end
                            pcall(executePerfectBomb, t, spawnRemote, explodeRemote, networkRemote, gen)
                            task.wait(0.3)
                        end
                    end)
                end,
                stop = function()
                    bombRunning = false
                    bombGen = bombGen + 1
                end,
            })
        end

        -- ------------------------------------------------------------------
        -- 🎛️ زر واحد في تاب السكربت يطلّع كل أزرار تاب 2 اللي فوق (أو يشيلها كلها)
        -- ------------------------------------------------------------------
        NewItem("اطفاء الاشياء", "Toggle", function(v)
            if v then
                task.spawn(function()
                    -- لو انشغل وقت التحميل قبل ما تنبني قائمة التخريب، ننتظرها شوي
                    for _ = 1, 50 do
                        if UI.TrollControls then break end
                        task.wait(0.1)
                    end
                    for _, f in ipairs(Features) do f.add() end
                    OK("➕ انضافت أزرار السكربتات في تاب 2")
                end)
            else
                for _, f in ipairs(Features) do f.remove() end
                OK("➖ انشالت أزرار السكربتات من تاب 2")
            end
        end, UI.Page6)
    end

    -- ====================== 🧱 منصة ثابتة (تاب السكربت) ======================
    do
        -- 🧩 قائمة جاهزة بستايل السكربت (حدود بلون التاب + سحب + تصغير + X + ظهور تدريجي)
        local function MakePanel(name, titleText, h, page, toggleName)
            local color = GetTabColorForInstance(page)
            local panel = Instance.new("Frame")
            panel.Name, panel.Size, panel.AnchorPoint = name, UDim2.new(0, 190, 0, h), Vector2.new(0.5, 0.5)
            panel.Position = UDim2.new(0.5, 265, 0.42, 0)
            panel.BackgroundColor3, panel.ClipsDescendants, panel.ZIndex = Color3.fromRGB(15, 15, 15), true, 1
            panel.Parent = NG
            Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 12)
            local stroke = Instance.new("UIStroke", panel)
            stroke.Color, stroke.Thickness = color, 2
            AddTabGlow(stroke, 1.5, page)
            State.FadeInPanel(panel, 0.35)
            MakeDraggable(panel)

            local title = Instance.new("TextLabel", panel)
            title.Size, title.Position, title.BackgroundTransparency = UDim2.new(1, -68, 0, 32), UDim2.new(0, 12, 0, 0), 1
            title.Text, title.TextColor3, title.Font, title.TextSize = titleText, color, Enum.Font.Arcade, 15
            title.TextXAlignment = Enum.TextXAlignment.Left

            local function small(text, x, textColor)
                local b = Instance.new("TextButton", panel)
                b.Size, b.Position, b.BackgroundColor3 = UDim2.new(0, 26, 0, 26), UDim2.new(1, x, 0, 3), Color3.fromRGB(35, 35, 35)
                b.Text, b.TextColor3, b.TextScaled, b.Font, b.AutoButtonColor = text, textColor, true, Enum.Font.Arcade, false
                Instance.new("UICorner", b)
                local g = Instance.new("UIStroke", b)
                g.Thickness = 1.5
                AddTabGlow(g, 1.5, page)
                return b
            end

            local body, collapsed = {}, false
            small("X", -32, Color3.fromRGB(255, 70, 70)).MouseButton1Click:Connect(function()
                playClick()
                local setter = UI.ToggleSetters[toggleName]
                if setter then setter(false, true) end
            end)
            local minBtn = small("−", -62, Color3.new(1, 1, 1))
            minBtn.MouseButton1Click:Connect(function()
                if not State.LockPanelToggle(panel) then return end
                playClick()
                collapsed = not collapsed
                minBtn.Text = collapsed and "+" or "−"
                for _, item in ipairs(body) do
                    if not collapsed then item.Visible = true end
                    task.delay(0.2, function() if collapsed then item.Visible = false end end)
                end
                State.TweenPanelHeight(panel, collapsed and h or 38, collapsed and 38 or h, 190)
            end)
            return panel, body
        end

        -- 🧱 منطق المنصة: تتبعك أفقيًا وتثبت الارتفاع لحظة التشغيل
        local plat, conn
        local function stop()
            if conn then conn:Disconnect() conn = nil end
            if plat then plat:Destroy() plat = nil end
        end
        local function start()
            stop()
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return false end
            local y = hrp.Position.Y - 3.5
            plat = Instance.new("Part")
            plat.Name, plat.Size, plat.Anchored = "SkyPlatform", Vector3.new(6, 1, 6), true
            plat.BrickColor, plat.Material = BrickColor.new("Bright blue"), Enum.Material.SmoothPlastic
            plat.Position = Vector3.new(hrp.Position.X, y, hrp.Position.Z)
            plat.Parent = workspace
            conn = RunService.RenderStepped:Connect(function()
                local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if r and plat then plat.Position = Vector3.new(r.Position.X, y, r.Position.Z) end
            end)
            return true
        end

        State.platformOn = false
        State.ClosePlatformPanel = function()
            stop()
            State.platformOn = false
            local closing = State.platformPanel
            State.platformPanel = nil
            if closing then
                State.FadeOutPanel(closing, 0.35)
                task.delay(0.4, function() closing:Destroy() end)
            end
        end

        State.OpenPlatformPanel = function()
            if State.platformPanel then State.platformPanel:Destroy() end
            local panel, body = MakePanel("SkyPlatformPanel", "🧱 منصة ثابتة", 96, UI.Page6, "منصة ثابتة")
            State.platformPanel = panel

            -- 🔘 زر التشغيل/الإيقاف بنفس شكل أزرار التابات
