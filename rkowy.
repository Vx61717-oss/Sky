local function newStroke(obj, color, thick, trans)
    local s = Instance.new("UIStroke")
    s.Color, s.Thickness, s.Transparency = color, thick, trans
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = obj
    return s
