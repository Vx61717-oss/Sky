        local DEFENSE_LEADERBOARD_URL = "https://skyv-1ce1a-default-rtdb.firebaseio.com/laneDefenseLeaderboard"
        local defensePlayer = game:GetService("Players").LocalPlayer
        local function defenseHttp(url, method, body)
            if type(request) ~= "function" then return false, nil end
            local ok, response = pcall(function()
                return request({Url=url, Method=method,
                    Headers=body and {["Content-Type"]="application/json"} or nil, Body=body})
            end)
            if not ok or type(response) ~= "table" then return false, nil end
            local status = tonumber(response.StatusCode)
            return (not status or (status >= 200 and status < 300)), (response.Body or response.body)
        end
