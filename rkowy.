            local function layout()
                local sz = overlay.AbsoluteSize
                local X, Y = sz.X, sz.Y
                if X >= Y * 1.2 then
                    -- أفقي: اللوحة كبيرة يسار والمعلومات والأزرار يمين
                    local s = math.min(Y - 24, X - 40 - 230)
                    s = math.clamp(math.floor(s / 8) * 8, 160, 640)
