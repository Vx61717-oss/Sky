        local touchStartPos = nil
        local maxDragDistance = 15
        local delayTime = 1
        local isTeleporting = false

        -- 🔴➡️ تأثير الدائرة عند النقر، بنفس لون التاب الحالي
        local function createTouchClickEffect(pos)
            local color = GetTabColorForInstance(UI.Page6)
            local effectGui = Instance.new("ScreenGui")
            effectGui.Name = "SkyTouchTeleportEffectGui"
            effectGui.Parent = game.CoreGui

            local circle = Instance.new("Frame")
            circle.Name = "TouchCircle"
            circle.Size = UDim2.new(0, 10, 0, 10)
            circle.Position = UDim2.new(0, pos.X, 0, pos.Y)
