	_SkyRatingsListShown = true

	local HttpService = game:GetService("HttpService")
	local UIS = game:GetService("UserInputService")

	-- 📥 يجيب التقييمات من Firebase (nil لو فشل الطلب)
	local function fetchEntries()
		local ok, res = pcall(function()
			return request({Url = RATINGS_URL .. "?auth=" .. AUTH_TOKEN, Method = "GET"})
		end)
		if not (ok and res and res.Body) then return nil end
		if res.Body == "null" then return {} end
		local okData, ratings = pcall(function()
			return HttpService:JSONDecode(res.Body)
		end)
		if not (okData and type(ratings) == "table") then return nil end

		local out = {}
		for id, item in pairs(ratings) do
			if type(item) == "table" and tonumber(item.rating) then
				table.insert(out, {id = id, data = item})
			end
		end
		table.sort(out, function(a, b)
			return tonumber(a.data.timestamp or 0) > tonumber(b.data.timestamp or 0)
		end)
		return out
	end

	-- 🕒 وقت التقييم: "قبل 5 دقايق"
	local function timeAgo(ts)
		ts = tonumber(ts)
		if not ts then return "" end
		local d = math.max(0, os.time() - ts)
		if d < 60 then return "الحين" end
		if d < 3600 then
			local n = math.floor(d / 60)
			return n == 1 and "قبل دقيقة" or ("قبل " .. n .. " دقايق")
		end
		if d < 86400 then
			local n = math.floor(d / 3600)
			return n == 1 and "قبل ساعة" or ("قبل " .. n .. " ساعات")
		end
		local n = math.floor(d / 86400)
		return n == 1 and "قبل يوم" or ("قبل " .. n .. " ايام")
	end

	-- 🔔 القايمة تطلع بس إذا فيه تقييم جديد ما شفته قبل. لو ما أحد قيّم، ما تبان.
	local SEEN_FILE = "SkyConfig/RatingsSeen.txt"
	local function loadSeen()
		local v = 0
		pcall(function()
			if readfile and isfile and isfile(SEEN_FILE) then
				v = tonumber(readfile(SEEN_FILE)) or 0
			end
		end)
		return v
	end
	local function saveSeen(v)
		pcall(function()
			if writefile and makefolder and isfolder then
				if not isfolder("SkyConfig") then makefolder("SkyConfig") end
				writefile(SEEN_FILE, tostring(v))
			end
		end)
	end
	local function newestTs(list)
		local m = 0
		for _, e in ipairs(list) do
			local t = tonumber(e.data.timestamp) or 0
			if t > m then m = t end
		end
		return m
	end

	local seenTs = loadSeen()
	local entries = fetchEntries()
	if not entries or newestTs(entries) <= seenTs then
