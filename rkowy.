            end

            -- من التلميح يمين → الخط العمودي → يتفرع للاسم ولليوزر
            C.part("SkyHintStart", C.HINT_X + C.HINT_W, C.startY - 1, C.TRUNK_X - (C.HINT_X + C.HINT_W) + 1, 2)
            C.part("SkyHintTrunk", C.TRUNK_X - 1, C.nameY - 1, 2, C.startY - C.nameY + 2)
            C.nameLine = C.part("SkyHintNameLine", C.TRUNK_X - 1, C.nameY - 1, 40, 2)
            C.userLine = C.part("SkyHintUserLine", C.TRUNK_X - 1, C.userY - 1, 40, 2)
            C.nameDot = C.part("SkyHintNameDot", 0, C.nameY - 3, 6, 6, true)
            C.userDot = C.part("SkyHintUserDot", 0, C.userY - 3, 6, 6, true)

            -- يحسب نهاية الخط حسب عرض النص الفعلي (النص ينعرض من اليمين)
            function C.update()
                local width = playerInfoFrame.AbsoluteSize.X - 112
                if width <= 0 then width = 238 end
                local rightEdge = 100 + width

                local function endX(text)
                    local w = 120
                    pcall(function()
                        w = game:GetService("TextService"):GetTextSize(text, playerInfoDetails.TextSize, playerInfoDetails.Font, Vector2.new(width, 1000)).X
                    end)
                    return math.max(C.TRUNK_X + 10, rightEdge - w - 8)
                end

                local nameEnd = endX(tostring(playerInfoDetails:GetAttribute("SkyName") or "") .. " الاسم")
                local userEnd = endX(tostring(playerInfoDetails:GetAttribute("SkyUser") or "") .. " اسم المستخدم")

                C.nameLine.Size = UDim2.new(0, nameEnd - (C.TRUNK_X - 1), 0, 2)
                C.userLine.Size = UDim2.new(0, userEnd - (C.TRUNK_X - 1), 0, 2)
                C.nameDot.Position = UDim2.new(0, nameEnd - 3, 0, C.nameY - 3)
                C.userDot.Position = UDim2.new(0, userEnd - 3, 0, C.userY - 3)
            end

            C.update()
            playerInfoFrame:GetPropertyChangedSignal("Visible"):Connect(function()
                if playerInfoFrame.Visible then C.update() end
            end)
            playerInfoDetails:GetAttributeChangedSignal("SkyName"):Connect(C.update)
            playerInfoDetails:GetAttributeChangedSignal("SkyUser"):Connect(C.update)
            end)
            if not C.ok then WARN("⚠️ تعذر تجهيز نسخ الاسم: " .. tostring(C.err)) end
        end

        do -- 🌐 معزول داخل do لتفادي حد 200 متغير محلي
