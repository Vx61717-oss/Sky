    NewItem("تشغيل Auto E", "ButtonOnce", function()
        local ok, err = pcall(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/Vx61717-oss/Sky/refs/heads/main/%D9%8A%D8%B6%D8%BA%D8%B7%20E"))()
