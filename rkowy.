        -- ----- الكمبيوتر -----
        local function overlapAt(x, y)
            for _, p in ipairs(pieces) do
                if p.alive then
                    local dx, dy = p.x - x, p.y - y
                    local rr = p.r + SR + 1
                    if dx * dx + dy * dy < rr * rr then return true end
                end
            end
            return false
        end
        local function segDist2(px, py, x1, y1, x2, y2)
            local dx, dy = x2 - x1, y2 - y1
            local l2 = dx * dx + dy * dy
            local t = 0
            if l2 > 0 then t = math.clamp(((px - x1) * dx + (py - y1) * dy) / l2, 0, 1) end
            local cx, cy = x1 + dx * t, y1 + dy * t
            return (px - cx) ^ 2 + (py - cy) ^ 2
        end
        local function pathClear(x1, y1, x2, y2, r, ignore)
            for _, p in ipairs(pieces) do
                if p.alive and p ~= ignore then
                    local rr = r + p.r + 2
                    if segDist2(p.x, p.y, x1, y1, x2, y2) < rr * rr then return false end
                end
            end
            return true
        end
        local function aiPlan()
            local myc = colorOf(turn)
            local targets = {}
            for _, p in ipairs(pieces) do
                if p.alive then targets[#targets + 1] = p end
            end
            local cands = {}
            for xi = 0, 12 do
                local t = xi / 12
                local sx = BASE_X0 + t * (BASE_X1 - BASE_X0)
                local sy = BASE_Y[turn]
                if not overlapAt(sx, sy) then
                    for _, tp in ipairs(targets) do
                        for _, pk in ipairs(POCKETS) do
                            local ux, uy = pk.x - tp.x, pk.y - tp.y
                            local ul = math.sqrt(ux * ux + uy * uy)
                            if ul > 1 then
                                ux, uy = ux / ul, uy / ul
                                local gx, gy = tp.x - ux * (SR + tp.r), tp.y - uy * (SR + tp.r)
                                local dx, dy = gx - sx, gy - sy
                                local dl = math.sqrt(dx * dx + dy * dy)
                                if dl > 1 and gx > SR and gx < B - SR and gy > SR and gy < B - SR then
                                    dx, dy = dx / dl, dy / dl
                                    local cosA = dx * ux + dy * uy
                                    if cosA > 0.3 then
                                        local clear = pathClear(sx, sy, gx, gy, SR, tp) and pathClear(tp.x, tp.y, pk.x, pk.y, tp.r, tp)
                                        cands[#cands + 1] = {
                                            t = t, dx = dx, dy = dy, cosA = cosA, dl = dl, ul = ul,
                                            score = cosA * 100 - dl * 0.03 - ul * 0.025 + (tp.kind == "w" and 14 or 0) + (tp.kind == "q" and 10 or 0) + (clear and 60 or 0),
                                        }
                                    end
                                end
                            end
                        end
                    end
                end
            end
            local plan
            if #cands > 0 then
                table.sort(cands, function(a, b) return a.score > b.score end)
                local pool = diff == "easy" and 6 or (diff == "normal" and 3 or 1)
                plan = cands[math.random(1, math.min(pool, #cands))]
            else
                -- ما فيه تسديدة واضحة: صوّب على قطعة من قطعه
                local tp = targets[math.random(1, math.max(1, #targets))] or queen
                local sx = math.clamp(tp.x, BASE_X0, BASE_X1)
                if overlapAt(sx, BASE_Y[turn]) then sx = 500 end
                local dx, dy = tp.x - sx, tp.y - BASE_Y[turn]
                local dl = math.sqrt(dx * dx + dy * dy)
                plan = {t = (sx - BASE_X0) / (BASE_X1 - BASE_X0), dx = dx / dl, dy = dy / dl, cosA = 1, dl = dl, ul = 350}
            end
