            if hadUnread > 0 then
                State.UnreadChatCount = math.max(0, (State.UnreadChatCount or 0) - hadUnread)
                if UI.MiniChatBadge then
                    UI.MiniChatBadge.Text = State.UnreadChatCount > 99 and "99+" or tostring(State.UnreadChatCount)
