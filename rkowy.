            local k = math.min(sx, sy)
            local px, py = W / 2 + d.X * k, H / 2 + d.Y * k
            _arrow.Rotation = math.deg(math.atan2(d.X, -d.Y))
            _arrow.Position = UDim2.new(0, px, 0, py)
            _dist.Position = UDim2.new(0, px, 0, py + sz * 0.7)
        end
        _dist.Text = studs .. " m"
        _arrow.Visible, _dist.Visible = true, true
    end)
end

