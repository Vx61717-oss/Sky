            circle.BackgroundTransparency = 0.2
            circle.BorderSizePixel = 0
            circle.Parent = effectGui

            Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

            local tweenIn = SkyTw(circle, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 70, 0, 70),
                BackgroundTransparency = 0.5
            })
            tweenIn:Play()

            tweenIn.Completed:Connect(function()
                local tweenOut = SkyTw(circle, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                    Size = UDim2.new(0, 90, 0, 90),
                    BackgroundTransparency = 1
                })
                tweenOut:Play()
                tweenOut.Completed:Connect(function() effectGui:Destroy() end)
            end)
        end

        State.TouchTeleportActive = false
        local ttBeganConn, ttEndedConn

        local function stopTouchTeleport()
            if ttBeganConn then ttBeganConn:Disconnect() ttBeganConn = nil end
            if ttEndedConn then ttEndedConn:Disconnect() ttEndedConn = nil end
            touchStartPos = nil
        end

        local function startTouchTeleport()
            stopTouchTeleport()

            ttBeganConn = ttUserInput.InputBegan:Connect(function(input, processedByUI)
                if not State.TouchTeleportActive or processedByUI then return end
                if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                    touchStartPos = input.Position
                end
            end)

            ttEndedConn = ttUserInput.InputEnded:Connect(function(input)
                if not State.TouchTeleportActive then return end
                if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                    if touchStartPos then
                        local touchEndPos = input.Position
                        local distanceMoved = (Vector2.new(touchStartPos.X, touchStartPos.Y) - Vector2.new(touchEndPos.X, touchEndPos.Y)).Magnitude
                        touchStartPos = nil
                        if distanceMoved > maxDragDistance then return end

                        createTouchClickEffect(touchEndPos)
                        ttClickSound:Play()

                        local character = LocalPlayer.Character
                        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                        local mouse = LocalPlayer:GetMouse()

                        if rootPart and not isTeleporting and mouse.Target ~= nil then
                            isTeleporting = true
                            local targetPosition = mouse.Hit.Position

                            task.wait(delayTime)

                            if State.TouchTeleportActive and character and character:FindFirstChild("HumanoidRootPart") then
