            local body
            if type(request) == "function" then
                local requestOK, response = pcall(function()
                    return request({Url = url, Method = "GET"})
                end)
                if requestOK and response then body = response.Body or response.body end
            end
            if type(body) ~= "string" or body == "" then
                local httpOK, httpBody = pcall(function() return game:HttpGet(url) end)
                if httpOK then body = httpBody end
            end
