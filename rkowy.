            -- ---------- حركة القطعة (انزلاق) ----------
            local function slide(m, piece, cb, dur)
                local from = squares[m.fr][m.fc]
                from.holder:ClearAllChildren()
                from.cur = false
                local ghost = Instance.new("Frame")
                ghost.BackgroundTransparency = 1
                ghost.Size = UDim2.new(0.125, 0, 0.125, 0)
                local fromR, fromC = boardCellPosition(m.fr, m.fc)
                local toR, toC = boardCellPosition(m.tr, m.tc)
                ghost.Position = UDim2.new((fromC - 1) * 0.125, 0, (fromR - 1) * 0.125, 0)
                ghost.ZIndex = Z + 15
                ghost.Parent = board
                local lift = Instance.new("UIScale", ghost)
                lift.Scale = 1.12
                drawPiece(ghost, piece:sub(2, 2), piece:sub(1, 1), Z + 15)
                local tw = TweenService:Create(ghost,
                    TweenInfo.new(dur or 0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                    {Position = UDim2.new((toC - 1) * 0.125, 0, (toR - 1) * 0.125, 0)})
                tw.Completed:Connect(function()
                    ghost:Destroy()
                    cb()
                end)
                tw:Play()
            end

            local function perform(m, done, dur)
                local myGame = gameId
                local piece = state.board[m.fr][m.fc]
                busy = true
                slide(m, piece, function()
                    if not alive or myGame ~= gameId then return end
                    state = Engine.applyMove(state, m)
                    lastMove = m
                    selected, selMoves = nil, {}
                    busy = false
                    updateStatus()
                    render()
                    if done then done() end
                end, dur)
            end

            local function aiTurn()
                if not alive or gameOver or state.turn ~= "b" then busy = false return end
                busy = true
                local myGame = gameId
                local thinking = true
                -- نقاط متحركة "يفكر..."
                task.spawn(function()
                    local i = 0
                    while thinking and alive and myGame == gameId do
                        status.Text = "الكمبيوتر يفكر" .. string.rep(".", i % 4)
                        status.TextColor3 = GRAY
                        i = i + 1
                        task.wait(0.35)
                    end
                end)
                local t0 = os.clock()
                task.wait(0.3)
                local m = Engine.pickMove(state, level)
                -- أقل وقت تفكير حسب المستوى عشان يكون واقعي
                local minT = ({1.0, 1.6, 2.4})[level] + math.random() * 0.9
                local left = minT - (os.clock() - t0)
                if left > 0 then task.wait(left) end
                thinking = false
                if not alive or myGame ~= gameId then return end
                if not m then busy = false return end
                -- "يمسك" القطعة: يظللها ويبين وين تقدر تروح لحظة قبل ما يحركها
                selected = {m.fr, m.fc}
                selMoves = {}
                for _, mv in ipairs(Engine.legalMoves(state)) do
                    if mv.fr == m.fr and mv.fc == m.fc then selMoves[#selMoves + 1] = mv end
                end
                render()
                task.wait(0.6)
                if not alive or myGame ~= gameId then return end
                selMoves = {}
                render()
                perform(m, nil, 0.6)
            end

            playerMove = function(m)
                if isMultiplayer and state.turn ~= myColor then return end
                history[#history + 1] = {state = state, last = lastMove}
                perform(m, function()
                    if isMultiplayer and matchId then
                        moveSeq = moveSeq + 1
                        chessCall("PUT", "matches/" .. matchId .. "/moves/" .. tostring(moveSeq), {
                            fr=m.fr, fc=m.fc, tr=m.tr, tc=m.tc, promo=m.promo and true or false,
                            pt=m.pt, by=myColor, seq=moveSeq, sentAt=os.time()})
                    elseif not gameOver and state.turn == "b" then
                        busy = true
                        task.spawn(aiTurn)
                    end
                end)
            end

            onSquare = function(r, c)
                if not alive or busy or gameOver or state.turn ~= (isMultiplayer and myColor or "w") or pendingPromo then return end
                if selected then
                    for _, m in ipairs(selMoves) do
                        if m.tr == r and m.tc == c then
                            if m.promo then
                                pendingPromo = m
                                promoLayer.Visible = true
                            else
                                playerMove(m)
                            end
                            return
                        end
                    end
                end
                local p = state.board[r][c]
                if p and p:sub(1, 1) == (isMultiplayer and myColor or "w") then
                    if selected and selected[1] == r and selected[2] == c then
                        selected, selMoves = nil, {}
                        updateStatus()
                    else
                        selected = {r, c}
                        selMoves = {}
                        for _, m in ipairs(Engine.legalMoves(state)) do
                            if m.fr == r and m.fc == c then selMoves[#selMoves + 1] = m end
                        end
                        status.Text = "اخترت: " .. NAMES[p:sub(2, 2)] .. (#selMoves == 0 and " (ما له حركة)" or "")
                        status.TextColor3 = GREEN
                    end
                else
                    selected, selMoves = nil, {}
                    updateStatus()
                end
                render()
            end

            task.spawn(function()
                while alive do
                    if isMultiplayer and matchId and not busy and not gameOver and state.turn ~= myColor then
                        local remote = chessCall("GET", "matches/" .. matchId .. "/moves/" .. tostring(moveSeq + 1), nil)
                        if type(remote) == "table" and tonumber(remote.seq) == moveSeq + 1 and remote.by ~= myColor then
                            local chosen
                            for _, candidate in ipairs(Engine.legalMoves(state)) do
                                if candidate.fr == tonumber(remote.fr) and candidate.fc == tonumber(remote.fc)
                                    and candidate.tr == tonumber(remote.tr) and candidate.tc == tonumber(remote.tc) then
                                    if candidate.promo then candidate.pt = remote.pt or "Q" end
                                    chosen = candidate; break
                                end
                            end
                            if chosen then
                                busy = true
                                perform(chosen, function() moveSeq = moveSeq + 1 end)
                            end
                        end
