                local function updateBits(dt)
                    for i = #bits, 1, -1 do
                        local b = bits[i]
                        b.life = b.life - dt
                        if b.life <= 0 then
                            b.p:Destroy()
                            table.remove(bits, i)
                        else
                            b.v = b.v - Vector3.new(0, b.grav * dt, 0)
                            b.p.CFrame = b.p.CFrame + b.v * dt
                            local s = b.size * (b.life / b.max)
                            b.p.Size = Vector3.new(s, s, s)
                        end
                    end
                end

                local function fitDist(width, depthFactor, aspect)
                    local tanH = math.tan(math.rad(cam3d.FieldOfView / 2))
                    local wFit = (width * 1.12) / (2 * tanH * math.max(0.3, aspect))
                    local hFit = (width * 1.12 * depthFactor) / (2 * tanH)
                    return math.max(wFit, hFit) + 8
                end

