                -- نتبع الرسالة الجديدة فقط لو أنا اللي أرسلت، أو كنت أصلاً عند آخر الرسايل
                local follow = (sender ~= "Sky AI") or (SkyAI.log.CanvasPosition.Y >= SkyAI.scrollTarget(SkyAI.log, SkyAI.list) - 150)
                local savedLog, savedList = chatLog, chatList
                chatLog, chatList = SkyAI.log, SkyAI.list
                local ok, err = pcall(addChatMsg, sender, text, nil, userId, ts, "general", game.JobId, game.PlaceId, cid, nil)
                chatLog, chatList = savedLog, savedList
                if not ok then pcall(warn, "[SkyAI] فشل عرض الرسالة: " .. tostring(err)) end
                if follow then SkyAI.scrollToLast(SkyAI.log, SkyAI.list) end
            end

