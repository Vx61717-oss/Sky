                stagesWon=stages, stageCount=#stages, pets=defensePetCount(d),
                entered=true, lastSeen=os.time(),
            }
            local url=DEFENSE_LEADERBOARD_URL .. "/" .. tostring(defensePlayer.UserId) .. ".json"
            if AUTH_TOKEN ~= "" then url=url .. "?auth=" .. AUTH_TOKEN end
            return defenseHttp(url, "PATCH", HttpService:JSONEncode(record))
        end
