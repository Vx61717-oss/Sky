    local function AnimatePage(page)
        local items = {}
        for _, c in ipairs(page:GetChildren()) do
            -- نتجاهل الـ frames اللي خلفيتها شفافة (مثل TrollContainer)
            if c:IsA("Frame") and c.BackgroundTransparency < 1 then
                table.insert(items, c)
            end
        end
        for _, item in ipairs(items) do
            item.BackgroundTransparency = 1
            item.Position = UDim2.new(0.1, 0, 0, 0)
            for _, child in ipairs(item:GetChildren()) do
                if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
                    child.TextTransparency = 1
                end
            end
        end
        for i, item in ipairs(items) do
            task.delay((i - 1) * 0.12, function()
                if item and item.Parent then
                    SkyTw(item, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        BackgroundTransparency = 0,
                        Position = UDim2.new(0, 0, 0, 0)
                    }):Play()
                    for _, child in ipairs(item:GetChildren()) do
                        if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
                            SkyTw(child, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                                TextTransparency = 0
                            }):Play()
                        end
                    end
                end
            end)
        end
    end

