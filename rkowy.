            local vt = plan.ul * 1.9 + 220
            local vc = vt / (1.29 * math.max(plan.cosA, 0.3))
            local v0 = math.clamp(vc + FRIC * plan.dl * 1.12, MINV + 40, MAXV)
            local power = ((v0 - MINV) / (MAXV - MINV)) ^ (1 / 1.15)
            local angNoise = diff == "easy" and 0.085 or (diff == "normal" and 0.028 or 0.007)
            local powNoise = diff == "easy" and 0.22 or (diff == "normal" and 0.09 or 0.02)
            local ang = math.atan2(plan.dy, plan.dx) + randn() * angNoise
            power = math.clamp(power * (1 + randn() * powNoise) + (diff == "hard" and 0.03 or 0), 0.12, 1)
            return {t = plan.t, dx = math.cos(ang), dy = math.sin(ang), power = power}
        end
