_MainMenuSound.Parent = SoundService
local _MainMenuSoundTween

local function _SetMainMenuSound(open)
    if _MainMenuSoundTween then
        _MainMenuSoundTween:Cancel()
        _MainMenuSoundTween = nil
    end

    if open then
        if not _MainMenuSound.IsPlaying then
            _MainMenuSound:Play()
        end
        _MainMenuSoundTween = _TweenS:Create(
            _MainMenuSound,
            TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
            {Volume = 1}
        )
        _MainMenuSoundTween:Play()
    else
        _MainMenuSoundTween = _TweenS:Create(
            _MainMenuSound,
            TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.In),
            {Volume = 0}
        )
        local tween = _MainMenuSoundTween
        tween.Completed:Connect(function()
            if tween == _MainMenuSoundTween and not State.MainUIVisible then
                _MainMenuSound:Stop()
            end
        end)
        tween:Play()
    end
end

