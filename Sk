            local function setGravityItemTransparency(item, hidden)
                if not item or not item.Parent then return end
                local goal = {}
                if item:IsA("TextLabel") then
                    goal.TextTransparency = hidden and 1 or 0
                elseif item:IsA("TextButton") then
                    goal.BackgroundTransparency = hidden and 1 or (item.Name == "ResetGravity" and 0.05 or 0)
                    goal.TextTransparency = hidden and 1 or 0
                end
                if next(goal) then
                    TweenService:Create(item, TweenInfo.new(hidden and 0.01 or 0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
                end
                    for _, child in ipairs(item:GetChildren()) do
                        if child:IsA("UIStroke") then
                            TweenService:Create(child, TweenInfo.new(hidden and 0.01 or 0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                                Transparency = hidden and 1 or (item.Name == "ResetGravity" and 0.1 or 0.3)
                            }):Play()
                        end
                    end
            end

            local function setGravityMinimized(minimized)
                State.gravityCollapsed = minimized
                minimizeBtn.Text = minimized and "+" or "−"
                for _, item in ipairs(gravityBodyItems) do
                    setGravityItemTransparency(item, minimized)
                end
                State.TweenPanelHeight(State.gravityPanel, minimized and 148 or 38, minimized and 38 or 148, 190)
            end

            minimizeBtn.MouseButton1Click:Connect(function()
                if not State.LockPanelToggle(State.gravityPanel) then return end
                playClick()
