local function fastRespawn()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			-- تصفير الصحة وكسر المفاصل معًا لتفعيل الموت والريسبون بأسرع وقت
			humanoid.Health = 0
			character:BreakJoints()
		elseif character then
			character:BreakJoints()
		else
			local ok, err = pcall(function() player:LoadCharacter() end)
			if not ok then warn("[R Respawn] تعذر إعادة إحياء الشخصية: " .. tostring(err)) end
		end
end

local function showTouchRespawnTip()
	FlyTipNotify("اضغط زر R لإعادة إحياء الشخصية", false, nil, 4.0, 1.0)
end

respawnButton.Active = true

-- 🖐️ تحريك زر R باللمس أو الماوس
local rDragging, rDragInput, rDragStart, rStartPos = false, nil, nil, nil
local rMoved = false
local _respawnClickTimes = {}
local TRIPLE_CLICK_WINDOW = 0.6

local function updateRespawnButton(input)
	local delta = input.Position - rDragStart
	if delta.Magnitude > 8 then rMoved = true end
	respawnButton.Position = UDim2.new(
		rStartPos.X.Scale, rStartPos.X.Offset + delta.X,
		rStartPos.Y.Scale, rStartPos.Y.Offset + delta.Y
	)
end

respawnButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		rDragging = true
		rMoved = false
		rDragStart = input.Position
		rStartPos = respawnButton.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				rDragging = false
			end
		end)
	end
end)

respawnButton.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		rDragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == rDragInput and rDragging then
		updateRespawnButton(input)
	end
end)

respawnButton.MouseButton1Click:Connect(function()
	if rMoved then
		rMoved = false
		return
	end

	-- 🔄 3 ضغطات سريعة على زر R = إرجاع كل القوائم لمكانها الأصلي.
	local now = tick()
	table.insert(_respawnClickTimes, now)
	while #_respawnClickTimes > 0 and (now - _respawnClickTimes[1]) > TRIPLE_CLICK_WINDOW do
		table.remove(_respawnClickTimes, 1)
	end

	if #_respawnClickTimes >= 3 then
		_respawnClickTimes = {}
		if _G.SkyResetMenuPositions then
			pcall(_G.SkyResetMenuPositions)
			if FlyTipNotify then
				pcall(function()
					FlyTipNotify("🔄 تم إرجاع كل القوائم لمكانها الأصلي", false, nil, 4.0, 1.0)
				end)
			end
		end
		return
	end

	fastRespawn()
end)
