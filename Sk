        local character = LocalPlayer.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            
            if humanoid and rootPart then
                -- Anti-Fling Logic
                if State.AntiFlingActive then
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character then
                            for _, part in pairs(p.Character:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    part.CanCollide = false
                                    part.Velocity = Vector3.new(0, 0, 0)
                                    part.RotVelocity = Vector3.new(0, 0, 0)
                                end
                            end
                        end
                    end
                end

                -- 🧠 كشف الماب/الشخصية: R6 أو R15 (يتحدث تلقائيًا مع كل ريسبون أو تغيير شخصية)
                local rig = State.GetRigName(humanoid)
                if rig ~= State.rigType then
                    State.rigType = rig
                    if State.speedActive then
                        OK("🧠 تم كشف شخصية " .. rig .. " — تم تبديل نظام السرعة")
                    end
                end

                if State.speedActive then
                    local profile = State.SpeedProfiles[rig] or State.SpeedProfiles.R6
                    humanoid.WalkSpeed = State.targetSpeed * profile.walkScale
                    if profile.cframeMult > 0 and humanoid.MoveDirection.Magnitude > 0 then
                        rootPart.CFrame = rootPart.CFrame + (humanoid.MoveDirection * (State.targetSpeed * profile.cframeMult))
                    end
                end

                -- ما نلمس النط إطلاقاً إلا لو غيّرته بنفسك، عشان يبقى نط الماب طبيعي دايم
                if State.jumpActive then
