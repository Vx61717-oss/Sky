                end
            end

            -- يظهر فقط إذا كانت أكثر من رسالتين مخفيتين تحت العرض.
            chatToBottomBtn.Visible = hiddenBelowCount > 2 and maxY > 12
            chatToBottomBtn.Active = chatToBottomBtn.Visible
        end

