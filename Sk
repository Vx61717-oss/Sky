            row:SetAttribute("ChatId", id or "")
            row:SetAttribute("ChatTimestamp", tonumber(timestamp) or 0)
            row:SetAttribute("ChatSender", tostring(sender))
            row:SetAttribute("ChatText", tostring(text))

            -- 🖼️ صورة المرسل (تظهر يسار الفقاعة لكلام الغير، ويمينها لكلامك انت)
