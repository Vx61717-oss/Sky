        local SKY_Original = {
            ClockTime = Lighting.ClockTime,
            Ambient = Lighting.Ambient,
            OutdoorAmbient = Lighting.OutdoorAmbient,
            Brightness = Lighting.Brightness,
            FogColor = Lighting.FogColor,
            FogStart = Lighting.FogStart,
            FogEnd = Lighting.FogEnd,
        }

        local SKY_ColorCorrection = Instance.new("ColorCorrectionEffect")
        SKY_ColorCorrection.Name = "SKY_AtmosphereCC"
        SKY_ColorCorrection.Enabled = false
        SKY_ColorCorrection.Parent = Lighting

        local SKY_SkyObj = Lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky", Lighting)
        local SKY_OriginalStarCount = SKY_SkyObj.StarCount

        local SKY_Index = 0 -- 0 = عادي

        local function ApplyNormal()
            Lighting.ClockTime = SKY_Original.ClockTime
            Lighting.Ambient = SKY_Original.Ambient
            Lighting.OutdoorAmbient = SKY_Original.OutdoorAmbient
            Lighting.Brightness = SKY_Original.Brightness
            Lighting.FogColor = SKY_Original.FogColor
            Lighting.FogStart = SKY_Original.FogStart
            Lighting.FogEnd = SKY_Original.FogEnd
            SKY_SkyObj.StarCount = SKY_OriginalStarCount
            SKY_ColorCorrection.Enabled = false
        end

        local function ApplySpace()
            Lighting.ClockTime = 0
            Lighting.Ambient = Color3.fromRGB(10, 10, 25)
            Lighting.OutdoorAmbient = Color3.fromRGB(15, 15, 30)
            Lighting.Brightness = 0
            Lighting.FogColor = Color3.fromRGB(0, 0, 5)
            Lighting.FogStart = 0
            Lighting.FogEnd = 100000
            SKY_SkyObj.StarCount = 3000
            SKY_ColorCorrection.TintColor = Color3.fromRGB(235, 240, 255)
            SKY_ColorCorrection.Saturation = -0.05
            SKY_ColorCorrection.Contrast = 0.05
            SKY_ColorCorrection.Enabled = true
        end

        local function ApplySunset()
            Lighting.ClockTime = 17.6
            Lighting.Ambient = Color3.fromRGB(70, 45, 35)
            Lighting.OutdoorAmbient = Color3.fromRGB(90, 60, 45)
            Lighting.Brightness = 2
            Lighting.FogColor = Color3.fromRGB(200, 120, 80)
            Lighting.FogStart = 300
            Lighting.FogEnd = 3000
            SKY_SkyObj.StarCount = 0
            SKY_ColorCorrection.TintColor = Color3.fromRGB(255, 225, 200)
            SKY_ColorCorrection.Saturation = 0.05
            SKY_ColorCorrection.Contrast = 0.05
            SKY_ColorCorrection.Enabled = true
        end

        local function ApplyPurpleNight()
            Lighting.ClockTime = 21
            Lighting.Ambient = Color3.fromRGB(35, 15, 45)
            Lighting.OutdoorAmbient = Color3.fromRGB(30, 15, 45)
            Lighting.Brightness = 1
            Lighting.FogColor = Color3.fromRGB(45, 15, 65)
            Lighting.FogStart = 200
            Lighting.FogEnd = 1500
            SKY_SkyObj.StarCount = 1500
            SKY_ColorCorrection.TintColor = Color3.fromRGB(230, 210, 250)
            SKY_ColorCorrection.Saturation = 0.05
            SKY_ColorCorrection.Contrast = 0.05
            SKY_ColorCorrection.Enabled = true
        end

        local SKY_Presets = {
            {name = "🌌 الفضاء", apply = ApplySpace},
            {name = "🌇 الغروب", apply = ApplySunset},
            {name = "🔮 الليل البنفسجي", apply = ApplyPurpleNight},
        }

        NewItem("أجواء الماب", "ButtonOnce", function()
            SKY_Index = SKY_Index + 1
            if SKY_Index > #SKY_Presets then
                SKY_Index = 0
            end

            if SKY_Index == 0 then
                ApplyNormal()
                Notify("🌤️ أجواء", "رجع الجو الطبيعي", Color3.fromRGB(170, 0, 255))
            else
                local preset = SKY_Presets[SKY_Index]
                preset.apply()
                Notify("🎨 أجواء", preset.name, Color3.fromRGB(170, 0, 255))
            end
        end, UI.Page3)
    end

