local PresenceNC, PresenceLayout = makeNotificationContainer("SkyPresenceNotifications", 0)
local GeneralNC, GeneralLayout = makeNotificationContainer("SkyGeneralNotifications", 0)
local ChatNC, ChatLayout = makeNotificationContainer("SkyChatNotifications", 0)

local _notificationQueues = {
    presence = {},
    general = {},
    chat = {},
}
local _notificationLimits = {presence = 2, general = 2, chat = 2}
local _notificationSerial = 0

local function notificationCategory(T, avatarUserId)
    T = tostring(T or "")
    if T:find("دخل") or T:find("غادر") or T:find("دخلت") or T:find("خرج") or T:find("ريسبون") then
        return "presence"
    end
    if T:sub(1, 2) == "💬" or T:find("الدردشة") then
        return "chat"
    end
    return "general"
end

local function getNotificationContainer(category)
    if category == "presence" then return PresenceNC end
    if category == "chat" then return ChatNC end
    return GeneralNC
end

local function updateNotificationPositions()
    -- الدردشة ثابتة تحت منطقة الإشعارات العامة.
    -- 📍 إشعارات القائمة (general) تجي تحت إشعارات دخول/خروج اللاعبين (presence)،
    -- بس إذا ما فيه إشعار دخول/خروج حاليًا، تاخذ إشعارات القائمة نفس مكان الأعلى بالضبط (بدون أي فراغ).
    local presenceHeight = PresenceLayout.AbsoluteContentSize.Y
    local generalHeight = GeneralLayout.AbsoluteContentSize.Y
    local gap = 10
    local presenceGap = (presenceHeight > 0) and gap or 0
    local generalGap = (generalHeight > 0) and gap or 0
    GeneralNC.Position = UDim2.new(1, -320, 0.08, presenceHeight + presenceGap)
    ChatNC.Position = UDim2.new(1, -320, 0.08, presenceHeight + presenceGap + generalHeight + generalGap)
end
PresenceLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateNotificationPositions)
GeneralLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateNotificationPositions)
ChatLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateNotificationPositions)

local function removeNotificationRecord(category, F)
    local q = _notificationQueues[category]
    for i = #q, 1, -1 do
        if q[i] == F then table.remove(q, i) end
    end
    updateNotificationPositions()
end

local function trimNotificationQueue(category)
    local q = _notificationQueues[category]
    local limit = _notificationLimits[category]
    while #q > limit do
        local old = table.remove(q, 1)
        if old and old.Parent then
            task.spawn(function()
                local inner = old:FindFirstChild("NotificationInner")
                if inner then
                    _TweenS:Create(inner, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                        Position = UDim2.new(0, 35, 0, 0), BackgroundTransparency = 1
                    }):Play()
                end
                task.wait(0.18)
                if old.Parent then old:Destroy() end
                updateNotificationPositions()
            end)
        end
    end
end

