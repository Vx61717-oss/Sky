        local function RefreshScriptUsers(presenceData)
            for _, child in ipairs(ScriptUsersScroll:GetChildren()) do
                if child:IsA("Frame") and child.Name == "ScriptUserCard" then
                    child:Destroy()
                end
            end

            local activeUsers = {}
            local myName = LocalPlayer.Name
            if type(presenceData) == "table" then
                for userName, timestamp in pairs(presenceData) do
                    if userName ~= myName and type(timestamp) == "number" and (os.time() - timestamp) < 12 then
                        table.insert(activeUsers, tostring(userName))
                    end
                end
            end
            table.sort(activeUsers)
            ScriptUsersEmpty.Visible = (#activeUsers == 0)

            for index, userName in ipairs(activeUsers) do
                local card = Instance.new("Frame", ScriptUsersScroll)
                card.Name = "ScriptUserCard"
                card.LayoutOrder = index
                card.Size = UDim2.new(0, 118, 0, 142)
                card.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                card.ZIndex = 7
                Instance.new("UICorner", card).CornerRadius = UDim.new(0, 12)

                local cardStroke = Instance.new("UIStroke", card)
                cardStroke.Thickness = 1.2
                cardStroke.Transparency = 0.1
                AddTabGlow(cardStroke, 1.5, UI.Page8)

                local avatar = Instance.new("ImageLabel", card)
                avatar.Size = UDim2.new(0, 82, 0, 82)
                avatar.Position = UDim2.new(0.5, -41, 0, 8)
                avatar.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
                avatar.Image = ""
                avatar.ZIndex = 8
