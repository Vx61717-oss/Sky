local function _TranslateText(value)
    if type(value) ~= "string" or _SelectedLanguage ~= "English" then return value end
    if _EnglishText[value] then return _EnglishText[value] end
    for arabic, english in pairs(_EnglishText) do
        if string.find(value, arabic, 1, true) then
            value = string.gsub(value, arabic, english)
        end
    end
    return value
end

function Notify(T, M, C, shake, avatarUserId, avatarStrokeColor)
    T = _TranslateText(T)
    M = _TranslateText(M)
    -- ✅ نضمن ظهور إشعار واحد بس في نفس الوقت: أي إشعار سابق لسه ظاهر يتشال فورًا
    if _currentNotification and _currentNotification.Parent then
        _currentNotification:Destroy()
    end

    local F = Instance.new("Frame", NC)
    _currentNotification = F
    F.Size = UDim2.new(1, 0, 0, 0)
    F.BackgroundTransparency = 1
    
    local I = Instance.new("Frame", F)
    I.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    I.BorderSizePixel = 0
    I.Size = UDim2.new(1, 0, 0, 0)
    I.Position = UDim2.new(0, 40, 0, 0) -- يبدأ مزحزح يمين عشان يدخل بحركة
    I.BackgroundTransparency = 1
    
    local Corner = Instance.new("UICorner", I)
    Corner.CornerRadius = UDim.new(0, 12)
    
    local Stroke = Instance.new("UIStroke", I)
    Stroke.Color = C
    Stroke.Thickness = 2
    Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    -- شريط لون رفيع على الجنب يميز نوع الإشعار
    local Bar = Instance.new("Frame", I)
    Bar.Size = UDim2.new(0, 4, 1, -8)
    Bar.Position = UDim2.new(0, 4, 0, 4)
    Bar.BackgroundColor3 = C
    Bar.BorderSizePixel = 0
    Instance.new("UICorner", Bar).CornerRadius = UDim.new(1, 0)

    -- 🖼️ صورة اللاعب (اختيارية) على يسار النص
    local textOffset = 14
    local AvatarImg
    if avatarUserId then
        AvatarImg = Instance.new("ImageLabel", I)
        AvatarImg.Size = UDim2.new(0, 32, 0, 32)
        AvatarImg.Position = UDim2.new(0, 12, 0.5, -16)
