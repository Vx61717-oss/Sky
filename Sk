-- 🔁 إشعارات "حية" تتحدث بنفسها بدل ما تتكدس: تستخدمها القيم المتغيرة بسرعة
-- (زيادة/نقصان الجاذبية، السرعة، وغيرها) عشان يبقى إشعار واحد بس يتحدث رقمه.
local _liveNotifFrames = {}

-- ينتظر ويطفي الإشعار بعد مدته؛ لو صار تحديث أحدث لنفس liveKey أثناء الانتظار
-- (رقم Gen تغيّر) يتوقف هذا الإخفاء القديم ويسيب المهمة للتحديث الأحدث.
local function _dismissNotificationAfterDelay(F, I, Stroke, TL, ML, AvatarImg, category, gen, liveKey)
    task.wait(category == "presence" and 3.2 or 2.8)
    if not F.Parent then return end
    if gen ~= nil and F:GetAttribute("Gen") ~= gen then return end
    _TweenS:Create(I, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Position = UDim2.new(0, 20, 0, -4), BackgroundTransparency = 1
    }):Play()
    _TweenS:Create(Stroke, TweenInfo.new(0.18), {Transparency = 1}):Play()
    _TweenS:Create(TL, TweenInfo.new(0.18), {TextTransparency = 1}):Play()
    _TweenS:Create(ML, TweenInfo.new(0.18), {TextTransparency = 1}):Play()
    if AvatarImg then _TweenS:Create(AvatarImg, TweenInfo.new(0.18), {ImageTransparency = 1}):Play() end
    task.wait(0.23)
    removeNotificationRecord(category, F)
    if F.Parent then F:Destroy() end
    if liveKey and _liveNotifFrames[liveKey] == F then _liveNotifFrames[liveKey] = nil end
end

function Notify(T, M, C, shake, avatarUserId, avatarStrokeColor, liveKey)
    T = _TranslateText(T)
    M = _TranslateText(M)
    local category = notificationCategory(T, avatarUserId)
    local container = getNotificationContainer(category)

    -- ♻️ إذا فيه إشعار حي شغال لنفس المفتاح، نحدّث نصه بدل ما نسوي وحد جديد فوقه.
    if liveKey and _liveNotifFrames[liveKey] and _liveNotifFrames[liveKey].Parent then
        local F = _liveNotifFrames[liveKey]
        local I = F:FindFirstChild("NotificationInner")
        if I then
            local TL = I:FindFirstChild("Title")
            local ML = I:FindFirstChild("Message")
            local Stroke = I:FindFirstChildOfClass("UIStroke")
            local AvatarImg = I:FindFirstChild("Avatar")
            if TL then TL.Text = T end
            if ML then ML.Text = M end
            -- ⚡ ومضة خفيفة على الحافة تعطي إحساس إن الإشعار تحدث فعلاً
            if Stroke then
                _TweenS:Create(Stroke, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Thickness = 2.4}):Play()
                task.delay(0.1, function()
                    if Stroke and Stroke.Parent then
                        _TweenS:Create(Stroke, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Thickness = 1.5}):Play()
                    end
                end)
            end
            local gen = (F:GetAttribute("Gen") or 0) + 1
            F:SetAttribute("Gen", gen)
            task.spawn(function()
                pcall(_dismissNotificationAfterDelay, F, I, Stroke, TL, ML, AvatarImg, category, gen, liveKey)
            end)
            return F
        end
    end

    _notificationSerial += 1

    local F = Instance.new("Frame", container)
    F.Name = "Notification_" .. tostring(_notificationSerial)
    F.Size = UDim2.new(1, 0, 0, 48)
    F.BackgroundTransparency = 1
    F.BorderSizePixel = 0
    F.LayoutOrder = _notificationSerial
    F.ZIndex = 50

    local I = Instance.new("Frame", F)
    I.Name = "NotificationInner"
    I.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    I.BorderSizePixel = 0
    I.Size = UDim2.new(1, 0, 0, 48)
    I.Position = UDim2.new(0, 35, 0, 0)
    I.BackgroundTransparency = 1
    I.ZIndex = 52
    Instance.new("UICorner", I).CornerRadius = UDim.new(0, 12)

    local Stroke = Instance.new("UIStroke", I)
    Stroke.Color = C
    Stroke.Thickness = 1.5
    Stroke.Transparency = 0.12
    Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    local GlowGradient = Instance.new("UIGradient", Stroke)
    GlowGradient.Name = "MovingNotificationGlow"
    GlowGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, C),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(8, 8, 10)),
        ColorSequenceKeypoint.new(1, C),
    })
    task.spawn(function()
        while GlowGradient.Parent do
            GlowGradient.Rotation = (GlowGradient.Rotation + 1.5) % 360
            task.wait(0.03)
        end
    end)

    local Bar = Instance.new("Frame", I)
    Bar.Size = UDim2.new(0, 4, 1, -8)
    Bar.Position = UDim2.new(0, 4, 0, 4)
    Bar.BackgroundColor3 = C
