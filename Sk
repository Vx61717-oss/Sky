        -- 📩 رسالة الدردشة العادية: تظهر داخل قائمة الدردشة فقط.
        local function sendMsg(box)
            box = box or inputBox
            local text = tostring(box.Text or "")
            if text:gsub("%s+", "") == "" then return end
            local badWord = findBadChatWord(text)
            if badWord ~= nil then
                setChatMute(game.Players.LocalPlayer.UserId, badWord)
                box.Text = ""
                box:ReleaseFocus()
                Notify("🚫 الدردشة", "تم كتمك لمدة دقيقة بسبب ألفاظ غير لائقة", Color3.fromRGB(255, 70, 70), true)
                return
            end
            if chatMuteRemaining(game.Players.LocalPlayer.UserId) > 0 then
                if updateChatMuteDisplay then
                    updateChatMuteDisplay(localChatMutes[game.Players.LocalPlayer.UserId])
                end
                box.Text = ""
                box:ReleaseFocus()
                Notify("⏳ الدردشة", "أنت مكتوم مؤقتًا، حاول بعد دقيقة", Color3.fromRGB(255, 170, 70), true)
                return
            end
            if hideDeveloperAnnouncement then hideDeveloperAnnouncement() end

            local myName = game.Players.LocalPlayer.Name
            local myUserId = game.Players.LocalPlayer.UserId
            local data = {
                ["sender"] = myName,
                ["text"] = text,
                ["timestamp"] = os.time(),
                ["userId"] = myUserId,
                ["jobId"] = game.JobId,
                ["placeId"] = game.PlaceId,
                ["chatType"] = currentChatMode
            }

            box.Text = ""
            box:ReleaseFocus()

            chatMessageCache["local:" .. tostring(data.timestamp) .. ":" .. tostring(math.random(1, 1000000))] = data
            -- رسالة محلية فورية داخل قائمة الدردشة، بدون فقاعة فوق الرأس.
            if isChatMessageVisible(data) then
                addChatMsg(myName, text, nil, myUserId, data.timestamp, data.chatType, data.jobId, data.placeId)
            end

            task.defer(function()
                task.wait()
                task.wait()
                local contentHeight = chatList.AbsoluteContentSize.Y
                local visibleHeight = chatLog.AbsoluteSize.Y
                local targetY = math.max(0, contentHeight - visibleHeight + 70)
                local maxY = math.max(0, chatLog.AbsoluteCanvasSize.Y - visibleHeight)
                targetY = math.min(targetY, maxY)
                chatLog.CanvasPosition = Vector2.new(0, targetY)
            end)

            task.spawn(function()
                local ok, res = pcall(function()
                    return request({
                        Url = FIREBASE_URL .. "?auth=" .. AUTH_TOKEN,
                        Method = "POST",
                        Headers = {["Content-Type"] = "application/json"},
                        Body = game:GetService("HttpService"):JSONEncode(data)
                    })
                end)
                if not ok then
                    WARN("فشل إرسال الرسالة: " .. tostring(res))
                elseif res and res.StatusCode and res.StatusCode ~= 200 then
                    WARN("فايربيس رفض الإرسال (" .. tostring(res.StatusCode) .. "): " .. tostring(res.Body))
                end
            end)
        end

