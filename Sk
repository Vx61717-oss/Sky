                local minV, maxV = opts.min or 0.5, opts.max or 1000
                local function makeStepBtn(symbol, xPos, delta)
                    local sb = Instance.new("TextButton", f)
                    sb.Size = UDim2.new(0.12, 0, 0.7, 0)
                    sb.Position = UDim2.new(xPos, 0, 0.15, 0)
                    sb.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
