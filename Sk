    -- 🌫️ فتح القوائم: تظهر القائمة بمكانها النهائي مع كل اللي فيها شوي شوي (عكس الإغلاق)
    -- نستدعيها بعد ما نحدد حجم/موضع القائمة؛ تخفيها فورًا ثم تظهرها بعد ما يخلص بناء كل العناصر.
    State.FadeInPanel = function(panel, duration)
        if not panel then return end
        duration = duration or 0.35
        panel.Visible = false
        task.defer(function()
            if not panel or not panel.Parent then return end
            local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            local jobs = {}
            local function prep(obj)
                local props
                if obj:IsA("TextButton") or obj:IsA("TextLabel") or obj:IsA("TextBox") then
                    props = {"BackgroundTransparency", "TextTransparency"}
                elseif obj:IsA("ScrollingFrame") then
                    props = {"BackgroundTransparency", "ScrollBarImageTransparency"}
                elseif obj:IsA("Frame") then
                    props = {"BackgroundTransparency"}
                elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                    props = {"BackgroundTransparency", "ImageTransparency"}
                elseif obj:IsA("UIStroke") then
                    props = {"Transparency"}
                end
                if not props then return end
                local goal = {}
                for _, prop in ipairs(props) do
                    local value = obj[prop]
                    -- العناصر المخفية أصلًا (شفافيتها 1) نتركها؛ لها أنيميشن ظهور خاص فيها.
                    if value < 0.999 then
                        goal[prop] = value
                        obj[prop] = 1
                    end
                end
                if next(goal) then jobs[#jobs + 1] = {obj, goal} end
            end
            prep(panel)
            for _, d in ipairs(panel:GetDescendants()) do prep(d) end
            panel.Visible = true
            for _, job in ipairs(jobs) do
                pcall(function() TweenService:Create(job[1], info, job[2]):Play() end)
            end
        end)
    end

    -- 🌫️ إغلاق القوائم: تختفي القائمة مع كل اللي فيها شوي شوي (بدون أنميشن تصغير)
    State.FadeOutPanel = function(panel, duration)
        if not panel or not panel.Parent then return end
        duration = duration or 0.35
        local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local function fade(obj)
            local goal
            if obj:IsA("TextButton") or obj:IsA("TextLabel") or obj:IsA("TextBox") then
                goal = {BackgroundTransparency = 1, TextTransparency = 1}
            elseif obj:IsA("ScrollingFrame") then
                goal = {BackgroundTransparency = 1, ScrollBarImageTransparency = 1}
            elseif obj:IsA("Frame") then
                goal = {BackgroundTransparency = 1}
            elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                goal = {BackgroundTransparency = 1, ImageTransparency = 1}
            elseif obj:IsA("UIStroke") then
                goal = {Transparency = 1}
            end
            if goal then
                pcall(function() TweenService:Create(obj, info, goal):Play() end)
            end
        end
        fade(panel)
        for _, d in ipairs(panel:GetDescendants()) do fade(d) end
    end
    State.TweenPanelHeight = function(panel, fromH, toH, width)
        if not panel or not panel.Parent then return end
        local pos = panel.Position
