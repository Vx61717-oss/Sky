            local bubbleLayout = Instance.new("UIListLayout", bubble)
            bubbleLayout.FillDirection = Enum.FillDirection.Vertical
            bubbleLayout.SortOrder = Enum.SortOrder.LayoutOrder
            bubbleLayout.Padding = UDim.new(0, 2)

            -- 👤 اسم المرسل: لون هادئ حتى ما يخرب شكل الـGlow
            local nameLabel = Instance.new("TextLabel", bubble)
            nameLabel.Name = "SenderName"
            nameLabel.LayoutOrder = 1
            nameLabel.BackgroundTransparency = 1
            nameLabel.Size = UDim2.new(1, 0, 0, 12)
            nameLabel.Text = sender
            nameLabel.TextColor3 = Color3.fromRGB(205, 205, 210)
            nameLabel.TextTransparency = 1 -- يبدأ شفاف عشان الانميشن مثل الباقي
            nameLabel.Font = Enum.Font.Arcade
            nameLabel.TextSize = 9
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            nameLabel.TextStrokeTransparency = 0.65
            nameLabel.ZIndex = 10

            local label = Instance.new("TextLabel", bubble)
            label.Name = "MsgText"
            label.LayoutOrder = 2
            label.BackgroundTransparency = 1
            label.Size = UDim2.new(1, 0, 0, 0)
            label.AutomaticSize = Enum.AutomaticSize.Y
            label.Text = _TranslateText(text)
            label.TextWrapped = true
            label.TextColor3 = Color3.new(1, 1, 1)
            label.TextTransparency = 1 -- يبدأ شفاف عشان الانميشن
            label.Font = Enum.Font.Arcade
            label.TextSize = 14
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.ZIndex = 10

            -- 📖 حالة الرسالة أسفل النص داخل نفس الفقاعة، مع مساحة مستقلة تلقائيًا.
            -- لا نستخدم Position ثابتة حتى لا تتداخل مع الرسائل الطويلة أو متعددة الأسطر.
            if isMine then
                local readStatus = Instance.new("TextLabel", bubble)
                readStatus.Name = "ReadStatus"
                readStatus.LayoutOrder = 3
                readStatus.BackgroundTransparency = 1
                readStatus.Size = UDim2.new(1, 0, 0, 12)
                readStatus.Text = _SelectedLanguage == "English" and "Unread" or "غير مقروء"
                readStatus.TextColor3 = Color3.fromRGB(175, 175, 185)
                readStatus.TextTransparency = 1
                readStatus.Font = Enum.Font.Arcade
                readStatus.TextSize = 9
                readStatus.TextXAlignment = Enum.TextXAlignment.Right
                readStatus.ZIndex = 10
