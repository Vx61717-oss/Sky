                    BackgroundColor3 = Color3.fromRGB(25, 25, 25) -- يعود للونه الأصلي
                }):Play()
                if not act then -- فقط إذا لم يكن الزر نشطًا بالفعل
                    _TweenS:Create(stroke, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Transparency = 0.7, -- يعود لشفافيته الأصلية
                        Thickness = 2 -- يعود لسمكه الأصلي
                    }):Play()
                end
            end)

            local act = false
            local function applyToggle(newAct)
                act = newAct
                local _onColor = GetTabColorForInstance(parent) -- 🎨 نجيب اللون الحالي وقت الضغط (مو محفوظ من قبل) عشان يطابق أي تغيير سويته من تاب الإعدادات
                btn.Text = _TranslateText(act and "إيقاف" or "تشغيل")
                stroke.Color = act and _onColor or TOGGLE_OFF_COLOR
                stroke.Transparency = 0
                SetGlowColor(_btnGlowGrad, act and _onColor or TOGGLE_OFF_COLOR) -- 🎨 نحدّث لون الحافة المتحركة نفسها
                _activeGlow(stroke, act, _onColor)
                UI.activeCounts[parent] = (UI.activeCounts[parent] or 0) + (act and 1 or -1)
                if UI.activeCounts[parent] < 0 then UI.activeCounts[parent] = 0 end
                UpdateBadge(parent)
                call(act)
            end
            btn.MouseButton1Click:Connect(function() 
                playClick()
                applyToggle(not act)
                -- زر السيرفر أمر لحظي، ولا يتم حفظ حالته أبداً.
                if txt ~= "سيرفر" then
                    SaveConfig()
                end
            end)
            -- 💾 تسجيل الأزرار في نظام الحفظ، باستثناء زر السيرفر لأنه أمر لحظي.
            if txt ~= "سيرفر" then
