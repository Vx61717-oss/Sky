                else
                    fadeGoals.BackgroundTransparency = 1
                end
                TweenService:Create(child, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), fadeGoals):Play()
            end
        end
        -- لا ندمر الأشكال هنا؛ نخفيها فقط حتى تعود عند فتح القائمة.
    end

