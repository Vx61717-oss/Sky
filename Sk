local function AddTabGlow(stroke, speed, parentInst)
    local idx = GetTabIndexForInstance(parentInst)
    local grad = AddMovingBorderGlow(stroke, speed, UI.TabColors[idx])
    UI.TabGlowRegistry[idx] = UI.TabGlowRegistry[idx] or {}
    table.insert(UI.TabGlowRegistry[idx], grad)
    return grad
end

