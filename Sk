        local function rebuildChatForMode()
            clearChatRows()
            local items = {}
            for _, m in pairs(chatMessageCache) do
                if isChatMessageVisible(m) then table.insert(items, m) end
            end
            table.sort(items, function(a,b) return (tonumber(a.timestamp) or 0) < (tonumber(b.timestamp) or 0) end)
            for _, m in ipairs(items) do
                addChatMsg(m.sender, m.text, m.id, m.userId, m.timestamp, m.chatType, m.jobId, m.placeId)
            end
            task.defer(function()
                if chatLog and chatLog.Parent then
                    local maxY = math.max(0, chatLog.AbsoluteCanvasSize.Y - chatLog.AbsoluteSize.Y)
                    chatLog.CanvasPosition = Vector2.new(0, maxY)
