                avatarImg.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(userId) .. "&w=150&h=150"
                avatarImg.ZIndex = 9
                avatarImg.Parent = row
                if isMine then
                    avatarImg.AnchorPoint = Vector2.new(1, 0)
                    avatarImg.Position = UDim2.new(1, -(5 + MY_MESSAGE_LEFT_SHIFT), 0, 2)
                else
                    avatarImg.AnchorPoint = Vector2.new(0, 0)
                    avatarImg.Position = UDim2.new(0, 5 + FRIEND_MESSAGE_RIGHT_SHIFT, 0, 2)
                end
                Instance.new("UICorner", avatarImg).CornerRadius = UDim.new(1, 0)
                local avStroke = Instance.new("UIStroke", avatarImg)
                avStroke.Thickness = 1.5
                local avatarGlowColor = isMine and COLOR_MINE or COLOR_OTHER
                avStroke.Color = avatarGlowColor
                avStroke.Transparency = 1
