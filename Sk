    Bot = Color3.fromRGB(0, 255, 0)
}

local function IsFriend(player)
    if not player or player == LocalPlayer then
        return false
    end

    local ok, result = pcall(function()
        return LocalPlayer:IsFriendsWith(player.UserId)
    end)

    return ok and result
end

local function GetRoot(character)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function GetPlayerESPColor(player)
    if player and player ~= LocalPlayer then
        return IsFriend(player) and COLORS.Friend or COLORS.Enemy
    end
    return COLORS.Enemy
end

-- ✨ ظهور واختفاء ناعم للـ ESP بدل الظهور/الاختفاء المفاجئ
-- (نخزن الدوال داخل State بدل local عشان ما نتعدى حد المتغيرات المحلية في Lua)
State.ESPFadeTime = 0.35

State.SetESPAlpha = function(data, alpha) -- 1 = ظاهر كامل، 0 = مخفي
    if data.Highlight then data.Highlight.OutlineTransparency = 1 - alpha end
    if data.Beam then data.Beam.Transparency = NumberSequence.new(1 - alpha) end
end

State.FadeESP = function(data, target, duration, onDone)
    data.FadeId = (data.FadeId or 0) + 1
    local id = data.FadeId
    local startAlpha = data.Alpha or 0
    task.spawn(function()
        local t0 = os.clock()
        while true do
            if data.FadeId ~= id then return end -- تم إلغاء هذا الأنميشن بأنميشن أحدث
            local k = math.clamp((os.clock() - t0) / duration, 0, 1)
            local eased = k * k * (3 - 2 * k)
            data.Alpha = startAlpha + (target - startAlpha) * eased
            State.SetESPAlpha(data, data.Alpha)
            if k >= 1 then break end
            RunService.Heartbeat:Wait()
        end
        if onDone then onDone() end
    end)
end

State.DestroyESPData = function(character, data)
    if data.Highlight then data.Highlight:Destroy() end
    if data.Attachment then data.Attachment:Destroy() end
    if data.Beam then data.Beam:Destroy() end
    if ESP[character] == data then ESP[character] = nil end
end

-- instant = true عند اختفاء الشخصية فعليًا (ما فيه شي نسوي له أنميشن)
local function RemoveESP(character, instant)
    local data = ESP[character]
    if not data then return end

    if instant then
        data.FadeId = (data.FadeId or 0) + 1
        State.DestroyESPData(character, data)
        return
    end

    if data.Removing then return end
    data.Removing = true
    State.FadeESP(data, 0, State.ESPFadeTime, function()
        if data.Removing then
            State.DestroyESPData(character, data)
        end
    end)
end

local function HideAllESP()
    for character in pairs(ESP) do
        RemoveESP(character)
    end
end

local function CreateESP(character, color)
    if ESP[character] then return end

    local root = GetRoot(character)
    if not root then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "SkyESP"
    highlight.Adornee = character
    highlight.FillTransparency = 1
    highlight.OutlineTransparency = 1
    highlight.OutlineColor = color
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character

    local attachment = Instance.new("Attachment")
    attachment.Name = "SkyESP_Tracer"
    attachment.Parent = root

    local beam = Instance.new("Beam")
    beam.Name = "SkyESP_Line"
    beam.Attachment0 = attachment
    beam.FaceCamera = true
    beam.Width0 = 0.04
    beam.Width1 = 0.04
    beam.Transparency = NumberSequence.new(1)
    beam.Color = ColorSequence.new(color)
    beam.LightEmission = 1
    beam.Segments = 1
    beam.Parent = root

    local data = {
        Root = root,
        Highlight = highlight,
        Attachment = attachment,
        Beam = beam,
        Color = color,
        Alpha = 0
    }
    ESP[character] = data
    State.FadeESP(data, 1, State.ESPFadeTime)
end

local function UpdateESP(character, color)
    local root = GetRoot(character)

    if not root then
        RemoveESP(character, true)
        return
    end

    if not ESP[character] then
        CreateESP(character, color)
    end

    local data = ESP[character]
    if not data then return end

    -- لو كان قاعد يختفي ورجع هدف صالح، نرجعه يظهر بنعومة.
    if data.Removing then
        data.Removing = false
        State.FadeESP(data, 1, State.ESPFadeTime)
    end

    -- لا نعيد إنشاء ColorSequence كل فريم.
    if data.Color ~= color then
        data.Color = color

        if data.Highlight then
            data.Highlight.OutlineColor = color
        end

        if data.Beam then
            data.Beam.Color = ColorSequence.new(color)
        end
    end

    if data.Highlight then
        data.Highlight.Adornee = character
        data.Highlight.Enabled = true
    end

    if data.Beam then
        data.Beam.Enabled = true
    end
end

