                ys = defaultPosition.Y.Scale, yo = defaultPosition.Y.Offset
            },
            get = function()
                local p = ui.Position
                return {xs = p.X.Scale, xo = p.X.Offset, ys = p.Y.Scale, yo = p.Y.Offset}
            end,
            apply = function(value)
                if type(value) ~= "table" then return end
                if type(value.xs) ~= "number" or type(value.xo) ~= "number"
                    or type(value.ys) ~= "number" or type(value.yo) ~= "number" then return end
                ui.Position = UDim2.new(value.xs, value.xo, value.ys, value.yo)
            end
