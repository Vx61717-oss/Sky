            State.gravityPanel.ClipsDescendants = true
            State.gravityPanel.Parent = NG
            State.gravityPanel.ZIndex = 1
            Instance.new("UICorner", State.gravityPanel).CornerRadius = UDim.new(0, 12)

            local stroke = Instance.new("UIStroke", State.gravityPanel)
            stroke.Color = ASSIST_BLUE
