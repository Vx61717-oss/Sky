                _FlyTipTweenS:Create(dismissBtn, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
                task.delay(0.3, function() if frame then frame:Destroy() end end)
            end
        end)
    end

    -- 🔽 دخول
    _FlyTipTweenS:Create(frame, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, 0, 0, 40),
        BackgroundTransparency = 0
    }):Play()
    _FlyTipTweenS:Create(stroke, TweenInfo.new(0.45), {Transparency = 0}):Play()

    -- ⏱️ مدة الرسالة محسوبة من بداية ظهورها إلى اختفائها بالكامل
    local fadeDuration = tonumber(customFadeDuration) or 1.0
    task.wait(math.max(0, displayDuration - 0.45 - fadeDuration))

    if not (frame and frame.Parent) then return end -- انسكرت مسبقًا بضغطة "خلاص عرفت"

    -- 🔼 تلاشي تدريجي حتى يكون إجمالي مدة الرسالة هو displayDuration
    _FlyTipTweenS:Create(frame, TweenInfo.new(fadeDuration, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {
