-- تحديث خفيف كل 0.20 ثانية بدل كل فريم.
task.spawn(function()
    local UPDATE_INTERVAL = 0.20

    while true do
        task.wait(UPDATE_INTERVAL)

        if not State.ESPActive then
            if next(ESP) then
                HideAllESP()
            end
            continue
        end

        local active = {}
        local playerCharacters = {}
        local localCharacter = LocalPlayer.Character

        -- اللاعبون الحقيقيون.
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local character = player.Character
                playerCharacters[character] = player

                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 and GetRoot(character) then
                    active[character] = true
                    UpdateESP(character, GetPlayerESPColor(player))
                    ConnectBeamToCamera(character)
                end
            end
        end

        -- البوتات:
        -- هذا الفحص الثقيل صار كل 0.20 ثانية فقط بدل 60+ مرة بالثانية.
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and not active[obj] then
                local belongsToPlayer = false

                if localCharacter and (obj == localCharacter or obj:IsDescendantOf(localCharacter)) then
                    belongsToPlayer = true
                end

                if not belongsToPlayer then
                    local owner = Players:GetPlayerFromCharacter(obj)
                    if owner then
                        belongsToPlayer = true
                    else
                        -- فقط نفحص النماذج التي تحتوي Humanoid؛
                        -- هذا يقلل عمل IsDescendantOf بشكل كبير.
                        local humanoid = obj:FindFirstChildOfClass("Humanoid")
                        if humanoid then
                            for playerCharacter in pairs(playerCharacters) do
                                if obj == playerCharacter or obj:IsDescendantOf(playerCharacter) then
                                    belongsToPlayer = true
                                    break
                                end
                            end
                        end
                    end
                end

                if not belongsToPlayer then
                    local humanoid = obj:FindFirstChildOfClass("Humanoid")
                    local root = GetRoot(obj)

                    if humanoid and root and humanoid.Health > 0 then
                        active[obj] = true
                        UpdateESP(obj, COLORS.Bot)
                        ConnectBeamToCamera(obj)
                    end
                end
            end
        end

        -- تنظيف العناصر التي اختفت أو ماتت.
        for character in pairs(ESP) do
            if not active[character] or not character.Parent then
                RemoveESP(character)
            end
        end
    end
end)

