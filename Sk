    -- 💾 حفظ مستقل لكل ماب حسب PlaceId
    local CONFIG_FOLDER = "SkyConfig"
    local PLACE_CONFIG_FOLDER = CONFIG_FOLDER .. "/Place_" .. tostring(game.PlaceId)
    local CONFIG_FILE = PLACE_CONFIG_FOLDER .. "/config.json"
    local _configLoading = false -- عشان وقت التحميل ما يعيد يحفظ فوق نفسه كل ما يغير قيمة

    local function EnsureConfigFolder()
        pcall(function()
            if not isfolder(CONFIG_FOLDER) then
                makefolder(CONFIG_FOLDER)
            end
            if not isfolder(PLACE_CONFIG_FOLDER) then
                makefolder(PLACE_CONFIG_FOLDER)
            end
        end)
    end

    SaveConfig = function()
        if _configLoading then return end
        if not (writefile and isfile and isfolder and makefolder) then return end
        local ok = pcall(function()
            EnsureConfigFolder()
            local data = {}
            for name, entry in pairs(UI.ConfigRegistry) do
                data[name] = entry.get()
            end
            writefile(CONFIG_FILE, game:GetService("HttpService"):JSONEncode(data))
        end)
        return ok
    end

    -- يستعمله نظام إعادة المواضع الموجود خارج RunMyOriginalScript.
    _G.SkySaveConfig = function()
        if SaveConfig then return SaveConfig() end
    end

    LoadConfig = function()
        if not (readfile and isfile) then return false end
        if not isfile(CONFIG_FILE) then return false end
        local ok, data = pcall(function()
            return game:GetService("HttpService"):JSONDecode(readfile(CONFIG_FILE))
        end)
        if not ok or type(data) ~= "table" then return false end
        UI._LoadedConfig = data

        _configLoading = true
        for name, value in pairs(data) do
            local entry = UI.ConfigRegistry[name]
            if entry then
                pcall(function() entry.apply(value) end)
            end
        end
        _configLoading = false
        return true
    end

    ResetConfig = function()
        _configLoading = true
        -- 1. إرجاع كل المميزات للوضع الافتراضي (إيقاف)
        for name, entry in pairs(UI.ConfigRegistry) do
            if entry.default ~= nil then
                pcall(function() entry.apply(entry.default) end)
            end
        end
        
        -- 2. إرجاع كل ألوان التابات للوضع الافتراضي
        if UI.DefaultTabColors and ApplyTabColor then
            for idx, defColor in pairs(UI.DefaultTabColors) do
                pcall(function() ApplyTabColor(idx, defColor) end)
            end
        end
        
        -- 3. تصفير عدادات البادج (Badges)
        if UI.activeCounts then
            for page, _ in pairs(UI.activeCounts) do
                UI.activeCounts[page] = 0
                UpdateBadge(page)
            end
        end
        
        -- 4. تحديث تظليل صفحة الإعدادات لو كانت مفتوحة
        if RefreshTabPickerHighlight then
            pcall(RefreshTabPickerHighlight)
        end

        -- 5. حذف ملف الحفظ نهائيًا (دعم مختلف برامج الإكسبلويت)
        pcall(function()
            local df = delfile or deletefile
            if isfile and isfile(CONFIG_FILE) and df then
                df(CONFIG_FILE)
            end
        end)
        
        _configLoading = false
        OK("🗑️ تم حذف الحفظ وإعادة كل الإعدادات للأصل")
    end

