local function ToggleFreeCam(state)
    freeCamActive = state
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if state then
        defaultRobloxFOV = Camera.FieldOfView
        
        if hrp then hrp.Anchored = true end
        if hum then hum.PlatformStand = true end

        Camera.CameraType = Enum.CameraType.Scriptable
        camPos = Camera.CFrame.Position
        
        local lx, ly = Camera.CFrame:ToEulerAnglesYXZ()
        yaw = math.deg(ly)
        pitch = math.deg(lx)
        targetYaw = yaw
        targetPitch = pitch
        currentTargetFOV = Camera.FieldOfView
        
        showSpeedAnimation(currentSpeed)

        -- 📢 نظام إشعارات تلميح لما تشتغل المناظرة (4 ثواني - ثبات 3 - تلاشي بطيء - 5 ثواني - إشعار ثاني - تتكرر كل 20 ثانية)
        -- من ثاني دورة (بعد ما تخلص كل الرسائل وتنعاد)، يظهر زر "خلاص عرفت" عشان توقفها نهائيًا
        State.freeCamTipDismissed = State.freeCamTipDismissed or false
        State.freeCamTipShown = State.freeCamTipShown or 0
        task.spawn(function()
            while freeCamActive and not State.freeCamTipDismissed do
                task.wait(4)
                if not freeCamActive or State.freeCamTipDismissed then break end
                State.freeCamTipShown = State.freeCamTipShown + 1
                task.spawn(function()
                    FlyTipNotify("ترا يمديك تضغط 2 على الشاشة وتزيد السرعة حقت الكاميرا", State.freeCamTipShown > 2, function() State.freeCamTipDismissed = true end)
                end)

                task.wait(5)
                if not freeCamActive or State.freeCamTipDismissed then break end
                State.freeCamTipShown = State.freeCamTipShown + 1
                task.spawn(function()
                    FlyTipNotify("ترا يمديك تضغط 3 مرات وتنقص السرعة الطبيعية: 50", State.freeCamTipShown > 2, function() State.freeCamTipDismissed = true end)
                end)

                task.wait(20)
            end
        end)

        freeCamConnection = RunService.RenderStepped:Connect(function(dt)
            yaw = yaw + (targetYaw - yaw) * math.clamp(smoothSpeed * dt, 0, 1)
            pitch = pitch + (targetPitch - pitch) * math.clamp(smoothSpeed * dt, 0, 1)

            local rotation = CFrame.Angles(0, math.rad(yaw), 0) * CFrame.Angles(math.rad(pitch), 0, 0)
            
            if moveTouch and moveOrigin and moveNow then
                local diff = moveNow - moveOrigin
                local maxDrag = 100 
                local dirX = math.clamp(diff.X / maxDrag, -1, 1)
                local dirY = math.clamp(diff.Y / maxDrag, -1, 1)
                
                local moveSpeed = currentSpeed * dt
                local forward = rotation.LookVector
                local right = rotation.RightVector
                
                camPos = camPos + (forward * -dirY * moveSpeed) + (right * dirX * moveSpeed)
            end

            Camera.FieldOfView = Camera.FieldOfView + (currentTargetFOV - Camera.FieldOfView) * math.clamp(fovSmoothSpeed * dt, 0, 1)
            Camera.CFrame = CFrame.new(camPos) * rotation
        end)
    else
        if freeCamConnection then
            freeCamConnection:Disconnect()
            freeCamConnection = nil
        end
        
        activeTouches = {}
        moveTouch, moveOrigin, moveNow = nil, nil, nil
        lookTouch, lastLookPos = nil, nil
        startPinchDistance, startFOV = nil, nil
        currentSpeed = defaultSpeed 

        Camera.CameraType = Enum.CameraType.Custom
        Camera.FieldOfView = defaultRobloxFOV
        
        speedIndicator.TextTransparency = 1
        speedIndicator.TextStrokeTransparency = 1
        
        if char then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid then
                Camera.CameraSubject = humanoid
                humanoid.PlatformStand = false
            end
        end
        if hrp then hrp.Anchored = false end
    end
end

