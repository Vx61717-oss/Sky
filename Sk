-- استقبال قراءة العداد الموجود أصلًا؛ لا يوجد RenderStepped إضافي للمراقبة.
_G.SkyPerformanceFpsSink = function(fps)
    if not SkyAutoFPSCheck then return end
    -- بعد تفعيل وضع الأداء نستمر في فحص الارتفاع حتى لو ظهرت شاشة التحميل سابقًا.
    if SkyPerformancePromptShown and not SkyRecoveryCheck then return end
    if SkyPerformanceMode or SkyRecoveryCheck then
        -- بعد الضغط على «خليه تلقائي»: عند 55 FPS أو أكثر يظهر خيار الوضع الطبيعي.
        if fps >= 55 then
            SkyRecoverySeconds = SkyRecoverySeconds + 0.4
            if SkyRecoverySeconds >= 2 then
                SkyShowPerformancePrompt(false, true)
            end
        else
            SkyRecoverySeconds = 0
        end
        return
    end
    if fps <= 35 then
        if SkyLowFpsPromptLatched then return end
        SkyLowFpsSeconds = SkyLowFpsSeconds + 0.4
        if SkyLowFpsSeconds >= 2 then
            SkyLowFpsPromptLatched = true
            SkyShowPerformancePrompt(SkyAutomaticMode)
        end
    else
        SkyLowFpsSeconds = 0
        SkyLowFpsPromptLatched = false
    end
end

