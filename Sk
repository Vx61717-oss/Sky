            end)
        end


        local lastData = ""
        local _lastSeenTimestamp = nil -- nil = أول تحميل، ما نبلّغ عن رسائل قديمة
        local _debugChat = true -- 🐞 خله true لين نتأكد إن كل شي يشتغل تمام، بعدها تقدر تخليه false
        task.spawn(function()
            while true do
                local success, response = pcall(function()
                    return request({Url = FIREBASE_URL .. "?auth=" .. AUTH_TOKEN, Method = "GET"})
                end)

                if not success then
                    -- ❌ فشل الطلب نفسه (مشكلة شبكة/إكسبلويت ما يدعم request)
                    if _debugChat then WARN("فشل جلب الدردشة: " .. tostring(response)) end
                elseif not response then
                    if _debugChat then WARN("جلب الدردشة رجع بدون رد (response = nil)") end
                elseif response.StatusCode and response.StatusCode ~= 200 then
                    -- ❌ السيرفر رد لكن برمز خطأ (مثلاً 400 = رابط غلط، 401/403 = صلاحيات)
                    if _debugChat then WARN("فايربيس رد بخطأ " .. tostring(response.StatusCode) .. ": " .. tostring(response.Body)) end
                elseif response.Body then
                    -- نحدّث الكتم في كل دورة، وليس فقط عند وصول رسالة جديدة.
                    refreshChatMutes()
                    if response.Body == lastData then
                        task.wait(1)
                        continue
                    end
                    lastData = response.Body
                    local data = game:GetService("HttpService"):JSONDecode(response.Body)
                    if data then
                        local msgs = {}
                        for k, v in pairs(data) do
                            v.id = k -- 🔑 مفتاح فايربيس الفريد
                            table.insert(msgs, v)
                        end
                        table.sort(msgs, function(a, b) return a.timestamp < b.timestamp end)
                        -- 🔢 نحتفظ بآخر 15 رسالة
                        while #msgs > 15 do table.remove(msgs, 1) end

                        -- 🚫 لا نمسح ونعيد إنشاء الرسائل عند كل تحديث.
                        -- نضيف فقط الرسائل الجديدة، حتى لا يحصل رعشة/إعادة ظهور للرسائل.
                        local existing = {}
                        for _, child in ipairs(chatLog:GetChildren()) do
                            if child:IsA("Frame") and child.Name == "MsgRow" then
                                local cid = child:GetAttribute("ChatId")
                                local cts = child:GetAttribute("ChatTimestamp")
                                local cs = child:GetAttribute("ChatSender")
                                local ct = child:GetAttribute("ChatText")
                                if cid and cid ~= "" then
                                    existing["id:" .. cid] = true
                                end
                                if cts and cts ~= 0 then
                                    existing["msg:" .. tostring(cts) .. ":" .. tostring(cs) .. ":" .. tostring(ct)] = true
                                end
                            end
                        end

                        for _, m in ipairs(msgs) do
                            -- إذا وصلت رسالة مسيئة من نسخة قديمة، اكتم صاحبها واحذفها محليًا ومن المصدر.
                            local incomingBadWord = findBadChatWord(m.text)
                            if incomingBadWord ~= nil and m.userId then
                                setChatMute(m.userId, incomingBadWord)
                                if m.id then
                                    task.spawn(function()
                                        pcall(function()
                                            deleteMsgFromServer(m.id)
                                        end)
                                    end)
                                end
                            end
                            local senderMuted = m.userId and chatMuteRemaining(m.userId) > 0
                            local key = "id:" .. tostring(m.id)
                            local fallback = "msg:" .. tostring(m.timestamp) .. ":" .. tostring(m.sender) .. ":" .. tostring(m.text)
                            if not existing[key] and not existing[fallback] then
                                if m.chatType == "private" and tonumber(m.targetUserId) == game.Players.LocalPlayer.UserId then
                                    if m.sender ~= game.Players.LocalPlayer.Name and showPrivateAlert then
                                        showPrivateAlert(m.text)
                                    end
                                elseif not senderMuted and not incomingBadWord
                                    and m.chatType ~= "bubble"
                                    and not (m.chatType == "developer" and m.developerMessage == true) then
                                    chatMessageCache["id:" .. tostring(m.id)] = m
                                    if isChatMessageVisible(m) then
                                        addChatMsg(m.sender, m.text, m.id, m.userId, m.timestamp, m.chatType, m.jobId, m.placeId)
                                    end
                                end
                                existing[key] = true
                                existing[fallback] = true
                            elseif not existing[key] and existing[fallback] then
                                -- 🔑 هذي رسالة رسمناها فورًا محلياً (بدون رقم)، وفايربيس رجع رقمها الحقيقي الحين.
                                -- نحدّث الصف الموجود برقمه الصح عشان الحذف يشتغل عليه لاحقاً
                                for _, child in ipairs(chatLog:GetChildren()) do
                                    if child:IsA("Frame") and child.Name == "MsgRow" then
                                        local cid = child:GetAttribute("ChatId")
                                        local cts = child:GetAttribute("ChatTimestamp")
                                        local cs = child:GetAttribute("ChatSender")
                                        local ct = child:GetAttribute("ChatText")
                                        if (not cid or cid == "") and tostring(cts) == tostring(m.timestamp) and cs == m.sender and ct == m.text then
                                            child:SetAttribute("ChatId", m.id)
                                            break
                                        end
                                    end
                                end
                                existing[key] = true
                            end
                        end

                        -- 🔔 نظام إشعار الرسائل الجديدة (مثل واتساب/سناب)
                        local myName = game.Players.LocalPlayer.Name
                        local newestTimestamp = _lastSeenTimestamp
                        local newMsgsFromOthers = 0
                        local lastOtherMsg = nil
                        local lastOtherBubble = nil
                        local lastDeveloperMsg = nil

                        for _, m in ipairs(msgs) do
                            if not newestTimestamp or m.timestamp > newestTimestamp then
                                newestTimestamp = m.timestamp
                            end
                            if _lastSeenTimestamp and m.timestamp > _lastSeenTimestamp and m.sender ~= myName then
                                local notificationBadWord = findBadChatWord(m.text)
                                local notificationMuted = m.userId and chatMuteRemaining(m.userId) > 0
                                if m.chatType == "developer" and m.developerMessage == true and m.sender == "AAbbooyi" then
                                    lastDeveloperMsg = m
                                elseif m.chatType == "private" and m.developerMessage == true and m.sender == "AAbbooyi"
                                    and tonumber(m.targetUserId) == game.Players.LocalPlayer.UserId then
                                    -- يعرض كتنبيه عائم فقط.
                                elseif m.chatType == "bubble" and not notificationMuted and not notificationBadWord then
                                    lastOtherBubble = m
                                elseif not notificationMuted and not notificationBadWord
                                    and (m.chatType ~= "private" or tonumber(m.targetUserId) == game.Players.LocalPlayer.UserId) then
                                    local isFriendsNotification = m.chatType == "friends"
                                    local notificationsEnabled = isFriendsNotification and chatNotifyFriendsEnabled or chatNotifyGeneralEnabled
                                    if notificationsEnabled then
                                        newMsgsFromOthers = newMsgsFromOthers + 1
                                        lastOtherMsg = m
                                    end
                                end
                            end
                        end

                        if lastDeveloperMsg then
                            _lastSeenTimestamp = newestTimestamp
                            if showDeveloperAnnouncement then
                                showDeveloperAnnouncement(lastDeveloperMsg.text)
                            end
                            playMsgNotify()
                        end

                        if _lastSeenTimestamp == nil then
                            -- أول تحميل: نسجل آخر توقيت بس بدون ما نزعج المستخدم برسائل قديمة
                            _lastSeenTimestamp = newestTimestamp
                        elseif newMsgsFromOthers > 0 then
                            _lastSeenTimestamp = newestTimestamp
                            -- لا نعدّ الرسائل إذا كان المستخدم داخل الدردشة فعلًا.
                            if State._chatPageOpen then
                                State.UnreadChatCount = 0
                                UI.MiniChatBadge.Text = "0"
                                UI.MiniChatBadge.Visible = false
                            else
                                State.UnreadChatCount = State.UnreadChatCount + newMsgsFromOthers
                                UI.MiniChatBadge.Text = State.UnreadChatCount > 99 and "99+" or tostring(State.UnreadChatCount)
                                -- يظهر العداد فوق زر الدردشة فقط عندما تكون القائمة الأساسية مصغّرة.
                                UI.MiniChatBadge.Visible = State._chatPanelOpen and not State.MainUIVisible
                                -- 💬 بوب أب إشعار فقط عندما تكون خارج الدردشة.
                                playMsgNotify()
                                Notify("💬 " .. lastOtherMsg.sender, lastOtherMsg.chatType == "private" and ("تنبيه: " .. tostring(lastOtherMsg.text)) or lastOtherMsg.text, lastOtherMsg.chatType == "private" and Color3.fromRGB(255, 45, 50) or Color3.fromRGB(170, 0, 255), true)
                            end
                            -- 💬 فقط رسائل chatType="bubble" تظهر فوق رأس صاحبها.
                            if lastOtherBubble then
                                local friendPlayer = nil
                                for _, p in ipairs(game.Players:GetPlayers()) do
                                    if (lastOtherBubble.userId and p.UserId == lastOtherBubble.userId) or p.Name == lastOtherBubble.sender then
                                        friendPlayer = p
                                        break
                                    end
                                end
                                if friendPlayer then
                                    showMessageAboveHead(lastOtherBubble.text, friendPlayer, false)
                                end
                            end
                        end
                    end
                end

                -- 🟢 نبعت "أنا موجود بالدردشة" بس وتاب الدردشة يكون مفتوح عندي فعلاً
                task.spawn(function()
                        pcall(function()
                            request({
                                Url = PRESENCE_URL .. "?auth=" .. AUTH_TOKEN,
                                Method = "PATCH",
                                Headers = {["Content-Type"] = "application/json"},
                                Body = game:GetService("HttpService"):JSONEncode({
                                    [game.Players.LocalPlayer.Name] = os.time()
                                })
                            })
                        end)
                    end)

                -- ✍️ نجيب هل في حد يكتب الحين (غير نفسي)
                do
                    local okT, resT = pcall(function()
                        return request({Url = TYPING_URL .. "?auth=" .. AUTH_TOKEN, Method = "GET"})
                    end)
                    if okT and resT and resT.Body then
                        local okD, typingData = pcall(function()
                            return game:GetService("HttpService"):JSONDecode(resT.Body)
                        end)
                        local myName = game.Players.LocalPlayer.Name
                        if okD and typingData and typingData.name and typingData.name ~= myName
                            and typingData.ts and (os.time() - typingData.ts) < 6 then
                            typingLabel.Text = typingData.name .. " : يكتب..."
                        else
                            typingLabel.Text = ""
                        end
                    end
                end

                -- 🟢 نجيب هل خويي متصل (فاتح تاب الدردشة عنده هو الحين)
                do
                    local okP, resP = pcall(function()
                        return request({Url = PRESENCE_URL .. "?auth=" .. AUTH_TOKEN, Method = "GET"})
                    end)
                    if okP and resP and resP.Body then
                        local okD, presenceData = pcall(function()
                            return game:GetService("HttpService"):JSONDecode(resP.Body)
                        end)
                        local myName = game.Players.LocalPlayer.Name
                        local friendOnline = false
                        if okD and presenceData then
                            for pname, pts in pairs(presenceData) do
                                if pname ~= myName and type(pts) == "number" and (os.time() - pts) < 10 then
                                    friendOnline = true
                                end
                            end
                        end
                        onlineLabel.Text = friendOnline and "🟢 متصل" or ""
                        _otherUserInChat = friendOnline
                        -- إذا لم يوجد أحد آخر داخل قائمة الدردشة تبقى رسائلي «غير مقروءة».
                        -- عند ظهور صديق/مستخدم آخر في الحضور تتحول إلى «مقروء».
                        updateOwnMessageReadState(friendOnline)
                    end
                end

                task.wait(3)
            end
        end)
    end
