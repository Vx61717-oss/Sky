            local visibleHeight = chatLog.AbsoluteSize.Y
            local maxY = math.max(0, chatLog.AbsoluteCanvasSize.Y - visibleHeight)
            local viewportBottom = chatLog.AbsolutePosition.Y + visibleHeight
            local hiddenBelowCount = 0

            -- نحسب الرسائل الفعلية الموجودة تحت الجزء الظاهر، وليس مساحة الفراغ.
            for _, child in ipairs(chatLog:GetChildren()) do
