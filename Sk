    -- ═══════════════════════════════════════════════════════════════════
    -- ⚙️ تاب الإعدادات: تغيير لون حواف أي تاب من التابات الستة
    -- ═══════════════════════════════════════════════════════════════════

    -- 🎨 يطبّق لون جديد على تاب معيّن: يحدّث زر التاب، عناصر صفحته، وإطار القائمة لو كان هذا التاب هو المفعّل حاليًا
    ApplyTabColor = function(idx, color)
        UI.TabColors[idx] = color

        if UI.tabGlowGrad[idx] then
            SetGlowColor(UI.tabGlowGrad[idx], color)
        end
        if UI.TabGlowRegistry[idx] then
            for _, g in ipairs(UI.TabGlowRegistry[idx]) do
                SetGlowColor(g, color)
            end
        end
        -- 🎨 لو فيه زر مفعّل حاليًا (تشغيل) بهذا التاب، حدث لونه فورًا بدون ما ننتظر ضغطة جديدة
        if UI.ActiveToggleWatchers[idx] then
            for _, w in ipairs(UI.ActiveToggleWatchers[idx]) do
                if w.isActive() then
                    w.stroke.Color = color
                    SetGlowColor(w.glow, color)
                end
            end
        end

        local page = UI["Page" .. idx]
        if page then UI.PageGlowColor[page] = color end

        -- لو هذا التاب هو المفعّل حاليًا (لونه ممزوج مب اللون الأساسي)، نحدث كل شي مرتبط به فورًا
        local btn = UI.tabButtons[idx]
        -- لا نلمس BackgroundColor3 هنا؛ يتغير الخط والتوهج فقط.
