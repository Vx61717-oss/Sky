        local _otherUserInChat = false

        local function updateOwnMessageReadState(otherUserInChat)
            local latestOwnRow = nil
            local latestTimestamp = -math.huge

            -- نحدد آخر رسالة لي فقط حتى لا نكرر كلمة الحالة تحت كل الرسائل القديمة.
            for _, row in ipairs(chatLog:GetChildren()) do
                if row:IsA("Frame") and row.Name == "MsgRow" and row:GetAttribute("IsMine") then
                    local rowTimestamp = tonumber(row:GetAttribute("ChatTimestamp")) or 0
                    if rowTimestamp >= latestTimestamp then
                        latestTimestamp = rowTimestamp
                        latestOwnRow = row
                    end

                    -- إذا دخل مستخدم آخر صفحة الدردشة، نثبت الرسائل على «مقروء».
                    if otherUserInChat then
                        row:SetAttribute("ReadState", "Read")
                    end
                end
            end

            for _, row in ipairs(chatLog:GetChildren()) do
                if row:IsA("Frame") and row.Name == "MsgRow" and row:GetAttribute("IsMine") then
                    local readStatus = row:FindFirstChild("ReadStatus")
                    if readStatus then
                        readStatus.Visible = (row == latestOwnRow)
                        local isRead = row:GetAttribute("ReadState") == "Read"
                        readStatus.Text = isRead
                            and (_SelectedLanguage == "English" and "Read" or "مقروء")
                            or (_SelectedLanguage == "English" and "Unread" or "غير مقروء")
                        readStatus.TextColor3 = isRead
                            and Color3.fromRGB(120, 220, 150)
                            or Color3.fromRGB(175, 175, 185)
                    end
                end
            end
        end

        local openPlayerInfo
