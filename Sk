        avStroke.Color = avatarStrokeColor or C
        avStroke.Thickness = 1.5
        avStroke.Transparency = 1
        textOffset = 52
    end

    local TL = Instance.new("TextLabel", I)
    TL.Size = UDim2.new(1, -textOffset - 11, 0, 18)
    TL.Position = UDim2.new(0, textOffset, 0, 5)
    TL.BackgroundTransparency = 1
    TL.Text = T
    TL.TextColor3 = C
    TL.TextTransparency = 1
    TL.Font = Enum.Font.GothamBold
    TL.TextSize = 14
    TL.TextXAlignment = Enum.TextXAlignment.Left
    
    local ML = Instance.new("TextLabel", I)
    ML.Size = UDim2.new(1, -textOffset - 11, 0, 16)
    ML.Position = UDim2.new(0, textOffset, 0, 22)
    ML.BackgroundTransparency = 1
    ML.Text = M
    ML.TextColor3 = Color3.fromRGB(220, 220, 220)
    ML.TextTransparency = 1
    ML.Font = Enum.Font.GothamMedium
    ML.TextSize = 12
    ML.TextXAlignment = Enum.TextXAlignment.Left
    
    task.spawn(function()
        pcall(function()
        if not F.Parent then return end
        I:TweenSize(UDim2.new(1, 0, 0, 45), "Out", "Quad", 0.2, true)
        F:TweenSize(UDim2.new(1, 0, 0, 45), "Out", "Quad", 0.2, true)
        -- دخول بحركة Back (بوّنس خفيف) + تعتيم تدريجي
        _TweenS:Create(I, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 0
        }):Play()
        _TweenS:Create(TL, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { TextTransparency = 0 }):Play()
        _TweenS:Create(ML, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { TextTransparency = 0 }):Play()
        if AvatarImg then
            _TweenS:Create(AvatarImg, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { ImageTransparency = 0 }):Play()
            local avStroke2 = AvatarImg:FindFirstChildOfClass("UIStroke")
            if avStroke2 then _TweenS:Create(avStroke2, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 0 }):Play() end
        end

        -- 📳 اهتزاز بصري بسيط للتنبيهات المهمة
        if shake then
            task.wait(0.45)
            if not F.Parent then return end
            local basePos = I.Position
            for i = 1, 3 do
                if not F.Parent then return end
                _TweenS:Create(I, TweenInfo.new(0.05, Enum.EasingStyle.Linear), { Position = basePos + UDim2.new(0, 6, 0, 0) }):Play()
                task.wait(0.05)
                _TweenS:Create(I, TweenInfo.new(0.05, Enum.EasingStyle.Linear), { Position = basePos - UDim2.new(0, 6, 0, 0) }):Play()
                task.wait(0.05)
            end
            if not F.Parent then return end
            _TweenS:Create(I, TweenInfo.new(0.05, Enum.EasingStyle.Linear), { Position = basePos }):Play()
        end

        task.wait(2.5)
        if not F.Parent then return end -- تم استبدال هذا الإشعار بواحد جديد قبل ما ينتهي وقته

        -- خروج: يطفى ويصعد لفوق بهدوء
        _TweenS:Create(I, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0, 0, 0, -10),
            BackgroundTransparency = 1
        }):Play()
        _TweenS:Create(TL, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }):Play()
        _TweenS:Create(ML, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }):Play()
        task.wait(0.2)
        if not F.Parent then return end
        I:TweenSize(UDim2.new(1, 0, 0, 0), "In", "Quad", 0.15, true)
        F:TweenSize(UDim2.new(1, 0, 0, 0), "In", "Quad", 0.15, true)
        task.wait(0.2)
        if _currentNotification == F then _currentNotification = nil end
        if F.Parent then F:Destroy() end
        end)
    end)
end

