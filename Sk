            -- كل قناة تحتفظ برسائلها وموضع تمريرها بشكل مستقل.
            if isFriends then
                chatLog = friendsChatLog
                chatList = friendsChatList
                generalChatLog.Visible = false
                friendsChatLog.Visible = true
            else
                chatLog = generalChatLog
                chatList = generalChatList
                friendsChatLog.Visible = false
