    -- ✨ أشكال هندسية متحركة: مربع، دائرة، مثلث
    -- ═══════════════════════════════════════════════════════════════════
    local TweenService = game:GetService("TweenService")
    local math_random = math.random
    local shapeColors = {
        Color3.fromRGB(170, 0, 255),
        Color3.fromRGB(80, 120, 255),
        Color3.fromRGB(220, 70, 255)
    }

    local function makeShape(shapeType)
        local size = math_random(18, 32)
        local shape
        local color = shapeColors[math_random(1, 3)]

        if shapeType == 3 then
            shape = Instance.new("TextLabel")
            shape.Text = "▲"
            shape.Font = Enum.Font.GothamBold
            shape.TextScaled = true
            shape.TextColor3 = color
            shape.BackgroundTransparency = 1
        else
            shape = Instance.new("Frame")
            shape.BackgroundColor3 = color
            shape.BackgroundTransparency = 0.2
            shape.BorderSizePixel = 0
            if shapeType == 2 then
                local circle = Instance.new("UICorner")
                circle.CornerRadius = UDim.new(1, 0)
                circle.Parent = shape
            end
        end

        shape.Name = "SkyShape"
        shape.Parent = ParticleContainer
        local fullSize = UDim2.new(0, size, 0, size)
        shape.Size = UDim2.new(0, 0, 0, 0)
        shape.AnchorPoint = Vector2.new(0.5, 0.5)
        local function offscreenPosition(edge)
            if edge == 1 then -- من اليسار
                return UDim2.new(-0.18, 0, math_random(8, 92) / 100, 0)
            elseif edge == 2 then -- من اليمين
                return UDim2.new(1.18, 0, math_random(8, 92) / 100, 0)
            elseif edge == 3 then -- من الأعلى
                return UDim2.new(math_random(8, 92) / 100, 0, -0.18, 0)
            else -- من الأسفل
                return UDim2.new(math_random(8, 92) / 100, 0, 1.18, 0)
            end
        end

        local function oppositeEdge(edge)
            if edge == 1 then return 2 end
            if edge == 2 then return 1 end
            if edge == 3 then return 4 end
            return 3
        end

        local entryEdge = math_random(1, 4)
        shape.Position = offscreenPosition(entryEdge)
        shape.Rotation = math_random(0, 360)
        shape.ZIndex = 3

        local isTriangle = shapeType == 3
        if isTriangle then
            shape.TextTransparency = 1
        else
            shape.BackgroundTransparency = 1
        end

        task.spawn(function()
            while shape.Parent do
                if BackgroundOverlay.Visible and not State.IsSuperMini then
                    local exitEdge = oppositeEdge(entryEdge)
                    local exitPosition = offscreenPosition(exitEdge)

                    -- يظهر من خارج الشاشة ثم يعبر كامل المساحة بدون تلاشي داخلها.
                    shape.Size = UDim2.new(0, 0, 0, 0)
                    if isTriangle then
                        shape.TextTransparency = 1
                    else
                        shape.BackgroundTransparency = 1
                    end

                    local appear = { Size = fullSize }
                    if isTriangle then
                        appear.TextTransparency = 0.05
                    else
                        appear.BackgroundTransparency = 0.2
                    end
                    local appearTween = TweenService:Create(shape, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), appear)
                    appearTween:Play()
                    appearTween.Completed:Wait()
                    if not shape.Parent then break end

                    local moveTween = TweenService:Create(shape, TweenInfo.new(math_random(32, 46) / 10, Enum.EasingStyle.Linear), {
                        Position = exitPosition,
                        Rotation = shape.Rotation + math_random(90, 270)
                    })
                    moveTween:Play()
                    moveTween.Completed:Wait()
                    if not shape.Parent then break end

                    -- يبدأ التلاشي بعد وصوله خارج الشاشة بالكامل.
                    local fade = { Size = UDim2.new(0, 0, 0, 0) }
                    if isTriangle then fade.TextTransparency = 1 else fade.BackgroundTransparency = 1 end
                    local fadeTween = TweenService:Create(shape, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In), fade)
                    fadeTween:Play()
                    fadeTween.Completed:Wait()

                    entryEdge = math_random(1, 4)
                    shape.Position = offscreenPosition(entryEdge)
                else
                    task.wait(0.5)
                end
            end
        end)
    end

    task.spawn(function()
        for i = 1, 12 do
            makeShape(((i - 1) % 3) + 1)
            task.wait(0.28)
        end
    end)
