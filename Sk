            -- 📍 محاذاة: كلامي يمين، كلام خويي يسار (نفس الشي عند الطرفين لأنه مبني على isMine)
            local targetPos
            if isMine then
                bubble.AnchorPoint = Vector2.new(1, 0)
                local rightOffset = avatarImg and (5 + AVATAR_SIZE + AVATAR_GAP + MY_MESSAGE_LEFT_SHIFT) or (5 + MY_MESSAGE_LEFT_SHIFT)
                targetPos = UDim2.new(1, -rightOffset, 0, 0)
                bubble.Position = UDim2.new(1, 25, 0, 0) -- يبدأ خارج الحافة عشان الانميشن
            else
                bubble.AnchorPoint = Vector2.new(0, 0)
                local leftOffset = avatarImg and (5 + AVATAR_SIZE + AVATAR_GAP + FRIEND_MESSAGE_RIGHT_SHIFT) or (5 + FRIEND_MESSAGE_RIGHT_SHIFT)
                targetPos = UDim2.new(0, leftOffset, 0, 0)
                bubble.Position = UDim2.new(0, leftOffset - 30, 0, 0)
            end

            -- نخلي السحاب فيه مساحة إضافية 500 بكسل، لكن ما نغيّر مكان المستخدم
            -- عند وصول/تحميل الرسائل. التحريك لآخر رسالة يصير فقط عند إرسال رسالة من المستخدم.
            chatLog.CanvasSize = UDim2.new(0, 0, 0, chatList.AbsoluteContentSize.Y + 500)

            -- 👆 كل الرسايل قابلة للضغط: الحذف بس لرسايلي، النسخ لأي رسالة
            -- (نخلي الفقاعة نفسها قابلة للنقر بدل ما نضيف عنصر جواها، عشان ما يصير تضارب بحساب الطول التلقائي)
            bubble.Active = true
            bubble.InputBegan:Connect(function(input)
                if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
                if _deleteModeActive and isMine then
                    local liveId = row:GetAttribute("ChatId")
                    if not liveId or liveId == "" then liveId = nil end
                    openSelectMenu(bubble, stroke, label, row, liveId)
                elseif _copyModeActive then
                    openCopyMenu(label)
                end
