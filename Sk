        task.spawn(function()
            if not request then return end
            local ok, res = pcall(function()
                return request({Url = NOTES_URL .. "?auth=" .. AUTH_TOKEN, Method = "GET"})
            end)
            if not (ok and res and res.Body and res.Body ~= "null") then return end
            local okD, allNotes = pcall(function()
                return game:GetService("HttpService"):JSONDecode(res.Body)
            end)
            if not (okD and type(allNotes) == "table") then return end

            local myUserId = game.Players.LocalPlayer.UserId
            local list = {}
            for k, v in pairs(allNotes) do
                if type(v) == "table" and (isNotesAdmin or v.userId == myUserId) then
                    v.__id = k
                    table.insert(list, v)
                end
            end
            table.sort(list, function(a, b) return (a.ts or 0) < (b.ts or 0) end)
            if not isNotesAdmin then
                while #list > 10 do table.remove(list, 1) end
            end
            if #list > 0 then NotesEmptyLbl.Visible = false end
            for _, v in ipairs(list) do
                addNoteRow(tostring(v.text or ""), true, v.__id, v.userId)
            end
        end)

