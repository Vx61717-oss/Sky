        if not request then
            WARN("⚠️ برنامج الإكسبلويت حقك ما يدعم دالة request/http_request/syn.request — الدردشة ما راح تشتغل أبد على هذا البرنامج")
        else
            -- 🧹 نمسح تاريخ الدردشة القديم كل ما نشغل السكربت، يبدأ نظيف من جديد
            task.spawn(function()
