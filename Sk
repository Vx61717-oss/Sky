                    sb.AutoButtonColor = false
                    sb.ZIndex = 7
                    Instance.new("UICorner", sb).CornerRadius = UDim.new(0, 8)
                    local sbc = Instance.new("UITextSizeConstraint", sb)
                    sbc.MaxTextSize = 22
                    sbc.MinTextSize = 10
                    local sbStroke = Instance.new("UIStroke", sb)
                    sbStroke.Color = Color3.fromRGB(170, 0, 255)
                    sbStroke.Thickness = 2
                    sbStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                    sbStroke.Transparency = 0.7
                    AddTabGlow(sbStroke, 1.5, parent)

                    sb.MouseEnter:Connect(function()
                        _TweenS:Create(sb, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            BackgroundColor3 = Color3.fromRGB(35, 35, 35)
                        }):Play()
                    end)
                    sb.MouseLeave:Connect(function()
                        _TweenS:Create(sb, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                        }):Play()
                    end)

                    local function applyStep()
                        local cur = tonumber(b.Text) or 0
                        local nv = math.clamp(math.floor((cur + delta) * 10 + 0.5) / 10, minV, maxV)
                        b.Text = tostring(nv)
                        call(b.Text)
                    end

                    local holding, longPress = false, false
                    sb.InputBegan:Connect(function(input)
                        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
                        holding = true
                        longPress = false
                        task.delay(0.45, function()
                            if not holding or not sb.Parent then return end
                            longPress = true
                            while holding and sb.Parent do
                                applyStep()
                                task.wait(0.12)
                            end
                            SaveConfig()
                        end)
                    end)
                    sb.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            holding = false
                        end
                    end)
                    sb.MouseButton1Click:Connect(function()
                        playClick()
                        if not longPress then
                            applyStep()
                            SaveConfig()
                        end
                        longPress = false
                    end)
                end
                makeStepBtn("-", 0.36, -opts.step)
                makeStepBtn("+", 0.78, opts.step)
            end
