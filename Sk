    -- 🎨 حواف متحركة بنفسجي + أسود (نفس ستايل باقي أزرار القائمة)
    local grad = Instance.new("UIGradient", stroke)
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(170, 0, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(8, 8, 10)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(170, 0, 255)),
    })
    task.spawn(function()
        while frame and frame.Parent do
            grad.Rotation = (grad.Rotation + 3) % 360
            task.wait(0.03)
        end
    end)

    local label = Instance.new("TextLabel", frame)
    label.Size = showDismissBtn and UDim2.new(1, -115, 1, -10) or UDim2.new(1, -20, 1, -10)
    label.Position = UDim2.new(0, 10, 0, 5)
