local function _disconnectSelectedDeathHooks()
    if _selectedDeathCharacterConn then
        _selectedDeathCharacterConn:Disconnect()
        _selectedDeathCharacterConn = nil
    end
    if _selectedDeathHumanoidConn then
        _selectedDeathHumanoidConn:Disconnect()
        _selectedDeathHumanoidConn = nil
    end
end

local function _hookSelectedPlayerDeath(player)
    _disconnectSelectedDeathHooks()
    if not player then return end

    local function hookCharacter(character)
        if _selectedDeathHumanoidConn then
            _selectedDeathHumanoidConn:Disconnect()
            _selectedDeathHumanoidConn = nil
        end

        if State.selectedPlayer ~= player then return end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
            or character:WaitForChild("Humanoid", 5)

        if humanoid and State.selectedPlayer == player then
            local playedThisDeath = false

            _selectedDeathHumanoidConn = humanoid.Died:Connect(function()
                if playedThisDeath or State.selectedPlayer ~= player then
                    return
                end

                playedThisDeath = true
                _selectedDeathSound:Stop()
                _selectedDeathSound.TimePosition = 0
                _selectedDeathSound:Play()
            end)
        end
    end

    if player.Character then
        hookCharacter(player.Character)
    end

    _selectedDeathCharacterConn = player.CharacterAdded:Connect(function(character)
        if State.selectedPlayer == player then
            hookCharacter(character)
        end
    end)
end

