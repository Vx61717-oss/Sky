        local DEFAULT_GRAVITY = workspace.Gravity
        local GRAVITY_STEP = 15
        local MIN_GRAVITY = 5
        local MAX_GRAVITY = 600

        State.gravityValue = math.clamp(tonumber(State.gravityValue) or DEFAULT_GRAVITY, MIN_GRAVITY, MAX_GRAVITY)
        State.gravityPanel = nil
        State.gravityCollapsed = false

        State.gravityValueLabel = nil
        local gravityBodyItems = {}
        -- 💾 تسجيل قيمة الجاذبية قبل تحميل الإعدادات، حتى تُستعاد تلقائيًا عند بدء السكربت.
        UI.ConfigRegistry["الجاذبية - القيمة"] = {
            get = function() return State.gravityValue end,
            default = DEFAULT_GRAVITY,
            apply = function(value)
                local loaded = math.clamp(math.floor(tonumber(value) or DEFAULT_GRAVITY), MIN_GRAVITY, MAX_GRAVITY)
                State.gravityValue = loaded
                workspace.Gravity = loaded
                if State.gravityValueLabel then
                    State.gravityValueLabel.Text = "الجاذبية: " .. loaded
                end
            end
        }

        local function closeGravityPanel(animated)
            if State.gravityPanel then
                local closing = State.gravityPanel
                State.gravityPanel = nil
                State.gravityValueLabel = nil
                if animated then
                    State.FadeOutPanel(closing, 0.35)
                    task.delay(0.4, function() if closing then closing:Destroy() end end)
                else
                    closing:Destroy()
                end
            end
        end

        local function openGravityPanel()
            closeGravityPanel()

            -- 🖼️ نفس إطار قائمة Fly بالضبط: حجم يبدأ من صفر ويتوسع بـ Back-easing، شفافية 1 → 0
            State.gravityPanel = Instance.new("Frame")
