-- 🔒 تحريك محدود لزر القفل: يقدر يتحرك شوي لكن ما يقدر يطلع من صندوق ثابت حواليه
-- (كذا حتى لو تحرك يفضل قريب من مكانه المعروف وما يضيع)
local lockBaseOffsetX, lockBaseOffsetY = -100, -110 -- نفس قيم موضع الزر الثابت فوق
local LOCK_BOX_RADIUS = 90 -- حجم الهدبوكس حول الزر (بالبكسل) -- كبير شوي عشان يعطي مجال حركة مريح

local function clampLockButtonPosition(pos)
	local minX, maxX = lockBaseOffsetX - LOCK_BOX_RADIUS, lockBaseOffsetX + LOCK_BOX_RADIUS
	local minY, maxY = lockBaseOffsetY - LOCK_BOX_RADIUS, lockBaseOffsetY + LOCK_BOX_RADIUS
	local x = math.clamp(pos.X.Offset, minX, maxX)
	local y = math.clamp(pos.Y.Offset, minY, maxY)
	return UDim2.new(pos.X.Scale, x, pos.Y.Scale, y)
end

local lockDragging, lockDragInput, lockDragStart, lockStartPos = false, nil, nil, nil
local lockMoved = false

local function updateLockButton(input)
	local delta = input.Position - lockDragStart
	if delta.Magnitude > 8 then lockMoved = true end
	local newPos = UDim2.new(
		lockStartPos.X.Scale, lockStartPos.X.Offset + delta.X,
		lockStartPos.Y.Scale, lockStartPos.Y.Offset + delta.Y
	)
	button.Position = clampLockButtonPosition(newPos)
end

button.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		lockDragging = true
		lockMoved = false
		lockDragStart = input.Position
		lockStartPos = button.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				lockDragging = false
			end
		end)
	end
end)

button.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		lockDragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == lockDragInput and lockDragging then
		updateLockButton(input)
	end
end)

-- 4. تفعيل الدوران (الشخصية تتبع الكاميرا)
local isLocked = false
-- عداد ضغطات زر القفل لإعادة أماكن كل القوائم بعد 3 ضغطات سريعة
local _lockClickTimes = {}
RunService.RenderStepped:Connect(function()
	if isLocked and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
		local hrp = player.Character.HumanoidRootPart
		local camLook = camera.CFrame.LookVector
		hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + Vector3.new(camLook.X, 0, camLook.Z))
	end
end)

-- 5. عند الضغط على الزر (تغيير الحالة) + كشف 3 ضغطات سريعة لإعادة القوائم لمكانها
button.MouseButton1Click:Connect(function()
	if lockMoved then
		lockMoved = false
		return
	end

	isLocked = not isLocked
	if isLocked then
		button.Image = UNLOCKED_ICON
		button.ImageColor3 = Color3.fromRGB(0, 255, 100)
		uiStroke.Color = Color3.fromRGB(0, 255, 100)
	else
		button.Image = LOCKED_ICON
		button.ImageColor3 = Color3.fromRGB(255, 255, 255)
		uiStroke.Color = Color3.fromRGB(255, 255, 255)
	end

	-- 🔁 3 ضغطات متتالية وسريعة على زر القفل = إرجاع كل القوائم لمكانها الأصلي
	local now = tick()
	table.insert(_lockClickTimes, now)
	while #_lockClickTimes > 0 and (now - _lockClickTimes[1]) > TRIPLE_CLICK_WINDOW do
		table.remove(_lockClickTimes, 1)
	end

	if #_lockClickTimes >= 3 then
		_lockClickTimes = {}
		if _G.SkyResetMenuPositions then
			local ok = pcall(_G.SkyResetMenuPositions)
			if ok and FlyTipNotify then
				pcall(function()
					FlyTipNotify("🔄 تم إرجاع كل القوائم لمكانها الأصلي", false, nil, 4.0, 1.0)
				end)
			end
		end
	end
end)

