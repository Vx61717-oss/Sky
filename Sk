                local p = math.clamp((i.Position.X - sB.AbsolutePosition.X) / sB.AbsoluteSize.X, 0, 1)
                applySlider(min + (p * (max - min)))
                SaveConfig()
            end 
        end)

        -- 💾 تسجيل السلايدر في نظام حفظ الإعدادات
        UI.ConfigRegistry[txt] = {
            get = function() return currentVal end,
            default = startVal,
            apply = function(value) applySlider(tonumber(value) or startVal) end
        }
