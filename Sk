    label.Font = Enum.Font.GothamBold
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeColor3 = Color3.fromRGB(170, 0, 255)
    label.TextStrokeTransparency = 0.4
    label.TextTransparency = 0
    label.TextSize = 17
    label.TextWrapped = true
    label.Text = "💡 معلومة: " .. msg

    -- ✅ زر "خلاص عرفت" (يظهر فقط عند تكرار الرسائل في الدورة الثانية) عشان توقف التلميحات نهائيًا لو ما تحتاجها
    local dismissBtn
    if showDismissBtn then
        dismissBtn = Instance.new("TextButton", frame)
        dismissBtn.Size = UDim2.new(0, 90, 0, 34)
        dismissBtn.AnchorPoint = Vector2.new(1, 0.5)
        dismissBtn.Position = UDim2.new(1, -10, 0.5, 0)
        dismissBtn.BackgroundColor3 = Color3.fromRGB(170, 0, 255)
        dismissBtn.Text = "خلاص عرفت"
        dismissBtn.TextColor3 = Color3.new(1, 1, 1)
        dismissBtn.Font = Enum.Font.GothamBold
        dismissBtn.TextScaled = true
        dismissBtn.ZIndex = 102
        Instance.new("UICorner", dismissBtn).CornerRadius = UDim.new(0, 8)
        local dismissConstraint = Instance.new("UITextSizeConstraint", dismissBtn)
        dismissConstraint.MaxTextSize = 13
        dismissConstraint.MinTextSize = 8

        dismissBtn.MouseButton1Click:Connect(function()
            if onDismiss then onDismiss() end
            if frame and frame.Parent then
                _FlyTipTweenS:Create(frame, TweenInfo.new(0.3), {
                    BackgroundTransparency = 1,
                    Position = frame.Position + UDim2.new(0, 0, 0, -20)
                }):Play()
                _FlyTipTweenS:Create(stroke, TweenInfo.new(0.3), {Transparency = 1}):Play()
                _FlyTipTweenS:Create(label, TweenInfo.new(0.3), {TextTransparency = 1, TextStrokeTransparency = 1}):Play()
                _FlyTipTweenS:Create(dismissBtn, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
                task.delay(0.3, function() if frame then frame:Destroy() end end)
            end
        end)
    end

    -- 🔽 دخول
    _FlyTipTweenS:Create(frame, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, 0, 0, 40),
        BackgroundTransparency = 0
    }):Play()
    _FlyTipTweenS:Create(stroke, TweenInfo.new(0.45), {Transparency = 0}):Play()

    -- ⏱️ مدة الرسالة محسوبة من بداية ظهورها إلى اختفائها بالكامل
    local fadeDuration = tonumber(customFadeDuration) or math.min(0.25, displayDuration * 0.2)
    task.wait(math.max(0, displayDuration - 0.45 - fadeDuration))

    if not (frame and frame.Parent) then return end -- انسكرت مسبقًا بضغطة "خلاص عرفت"

    -- 🔼 تلاشي تدريجي حتى يكون إجمالي مدة الرسالة هو displayDuration
    _FlyTipTweenS:Create(frame, TweenInfo.new(fadeDuration, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {
        BackgroundTransparency = 1,
        Position = frame.Position + UDim2.new(0, 0, 0, -20)
    }):Play()
    _FlyTipTweenS:Create(stroke, TweenInfo.new(fadeDuration), {Transparency = 1}):Play()
    _FlyTipTweenS:Create(label, TweenInfo.new(fadeDuration), {TextTransparency = 1, TextStrokeTransparency = 1}):Play()
    task.wait(fadeDuration)
    if frame then frame:Destroy() end
end
