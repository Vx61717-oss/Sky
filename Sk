    local function MakeDraggable(ui)
        local UserInputService = game:GetService("UserInputService")
        local dragging, dragInput, dragStart, startPos

        -- تسجيل موضع النافذة داخل نفس ملف config المستخدم للإعدادات.
        local positionKey = "__Position_" .. ui.Name
        local defaultPosition = ui.Position
        UI.ConfigRegistry[positionKey] = {
            default = {
                xs = defaultPosition.X.Scale, xo = defaultPosition.X.Offset,
                ys = defaultPosition.Y.Scale, yo = defaultPosition.Y.Offset
            },
            get = function()
                local p = ui.Position
                return {xs = p.X.Scale, xo = p.X.Offset, ys = p.Y.Scale, yo = p.Y.Offset}
            end,
            apply = function(value)
                if type(value) ~= "table" then return end
                if type(value.xs) ~= "number" or type(value.xo) ~= "number"
                    or type(value.ys) ~= "number" or type(value.yo) ~= "number" then return end
                ui.Position = UDim2.new(value.xs, value.xo, value.ys, value.yo)
            end
        }

        -- إذا كانت النافذة أُنشئت بعد تحميل config، طبّق موضعها المحفوظ فوراً.
        if UI._LoadedConfig and UI._LoadedConfig[positionKey] then
            pcall(function() UI.ConfigRegistry[positionKey].apply(UI._LoadedConfig[positionKey]) end)
        end

        ui.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true; dragStart = input.Position; startPos = ui.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                        if SaveConfig then SaveConfig() end
                    end
                end)
            end
        end)
        ui.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                local delta = input.Position - dragStart
                ui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
    end

