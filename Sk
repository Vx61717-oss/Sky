local function getDistanceBetweenTouches()
    if #activeTouches < 2 then return nil end
    local p1 = activeTouches[1].Position
    local p2 = activeTouches[2].Position
    return (Vector2.new(p1.X, p1.Y) - Vector2.new(p2.X, p2.Y)).Magnitude
end

