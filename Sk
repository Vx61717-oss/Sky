        -- تسجيل موضع النافذة داخل نفس ملف config المستخدم للإعدادات.
        local positionKey = "__Position_" .. ui.Name
        local defaultPosition = ui.Position
        UI.ConfigRegistry[positionKey] = {
            default = {
