        local function sendMsg()
            local text = inputBox.Text
            if text == "" then return end
            local myName = game.Players.LocalPlayer.Name
            local myUserId = game.Players.LocalPlayer.UserId
            local data = {["sender"] = myName, ["text"] = text, ["timestamp"] = os.time(), ["userId"] = myUserId}
            inputBox.Text = ""
            -- ✅ نطلع الرسالة فورًا بالقائمة بدون ما ننتظر الرد من فايربيس
            addChatMsg(myName, text, nil, myUserId, data.timestamp)

            -- بعد الإرسال فقط: نوقف عند آخر رسالة فعلية، وليس عند نهاية المساحة الفارغة.
            task.defer(function()
                task.wait()
                task.wait() -- ننتظر تحديث UIListLayout قبل حساب مكان آخر رسالة
                local contentHeight = chatList.AbsoluteContentSize.Y
                local visibleHeight = chatLog.AbsoluteSize.Y
                -- نخلي آخر رسالة تنزل شوي زيادة عشان تكون كاملة وواضحة فوق شريط الكتابة،
                -- لكن ما نوصل لنهاية الـ500 بكسل الفاضية.
                local extraReveal = 70
                local targetY = math.max(0, contentHeight - visibleHeight + extraReveal)
                local maxY = math.max(0, chatLog.AbsoluteCanvasSize.Y - visibleHeight)
                targetY = math.min(targetY, maxY)
                chatLog.CanvasPosition = Vector2.new(0, targetY)
            end)

            task.spawn(function()
                local ok, res = pcall(function()
                    return request({
                        Url = FIREBASE_URL .. "?auth=" .. AUTH_TOKEN,
                        Method = "POST",
                        Headers = {["Content-Type"] = "application/json"},
                        Body = game:GetService("HttpService"):JSONEncode(data)
                    })
                end)
                if not ok then
                    WARN("فشل إرسال الرسالة: " .. tostring(res))
                elseif res and res.StatusCode and res.StatusCode ~= 200 then
                    WARN("فايربيس رفض الإرسال (" .. tostring(res.StatusCode) .. "): " .. tostring(res.Body))
                end
            end)
        end
        
