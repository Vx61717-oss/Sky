            btn.Position = UDim2.new(0.65, 0, 0.15, 0)
            btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25) -- لون خلفية أغمق ليتناسب مع الثيم
            btn.Text = _TranslateText("تشغيل")
            btn.TextColor3 = Color3.new(1,1,1)
