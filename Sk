            task.defer(function()
                local slideInfo = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                local fadeInfo = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                TweenService:Create(bubble, slideInfo, {Position = targetPos}):Play()
                TweenService:Create(bubble, fadeInfo, {BackgroundTransparency = 0.25}):Play()
                TweenService:Create(stroke, fadeInfo, {Transparency = 0}):Play()
                TweenService:Create(nameLabel, fadeInfo, {TextTransparency = 0.35}):Play()
                TweenService:Create(label, fadeInfo, {TextTransparency = 0}):Play()
                if avatarImg then
                    local avStroke = avatarImg:FindFirstChildOfClass("UIStroke")
                    TweenService:Create(avatarImg, fadeInfo, {ImageTransparency = 0}):Play()
                    if avStroke then TweenService:Create(avStroke, fadeInfo, {Transparency = 0}):Play() end
                end
            end)
