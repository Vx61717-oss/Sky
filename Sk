        -- 🛡️ فلتر الدردشة: يزيل الرموز والفواصل والتشكيل، ثم يجمع الحروف
        -- حتى تُكتشف صيغ مثل: "كل//ز//ق" و"كـل زَق".
        local localChatMutes = {}
        local updateChatMuteDisplay
        -- الكلمات المطلوبة فقط بعد إزالة المسافات والرموز:
        -- نتحقق من العبارات المسيئة الواضحة فقط.
        -- كلمة "امك" وحدها لا تُحظر لأنها قد تأتي في جملة عادية.
        -- "كس امك" = "كسامك"، و"كل زق" = "كلزق"، و"كل خرا" = "كلخرا".
        local badChatWords = {
            "كسامك",
            "كلزق",
            "كلخرا",
            "علىزبي"
        }

        local function normalizeChatText(value)
            value = tostring(value or ""):lower()
            local out = {}
            local ok = pcall(function()
                for _, codepoint in utf8.codes(value) do
                    -- إزالة التشكيل والتطويل.
                    if not ((codepoint >= 0x064B and codepoint <= 0x065F) or codepoint == 0x0640) then
                        -- توحيد أشكال الحروف العربية الشائعة للتحايل.
                        if codepoint == 0x0622 or codepoint == 0x0623 or codepoint == 0x0625 or codepoint == 0x0671 then
                            codepoint = 0x0627 -- ا
                        elseif codepoint == 0x0629 then
                            codepoint = 0x0647 -- ة -> ه
                        elseif codepoint == 0x0649 then
                            codepoint = 0x064A -- ى -> ي
                        elseif codepoint == 0x0624 then
                            codepoint = 0x0648 -- ؤ -> و
                        elseif codepoint == 0x0626 then
                            codepoint = 0x064A -- ئ -> ي
                        end

                        -- نحتفظ بالأحرف العربية واللاتينية فقط؛ أي رمز آخر يُهمل.
                        local isArabicLetter = (codepoint >= 0x0621 and codepoint <= 0x063A)
                            or (codepoint >= 0x0641 and codepoint <= 0x064A)
                            or (codepoint >= 0x0671 and codepoint <= 0x06D3)
                            or (codepoint >= 0x06FA and codepoint <= 0x06FC)
                        local isLatinLetter = (codepoint >= 0x61 and codepoint <= 0x7A)
                        if isArabicLetter or isLatinLetter then
                            table.insert(out, utf8.char(codepoint))
                        end
                    end
                end
            end)
            if not ok then return "" end
            return table.concat(out)
        end

        local function findBadChatWord(value)
            local normalized = normalizeChatText(value)
            if normalized == "" then return nil, normalized end
            for _, word in ipairs(badChatWords) do
                -- الكلمات هنا كلها أطول من حرفين؛ المطابقة الجزئية تمنع التحايل
                -- بإضافة رموز أو مسافات بين الحروف، من دون اعتبار النص العادي مخالفة.
                if string.find(normalized, word, 1, true) then
                    return word, normalized
                end
            end
            return nil, normalized
        end

        local function moderationUrlFor(userId)
            return MODERATION_URL:gsub("%.json$", "/" .. tostring(userId) .. ".json") .. "?auth=" .. AUTH_TOKEN
        end

        local function setChatMute(userId, reason, durationSeconds)
            userId = tonumber(userId)
            if not userId then return end
            local untilTime = os.time() + (tonumber(durationSeconds) or CHAT_MUTE_SECONDS)
            localChatMutes[userId] = untilTime
            if updateChatMuteDisplay then
                updateChatMuteDisplay(untilTime)
            end
            task.spawn(function()
                pcall(function()
                    request({
                        Url = moderationUrlFor(userId),
                        Method = "PUT",
                        Headers = { ["Content-Type"] = "application/json" },
                        Body = game:GetService("HttpService"):JSONEncode({
                            ["until"] = untilTime,
                            reason = tostring(reason or "chat_filter"),
                            updatedAt = os.time()
                        })
                    })
                end)
            end)
        end

        local function refreshChatMutes()
            if not request then return end
            local ok, response = pcall(function()
                return request({Url = MODERATION_URL .. "?auth=" .. AUTH_TOKEN, Method = "GET"})
            end)
            if not ok or not response or not response.Body then return end
            local decodedOk, moderation = pcall(function()
                return game:GetService("HttpService"):JSONDecode(response.Body)
            end)
            if not decodedOk or type(moderation) ~= "table" then return end
            local now = os.time()
            for userId, record in pairs(moderation) do
                local untilTime = tonumber(record and record["until"])
                if untilTime and untilTime > now then
                    localChatMutes[tonumber(userId)] = untilTime
                    if tonumber(userId) == game.Players.LocalPlayer.UserId and updateChatMuteDisplay then
                        updateChatMuteDisplay(untilTime)
                    end
                end
            end
        end

        local function chatMuteRemaining(userId)
            local untilTime = localChatMutes[tonumber(userId)]
            if untilTime and untilTime > os.time() then
                return untilTime - os.time()
            end
            if untilTime then localChatMutes[tonumber(userId)] = nil end
            return 0
        end

