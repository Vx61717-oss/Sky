        -- 💬 فقاعة ثابتة فوق الرأس بحجم شاشة واحد.
        -- الفقاعة الأصلية في Roblox تكبر وتصغر مع بُعد الكاميرا، لذلك نستخدم
        -- ScreenGui ونحوّل مكان الرأس إلى إحداثيات الشاشة في كل إطار.
        -- 💬 فقاعات فوق الرأس مثل روبلوكس:
        -- نسمح بحد أقصى 3 رسايل لنفس الشخص في نفس الوقت.
        -- الجديدة تكون تحت، والأقدم تطلع فوق. إذا وصلت رسالة رابعة نحذف الأقدم.
        local _headBubbleStacks = {}
        local HEAD_BUBBLE_MAX = 3
        local HEAD_BUBBLE_GAP = 5
        local HEAD_BUBBLE_BASE_OFFSET = 8
        local HEAD_BUBBLE_MAX_HEIGHT = 120

        local function showMessageAboveHead(text, targetPlayer, isMine)
            local player = targetPlayer or game.Players.LocalPlayer
            local character = player and player.Character
            local head = character and character:FindFirstChild("Head")
            if not head then return end

            text = tostring(text or "")
            if text == "" then return end
            if isMine == nil then isMine = true end

            local userKey = tostring(player.UserId)
            local stack = _headBubbleStacks[userKey]
            if not stack then
                stack = {}
                _headBubbleStacks[userKey] = stack
            end

            -- 🧹 إذا عندنا 3 بالفعل، نحذف أقدم فقاعة قبل إضافة الجديدة.
            while #stack >= HEAD_BUBBLE_MAX do
                -- الرابعة لا تدخل أصلًا: نحذف أقدم فقاعة فقط ونبقي آخر 3.
                local oldest = table.remove(stack, 1)
                if oldest then
                    oldest.alive = false
                    if oldest.followConnection then
                        oldest.followConnection:Disconnect()
                        oldest.followConnection = nil
                    end
                    if oldest.bubble and oldest.bubble.Parent then
                        oldest.bubble:Destroy()
                    end
                end
            end

            local Camera = workspace.CurrentCamera
            if not Camera then return end

            -- حجم متناسب مع الكلام، مع حد أدنى حتى لا تصغر الرسائل القصيرة جدًا.
            local TextService = game:GetService("TextService")
            local textFont = Enum.Font.Arcade
            local textSize = 18
            local measured = TextService:GetTextSize(text, textSize, textFont, Vector2.new(300, 1000))
            local bubbleWidth = math.clamp(measured.X + 34, 155, 310)
            local bubbleHeight = math.clamp(measured.Y + 22, 58, 110)

            -- 🎨 لون التوهج: أنا بنفسجي، خويي أزرق، وغير المضاف رصاصي.
            local headIsFriend = false
            if not isMine and player then
                pcall(function()
                    headIsFriend = game.Players.LocalPlayer:IsFriendsWith(player.UserId)
                end)
            end
            local glowColor = isMine and Color3.fromRGB(170, 0, 255)
                or (headIsFriend and Color3.fromRGB(0, 140, 255) or Color3.fromRGB(145, 145, 155))

            local bubble = Instance.new("Frame")
            bubble.Name = "SkyFixedChatBubble_" .. userKey .. "_" .. tostring(math.floor(os.clock() * 1000000))
            bubble.Parent = NG
            bubble.AnchorPoint = Vector2.new(0.5, 1)
            local bubbleFullSize = UDim2.new(0, bubbleWidth, 0, bubbleHeight)
            bubble.Size = UDim2.new(0, 0, 0, 0)
            bubble.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
            bubble.BackgroundTransparency = 1
            bubble.BorderSizePixel = 0
            bubble.ZIndex = 100
            Instance.new("UICorner", bubble).CornerRadius = UDim.new(0, 14)

            local bubbleStroke = Instance.new("UIStroke", bubble)
            bubbleStroke.Color = glowColor
            bubbleStroke.Thickness = 1.6
            bubbleStroke.Transparency = 1

            local bubbleGradient = Instance.new("UIGradient", bubbleStroke)
            bubbleGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, glowColor),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(8, 8, 10)),
                ColorSequenceKeypoint.new(1, glowColor),
            })
            task.spawn(function()
                while bubbleGradient and bubbleGradient.Parent do
                    bubbleGradient.Rotation = (bubbleGradient.Rotation + 1.5) % 360
                    task.wait(0.03)
                end
            end)

            local label = Instance.new("TextLabel", bubble)
            label.Size = UDim2.new(1, -24, 1, -14)
            label.Position = UDim2.new(0, 12, 0, 7)
            label.BackgroundTransparency = 1
            label.Text = text
            label.TextColor3 = Color3.fromRGB(255, 255, 255)
            label.TextTransparency = 1
            label.Font = Enum.Font.Arcade
            label.TextSize = 18
            label.TextWrapped = true
            label.TextTruncate = Enum.TextTruncate.None
            label.TextXAlignment = Enum.TextXAlignment.Center
            label.TextYAlignment = Enum.TextYAlignment.Center
            label.ZIndex = 101

            -- ذيل صغير يربط الفقاعة بالرأس.
            local tail = Instance.new("Frame", bubble)
            tail.Size = UDim2.new(0, 12, 0, 12)
            tail.AnchorPoint = Vector2.new(0.5, 0)
            tail.Position = UDim2.new(0.5, 0, 1, -4)
            tail.Rotation = 45
            tail.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
            tail.BackgroundTransparency = 1
            tail.BorderSizePixel = 0
            tail.ZIndex = 99

            local record = {
                bubble = bubble,
                bubbleStroke = bubbleStroke,
                label = label,
                tail = tail,
                height = bubbleHeight,
                alive = true,
                followConnection = nil,
            }
            table.insert(stack, record)

            -- نعيد ترتيب الفقاعات: الأحدث تحت، والأقدم فوقها.
            local function repositionStack()
                for index, item in ipairs(stack) do
                    if item and item.bubble and item.bubble.Parent then
                        local newerCount = #stack - index
                        item.stackOffset = newerCount
                    end
                end
            end
            repositionStack()

            -- ⏱️ كل فقاعة لها مدة مستقلة، لكن وجود أكثر من 3 لا يحدث أبدًا.
            local baseSeconds = 6
            local extraSeconds = 0
            if #text > 15 then
                extraSeconds = math.clamp((#text - 15) * 0.09, 0, 12)
            end
            local visibleUntil = os.clock() + baseSeconds + extraSeconds
            local isClosing = false

            local function removeRecord()
                if not record.alive then return end
                record.alive = false
                if record.followConnection then
                    record.followConnection:Disconnect()
                    record.followConnection = nil
                end

                for i, item in ipairs(stack) do
                    if item == record then
                        table.remove(stack, i)
                        break
                    end
                end
                if #stack == 0 then
                    _headBubbleStacks[userKey] = nil
                end
                repositionStack()
                if bubble.Parent then bubble:Destroy() end
            end

            record.followConnection = RunService.RenderStepped:Connect(function()
                if not record.alive or not bubble.Parent or not head.Parent then
                    removeRecord()
                    return
                end

                Camera = workspace.CurrentCamera or Camera
                if not Camera then return end

                -- 📌 ترتيب Roblox: آخر رسالة تكون تحت، والرسائل الأقدم تصعد فوقها.
                -- لكل لاعب Stack مستقل، لذلك رسائل اللاعبين الآخرين لا تتداخل مع بعض.
                local stackIndex = table.find(stack, record) or #stack
                local pixelOffset = HEAD_BUBBLE_BASE_OFFSET + 30

                -- نجمع ارتفاع الفقاعات الأحدث فقط؛ بهذا تكون الجديدة دائمًا أقرب للرأس.
                for i = #stack, stackIndex + 1, -1 do
                    local newer = stack[i]
                    if newer and newer.alive and newer.bubble and newer.bubble.Parent then
                        pixelOffset = pixelOffset + math.min(newer.height or 58, HEAD_BUBBLE_MAX_HEIGHT) + HEAD_BUBBLE_GAP
                    end
                end

                local screenPoint, onScreen = Camera:WorldToViewportPoint(head.Position)
                bubble.Position = UDim2.fromOffset(screenPoint.X, screenPoint.Y - pixelOffset)
                bubble.Visible = (onScreen and screenPoint.Z > 0) or isClosing

                if os.clock() >= visibleUntil and not isClosing then
                    isClosing = true
                    local outInfo = TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                    _TweenS:Create(bubble, outInfo, {
                        Size = UDim2.new(0, 0, 0, 0),
                        BackgroundTransparency = 1
                    }):Play()
                    _TweenS:Create(bubbleStroke, outInfo, {Transparency = 1}):Play()
                    _TweenS:Create(label, outInfo, {TextTransparency = 1}):Play()
                    _TweenS:Create(tail, outInfo, {BackgroundTransparency = 1}):Play()
                    task.delay(0.35, removeRecord)
                end
            end)

            -- أنيميشن ظهور: تكبر الفقاعة من نقطة صغيرة.
            local inInfo = TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            _TweenS:Create(bubble, inInfo, {
                Size = bubbleFullSize,
                BackgroundTransparency = 0.08
            }):Play()
            _TweenS:Create(bubbleStroke, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Transparency = 0.12
            }):Play()
            _TweenS:Create(label, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                TextTransparency = 0
            }):Play()
            _TweenS:Create(tail, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundTransparency = 0
            }):Play()
        end

        -- 💬 زر خارجي بسيط لفتح نسخة ثانية من مربع الكتابة خارج قائمة الدردشة
        local ChatFloatBtn = Instance.new("TextButton", ChatInputBar)
        ChatFloatBtn.Name = "ChatFloatBtn"
        ChatFloatBtn.Size = UDim2.new(0, 38, 0, 38)
        ChatFloatBtn.Position = UDim2.new(0.55, -68, 0.5, -19) -- قريب من مربع الكتابة الأصلي مع مسافة بسيطة
        ChatFloatBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
