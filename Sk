        l.Text = txt .. ": " .. startVal; l.TextColor3 = Color3.new(1,1,1); l.BackgroundTransparency = 1; l.TextXAlignment = "Left"; l.TextSize = 18; l.Font = Enum.Font.GothamMedium; l.ZIndex = 7

