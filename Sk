    -- (القوائم AnchorPoint = 0.5,0.5 فنعوّض حركة المركز مع تغيير الارتفاع)
    State.PanelBusy = setmetatable({}, {__mode = "k"})
    State.LockPanelToggle = function(panel) -- يمنع ضغطتين متداخلتين أثناء الأنميشن
        if not panel then return false end
