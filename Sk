        dismissConstraint.MaxTextSize = 13
        dismissConstraint.MinTextSize = 8

        dismissBtn.MouseButton1Click:Connect(function()
            if onDismiss then onDismiss() end
            if frame and frame.Parent then
                _FlyTipTweenS:Create(frame, TweenInfo.new(0.3), {
                    BackgroundTransparency = 1,
                    Position = frame.Position + UDim2.new(0, 0, 0, -20)
                }):Play()
                _FlyTipTweenS:Create(stroke, TweenInfo.new(0.3), {Transparency = 1}):Play()
