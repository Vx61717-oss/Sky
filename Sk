        -- 📤 إرسال الملاحظة لفايربيس عشان المطوّرة تشوفها لاحقًا
        local function sendNote()
            local text = tostring(notesInputBox.Text or "")
            if text:gsub("%s+", "") == "" then return end
            notesInputBox.Text = ""

            local myName = game.Players.LocalPlayer.Name
            local myUserId = game.Players.LocalPlayer.UserId
            local payload = {
                ["sender"] = myName,
                ["userId"] = myUserId,
                ["text"] = text,
                ["ts"] = os.time(),
                ["placeId"] = tostring(game.PlaceId),
            }

            task.spawn(function()
                local ok = false
                local newId = nil
                if request then
                    local success, response = pcall(function()
                        return request({
                            Url = NOTES_URL .. "?auth=" .. AUTH_TOKEN,
                            Method = "POST",
                            Headers = {["Content-Type"] = "application/json"},
                            Body = game:GetService("HttpService"):JSONEncode(payload)
                        })
                    end)
                    ok = success and response and (not response.StatusCode or response.StatusCode == 200)
                    if ok and response.Body then
                        local okK, keyData = pcall(function()
                            return game:GetService("HttpService"):JSONDecode(response.Body)
                        end)
                        if okK and keyData and keyData.name then newId = keyData.name end
                    end
                end
                addNoteRow(text, ok, newId, myUserId)
                if ok then
                    Notify("📝 تم الإرسال", "وصلت ملاحظتك، شكرًا لك", UI.TabColors[8])
                else
                    Notify("❌ فشل الإرسال", "تأكد من الاتصال وحاول مرة ثانية", Color3.fromRGB(255, 60, 60))
                end
            end)
        end

        notesInputBox.FocusLost:Connect(function(enter)
            if enter then sendNote() end
        end)

