local LocalPlayer = Players.LocalPlayer
local ESP = {}

local COLORS = {
    Enemy = Color3.fromRGB(255, 0, 0),
    Friend = Color3.fromRGB(0, 120, 255),
    Bot = Color3.fromRGB(0, 255, 0)
}

local function IsFriend(player)
    if not player or player == LocalPlayer then
        return false
    end

    local ok, result = pcall(function()
        return LocalPlayer:IsFriendsWith(player.UserId)
    end)

    return ok and result
end

local function GetRoot(character)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function GetPlayerESPColor(player)
    if player and player ~= LocalPlayer then
        return IsFriend(player) and COLORS.Friend or COLORS.Enemy
    end
    return COLORS.Enemy
end

local function RemoveESP(character)
    local data = ESP[character]
    if not data then return end

    if data.Highlight then data.Highlight:Destroy() end
    if data.Attachment then data.Attachment:Destroy() end
    if data.Beam then data.Beam:Destroy() end

    ESP[character] = nil
end

local function HideAllESP()
    for character in pairs(ESP) do
        RemoveESP(character)
    end
end

local function CreateESP(character, color)
    if ESP[character] then return end

    local root = GetRoot(character)
    if not root then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "SkyESP"
    highlight.Adornee = character
    highlight.FillTransparency = 1
    highlight.OutlineTransparency = 0
    highlight.OutlineColor = color
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character

    local attachment = Instance.new("Attachment")
    attachment.Name = "SkyESP_Tracer"
    attachment.Parent = root

    local beam = Instance.new("Beam")
    beam.Name = "SkyESP_Line"
    beam.Attachment0 = attachment
    beam.FaceCamera = true
    beam.Width0 = 0.04
    beam.Width1 = 0.04
    beam.Transparency = NumberSequence.new(0)
    beam.Color = ColorSequence.new(color)
    beam.LightEmission = 1
    beam.Segments = 1
    beam.Parent = root

    ESP[character] = {
        Root = root,
        Highlight = highlight,
        Attachment = attachment,
        Beam = beam,
        Color = color
    }
end

local function UpdateESP(character, color)
    local root = GetRoot(character)

    if not root then
        RemoveESP(character)
        return
    end

    if not ESP[character] then
        CreateESP(character, color)
    end

    local data = ESP[character]
    if not data then return end

    -- لا نعيد إنشاء ColorSequence كل فريم.
    if data.Color ~= color then
        data.Color = color

        if data.Highlight then
            data.Highlight.OutlineColor = color
        end

        if data.Beam then
            data.Beam.Color = ColorSequence.new(color)
        end
    end

    if data.Highlight then
        data.Highlight.Adornee = character
        data.Highlight.Enabled = true
    end

    if data.Beam then
        data.Beam.Enabled = true
    end
end

